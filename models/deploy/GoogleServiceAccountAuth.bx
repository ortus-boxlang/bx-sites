/**
 * Shared Google Cloud OAuth2 service-account authentication, used by both
 * `GcsTarget` and `FirebaseTarget` - trades a downloaded GCP/Firebase
 * service-account JSON key file for a short-lived OAuth2 Bearer access
 * token via the standard "JWT Bearer" grant (RFC 7523): build and
 * RS256-sign a JWT asserting the service account's identity/requested
 * scope, then exchange it at the key's own `token_uri` for an
 * `access_token`.
 *
 * Deliberately no token caching/refresh here - `getAccessToken()` is meant
 * to be called once per `deploy()` run, right before that target's own
 * upload loop; a fresh token is cheap to mint and comfortably outlives a
 * single deploy (Google tokens are valid ~1 hour).
 *
 * `buildJwt()` and `base64UrlEncode()` are exposed as their own pure
 * (no-HTTP, no-file-I/O) public functions specifically so specs can
 * exercise the JWT-building and base64url-encoding logic directly against
 * fixed inputs, without a real Google Cloud/Firebase account - see
 * GoogleServiceAccountAuthSpec.bx. Only `getAccessToken()`'s final HTTP
 * token-exchange call against Google's real `token_uri` is NOT exercised
 * for real in this sandbox (no live GCP/Firebase credentials available
 * here) - it's covered only indirectly, by exercising every step up to and
 * including the request it would send.
 */
class {

	variables.GRANT_TYPE = "urn:ietf:params:oauth:grant-type:jwt-bearer"

	/**
	 * Full flow: read + parse the service-account key file, build + sign a
	 * JWT for the requested scope, exchange it at the key's own `token_uri`.
	 *
	 * @serviceAccountKeyPath Absolute path to the downloaded service-account JSON key file
	 * @scope The OAuth2 scope(s) to request - space-separated if more than one
	 *        (e.g. "https://www.googleapis.com/auth/devstorage.read_write")
	 *
	 * @return { accessToken, expiresAt } - `expiresAt` is an epoch-seconds estimate (now + expires_in)
	 */
	struct function getAccessToken( required string serviceAccountKeyPath, required string scope ) {
		var serviceAccountKey = readServiceAccountKey( arguments.serviceAccountKeyPath )
		var jwt = buildJwt( serviceAccountKey, arguments.scope, nowEpochSeconds() )
		return exchangeJwtForToken( serviceAccountKey.token_uri, jwt )
	}

	/**
	 * Reads and parses a service-account JSON key file, validating it has
	 * the three fields this flow actually needs.
	 *
	 * @serviceAccountKeyPath Absolute path to the downloaded service-account JSON key file
	 *
	 * @return The parsed key struct - `client_email`, `private_key` (PEM), `token_uri`, plus whatever else Google put in the file
	 */
	struct function readServiceAccountKey( required string serviceAccountKeyPath ) {
		if ( !fileExists( arguments.serviceAccountKeyPath ) ) {
			throw(
				type    = "BxSites.MissingServiceAccountKey",
				message = "Service account key file not found: #arguments.serviceAccountKeyPath#"
			)
		}

		var key = ""
		try {
			key = jsonDeserialize( fileRead( arguments.serviceAccountKeyPath ) )
		} catch ( any e ) {
			throw(
				type    = "BxSites.InvalidServiceAccountKey",
				message = "Could not parse service account key file [#arguments.serviceAccountKeyPath#] as JSON: #e.message#"
			)
		}

		for ( var field in [ "client_email", "private_key", "token_uri" ] ) {
			if ( !len( key[ field ] ?: "" ) ) {
				throw(
					type    = "BxSites.InvalidServiceAccountKey",
					message = "Service account key file [#arguments.serviceAccountKeyPath#] is missing '#field#'"
				)
			}
		}

		return key
	}

	/**
	 * Builds an RS256-signed JWT asserting `serviceAccountKey.client_email`'s
	 * identity for `scope`, per Google's Service Account JWT profile - pure
	 * (no HTTP), taking `issuedAt` as a parameter (rather than calling `now()`
	 * internally) so specs can pass a fixed value and assert exact `iat`/`exp`
	 * claims.
	 *
	 * @serviceAccountKey The parsed service-account key struct (see readServiceAccountKey()) - `client_email`/`private_key`/`token_uri` are used
	 * @scope The OAuth2 scope(s) to request - space-separated if more than one
	 * @issuedAt Epoch seconds to use as the JWT's `iat` claim (`exp` is `issuedAt + 3600`)
	 *
	 * @return The complete signed JWT: `base64url(header).base64url(claims).base64url(signature)`
	 */
	string function buildJwt( required struct serviceAccountKey, required string scope, required numeric issuedAt ) {
		var header = { "alg" : "RS256", "typ" : "JWT" }
		var claims = {
			"iss"   : arguments.serviceAccountKey.client_email,
			"scope" : arguments.scope,
			"aud"   : arguments.serviceAccountKey.token_uri,
			"iat"   : arguments.issuedAt,
			"exp"   : arguments.issuedAt + 3600
		}

		var headerSegment = base64UrlEncode( charsetDecode( jsonSerialize( header ), "utf-8" ) )
		var claimsSegment = base64UrlEncode( charsetDecode( jsonSerialize( claims ), "utf-8" ) )
		var signingInput = headerSegment & "." & claimsSegment

		var signatureBytes = signRS256( signingInput, arguments.serviceAccountKey.private_key )

		return signingInput & "." & base64UrlEncode( signatureBytes )
	}

	/**
	 * Base64url encoding (RFC 4648 sec.5): standard base64 with `+`/`/`
	 * substituted for `-`/`_` and trailing `=` padding stripped entirely -
	 * a pure, directly-unit-testable helper, no HTTP/JWT knowledge at all.
	 *
	 * @bytes The raw bytes to encode
	 *
	 * @return The base64url-encoded string, unpadded
	 */
	string function base64UrlEncode( required binary bytes ) {
		return binaryEncode( arguments.bytes, "base64" )
			.replace( "+", "-", "all" )
			.replace( "/", "_", "all" )
			.replace( "=", "", "all" )
	}

	/**
	 * RS256 (RSA-SHA256) signs `signingInput`'s UTF-8 bytes using the PEM-
	 * encoded PKCS#8 RSA private key from a service-account key file.
	 *
	 * @signingInput The JWT signing input: `base64url(header).base64url(claims)`
	 * @privateKeyPem The service-account key's `private_key` field - PEM text with `-----BEGIN/END PRIVATE KEY-----` markers
	 *
	 * @return The raw (unencoded) RSA signature bytes
	 */
	private binary function signRS256( required string signingInput, required string privateKeyPem ) {
		var keySpec = createObject( "java", "java.security.spec.PKCS8EncodedKeySpec" ).init( pemToDer( arguments.privateKeyPem ) )
		var keyFactory = createObject( "java", "java.security.KeyFactory" ).getInstance( "RSA" )
		var privateKey = keyFactory.generatePrivate( keySpec )

		var signer = createObject( "java", "java.security.Signature" ).getInstance( "SHA256withRSA" )
		signer.initSign( privateKey )
		signer.update( charsetDecode( arguments.signingInput, "utf-8" ) )

		return signer.sign()
	}

	/**
	 * Strips a PEM key's `-----BEGIN/END ...-----` markers and all
	 * whitespace, then base64-decodes what's left down to the raw DER bytes
	 * `PKCS8EncodedKeySpec` expects. JSON's own `\n` unescaping (done by
	 * `jsonDeserialize()` when the key file was read) already turns the key
	 * file's escaped `\n` sequences into real newlines before this ever
	 * runs - this strips those (and any other whitespace) regardless of
	 * form, so it works whether the PEM body arrives single-line or
	 * line-wrapped.
	 *
	 * @privateKeyPem The PEM text, `-----BEGIN PRIVATE KEY-----`...`-----END PRIVATE KEY-----`
	 *
	 * @return The raw DER-encoded key bytes
	 */
	private binary function pemToDer( required string privateKeyPem ) {
		var body = arguments.privateKeyPem
			.reReplace( "-----BEGIN [A-Z ]+-----", "", "all" )
			.reReplace( "-----END [A-Z ]+-----", "", "all" )
			.reReplace( "[\r\n\s]+", "", "all" )
		return binaryDecode( body, "base64" )
	}

	/**
	 * Exchanges a signed JWT for a Bearer access token at Google's token
	 * endpoint, per RFC 7523's JWT Bearer grant.
	 *
	 * @tokenUri The service-account key's own `token_uri` (normally `https://oauth2.googleapis.com/token`)
	 * @jwt The signed JWT from buildJwt()
	 *
	 * @return { accessToken, expiresAt }
	 */
	private struct function exchangeJwtForToken( required string tokenUri, required string jwt ) {
		var body = "grant_type=" & variables.GRANT_TYPE & "&assertion=" & arguments.jwt

		var result = ""
		bx:http url="#arguments.tokenUri#" method="POST" result="result" {
			bx:httpparam type="header" name="Content-Type" value="application/x-www-form-urlencoded";
			bx:httpparam type="body" value="#body#";
		}

		var statusCode = val( listFirst( result.statusCode ?: "0", " " ) )
		if ( statusCode < 200 || statusCode >= 300 ) {
			throw(
				type    = "BxSites.AuthFailed",
				message = "Failed to exchange service-account JWT for an access token at #arguments.tokenUri# (status #result.statusCode#): #result.fileContent#"
			)
		}

		var parsed = jsonDeserialize( result.fileContent )
		var expiresIn = val( parsed.expires_in ?: 3600 )

		return {
			accessToken : parsed.access_token,
			expiresAt   : nowEpochSeconds() + expiresIn
		}
	}

	/**
	 * @return Current time as epoch seconds (Java's own millis-since-epoch clock, floored to whole seconds)
	 */
	private numeric function nowEpochSeconds() {
		return int( createObject( "java", "java.lang.System" ).currentTimeMillis() / 1000 )
	}

}
