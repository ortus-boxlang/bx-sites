/**
 * Reads, defaults, and validates a project's `bxdocs.json` site configuration
 * (module spec section 4). Pure struct in, struct out - no CLI/argv concerns,
 * so it is unit-testable directly against a temp project directory.
 */
class {

	/**
	 * Default site configuration, deep-merged with the user's bxdocs.json.
	 * Markdown passthrough options are otherwise left to bx-markdown's own
	 * defaults - the one exception is `enableAdmonition`, which bx-docs
	 * itself defaults to `true` (admonition callout blocks have always been
	 * an out-of-the-box bx-docs feature; a project can still turn them off
	 * via `{"markdown":{"enableAdmonition":false}}`).
	 */
	variables.defaults = {
		"description"  : "",
		"baseURL"      : "/",
		"theme"        : { "name" : "bootstrap", "options" : {}, "logo" : "", "favicon" : "" },
		"search"       : true,
		"nav"          : [],
		"markdown"     : { "enableAdmonition" : true },
		"repo"         : { "url" : "", "editUri" : "" },
		"social"       : [],
		"footer"       : false,
		"lastUpdated"  : false,
		"mermaid"      : false,
		"math"         : false,
		"analytics"    : { "provider" : "", "id" : "" },
		"ogImage"      : "",
		"generateOgImages" : false,
		"extraCss"     : [],
		"extraJs"      : [],
		"plugins"      : [],
		"i18n"         : { "defaultLocale" : { "code" : "en", "label" : "English" }, "locales" : [] }
	}

	/**
	 * The theme names shipped by this module in v1 (module spec section 6).
	 */
	variables.builtInThemes = [ "bootstrap", "material", "tailwind" ]

	/**
	 * Reads and validates `<projectRoot>/bxdocs.json`, merging it over the
	 * module's own defaults.
	 *
	 * @projectRoot Absolute path to the project root
	 *
	 * @return The normalized site configuration struct
	 */
	struct function load( required string projectRoot ) {
		var configPath = configPathFor( arguments.projectRoot )

		if ( !fileExists( configPath ) ) {
			throw(
				type    = "BxDocs.ConfigNotFound",
				message = "No bxdocs.json found at [#configPath#] - run `new` to scaffold a project first"
			)
		}

		var parsed = ""
		try {
			parsed = jsonDeserialize( fileRead( configPath ) )
		} catch ( any e ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "bxdocs.json at [#configPath#] is not valid JSON: #e.message#"
			)
		}

		if ( !isStruct( parsed ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "bxdocs.json at [#configPath#] must contain a JSON object"
			)
		}

		return validate( mergeDefaults( parsed ) )
	}

	/**
	 * The absolute path to a project's `bxdocs.json`, regardless of whether it exists yet.
	 *
	 * @projectRoot Absolute path to the project root
	 */
	string function configPathFor( required string projectRoot ) {
		return arguments.projectRoot.reReplace( "[\/]+$", "" ) & "/bxdocs.json"
	}

	/**
	 * Deep-merges a parsed bxdocs.json struct over the module defaults - a
	 * user-supplied key wins outright, a user-supplied struct key is merged
	 * one level deep (so `{"theme":{"name":"material"}}` still keeps the
	 * default empty `options`), everything else falls back to the default.
	 *
	 * @config The parsed bxdocs.json struct
	 *
	 * @return The config struct with defaults applied
	 */
	struct function mergeDefaults( required struct config ) {
		var merged = duplicate( variables.defaults )

		for ( var key in arguments.config ) {
			if ( isStruct( merged[ key ] ?: "" ) && isStruct( arguments.config[ key ] ) ) {
				for ( var subKey in arguments.config[ key ] ) {
					merged[ key ][ subKey ] = arguments.config[ key ][ subKey ]
				}
			} else {
				merged[ key ] = arguments.config[ key ]
			}
		}

		return merged
	}

	/**
	 * Validates a merged site configuration struct.
	 *
	 * @config The merged config struct to validate
	 *
	 * @return The same config struct, unchanged, if valid
	 */
	struct function validate( required struct config ) {
		if ( !len( trim( arguments.config.name ?: "" ) ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "bxdocs.json is missing a required [name] property"
			)
		}

		var theme = arguments.config.theme ?: ""
		if ( !isStruct( theme ) || !len( trim( theme.name ?: "" ) ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "bxdocs.json [theme] must be an object with a [name] property"
			)
		}

		var colorMode = theme.options.colorMode ?: "auto"
		if ( !listFindNoCase( "light,dark,auto", colorMode ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "bxdocs.json [theme.options.colorMode], when present, must be one of: light, dark, auto"
			)
		}

		if ( !isSimpleValue( theme.logo ?: "" ) || !isSimpleValue( theme.favicon ?: "" ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "bxdocs.json [theme.logo]/[theme.favicon], when present, must be strings"
			)
		}

		for ( var navFlag in [ "navCollapsible", "navExpandAll" ] ) {
			if ( theme.options.keyExists( navFlag ) && !isBoolean( theme.options[ navFlag ] ) ) {
				throw(
					type    = "BxDocs.InvalidConfig",
					message = "bxdocs.json [theme.options.#navFlag#], when present, must be a boolean"
				)
			}
		}

		var tocPosition = theme.options.tocPosition ?: "top"
		if ( !listFindNoCase( "top,sticky", tocPosition ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "bxdocs.json [theme.options.tocPosition], when present, must be one of: top, sticky"
			)
		}

		var pageMetaPosition = theme.options.pageMetaPosition ?: "bottom"
		if ( !listFindNoCase( "top,bottom", pageMetaPosition ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "bxdocs.json [theme.options.pageMetaPosition], when present, must be one of: top, bottom"
			)
		}

		if ( !isBoolean( arguments.config.search ?: "" ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "bxdocs.json [search] must be a boolean"
			)
		}

		if ( !isBoolean( arguments.config.mermaid ?: "" ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "bxdocs.json [mermaid] must be a boolean"
			)
		}

		if ( !isBoolean( arguments.config.math ?: "" ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "bxdocs.json [math] must be a boolean"
			)
		}

		if ( !isArray( arguments.config.nav ?: "" ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "bxdocs.json [nav], when present, must be an array"
			)
		}

		if ( !isStruct( arguments.config.markdown ?: "" ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "bxdocs.json [markdown], when present, must be an object"
			)
		}

		var repo = arguments.config.repo ?: ""
		if ( !isStruct( repo ) || !isSimpleValue( repo.url ?: "" ) || !isSimpleValue( repo.editUri ?: "" ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "bxdocs.json [repo], when present, must be an object with string [url]/[editUri]"
			)
		}

		if ( !isArray( arguments.config.social ?: "" ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "bxdocs.json [social], when present, must be an array"
			)
		}
		for ( var link in arguments.config.social ) {
			if ( !isStruct( link ) || !len( trim( link.url ?: "" ) ) ) {
				throw(
					type    = "BxDocs.InvalidConfig",
					message = "bxdocs.json [social] entries must be objects with a non-empty [url]"
				)
			}
		}

		if ( !isBoolean( arguments.config.footer ?: "" ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "bxdocs.json [footer] must be a boolean"
			)
		}

		if ( !isBoolean( arguments.config.lastUpdated ?: "" ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "bxdocs.json [lastUpdated] must be a boolean"
			)
		}

		var analytics = arguments.config.analytics ?: ""
		if ( !isStruct( analytics ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "bxdocs.json [analytics], when present, must be an object"
			)
		}
		var analyticsProvider = trim( analytics.provider ?: "" )
		if ( len( analyticsProvider ) && analyticsProvider != "google" ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "bxdocs.json [analytics.provider], when present, must be: google"
			)
		}
		if ( analyticsProvider == "google" && !len( trim( analytics.id ?: "" ) ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "bxdocs.json [analytics.id] is required when [analytics.provider] is set"
			)
		}
		if ( len( analyticsProvider ) && !reFind( "^[A-Za-z0-9\-]+$", trim( analytics.id ?: "" ) ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "bxdocs.json [analytics.id] must contain only letters, numbers and hyphens"
			)
		}

		if ( !isSimpleValue( arguments.config.ogImage ?: "" ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "bxdocs.json [ogImage], when present, must be a string"
			)
		}

		if ( !isBoolean( arguments.config.generateOgImages ?: "" ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "bxdocs.json [generateOgImages], when present, must be a boolean"
			)
		}

		for ( var assetsKey in [ "extraCss", "extraJs" ] ) {
			var assetUrls = arguments.config[ assetsKey ] ?: ""
			if ( !isArray( assetUrls ) ) {
				throw(
					type    = "BxDocs.InvalidConfig",
					message = "bxdocs.json [#assetsKey#], when present, must be an array"
				)
			}
			for ( var assetUrl in assetUrls ) {
				if ( !isSimpleValue( assetUrl ) || !len( trim( assetUrl ) ) ) {
					throw(
						type    = "BxDocs.InvalidConfig",
						message = "bxdocs.json [#assetsKey#] entries must be non-empty strings"
					)
				}
			}
		}

		if ( !isArray( arguments.config.plugins ?: "" ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "bxdocs.json [plugins], when present, must be an array"
			)
		}
		for ( var pluginName in arguments.config.plugins ) {
			if ( !isSimpleValue( pluginName ) || !len( trim( pluginName ) ) ) {
				throw(
					type    = "BxDocs.InvalidConfig",
					message = "bxdocs.json [plugins] entries must be non-empty strings (BoxLang module names)"
				)
			}
		}

		validateI18n( arguments.config.i18n ?: "" )

		return arguments.config
	}

	/**
	 * Validates `bxdocs.json`'s `i18n` block (module spec section 4) - the
	 * `docs/i18n/<code>/` locale-folder convention's own display/routing
	 * metadata. An empty `locales` array (the default) means the project
	 * isn't multilingual at all - no `docs/i18n/` folder is required to
	 * exist, and none of this is otherwise consulted.
	 *
	 * @i18n The merged config's own `i18n` value - `any`, not `struct`, so a
	 * user-supplied non-struct value (mergeDefaults() only overwrites the
	 * default wholesale when it isn't a struct - see its own docblock)
	 * fails with a clean BxDocs.InvalidConfig below, rather than a raw
	 * BoxLang type-mismatch error from the function signature itself.
	 */
	private void function validateI18n( required any i18n ) {
		if ( !isStruct( arguments.i18n ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "bxdocs.json [i18n], when present, must be an object"
			)
		}

		validateLocale( arguments.i18n.defaultLocale ?: "", "i18n.defaultLocale" )

		if ( !isArray( arguments.i18n.locales ?: "" ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "bxdocs.json [i18n.locales], when present, must be an array"
			)
		}

		var seenCodes = [ lCase( arguments.i18n.defaultLocale.code ) ]
		for ( var locale in arguments.i18n.locales ) {
			validateLocale( locale, "i18n.locales" )
			var code = lCase( trim( locale.code ) )
			if ( seenCodes.contains( code ) ) {
				throw(
					type    = "BxDocs.InvalidConfig",
					message = "bxdocs.json [i18n.locales] has a duplicate locale code [#locale.code#] (also used by [i18n.defaultLocale] or an earlier entry)"
				)
			}
			seenCodes.append( code )
		}
	}

	/**
	 * Validates a single locale entry - `i18n.defaultLocale`, or one entry
	 * of `i18n.locales`. `code` doubles as a `docs/i18n/<code>/` folder name
	 * and a URL path segment, so it's restricted to letters/digits/hyphens
	 * (BCP-47-shaped, e.g. `es`, `pt-BR`, `zh-Hans` - no `/`/`.` a path
	 * could ever escape with).
	 *
	 * @locale The locale struct to validate
	 * @path Where it lives in bxdocs.json, for the error message
	 */
	private void function validateLocale( required any locale, required string path ) {
		if ( !isStruct( arguments.locale ) || !len( trim( arguments.locale.code ?: "" ) ) || !len( trim( arguments.locale.label ?: "" ) ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "bxdocs.json [#arguments.path#] must be an object with a non-empty [code] and [label]"
			)
		}

		if ( !reFind( "^[A-Za-z][A-Za-z0-9\-]*$", trim( arguments.locale.code ) ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "bxdocs.json [#arguments.path#.code] [#arguments.locale.code#] must contain only letters, digits and hyphens"
			)
		}

		var dir = arguments.locale.dir ?: "ltr"
		if ( !listFindNoCase( "ltr,rtl", dir ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "bxdocs.json [#arguments.path#.dir], when present, must be one of: ltr, rtl"
			)
		}

		if ( arguments.locale.keyExists( "strings" ) && !isStruct( arguments.locale.strings ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "bxdocs.json [#arguments.path#.strings], when present, must be an object"
			)
		}

		if ( arguments.locale.keyExists( "flag" ) && !isSimpleValue( arguments.locale.flag ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "bxdocs.json [#arguments.path#.flag], when present, must be a string"
			)
		}
	}

	/**
	 * The theme names this module ships built-in support for (module spec section 6).
	 */
	array function getBuiltInThemes() {
		return variables.builtInThemes
	}

}
