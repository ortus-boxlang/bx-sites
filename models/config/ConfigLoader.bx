/**
 * Reads, defaults, and validates a project's site configuration (module spec
 * section 4). `bxdocs.yaml` (or `.yml`) is the preferred/default format -
 * `bxdocs.json` is still fully supported for existing projects, resolved in
 * that order when more than one is present. Pure struct in, struct out - no
 * CLI/argv concerns, so it is unit-testable directly against a temp project
 * directory.
 */
class {

	/**
	 * The config file names this module recognizes, in resolution
	 * preference order - the first one found on disk wins. `bxdocs.yaml`/
	 * `.yml` are parsed via bx-yaml's `yamlDeserialize()`/`yamlDeserializeFile()`
	 * BIFs, `bxdocs.json` via the built-in `jsonDeserialize()`.
	 */
	variables.configFileNames = [ "bxdocs.yaml", "bxdocs.yml", "bxdocs.json" ]

	/**
	 * The config file name in play for the current/last `load()` call - only
	 * used to phrase validation error messages against whichever file the
	 * project actually has. Defaults to the preferred name so a direct,
	 * standalone `validate()` call (bypassing `load()` - not used by this
	 * module itself, but a valid call shape) still produces a sensible message.
	 */
	variables.configFileName = "bxdocs.yaml"

	/**
	 * Parses `bxdocs.yaml`/`.yml` - real bx-yaml BIFs by default, swappable
	 * via setYamlRenderer() (YamlRenderer.bx's own docblock explains why).
	 */
	variables.yamlRenderer = new "models.build.YamlRenderer@bxdocs"()

	/**
	 * Swaps in a fake/test YAML renderer - see YamlRenderer.bx's docblock.
	 *
	 * @renderer Any object exposing `fromYaml( content )`
	 */
	void function setYamlRenderer( required any renderer ) {
		variables.yamlRenderer = arguments.renderer
	}

	/**
	 * Default site configuration, deep-merged with the user's site config.
	 * Markdown passthrough options are otherwise left to bx-markdown's own
	 * defaults - the one exception is `enableAdmonition`, which bx-docs
	 * itself defaults to `true` (admonition callout blocks have always been
	 * an out-of-the-box bx-docs feature; a project can still turn them off
	 * via `{"markdown":{"enableAdmonition":false}}`).
	 */
	variables.defaults = {
		"description"  : "",
		"baseURL"      : "/",
		"theme"        : { "name" : "bootstrap", "options" : {}, "logo" : "", "favicon" : "" },
		"search"       : true,
		"searchProvider" : {
			"provider" : "local",
			"algolia"  : { "appId" : "", "apiKey" : "", "indexName" : "", "insights" : false },
			"pagefind" : { "bin" : "pagefind", "options" : [] }
		},
		"nav"          : [],
		"markdown"     : { "enableAdmonition" : true },
		"repo"         : { "url" : "", "editUri" : "" },
		"social"       : [],
		"footer"       : false,
		"lastUpdated"  : false,
		"mermaid"      : false,
		"math"         : false,
		"analytics"    : { "provider" : "", "id" : "" },
		"ogImage"      : "",
		"generateOgImages" : false,
		"extraCss"     : [],
		"extraJs"      : [],
		"plugins"      : [],
		"i18n"         : { "defaultLocale" : { "code" : "en", "label" : "English" }, "locales" : [] },
		"blog"         : { "postsPerPage" : 10, "feed" : true }
	}

	/**
	 * The theme names shipped by this module in v1 (module spec section 6).
	 */
	variables.builtInThemes = [ "bootstrap", "material", "tailwind" ]

	/**
	 * Reads and validates a project's site config - `<projectRoot>/bxdocs.yaml`
	 * (or `.yml`/`.json`, whichever is actually present - see `configFileNames`),
	 * merging it over the module's own defaults.
	 *
	 * @projectRoot Absolute path to the project root
	 *
	 * @return The normalized site configuration struct
	 */
	struct function load( required string projectRoot ) {
		var configPath = configPathFor( arguments.projectRoot )
		variables.configFileName = configPath.listLast( "/" )

		if ( !fileExists( configPath ) ) {
			throw(
				type    = "BxDocs.ConfigNotFound",
				message = "No bxdocs.yaml (or bxdocs.json) found at [#arguments.projectRoot#] - run `new` to scaffold a project first"
			)
		}

		var isYaml = variables.configFileName.endsWith( ".yaml" ) || variables.configFileName.endsWith( ".yml" )

		var parsed = ""
		try {
			parsed = isYaml ? variables.yamlRenderer.fromYaml( fileRead( configPath ) ) : jsonDeserialize( fileRead( configPath ) )
		} catch ( any e ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "#variables.configFileName# at [#configPath#] is not valid #isYaml ? 'YAML' : 'JSON'#: #e.message#"
			)
		}

		if ( !isStruct( parsed ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "#variables.configFileName# at [#configPath#] must contain a #isYaml ? 'YAML' : 'JSON'# object"
			)
		}

		return validate( mergeDefaults( parsed ) )
	}

	/**
	 * The absolute path to a project's site config file - the first of
	 * `configFileNames` found on disk under `projectRoot`, or the preferred
	 * `bxdocs.yaml` path when none exist yet (a project with no config at all).
	 *
	 * @projectRoot Absolute path to the project root
	 */
	string function configPathFor( required string projectRoot ) {
		var dir = arguments.projectRoot.reReplace( "[\/]+$", "" )

		for ( var fileName in variables.configFileNames ) {
			var candidate = dir & "/" & fileName
			if ( fileExists( candidate ) ) {
				return candidate
			}
		}

		return dir & "/" & variables.configFileNames[ 1 ]
	}

	/**
	 * Deep-merges a parsed site config struct over the module defaults - a
	 * user-supplied key wins outright, a user-supplied struct key is merged
	 * one level deep (so `{"theme":{"name":"material"}}` still keeps the
	 * default empty `options`), everything else falls back to the default.
	 *
	 * @config The parsed site config struct
	 *
	 * @return The config struct with defaults applied
	 */
	struct function mergeDefaults( required struct config ) {
		var merged = duplicate( variables.defaults )

		for ( var key in arguments.config ) {
			if ( isStruct( merged[ key ] ?: "" ) && isStruct( arguments.config[ key ] ) ) {
				for ( var subKey in arguments.config[ key ] ) {
					merged[ key ][ subKey ] = arguments.config[ key ][ subKey ]
				}
			} else {
				merged[ key ] = arguments.config[ key ]
			}
		}

		return merged
	}

	/**
	 * Validates a merged site configuration struct.
	 *
	 * @config The merged config struct to validate
	 *
	 * @return The same config struct, unchanged, if valid
	 */
	struct function validate( required struct config ) {
		if ( !len( trim( arguments.config.name ?: "" ) ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "#variables.configFileName# is missing a required [name] property"
			)
		}

		var theme = arguments.config.theme ?: ""
		if ( !isStruct( theme ) || !len( trim( theme.name ?: "" ) ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "#variables.configFileName# [theme] must be an object with a [name] property"
			)
		}

		var colorMode = theme.options.colorMode ?: "auto"
		if ( !listFindNoCase( "light,dark,auto", colorMode ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "#variables.configFileName# [theme.options.colorMode], when present, must be one of: light, dark, auto"
			)
		}

		if ( !isSimpleValue( theme.logo ?: "" ) || !isSimpleValue( theme.favicon ?: "" ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "#variables.configFileName# [theme.logo]/[theme.favicon], when present, must be strings"
			)
		}

		for ( var navFlag in [ "navCollapsible", "navExpandAll" ] ) {
			if ( theme.options.keyExists( navFlag ) && !isBoolean( theme.options[ navFlag ] ) ) {
				throw(
					type    = "BxDocs.InvalidConfig",
					message = "#variables.configFileName# [theme.options.#navFlag#], when present, must be a boolean"
				)
			}
		}

		var tocPosition = theme.options.tocPosition ?: "top"
		if ( !listFindNoCase( "top,sticky", tocPosition ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "#variables.configFileName# [theme.options.tocPosition], when present, must be one of: top, sticky"
			)
		}

		var pageMetaPosition = theme.options.pageMetaPosition ?: "bottom"
		if ( !listFindNoCase( "top,bottom", pageMetaPosition ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "#variables.configFileName# [theme.options.pageMetaPosition], when present, must be one of: top, bottom"
			)
		}

		if ( !isBoolean( arguments.config.search ?: "" ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "#variables.configFileName# [search] must be a boolean"
			)
		}

		validateSearchProvider( arguments.config.searchProvider ?: "" )

		if ( !isBoolean( arguments.config.mermaid ?: "" ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "#variables.configFileName# [mermaid] must be a boolean"
			)
		}

		if ( !isBoolean( arguments.config.math ?: "" ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "#variables.configFileName# [math] must be a boolean"
			)
		}

		if ( !isArray( arguments.config.nav ?: "" ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "#variables.configFileName# [nav], when present, must be an array"
			)
		}

		if ( !isStruct( arguments.config.markdown ?: "" ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "#variables.configFileName# [markdown], when present, must be an object"
			)
		}

		var repo = arguments.config.repo ?: ""
		if ( !isStruct( repo ) || !isSimpleValue( repo.url ?: "" ) || !isSimpleValue( repo.editUri ?: "" ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "#variables.configFileName# [repo], when present, must be an object with string [url]/[editUri]"
			)
		}

		if ( !isArray( arguments.config.social ?: "" ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "#variables.configFileName# [social], when present, must be an array"
			)
		}
		for ( var link in arguments.config.social ) {
			if ( !isStruct( link ) || !len( trim( link.url ?: "" ) ) ) {
				throw(
					type    = "BxDocs.InvalidConfig",
					message = "#variables.configFileName# [social] entries must be objects with a non-empty [url]"
				)
			}
		}

		if ( !isBoolean( arguments.config.footer ?: "" ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "#variables.configFileName# [footer] must be a boolean"
			)
		}

		if ( !isBoolean( arguments.config.lastUpdated ?: "" ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "#variables.configFileName# [lastUpdated] must be a boolean"
			)
		}

		var analytics = arguments.config.analytics ?: ""
		if ( !isStruct( analytics ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "#variables.configFileName# [analytics], when present, must be an object"
			)
		}
		var analyticsProvider = trim( analytics.provider ?: "" )
		if ( len( analyticsProvider ) && analyticsProvider != "google" ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "#variables.configFileName# [analytics.provider], when present, must be: google"
			)
		}
		if ( analyticsProvider == "google" && !len( trim( analytics.id ?: "" ) ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "#variables.configFileName# [analytics.id] is required when [analytics.provider] is set"
			)
		}
		if ( len( analyticsProvider ) && !reFind( "^[A-Za-z0-9\-]+$", trim( analytics.id ?: "" ) ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "#variables.configFileName# [analytics.id] must contain only letters, numbers and hyphens"
			)
		}

		if ( !isSimpleValue( arguments.config.ogImage ?: "" ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "#variables.configFileName# [ogImage], when present, must be a string"
			)
		}

		if ( !isBoolean( arguments.config.generateOgImages ?: "" ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "#variables.configFileName# [generateOgImages], when present, must be a boolean"
			)
		}

		for ( var assetsKey in [ "extraCss", "extraJs" ] ) {
			var assetUrls = arguments.config[ assetsKey ] ?: ""
			if ( !isArray( assetUrls ) ) {
				throw(
					type    = "BxDocs.InvalidConfig",
					message = "#variables.configFileName# [#assetsKey#], when present, must be an array"
				)
			}
			for ( var assetUrl in assetUrls ) {
				if ( !isSimpleValue( assetUrl ) || !len( trim( assetUrl ) ) ) {
					throw(
						type    = "BxDocs.InvalidConfig",
						message = "#variables.configFileName# [#assetsKey#] entries must be non-empty strings"
					)
				}
			}
		}

		if ( !isArray( arguments.config.plugins ?: "" ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "#variables.configFileName# [plugins], when present, must be an array"
			)
		}
		for ( var pluginName in arguments.config.plugins ) {
			if ( !isSimpleValue( pluginName ) || !len( trim( pluginName ) ) ) {
				throw(
					type    = "BxDocs.InvalidConfig",
					message = "#variables.configFileName# [plugins] entries must be non-empty strings (BoxLang module names)"
				)
			}
		}

		validateI18n( arguments.config.i18n ?: "" )
		validateBlog( arguments.config.blog ?: "" )

		return arguments.config
	}

	/**
	 * Validates the site config's `blog` block - the `docs/blog/posts/`
	 * by-convention feature's own display/pagination options. No `docs/blog/`
	 * folder needs to exist for this to validate cleanly; it's only ever
	 * consulted once BlogDiscoverer.bx finds at least one post.
	 *
	 * @blog The merged config's own `blog` value - `any`, not `struct`, for
	 * the same reason validateI18n() takes `any` (see its own docblock)
	 */
	private void function validateBlog( required any blog ) {
		if ( !isStruct( arguments.blog ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "#variables.configFileName# [blog], when present, must be an object"
			)
		}

		var postsPerPage = arguments.blog.postsPerPage ?: 10
		if ( !isNumeric( postsPerPage ) || val( postsPerPage ) < 1 || val( postsPerPage ) != int( val( postsPerPage ) ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "#variables.configFileName# [blog.postsPerPage], when present, must be a positive whole number"
			)
		}

		if ( arguments.blog.keyExists( "feed" ) && !isBoolean( arguments.blog.feed ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "#variables.configFileName# [blog.feed], when present, must be a boolean"
			)
		}
	}

	/**
	 * Validates the site config's `searchProvider` block - which search UI
	 * `search: true` wires up (module spec section 7). `local` (the
	 * default, bx-docs' own static lunr search) needs no further settings.
	 * `algolia` (Algolia DocSearch) requires its own `algolia.{appId,apiKey,
	 * indexName}` - everything DocSearch's client itself requires to run.
	 * `pagefind` only validates its own `pagefind.{bin,options}` shape, if
	 * present - both are optional (`SearchProviderRegistry`/ConfigLoader's
	 * own defaults already cover the common case of `pagefind` being on
	 * `PATH` with no extra flags). Any other `provider` name isn't validated
	 * further here - it's a project's own custom/plugin-supplied provider,
	 * wired up by a `theme/` override rather than bx-docs core (see
	 * SearchProviderRegistry.bx).
	 *
	 * @searchProvider The merged config's own `searchProvider` value - `any`,
	 * not `struct`, for the same reason validateI18n() takes `any` (see its
	 * own docblock)
	 */
	private void function validateSearchProvider( required any searchProvider ) {
		if ( !isStruct( arguments.searchProvider ) || !len( trim( arguments.searchProvider.provider ?: "" ) ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "#variables.configFileName# [searchProvider] must be an object with a non-empty [provider]"
			)
		}

		var provider = lCase( trim( arguments.searchProvider.provider ) )

		if ( provider == "algolia" ) {
			var algolia = arguments.searchProvider.algolia ?: ""
			if (
				!isStruct( algolia )
				|| !len( trim( algolia.appId ?: "" ) )
				|| !len( trim( algolia.apiKey ?: "" ) )
				|| !len( trim( algolia.indexName ?: "" ) )
			) {
				throw(
					type    = "BxDocs.InvalidConfig",
					message = "#variables.configFileName# [searchProvider.algolia] must be an object with non-empty [appId], [apiKey] and [indexName] when [searchProvider.provider] is ""algolia"""
				)
			}

			if ( algolia.keyExists( "insights" ) && !isBoolean( algolia.insights ) ) {
				throw(
					type    = "BxDocs.InvalidConfig",
					message = "#variables.configFileName# [searchProvider.algolia.insights], when present, must be a boolean"
				)
			}
			return
		}

		if ( provider == "pagefind" ) {
			var pagefind = arguments.searchProvider.pagefind ?: ""
			if ( !isStruct( pagefind ) ) {
				throw(
					type    = "BxDocs.InvalidConfig",
					message = "#variables.configFileName# [searchProvider.pagefind], when present, must be an object"
				)
			}

			if ( pagefind.keyExists( "bin" ) && !len( trim( pagefind.bin ?: "" ) ) ) {
				throw(
					type    = "BxDocs.InvalidConfig",
					message = "#variables.configFileName# [searchProvider.pagefind.bin], when present, must be a non-empty string"
				)
			}

			if ( pagefind.keyExists( "options" ) ) {
				if ( !isArray( pagefind.options ) ) {
					throw(
						type    = "BxDocs.InvalidConfig",
						message = "#variables.configFileName# [searchProvider.pagefind.options], when present, must be an array"
					)
				}
				for ( var option in pagefind.options ) {
					if ( !isSimpleValue( option ) || !len( trim( option ) ) ) {
						throw(
							type    = "BxDocs.InvalidConfig",
							message = "#variables.configFileName# [searchProvider.pagefind.options] entries must be non-empty strings"
						)
					}
				}
			}
		}
	}

	/**
	 * Validates the site config's `i18n` block (module spec section 4) - the
	 * `docs/i18n/<code>/` locale-folder convention's own display/routing
	 * metadata. An empty `locales` array (the default) means the project
	 * isn't multilingual at all - no `docs/i18n/` folder is required to
	 * exist, and none of this is otherwise consulted.
	 *
	 * @i18n The merged config's own `i18n` value - `any`, not `struct`, so a
	 * user-supplied non-struct value (mergeDefaults() only overwrites the
	 * default wholesale when it isn't a struct - see its own docblock)
	 * fails with a clean BxDocs.InvalidConfig below, rather than a raw
	 * BoxLang type-mismatch error from the function signature itself.
	 */
	private void function validateI18n( required any i18n ) {
		if ( !isStruct( arguments.i18n ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "#variables.configFileName# [i18n], when present, must be an object"
			)
		}

		validateLocale( arguments.i18n.defaultLocale ?: "", "i18n.defaultLocale" )

		if ( !isArray( arguments.i18n.locales ?: "" ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "#variables.configFileName# [i18n.locales], when present, must be an array"
			)
		}

		var seenCodes = [ lCase( arguments.i18n.defaultLocale.code ) ]
		for ( var locale in arguments.i18n.locales ) {
			validateLocale( locale, "i18n.locales" )
			var code = lCase( trim( locale.code ) )
			if ( seenCodes.contains( code ) ) {
				throw(
					type    = "BxDocs.InvalidConfig",
					message = "#variables.configFileName# [i18n.locales] has a duplicate locale code [#locale.code#] (also used by [i18n.defaultLocale] or an earlier entry)"
				)
			}
			seenCodes.append( code )
		}
	}

	/**
	 * Validates a single locale entry - `i18n.defaultLocale`, or one entry
	 * of `i18n.locales`. `code` doubles as a `docs/i18n/<code>/` folder name
	 * and a URL path segment, so it's restricted to letters/digits/hyphens
	 * (BCP-47-shaped, e.g. `es`, `pt-BR`, `zh-Hans` - no `/`/`.` a path
	 * could ever escape with).
	 *
	 * @locale The locale struct to validate
	 * @path Where it lives in the site config, for the error message
	 */
	private void function validateLocale( required any locale, required string path ) {
		if ( !isStruct( arguments.locale ) || !len( trim( arguments.locale.code ?: "" ) ) || !len( trim( arguments.locale.label ?: "" ) ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "#variables.configFileName# [#arguments.path#] must be an object with a non-empty [code] and [label]"
			)
		}

		if ( !reFind( "^[A-Za-z][A-Za-z0-9\-]*$", trim( arguments.locale.code ) ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "#variables.configFileName# [#arguments.path#.code] [#arguments.locale.code#] must contain only letters, digits and hyphens"
			)
		}

		var dir = arguments.locale.dir ?: "ltr"
		if ( !listFindNoCase( "ltr,rtl", dir ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "#variables.configFileName# [#arguments.path#.dir], when present, must be one of: ltr, rtl"
			)
		}

		if ( arguments.locale.keyExists( "strings" ) && !isStruct( arguments.locale.strings ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "#variables.configFileName# [#arguments.path#.strings], when present, must be an object"
			)
		}

		if ( arguments.locale.keyExists( "flag" ) && !isSimpleValue( arguments.locale.flag ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "#variables.configFileName# [#arguments.path#.flag], when present, must be a string"
			)
		}
	}

	/**
	 * The theme names this module ships built-in support for (module spec section 6).
	 */
	array function getBuiltInThemes() {
		return variables.builtInThemes
	}

}
