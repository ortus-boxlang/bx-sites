/**
 * Names bx-docs' built-in search providers (module spec section 7) and
 * which of them need the static lunr index BuildPipeline builds by default.
 *
 * `local` (the default, unchanged) is bx-docs' own fully static/client-side
 * search - a `search-index.json` built at `build` time, searched with
 * lunr.js in the browser, no server involved. `algolia` wires up Algolia
 * DocSearch instead, which serves results from Algolia's own hosted index
 * (populated by their crawler/API, not by bx-docs), so it has no use for
 * `search-index.json` at all. `pagefind` is also fully static/no-server,
 * like `local`, but indexes the *built* `site/` HTML with the external
 * `pagefind` CLI (PagefindIndexer.bx) into its own self-hosted
 * `site/pagefind/` bundle, rather than bx-docs' own `search-index.json`/lunr.
 *
 * A `searchProvider.provider` outside `getBuiltIn()` isn't an error -
 * ConfigLoader only validates the providers this module ships built-in UI
 * for; anything else is assumed to be wired up by a project's own `theme/`
 * override (ThemeRenderer's project-theme-wins resolution order), which can
 * read `siteConfig.searchProvider` itself and render whatever search widget
 * it wants. See docs/guides/search.md's "Other search providers" section.
 */
class {

	variables.builtIn = [ "local", "algolia", "pagefind" ]

	/**
	 * The search provider names this module ships built-in theme support for.
	 */
	array function getBuiltIn() {
		return variables.builtIn
	}

	/**
	 * Whether `provider` should get the static `search-index.json` built (and
	 * the shared lunr widget copied/wired up) - true for `local` and for any
	 * provider this module doesn't specifically know about (harmless, and
	 * leaves the index available as a fallback for a custom theme that wants
	 * it); false for `algolia`/`pagefind`, the two built-in providers that
	 * each serve results from their own index instead (Algolia's hosted
	 * index, Pagefind's own `site/pagefind/` bundle).
	 *
	 * @provider bxdocs.json's `searchProvider.provider`
	 */
	boolean function usesLocalIndex( required string provider ) {
		return !listFindNoCase( "algolia,pagefind", trim( arguments.provider ) )
	}

	/**
	 * Whether `provider` needs PagefindIndexer.bx run against the finished
	 * `site/` output at the end of `build` - true only for `pagefind` itself.
	 *
	 * @provider bxdocs.json's `searchProvider.provider`
	 */
	boolean function usesPagefind( required string provider ) {
		return lCase( trim( arguments.provider ) ) == "pagefind"
	}

}
