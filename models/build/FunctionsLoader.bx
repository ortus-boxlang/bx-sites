/**
 * Loads a project's "magic functions" - `docs/functions.bxs`
 * (`docs/versions/<name>/functions.bxs`, `docs/i18n/<code>/functions.bxs`
 * inside a version/locale tree, mirroring every other by-convention file
 * this module already supports), a plain BoxLang script a project author
 * drops in to make small helper functions available everywhere page
 * content gets built - no plugin module, no wiring, just a file.
 *
 * A magic function's name must start with `$` - `function $greet( name ) {...}`
 * - the sigil marks a function as one of this file's *public* helpers,
 * meant to be called directly, either as `{{ $greet(...) }}` from markdown
 * (VariablesProcessor.bx only ever recognizes a `$`-prefixed call target -
 * see its own docblock) or bare as `$greet(...)` from a project's own
 * `theme/` `.bxm` overrides (ThemeRenderer.bx). A plain, non-`$` function
 * declared in the same file is a private helper, meant to be called only
 * from another function inside `functions.bxs` itself - `load()` still
 * returns it (see below for why), but nothing calls it *directly* by that
 * bare name outside of `functions.bxs`'s own functions calling each other.
 *
 * The loading mechanism relies on BoxLang's own `include` scope-absorption
 * (the same mechanism ThemeRenderer.bx already leans on for `layout.bxm`/
 * `page.bxm`): `include`-ing a plain script from inside a class method
 * writes any top-level `function name(){...}` declaration straight into
 * that method's owning instance's own `variables` scope, indistinguishable
 * from a method the class declared itself. Snapshotting `variables`' own
 * keys immediately before the include, then diffing after, isolates
 * exactly the new functions `functions.bxs` just contributed - dropping
 * this class's own `load()` method itself (always present before and
 * after), the only thing filtered out. Every one of those new keys is
 * deleted back out of `variables` before `load()` returns (in a
 * `finally`, so it happens even when validation below throws) - without
 * that cleanup, a second `load()` call on the *same* instance (this
 * class is a long-lived singleton on `BuildPipeline`, reused across every
 * `bxSites serve` rebuild) would see the first call's own leftover keys
 * already sitting in `before`, silently treating an unchanged function
 * across a real functions.bxs edit as "not new" and dropping it from the
 * result entirely - `load()` needs to be safely repeatable on one instance.
 *
 * `load()` deliberately returns *every* function `functions.bxs` declares,
 * `$`-prefixed or not, rather than dropping the plain ones - a bare-name
 * call BoxLang resolves inside a function's own body (e.g. `$price()`
 * calling a private `formatPrice()`) only succeeds when that callee is
 * itself reachable in whatever scope the caller is eventually invoked
 * from. Both real call sites (VariablesProcessor.bx, ThemeRenderer.bx)
 * bind this whole struct into their own instance scope before calling
 * anything from it, precisely so a `$`-prefixed function can still reach
 * its own file's private helpers once it's actually invoked - dropping the
 * plain ones here would silently break that for every consumer.
 *
 * Also validates that no returned function name collides with one of the
 * fixed "supporting variables" every consumer already binds alongside
 * these functions (`page`/`nav`/`siteConfig`/etc. - see
 * docs/guides/variables-and-functions.md's "Reserved names" section) -
 * `ThemeRenderer.bx` binds every loaded function directly into its own
 * live rendering scope, so a same-named private helper would otherwise
 * silently overwrite real page/site context instead of failing loudly.
 *
 * A project with no `functions.bxs` simply has no magic functions -
 * `load()` returns an empty struct, same "opt-in by presence" shape as
 * BlogAuthorsLoader.bx's `authors.yml`.
 */
class {

	/**
	 * The "supporting variables" every consumer of this class's own output
	 * binds alongside the loaded functions (ThemeRenderer.bx's own
	 * rendering scope; VariablesProcessor.bx's `functionContext` param) -
	 * a `functions.bxs` function reusing one of these names would silently
	 * shadow real page/site context instead of failing loudly, so `load()`
	 * rejects it outright instead.
	 */
	variables.reservedNames = [
		"page", "nav", "siteConfig", "themeDir", "basePath", "moduleAssetsDir",
		"versions", "currentVersion", "locales", "currentLocale", "currentLocaleDir",
		"strings", "requiredFiles", "stringsResolver"
	]

	/**
	 * Loads `docs/functions.bxs` (or `src/functions.bxs`, whichever the
	 * caller resolved) - every function it declares, `$`-prefixed or not
	 * (see this class's own docblock for why the plain ones are kept too).
	 * Safe to call more than once on the same instance (see this class's
	 * own docblock) - each call leaves `variables` exactly as it found it.
	 *
	 * @docsDir Absolute path to the project's (or version/locale tree's own) docs/ directory
	 *
	 * @return Struct keyed by function name, each value a callable BoxLang function
	 */
	struct function load( required string docsDir ) {
		var dir = arguments.docsDir.reReplace( "[\/]+$", "" )
		var functionsPath = dir & "/functions.bxs"

		if ( !fileExists( functionsPath ) ) {
			return {}
		}

		// `include` doesn't resolve a bare OS absolute path against the real
		// filesystem - BoxLang coerces an absolute-looking path against
		// registered mappings/webroot instead, so `include functionsPath`
		// here intermittently threw "The template path [...] could not be
		// found" for this exact path, moments after `fileExists()` just
		// above had already confirmed it was there - not a race, just an
		// unsupported way to reach an arbitrary, runtime-computed
		// directory. Registering a mapping for `dir` and including through
		// that instead is the supported path (see
		// `getBoxRuntime().getConfiguration().registerMapping()` - BoxLang
		// docs' "Includes"/"Mappings & Class Resolution" pages). A fixed,
		// module-namespaced prefix is safe to re-register on every call
		// (cheap, and this class's own singleton is reused with a
		// potentially different `docsDir` across `bxSites serve` rebuilds) -
		// it simply repoints the same prefix at the current `dir`.
		var mappingPrefix = "/bxsitesFunctionsInclude"
		getBoxRuntime().getConfiguration().registerMapping( mappingPrefix, dir )

		var before = structKeyArray( variables )
		try {
			include "#mappingPrefix#/functions.bxs"
		} catch ( any e ) {
			throw(
				type    : "BxSites.InvalidFunctions",
				message : "functions.bxs at [#functionsPath#] failed to load: #e.message#"
			)
		}

		var fns = {}
		var newKeys = []
		for ( var key in variables ) {
			if ( !before.contains( key ) ) {
				newKeys.append( key )
				if ( isCustomFunction( variables[ key ] ) || isClosure( variables[ key ] ) ) {
					fns[ key ] = variables[ key ]
				}
			}
		}

		try {
			for ( var reserved in variables.reservedNames ) {
				if ( fns.keyExists( reserved ) ) {
					throw(
						type    : "BxSites.InvalidFunctions",
						message : "functions.bxs at [#functionsPath#] declares a function named [#reserved#], which collides with one of the built-in supporting variables every magic function already has access to - see docs/guides/variables-and-functions.md's ""Reserved names"" section"
					)
				}
			}
			return fns
		} finally {
			for ( var newKey in newKeys ) {
				structDelete( variables, newKey )
			}
		}
	}

}
