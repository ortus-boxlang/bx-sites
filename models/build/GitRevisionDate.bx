/**
 * Looks up a file's last commit date via `git log`, backing bxdocs.json's
 * `lastUpdated` option. Shells out (there's no BoxLang-native git binding)
 * and fails soft everywhere - not a git repo, git not installed, an
 * untracked file, a build running from a downloaded zip with no `.git` at
 * all - a page simply gets no last-updated date rather than a broken build.
 */
class {

	/**
	 * Looks up a file's most recent git commit date via `git log -1
	 * --format=%aI`, for the `lastUpdated` config option.
	 *
	 * @projectRoot Absolute path to the project root - used as git's working directory, so a relative path resolves correctly
	 * @filePath Absolute or project-relative path to the file to look up
	 *
	 * @return An ISO-8601 date-time string (e.g. "2026-08-18T10:15:00-05:00"), or "" if unavailable
	 */
	string function forFile( required string projectRoot, required string filePath ) {
		try {
			var pb = createObject( "java", "java.lang.ProcessBuilder" ).init( [
				"git", "log", "-1", "--format=%cI", "--", arguments.filePath
			] )
			pb.directory( createObject( "java", "java.io.File" ).init( arguments.projectRoot ) )
			pb.redirectErrorStream( true )

			var process = pb.start()
			var output = createObject( "java", "java.lang.String" ).init( process.getInputStream().readAllBytes(), "UTF-8" )
			process.waitFor()

			var trimmed = trim( output )
			return trimmed.reFind( "^\d{4}-\d{2}-\d{2}" ) ? trimmed : ""
		} catch ( any e ) {
			return ""
		}
	}

}
