/**
 * Scaffolds a new bx-sites project skeleton - the `new` CLI verb's real
 * implementation: a `docs/` folder with a starter `index.md`, and a site
 * config defaulted to the requested (or bootstrap) theme (module spec
 * sections 3, 4 and 6). `bxsites.yaml` is the default/preferred format;
 * `format: "toml"` or `format: "json"` scaffolds the matching config file,
 * for a project that
 * wants to stay on it - both are fully supported by ConfigLoader.bx.
 */
class {

	/**
	 * Writes a starter site config and `docs/index.md` for the `new` verb.
	 *
	 * @targetDir Absolute path to the new project directory (created if missing; refuses to run if it already contains a bxsites.yaml/.yml/.json)
	 * @name The site name written into the config
	 * @theme The built-in theme name to default the project to
	 * @description Optional site description
	 * @format `"yaml"` (default), `"toml"`, or `"json"` - which config format to scaffold
	 *
	 * @return { projectRoot, configPath, indexPath }
	 */
	struct function scaffold(
		required string targetDir,
		required string name,
		required string theme,
		string description = "",
		string format = "yaml"
	) {
		var configFormat = lCase( trim( arguments.format ) )
		if ( !listFindNoCase( "yaml,toml,json", configFormat ) ) {
			throw(
				type    = "BxSites.InvalidFormat",
				message = "Unknown config format [#arguments.format#] - must be one of: yaml, toml, json"
			)
		}

		var dir = arguments.targetDir.reReplace( "[\/]+$", "" )

		for ( var existingName in [ "bxsites.yaml", "bxsites.yml", "bxsites.toml", "bxsites.json" ] ) {
			if ( fileExists( dir & "/" & existingName ) ) {
				throw(
					type    = "BxSites.ProjectAlreadyExists",
					message = "[#dir#] already contains a #existingName# - refusing to overwrite an existing project"
				)
			}
		}

		var configPath = dir & "/bxsites." & configFormat

		directoryCreate( path = dir, createPath = true, ignoreExists = true )
		directoryCreate( path = dir & "/docs", createPath = true, ignoreExists = true )
		directoryCreate( path = dir & "/docs/assets", createPath = true, ignoreExists = true )

		var indexPath = dir & "/docs/index.md"
		fileWrite( indexPath, renderIndexMd( arguments.name ) )

		var configSource = configFormat == "yaml"
			? renderConfigYaml( arguments.name, arguments.theme, arguments.description )
			: ( configFormat == "toml"
				? renderConfigToml( arguments.name, arguments.theme, arguments.description )
				: renderConfigJson( arguments.name, arguments.theme, arguments.description ) )
		fileWrite( configPath, configSource )

		return {
			projectRoot : dir,
			configPath  : configPath,
			indexPath   : indexPath
		}
	}

	/**
	 * Renders a starter `bxsites.yaml`, quoting `name`/`description` so
	 * special characters in either can't break the generated YAML.
	 *
	 * @name The site name
	 * @theme The default theme name
	 * @description The site description
	 *
	 * @return The rendered bxsites.yaml source
	 */
	private string function renderConfigYaml( required string name, required string theme, required string description ) {
		var lines = [
			"name: #yamlScalar( arguments.name )#",
			"description: #yamlScalar( arguments.description )#",
			'baseURL: "/"',
			"theme:",
			"  name: #yamlScalar( arguments.theme )#",
			"  options: {}",
			"search: true",
			"nav: []",
			"markdown: {}",
			""
		]
		return lines.toList( char( 10 ) )
	}

	/**
	 * Renders a starter `bxsites.json`, escaping `name`/`description` so
	 * quotes in either can't break the generated JSON.
	 *
	 * @name The site name
	 * @theme The default theme name
	 * @description The site description
	 *
	 * @return The rendered bxsites.json source
	 */
	private string function renderConfigJson( required string name, required string theme, required string description ) {
		var lines = [
			"{",
			'	"name": "#jsonEscape( arguments.name )#",',
			'	"description": "#jsonEscape( arguments.description )#",',
			'	"baseURL": "/",',
			'	"theme": {',
			'		"name": "#jsonEscape( arguments.theme )#",',
			'		"options": {}',
			"	},",
			'	"search": true,',
			'	"nav": [],',
			'	"markdown": {}',
			"}",
			""
		]
		return lines.toList( char( 10 ) )
	}

	/**
	 * Renders a starter `bxsites.toml`, escaping `name`/`description` so
	 * quotes in either can't break the generated TOML.
	 *
	 * @name The site name
	 * @theme The default theme name
	 * @description The site description
	 *
	 * @return The rendered bxsites.toml source
	 */
	private string function renderConfigToml( required string name, required string theme, required string description ) {
		return tomlSerialize( {
			name        : arguments.name,
			description : arguments.description,
			baseURL     : "/",
			theme       : { name : arguments.theme, options : {} },
			search      : true,
			nav         : [],
			markdown    : {}
		} )
	}

	/**
	 * Escapes a plain string for embedding as a JSON string value.
	 *
	 * @value The raw value to escape
	 */
	private string function jsonEscape( required string value ) {
		return arguments.value
			.replace( char( 92 ), char( 92 ) & char( 92 ), "all" )
			.replace( '"', char( 92 ) & '"', "all" )
			.replace( char( 10 ), char( 92 ) & "n", "all" )
			.replace( char( 13 ), char( 92 ) & "r", "all" )
			.replace( char( 9 ), char( 92 ) & "t", "all" )
	}

	/**
	 * Renders a plain string as a double-quoted YAML scalar - always
	 * quoted (regardless of content) so an empty/blank/special-looking
	 * value (`""`, `no`, `1.0`, `null`, ...) round-trips as a plain string
	 * rather than YAML's own implicit-typing rules reinterpreting it.
	 *
	 * @value The raw value to render
	 */
	private string function yamlScalar( required string value ) {
		var escaped = arguments.value
			.replace( char( 92 ), char( 92 ) & char( 92 ), "all" )
			.replace( '"', char( 92 ) & '"', "all" )
			.replace( char( 10 ), char( 92 ) & "n", "all" )
			.replace( char( 13 ), char( 92 ) & "r", "all" )
			.replace( char( 9 ), char( 92 ) & "t", "all" )
		return '"#escaped#"'
	}

	/**
	 * Renders a minimal starter `docs/index.md`.
	 *
	 * @name The site name, used as the starter page's H1
	 *
	 * @return The rendered docs/index.md source
	 */
	private string function renderIndexMd( required string name ) {
		var lines = [
			"---",
			"title: Home",
			"order: 1",
			"---",
			"",
			"## #arguments.name#",
			"",
			"Welcome to your new documentation site. Edit this page at `docs/index.md`,",
			"and add more `.md` files under `docs/` - folder and file nesting becomes",
			"the site navigation automatically.",
			""
		]
		return lines.toList( char( 10 ) )
	}

}
