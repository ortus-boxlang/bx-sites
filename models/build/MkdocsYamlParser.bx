/**
 * Parses a YAML *subset* sufficient for `mkdocs.yml` - nested maps and
 * lists via indentation, `- item` list entries (including the
 * `- Title: path.md` shorthand mkdocs' own `nav:` tree uses), inline
 * `[a, b]` lists, quoted/unquoted/boolean/numeric scalars, `#` comments.
 * Deliberately not a general YAML parser (no anchors, tags, flow mappings,
 * multi-document streams) - the same "sized to what the real files
 * actually use" scope FrontmatterParser.bx already takes for frontmatter
 * blocks, just recursive/indentation-aware since `mkdocs.yml` itself
 * (unlike a flat frontmatter block) nests arbitrarily deep.
 */
class {

	/**
	 * Parses a whole `mkdocs.yml` document into a plain struct - array
	 * values throughout for any YAML list (including a single-key-map-per-item
	 * list like `nav:`), nested structs for any YAML map.
	 *
	 * @content mkdocs.yml's raw text
	 *
	 * @return The parsed document as a struct (empty when content has no top-level entries)
	 */
	struct function parse( required string content ) {
		var entries = tokenize( arguments.content )
		if ( !entries.len() ) {
			return {}
		}
		var result = parseBlock( entries, 1, entries[ 1 ].indent )
		return isStruct( result.value ) ? result.value : {}
	}

	/**
	 * Splits raw YAML text into `{ indent, text }` entries, one per
	 * meaningful line - blank lines and full-line comments dropped,
	 * trailing `# comment` stripped (a `#` inside a quoted scalar is left
	 * alone, since mkdocs.yml's own real usage never needs one mid-value).
	 *
	 * @content Raw YAML text
	 */
	private array function tokenize( required string content ) {
		var normalized = arguments.content.reReplace( char( 13 ) & char( 10 ), char( 10 ), "all" )
		var rawLines = listToArray( normalized, char( 10 ), true )
		var entries = []

		for ( var raw in rawLines ) {
			var stripped = stripComment( raw )
			if ( !len( trim( stripped ) ) ) {
				continue
			}
			var indent = len( stripped ) - len( stripped.reReplace( "^[ ]*", "" ) )
			entries.append( { indent : indent, text : trim( stripped ) } )
		}

		return entries
	}

	/**
	 * Strips a trailing `# comment` from one raw line - only when the `#`
	 * isn't inside a `"..."`/`'...'` quoted scalar.
	 *
	 * @line One raw (un-trimmed) line
	 */
	private string function stripComment( required string line ) {
		var inQuote = ""
		for ( var i = 1; i <= len( arguments.line ); i++ ) {
			var ch = arguments.line.mid( i, 1 )
			if ( len( inQuote ) ) {
				if ( ch == inQuote ) {
					inQuote = ""
				}
				continue
			}
			if ( ch == '"' || ch == "'" ) {
				inQuote = ch
				continue
			}
			if ( ch == "#" ) {
				return arguments.line.left( i - 1 )
			}
		}
		return arguments.line
	}

	/**
	 * Dispatches to parseList()/parseMap() depending on whether the entry
	 * at `startIndex` opens a list (`-`/`- ...`) or a map (`key: ...`).
	 *
	 * @entries tokenize()'s own output
	 * @startIndex The first entry belonging to this block
	 * @indent The indentation level every entry in this block shares
	 */
	private struct function parseBlock( required array entries, required numeric startIndex, required numeric indent ) {
		var first = arguments.entries[ arguments.startIndex ].text
		if ( first == "-" || first.left( 2 ) == "- " ) {
			return parseList( arguments.entries, arguments.startIndex, arguments.indent )
		}
		return parseMap( arguments.entries, arguments.startIndex, arguments.indent )
	}

	/**
	 * Parses a run of `key: value` / `key:` (nested) entries at the same
	 * indentation into a struct.
	 *
	 * @entries tokenize()'s own output
	 * @startIndex The first entry belonging to this map
	 * @indent The indentation level every entry in this map shares
	 *
	 * @return { value: struct, nextIndex: numeric } - nextIndex is the first entry past this map
	 */
	private struct function parseMap( required array entries, required numeric startIndex, required numeric indent ) {
		var map = {}
		var i = arguments.startIndex

		while ( i <= arguments.entries.len() && arguments.entries[ i ].indent == arguments.indent ) {
			var split = splitKeyValue( arguments.entries[ i ].text )
			if ( !split.hasKey ) {
				// Not a `key: ...` line where one was expected (malformed/unsupported
				// construct for this subset) - skip it rather than mis-parse.
				i++
				continue
			}

			if ( !len( split.rawValue ) ) {
				if ( i + 1 <= arguments.entries.len() && arguments.entries[ i + 1 ].indent > arguments.indent ) {
					var nested = parseBlock( arguments.entries, i + 1, arguments.entries[ i + 1 ].indent )
					map[ split.key ] = nested.value
					i = nested.nextIndex
				} else {
					map[ split.key ] = ""
					i++
				}
			} else if ( isInlineList( split.rawValue ) ) {
				map[ split.key ] = parseInlineList( split.rawValue )
				i++
			} else {
				map[ split.key ] = coerceScalar( split.rawValue )
				i++
			}
		}

		return { value : map, nextIndex : i }
	}

	/**
	 * Parses a run of `- item` entries at the same indentation into an
	 * array. `- Title: value` (mkdocs' own `nav:` shorthand for "this list
	 * item is itself a single-key map") is recognized the same way
	 * parseMap() reads any other `key: value` line, nested children (a
	 * sub-list under a nav group) included.
	 *
	 * @entries tokenize()'s own output
	 * @startIndex The first entry belonging to this list
	 * @indent The indentation level every `-` in this list shares
	 *
	 * @return { value: array, nextIndex: numeric } - nextIndex is the first entry past this list
	 */
	private struct function parseList( required array entries, required numeric startIndex, required numeric indent ) {
		var list = []
		var i = arguments.startIndex

		while (
			i <= arguments.entries.len()
			&& arguments.entries[ i ].indent == arguments.indent
			&& ( arguments.entries[ i ].text == "-" || arguments.entries[ i ].text.left( 2 ) == "- " )
		) {
			var text = arguments.entries[ i ].text
			var afterDash = trim( len( text ) > 1 ? text.right( len( text ) - 1 ) : "" )

			if ( !len( afterDash ) ) {
				if ( i + 1 <= arguments.entries.len() && arguments.entries[ i + 1 ].indent > arguments.indent ) {
					var nestedEmpty = parseBlock( arguments.entries, i + 1, arguments.entries[ i + 1 ].indent )
					list.append( nestedEmpty.value )
					i = nestedEmpty.nextIndex
				} else {
					list.append( "" )
					i++
				}
				continue
			}

			var split = splitKeyValue( afterDash )
			if ( split.hasKey ) {
				if ( len( split.rawValue ) ) {
					list.append( isInlineList( split.rawValue ) ? { "#split.key#" : parseInlineList( split.rawValue ) } : { "#split.key#" : coerceScalar( split.rawValue ) } )
					i++
				} else if ( i + 1 <= arguments.entries.len() && arguments.entries[ i + 1 ].indent > arguments.indent ) {
					var nested = parseBlock( arguments.entries, i + 1, arguments.entries[ i + 1 ].indent )
					list.append( { "#split.key#" : nested.value } )
					i = nested.nextIndex
				} else {
					list.append( { "#split.key#" : "" } )
					i++
				}
			} else if ( isInlineList( afterDash ) ) {
				list.append( parseInlineList( afterDash ) )
				i++
			} else {
				list.append( coerceScalar( afterDash ) )
				i++
			}
		}

		return { value : list, nextIndex : i }
	}

	/**
	 * Splits a `key: value` / `key:` line on its first `key`-terminating
	 * colon (a bare colon followed by a space, or a colon at the very end
	 * of the line) - a value containing its own `://` (a URL) is never
	 * mistaken for the split point, since that colon isn't followed by a
	 * space/end-of-line.
	 *
	 * @text One already-trimmed line (or the text following a list `- `)
	 *
	 * @return { hasKey: boolean, key: string, rawValue: string (trimmed, "" when the value is on following lines) }
	 */
	private struct function splitKeyValue( required string text ) {
		var matcher = createObject( "java", "java.util.regex.Pattern" ).compile( "^([^:\s][^:]*?):(\s+(.*))?$" ).matcher( arguments.text )
		if ( !matcher.matches() ) {
			return { hasKey : false, key : "", rawValue : "" }
		}
		return {
			hasKey   : true,
			key      : trim( matcher.group( 1 ) ),
			rawValue : trim( matcher.group( 3 ) ?: "" )
		}
	}

	/**
	 * @value A trimmed value string
	 *
	 * @return true when it's a single-line `[...]` inline list
	 */
	private boolean function isInlineList( required string value ) {
		return arguments.value.left( 1 ) == "[" && arguments.value.right( 1 ) == "]"
	}

	/**
	 * Parses a single-line inline list, e.g. `[icon, cli, "guide"]`.
	 *
	 * @value The full `[...]` value, brackets included
	 */
	private array function parseInlineList( required string value ) {
		var inner = trim( arguments.value.mid( 2, len( arguments.value ) - 2 ) )
		if ( !len( inner ) ) {
			return []
		}
		return listToArray( inner, "," ).map( item => coerceScalar( trim( item ) ) )
	}

	/**
	 * Coerces a raw scalar value: quoted strings unwrap, `true`/`false`
	 * become booleans, `null`/`~`/empty become `""`, numeric-looking
	 * values become numbers, everything else stays a string.
	 *
	 * @value The raw (already-trimmed) value text
	 */
	private any function coerceScalar( required string value ) {
		var v = arguments.value

		if ( len( v ) >= 2 && ( ( v.left( 1 ) == '"' && v.right( 1 ) == '"' ) || ( v.left( 1 ) == "'" && v.right( 1 ) == "'" ) ) ) {
			return v.mid( 2, len( v ) - 2 )
		}
		if ( v == "true" ) {
			return true
		}
		if ( v == "false" ) {
			return false
		}
		if ( v == "null" || v == "~" ) {
			return ""
		}
		if ( isNumeric( v ) ) {
			return val( v )
		}
		return v
	}

}
