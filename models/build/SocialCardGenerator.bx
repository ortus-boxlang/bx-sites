/**
 * Renders a 1200x630 `og:image`/`twitter:card` social-card PNG per page at
 * build time with the `bx-image` module - no headless browser or external
 * service involved. Used when `bxsites.json`'s `generateOgImages` is on and
 * a page has no explicit `ogImage` frontmatter/site-wide override of its own
 * - see BuildPipeline.bx's `assignOgImages()`.
 *
 * The card is a dark brand-tinted background with a soft accent glow and
 * rings, the site logo and name, an optional section chip, the page title,
 * the page description and the page URL, with the accent gradient bar along
 * the bottom edge. Every visual input beyond the title, site name and output
 * path is optional (see `generate()`'s `options`), and the original
 * three-argument call still works.
 *
 * Needs bx-image 1.13.0 or later: hex colors, linear gradients, text
 * measurement and font files all arrived in that release.
 */
class {

	variables.width = 1200
	variables.height = 630
	variables.barHeight = 14
	variables.marginX = 80

	/**
	 * Renders a 1200x630 branded PNG social card with `bx-image`.
	 *
	 * @title The page (or site) title to render, word-wrapped to fit
	 * @subtitle The site name, drawn next to the logo
	 * @outputPath Absolute path to write the PNG to (parent directory must already exist)
	 * @options Optional struct. Every key is optional:
	 *   `description` (string, under the title, up to 3 lines),
	 *   `section` (string, a small chip top right),
	 *   `url` (string, drawn bottom left),
	 *   `logoPath` (absolute path to a PNG/JPG/GIF, drawn left of the site name),
	 *   `fontPath` (absolute path to a TTF/OTF used for all text but the URL),
	 *   `background`, `accent`, `accentEnd`, `text`, `muted` (`#RGB` or `#RRGGBB` colors).
	 */
	void function generate( required string title, required string subtitle, required string outputPath, struct options = {} ) {
		assertImageModule()

		var opts = arguments.options
		var background = parseColor( opts.background ?: "", "##0b161b" )
		var accent = parseColor( opts.accent ?: "", "##00ff78" )
		var accentEnd = parseColor( opts.accentEnd ?: "", "##00dbff" )
		var textColor = parseColor( opts.text ?: "", "##ffffff" )
		var mutedColor = parseColor( opts.muted ?: "", "##a0b8b5" )
		var family = resolveFontFamily( opts.fontPath ?: "" )

		var image = imageNew( "", variables.width, variables.height, "rgb", background )
		image.setAntiAliasing( true )

		drawBackground( image, background, accent, accentEnd )

		var headerY = 64

		// Logo and site name
		var textX = variables.marginX
		var logo = loadLogo( opts.logoPath ?: "" )
		if ( !isNull( logo ) ) {
			var logoSize = 56
			logo.scaleToFit( logoSize, logoSize )
			image.drawImage( logo, variables.marginX, headerY + int( ( logoSize - logo.getHeight() ) / 2 ) )
			textX = variables.marginX + logoSize + 18
		}
		image.setDrawingColor( mutedColor )
		image.drawText( arguments.subtitle, textX, headerY + 39, fontAttrs( family, 30, "bold" ) )

		// Section chip, top right
		var section = trim( opts.section ?: "" )
		if ( len( section ) ) {
			var chipAttrs = fontAttrs( family, 20, "bold" )
			var chipText = uCase( section )
			var chipW = int( image.measureText( chipText, chipAttrs ).width ) + 44
			var chipX = variables.width - variables.marginX - chipW
			var chipY = headerY + 8
			image.setDrawingColor( withAlpha( accent, 28 ) )
			image.drawRoundRect( chipX, chipY, chipW, 40, 40, 40, true )
			image.setDrawingColor( withAlpha( accent, 150 ) )
			image.setDrawingStroke( { width : 2 } )
			image.drawRoundRect( chipX, chipY, chipW, 40, 40, 40, false )
			image.setDrawingColor( accent )
			image.drawText( chipText, chipX + 22, chipY + 27, chipAttrs )
		}

		// Accent rule above the title
		image.setDrawingGradient( variables.marginX, 0, variables.marginX + 110, 0, [ accent, accentEnd ] )
		image.drawRoundRect( variables.marginX, 176, 110, 8, 8, 8, true )

		// Title: shrink until it fits in 3 lines
		var maxTextWidth = 880
		var titleSize = 76
		var titleLines = []
		while ( true ) {
			titleLines = wrapText( image, arguments.title, fontAttrs( family, titleSize, "bold" ), maxTextWidth, 3 )
			if ( !titleLines.len() || right( titleLines[ titleLines.len() ], 1 ) != "…" || titleSize <= 52 ) {
				break
			}
			titleSize -= 4
		}
		var lineHeight = int( titleSize * 1.16 )
		var y = 184 + 24 + titleSize
		image.setDrawingColor( textColor )
		for ( var line in titleLines ) {
			image.drawText( line, variables.marginX, y, fontAttrs( family, titleSize, "bold" ) )
			y += lineHeight
		}

		// Description
		var description = trim( opts.description ?: "" )
		if ( len( description ) ) {
			var descAttrs = fontAttrs( family, 32, "plain" )
			var descLines = wrapText( image, description, descAttrs, maxTextWidth, y > 400 ? 2 : 3 )
			image.setDrawingColor( mutedColor )
			y += 14
			for ( var line in descLines ) {
				image.drawText( line, variables.marginX, y, descAttrs )
				y += 46
			}
		}

		// URL, bottom left
		var url = trim( opts.url ?: "" )
		if ( len( url ) ) {
			image.setDrawingColor( withAlpha( mutedColor, 190 ) )
			image.drawText( url, variables.marginX, variables.height - variables.barHeight - 36, { font : "Monospaced", size : 26, style : "plain" } )
		}

		// Gradient bar along the bottom edge
		image.setDrawingGradient( 0, 0, variables.width, 0, [ accent, accentEnd ] )
		image.drawRect( 0, variables.height - variables.barHeight, variables.width, variables.barHeight, true )

		image.write( arguments.outputPath )
	}

	/**
	 * Dark brand-tinted background: a diagonal gradient, a soft accent glow
	 * top left, a faint dot grid, and two accent-gradient rings bleeding off
	 * the bottom right corner.
	 */
	private void function drawBackground( required any image, required string background, required string accent, required string accentEnd ) {
		var image = arguments.image

		image.setDrawingGradient( 0, 0, variables.width, variables.height, [ arguments.background, mix( arguments.background, arguments.accentEnd, 0.10 ) ] )
		image.drawRect( 0, 0, variables.width, variables.height, true )

		// Soft glow, concentric translucent discs
		image.setDrawingColor( withAlpha( arguments.accent, 3 ) )
		for ( var i = 30; i >= 1; i-- ) {
			var radius = 80 + i * 19
			image.drawOval( 160 - radius, 40 - radius, radius * 2, radius * 2, true )
		}

		// Dot grid
		image.setDrawingColor( withAlpha( arguments.accentEnd, 22 ) )
		for ( var gx = variables.marginX; gx < variables.width; gx += 40 ) {
			for ( var gy = 40; gy < variables.height - variables.barHeight; gy += 40 ) {
				image.drawRect( gx, gy, 3, 3, true )
			}
		}

		// Rings bleeding off the bottom right
		image.setDrawingStroke( { width : 16 } )
		image.setDrawingGradient( 820, 260, 1200, 630, [ withAlpha( arguments.accent, 70 ), withAlpha( arguments.accentEnd, 70 ) ] )
		image.drawOval( 830, 270, 520, 520, false )
		image.setDrawingStroke( { width : 8 } )
		image.setDrawingGradient( 900, 340, 1200, 630, [ withAlpha( arguments.accent, 45 ), withAlpha( arguments.accentEnd, 45 ) ] )
		image.drawOval( 930, 370, 360, 360, false )
	}

	/**
	 * bx-image 1.13.0 added hex colors, gradients and text measurement, all of
	 * which the card needs. An older module would draw black instead of the
	 * brand colors without complaining, so the first card checks for them.
	 */
	private void function assertImageModule() {
		if ( variables.moduleChecked ?: false ) {
			return
		}
		try {
			imageNew( "", 4, 4, "rgb", "##ff0000" )
				.setDrawingGradient( 0, 0, 4, 0, [ "##ff0000", "##0000ff" ] )
				.measureText( "a", { size : 10 } )
		} catch ( any e ) {
			if ( !e.message.findNoCase( "method" ) ) {
				rethrow
			}
			throw(
				type    = "BxSites.UnsupportedImageModule",
				message = "The installed bx-image module is too old to draw social cards. bx-sites needs bx-image 1.13.0 or later.",
				detail  = "Update it with `install-bx-module bx-image`."
			)
		}
		variables.moduleChecked = true
	}

	/**
	 * Registers a TTF/OTF with bx-image and returns its family name, so drawing
	 * and measuring use the same font. Falls back to the JVM's SansSerif when
	 * the path is empty, missing or not a font.
	 */
	private string function resolveFontFamily( required string fontPath ) {
		if ( len( arguments.fontPath ) && fileExists( arguments.fontPath ) ) {
			try {
				return imageRegisterFont( arguments.fontPath )
			} catch ( any e ) {
				// not a usable font file: use the default
			}
		}
		return "SansSerif"
	}

	private struct function fontAttrs( required string family, required numeric size, required string style ) {
		return { font : arguments.family, size : arguments.size, style : arguments.style }
	}

	/**
	 * Reads a PNG/JPG/GIF logo, or returns null when the path is empty,
	 * missing or not a readable raster image (for example an SVG).
	 */
	private any function loadLogo( required string logoPath ) {
		if ( !len( arguments.logoPath ) || !fileExists( arguments.logoPath ) ) {
			return
		}
		try {
			return imageRead( arguments.logoPath )
		} catch ( any e ) {
			return
		}
	}

	/**
	 * Normalizes `#RGB` or `#RRGGBB` to a lowercase `#rrggbb`, falling back to
	 * the given default for anything else.
	 */
	private string function parseColor( required string value, required string fallback ) {
		var hex = trim( arguments.value )
		if ( reFind( "^##?[0-9a-fA-F]{3}$", hex ) ) {
			hex = replace( hex, "##", "" )
			hex = left( hex, 1 ) & left( hex, 1 ) & mid( hex, 2, 1 ) & mid( hex, 2, 1 ) & right( hex, 1 ) & right( hex, 1 )
		} else if ( reFind( "^##?[0-9a-fA-F]{6}$", hex ) ) {
			hex = replace( hex, "##", "" )
		} else {
			return arguments.fallback
		}
		return "##" & lCase( hex )
	}

	/** `#rrggbb` plus an alpha of 0-255, as the `#rrggbbaa` form bx-image takes. */
	private string function withAlpha( required string color, required numeric alpha ) {
		return arguments.color & right( "0" & formatBaseN( arguments.alpha, 16 ), 2 )
	}

	/** Blends `fraction` of `b` into `a`, both `#rrggbb`. */
	private string function mix( required string a, required string b, required numeric fraction ) {
		var f = arguments.fraction
		var out = "##"
		for ( var start in [ 2, 4, 6 ] ) {
			var from = inputBaseN( mid( arguments.a, start, 2 ), 16 )
			var to = inputBaseN( mid( arguments.b, start, 2 ), 16 )
			out &= right( "0" & formatBaseN( int( from * ( 1 - f ) + to * f ), 16 ), 2 )
		}
		return out
	}

	/**
	 * Greedy word-wrap against the given font, capped at `maxLines` - an
	 * over-long last line is truncated with an ellipsis rather than
	 * overflowing the card.
	 *
	 * @image The image whose font metrics measure each line
	 * @text The text to wrap
	 * @attrs The font attributes (font, size, style) the text will be drawn with
	 * @maxWidth Maximum pixel width per line
	 * @maxLines Maximum number of lines before truncating with an ellipsis
	 */
	private array function wrapText( required any image, required string text, required struct attrs, required numeric maxWidth, required numeric maxLines ) {
		var image = arguments.image
		var attrs = arguments.attrs
		var words = listToArray( arguments.text, " ", false )
		var lines = []
		var current = ""
		var truncated = false

		for ( var i = 1; i <= words.len(); i++ ) {
			var word = words[ i ]
			var candidate = len( current ) ? current & " " & word : word
			if ( image.measureText( candidate, attrs ).width <= arguments.maxWidth || !len( current ) ) {
				current = candidate
			} else {
				lines.append( current )
				current = ""
				if ( lines.len() == arguments.maxLines ) {
					truncated = true
					break
				}
				current = word
			}
		}
		if ( len( current ) ) {
			lines.append( current )
		}

		if ( truncated && lines.len() ) {
			var lastIndex = lines.len()
			var lastLine = lines[ lastIndex ]
			while ( len( lastLine ) && image.measureText( lastLine & "…", attrs ).width > arguments.maxWidth ) {
				lastLine = left( lastLine, len( lastLine ) - 1 )
			}
			lines[ lastIndex ] = trim( lastLine ) & "…"
		}

		return lines
	}

}
