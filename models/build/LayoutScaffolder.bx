/**
 * Backs the `layout:new` CLI verb: copies one of the active theme's
 * templates (default `layout.bxm`, the outer shell) to a new, named layout the
 * project can select with `layout: <name>` frontmatter or an implicit-layouts
 * rule. A named layout replaces the theme's `layout.bxm` for the pages that
 * select it, and can include `#variables.themeDir#/#variables.bodyFile#`
 * to embed the page's own content.
 *
 * The copy lands in `<contentRoot>/.overrides/<theme>/<name>.bxm`, the folder
 * a project's overrides for that theme live in (ThemeRenderer.resolveThemeDir()).
 * A project using a complete flat `.theme/` gets the file there instead,
 * since `.overrides/` is not applied on top of a complete project theme.
 */
class {

	variables.namePattern = "^[A-Za-z0-9][A-Za-z0-9_-]*$"

	variables.sourceDirResolver = new "models.config.SourceDirResolver@bxsites"()

	void function setSourceDirResolver( required any resolver ) {
		variables.sourceDirResolver = arguments.resolver
	}

	/**
	 * @projectRoot Absolute path to the project root
	 * @theme The theme slug whose template is copied (the project's `theme.name`)
	 * @name The new layout's name: a bare template name such as `landing`
	 * @from Which template of the theme to copy, without extension (default `layout`)
	 *
	 * @return { path, from } - `path` is the file that was created
	 */
	struct function scaffold( required string projectRoot, required string theme, required string name, string from = "layout" ) {
		var layoutName = trim( arguments.name )
		var fromName = len( trim( arguments.from ) ) ? trim( arguments.from ) : "layout"

		if ( !reFind( variables.namePattern, layoutName ) ) {
			throw(
				type    = "BxSites.InvalidLayoutName",
				message = "Layout name [#layoutName#] must be a bare template name such as [landing] (letters, digits, hyphens and underscores)"
			)
		}
		if ( !reFind( variables.namePattern, fromName ) ) {
			throw(
				type    = "BxSites.InvalidLayoutName",
				message = "--from [#fromName#] must be a bare template name such as [layout]"
			)
		}

		var contentRoot = variables.sourceDirResolver.resolveConfigured( arguments.projectRoot )
		var themeDir = baseThemeDir( contentRoot, arguments.theme )
		var source = themeDir & "/" & fromName & ".bxm"

		if ( !fileExists( source ) ) {
			var available = directoryList( themeDir, false, "name", "*.bxm" ).map( ( file ) => file.reReplace( "\.bxm$", "" ) )
			throw(
				type    = "BxSites.LayoutSourceNotFound",
				message = "Theme [#arguments.theme#] has no [#fromName#].bxm to copy; available: #available.sort( 'text' ).toList( ', ' )#"
			)
		}

		var targetDir = directoryExists( contentRoot & "/.theme" )
			? contentRoot & "/.theme"
			: contentRoot & "/.overrides/" & arguments.theme
		var target = targetDir & "/" & layoutName & ".bxm"

		if ( fileExists( target ) ) {
			throw( type = "BxSites.LayoutExists", message = "[#target#] already exists - edit it directly or choose another --name" )
		}

		directoryCreate( targetDir, true, true )
		fileCopy( source, target )

		return { path : target, from : fromName }
	}

	/**
	 * The theme folder a layout is copied from: an installed
	 * `.themes/<theme>/`, else the built-in theme of that name. A
	 * project's complete flat `.theme/` is its own source when present.
	 */
	private string function baseThemeDir( required string contentRoot, required string theme ) {
		if ( directoryExists( arguments.contentRoot & "/.theme" ) ) {
			return arguments.contentRoot & "/.theme"
		}
		var installed = arguments.contentRoot & "/.themes/" & arguments.theme
		if ( directoryExists( installed ) ) {
			return installed
		}
		var builtIn = getDirectoryFromPath( getCurrentTemplatePath() ).reReplace( "[\\\/]models[\\\/]build[\\\/]?$", "" ) & "/resources/themes/" & arguments.theme
		if ( directoryExists( builtIn ) ) {
			return builtIn
		}
		throw( type = "BxSites.ThemeNotFound", message = "No theme found for [#arguments.theme#] to copy a layout from" )
	}

}
