/**
 * Builds a standard XML sitemap (sitemaps.org protocol). Only meaningful
 * with a real absolute site URL - the protocol requires absolute `<loc>`
 * values - so BuildPipeline only calls this when `BaseUrlResolver` found
 * one (bxsites.json's `baseURL` was a full `http(s)://` URL). Hidden pages
 * are excluded, same as the nav and search index.
 */
class {

	/**
	 * Renders `sitemap.xml`, one `<url><loc>` per visible page.
	 *
	 * @pages Array of page structs from DocsLoader.load()
	 * @siteUrl The absolute site URL, ending with `/` (BaseUrlResolver's `absolute`)
	 *
	 * @return The rendered sitemap.xml content
	 */
	string function build( required array pages, required string siteUrl ) {
		var lines = [
			'<?xml version="1.0" encoding="UTF-8"?>',
			'<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">'
		]

		for ( var page in arguments.pages ) {
			if ( page.hidden ) {
				continue
			}
			lines.append( "	<url><loc>" & arguments.siteUrl & page.urlPath & "</loc></url>" )
		}

		lines.append( "</urlset>" )
		lines.append( "" )

		return lines.toList( char( 10 ) )
	}

}
