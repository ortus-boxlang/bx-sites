/**
 * Turns already-markdown-converted blog posts (BlogDiscoverer.bx's own
 * output, run through BuildPipeline.bx's normal convertMarkdown()/
 * assignTableOfContents()/etc. finishing steps first) into everything the
 * blog itself needs: each post's own detail-page content (a featured-image/
 * byline header prepended to its real body, plus a draft badge when the
 * post is a draft - only ever present at all in `bxSites serve`'s own
 * preview build, see BuildPipeline.bx's own `includeDrafts`), plus every
 * "index" page around it - `/blog/` (paginated, with "Browse by year"/
 * "Browse by category" links blocks once posts span more than one
 * year/category, and a link to `/blog/stats/`), one `/blog/category/<slug>/`
 * per category (paginated), one `/blog/archive/<year>/` per calendar year
 * with at least one post (paginated), one `/blog/authors/<id>/` per author
 * who has at least one post, and `/blog/stats/` - a handful of aggregate
 * "cool cards" (total posts/words, categories, contributors, longest post,
 * most active category/author) computed purely from already-loaded posts,
 * no separate analytics/tracking involved.
 *
 * Pure HTML-string generation - no file I/O. Every index page comes back as
 * a minimal page struct (`title`/`description`/`contentHtml`/`urlPath`/
 * `ogImage`/`tags`) in the exact shape write404Page()/writeTagsPage()
 * already hand ThemeRenderer.renderPage() in BuildPipeline.bx - it fills in
 * every other field (`toc`/`prevPage`/`breadcrumbs`/...) with sensible
 * empty defaults, so no theme template needs to change at all; a post/list/
 * category/author/stats page renders through the exact same `page.bxm`
 * every other page does.
 */
class {

	variables.blogAuthorsLoader = new "models.build.BlogAuthorsLoader@bxsites"()
	variables.responsiveImageProcessor = new "models.build.ResponsiveImageProcessor@bxsites"()
	variables.iconResolver = new "models.build.IconResolver@bxsites"()

	/**
	 * Average adult silent-reading speed, in words per minute - the same
	 * ballpark figure (200-238wpm) most reading-time estimates (Medium,
	 * WordPress reading-time plugins, ...) use. Deliberately not
	 * configurable in v1 - an estimate this rough doesn't need a config
	 * knob, and picking a "wrong" constant is a lot less costly than the
	 * config-surface creep of exposing it.
	 */
	variables.wordsPerMinute = 200

	/**
	 * @posts BlogDiscoverer.load()'s own output, already markdown-converted (`contentHtml` set) - newest first
	 * @authors BlogAuthorsLoader.load()'s own output
	 * @postsPerPage bxsites.json's `blog.postsPerPage`
	 * @basePath Root-relative base path ending with `/` (BaseUrlResolver's `basePath`)
	 * @imageManifest ImageVariantGenerator.buildManifest()'s own output - "" (the default) makes every generated `<img>` here (a post's own featured image, its card thumbnail, an author's own avatar) a plain, unprocessed `<img>`, same as before this param existed. These images never pass through BuildPipeline.bx's own convertMarkdown()-time responsive-image rewrite at all (they don't exist yet at that point - BlogBuilder.bx generates them afterward), so ResponsiveImageProcessor.pictureTag() is called directly here instead
	 *
	 * @return { posts: array (same posts, enriched + detail-page-ready contentHtml), indexPages: array of synthetic page structs, categories: array of { name, slug, count }, alphabetical - BuildPipeline.bx's own cue for which `/blog/category/<slug>/feed.xml` files to write }
	 */
	struct function build( required array posts, required struct authors, required numeric postsPerPage, required string basePath, struct imageManifest = {} ) {
		var enrichedPosts = enrichPosts( arguments.posts, arguments.authors, arguments.basePath, arguments.imageManifest )
		var categories = categoryCounts( enrichedPosts )
		var years = distinctYears( enrichedPosts )
		var authorIds = distinctAuthorIds( enrichedPosts )

		var indexPages = []

		var mainListPages = buildListPages( enrichedPosts, "blog", "Blog", arguments.postsPerPage, arguments.basePath, arguments.imageManifest )
		var browseLinksHtml = renderArchiveLinksHtml( years, enrichedPosts, arguments.basePath ) & renderCategoryLinksHtml( categories, arguments.basePath ) & renderStatsLinkHtml( arguments.basePath )
		if ( len( browseLinksHtml ) ) {
			for ( var page in mainListPages ) {
				page.contentHtml &= browseLinksHtml
			}
		}
		indexPages.append( mainListPages, true )

		for ( var category in categories ) {
			var categoryPosts = enrichedPosts.filter( post => hasCategoryNoCase( post.categories ?: [], category.name ) )
			indexPages.append( buildListPages( categoryPosts, "blog/category/" & category.slug, category.name, arguments.postsPerPage, arguments.basePath, arguments.imageManifest ), true )
		}

		for ( var yr in years ) {
			var yearPosts = enrichedPosts.filter( post => year( post.date ) == yr )
			indexPages.append( buildListPages( yearPosts, "blog/archive/" & yr, "#yr#", arguments.postsPerPage, arguments.basePath, arguments.imageManifest ), true )
		}

		for ( var authorId in authorIds ) {
			var authorPosts = enrichedPosts.filter( post => postHasAuthorId( post, authorId ) )
			var author = arguments.authors[ authorId ]
			indexPages.append( {
				title       : author.name,
				description : len( trim( author.bio ) ) ? author.bio : "Posts by " & author.name,
				contentHtml : renderAuthorPageHtml( author, authorPosts, arguments.basePath, arguments.imageManifest ),
				urlPath     : "blog/authors/" & authorId & "/index.html",
				ogImage     : author.avatar,
				tags        : [],
				hidden      : false
			} )
		}

		indexPages.append( buildStatsPage( enrichedPosts, categories, years, authorIds, arguments.authors, arguments.basePath ) )

		return { posts : enrichedPosts, indexPages : indexPages, categories : categories }
	}

	/**
	 * Resolves each post's own authors, computes its excerpt/display date/
	 * word count/reading time, defaults its SEO description/og:image from
	 * its own content when the frontmatter left them blank, assigns a
	 * simple chronological prev/next and a `Blog -> post` breadcrumb, and
	 * prepends its own featured-image/byline header (plus a draft badge,
	 * for a post whose frontmatter sets `draft: true` - only ever present
	 * at all when the caller opted into drafts, see BlogDiscoverer.load()'s
	 * own `includeDrafts`) onto its real body `contentHtml`.
	 *
	 * @posts BlogDiscoverer.load()'s own output, already markdown-converted
	 * @authors BlogAuthorsLoader.load()'s own output
	 * @basePath Root-relative base path ending with `/`
	 * @imageManifest ImageVariantGenerator.buildManifest()'s own output - see build()'s own docblock
	 */
	private array function enrichPosts( required array posts, required struct authors, required string basePath, struct imageManifest = {} ) {
		var enriched = []

		for ( var i = 1; i <= arguments.posts.len(); i++ ) {
			var post = duplicate( arguments.posts[ i ] )
			post.resolvedAuthors = variables.blogAuthorsLoader.resolve( post.authors, arguments.authors )
			post.dateDisplay = dateTimeFormat( post.date, "medium" )

			post.wordCount = countWords( stripTags( post.contentHtml ) )
			post.readingTimeMinutes = max( 1, round( post.wordCount / variables.wordsPerMinute ) )

			var excerpt = computeExcerpt( post.contentHtml, post.summary )
			post.excerptHtml = excerpt.html
			post.excerptText = excerpt.text
			if ( !len( trim( post.description ) ) ) {
				post.description = excerpt.text
			}
			if ( !len( trim( post.ogImage ) ) ) {
				post.ogImage = post.image
			}

			post.breadcrumbs = [ { title : "Blog", url : "blog/index.html" }, { title : post.title, url : post.urlPath } ]
			post.prevPage = i > 1 ? { title : arguments.posts[ i - 1 ].title, url : arguments.posts[ i - 1 ].urlPath } : { title : "", url : "" }
			post.nextPage = i < arguments.posts.len() ? { title : arguments.posts[ i + 1 ].title, url : arguments.posts[ i + 1 ].urlPath } : { title : "", url : "" }

			// Backs a theme's own `og:type: article`/`article:published_time`/
			// `article:author` meta tags (layout.bxm, all three built-in
			// themes) - a plain doc page never sets these, so they default to
			// "website"/empty there instead.
			post.ogType = "article"
			post.publishedTime = dateTimeFormat( post.date, "yyyy-MM-dd" )
			post.articleAuthorUrls = []
			for ( var author in post.resolvedAuthors ) {
				if ( len( trim( author.url ?: "" ) ) ) {
					post.articleAuthorUrls.append( author.url )
				}
			}

			post.contentHtml = renderDraftBadgeHtml( post ) & renderPostHeaderHtml( post, arguments.basePath, arguments.imageManifest ) & post.contentHtml

			enriched.append( post )
		}

		return enriched
	}

	/**
	 * Splits pagination items into page-sized chunks and renders one
	 * synthetic list-page struct per chunk.
	 *
	 * @items The posts to paginate (already filtered to one category, or the whole blog)
	 * @baseDir The URL path segment these pages live under - `"blog"`, or `"blog/category/<slug>"`
	 * @title The list's own title - `"Blog"`, or the category name
	 * @perPage bxsites.json's `blog.postsPerPage`
	 * @basePath Root-relative base path ending with `/`
	 * @imageManifest ImageVariantGenerator.buildManifest()'s own output - see build()'s own docblock
	 */
	private array function buildListPages( required array items, required string baseDir, required string title, required numeric perPage, required string basePath, struct imageManifest = {} ) {
		var chunks = paginate( arguments.items, arguments.perPage )
		var pages = []

		for ( var chunk in chunks ) {
			pages.append( {
				title       : chunk.pageNumber == 1 ? arguments.title : ( arguments.title & " (Page " & chunk.pageNumber & ")" ),
				description : arguments.title == "Blog" ? "Blog posts" : ( "Blog posts in " & arguments.title ),
				contentHtml : renderListContentHtml( chunk.items, arguments.baseDir, chunk.pageNumber, chunk.totalPages, arguments.basePath, arguments.imageManifest ),
				urlPath     : pageUrlPath( arguments.baseDir, chunk.pageNumber ),
				ogImage     : chunk.items.len() ? ( chunk.items[ 1 ].image ?: "" ) : "",
				tags        : [],
				hidden      : false
			} )
		}

		return pages
	}

	/**
	 * Splits `items` into `perPage`-sized chunks, at least one (possibly
	 * empty) page even when `items` is empty.
	 *
	 * @items The full, already-ordered array to paginate
	 * @perPage Items per page - coerced to at least 1
	 */
	private array function paginate( required array items, required numeric perPage ) {
		var perPage = max( 1, int( arguments.perPage ) )
		var total = arguments.items.len()
		var pageCount = max( 1, ceiling( total / perPage ) )
		var pages = []

		for ( var i = 1; i <= pageCount; i++ ) {
			var startIndex = ( i - 1 ) * perPage + 1
			var endIndex = min( i * perPage, total )
			var pageItems = startIndex <= total ? arguments.items.slice( startIndex, endIndex - startIndex + 1 ) : []
			pages.append( { pageNumber : i, items : pageItems, totalPages : pageCount } )
		}

		return pages
	}

	/**
	 * The URL path for one page of a paginated list - page 1 is the list's
	 * own root (`blog/index.html`, `blog/category/<slug>/index.html`),
	 * every later page moves under its own `page/<n>/` (`blog/page/2/index.html`).
	 *
	 * @baseDir The URL path segment this list lives under
	 * @pageNumber 1-based page number
	 */
	private string function pageUrlPath( required string baseDir, required numeric pageNumber ) {
		return arguments.pageNumber == 1
			? ( arguments.baseDir & "/index.html" )
			: ( arguments.baseDir & "/page/" & arguments.pageNumber & "/index.html" )
	}

	/**
	 * Renders one page's worth of post cards plus a prev/next pager.
	 *
	 * @pagePosts This page's own slice of posts
	 * @baseDir The URL path segment this list lives under - for the pager's own links
	 * @pageNumber This page's own 1-based number
	 * @totalPages How many pages this list has in total
	 * @basePath Root-relative base path ending with `/`
	 * @imageManifest ImageVariantGenerator.buildManifest()'s own output - see build()'s own docblock
	 */
	private string function renderListContentHtml( required array pagePosts, required string baseDir, required numeric pageNumber, required numeric totalPages, required string basePath, struct imageManifest = {} ) {
		var html = ""

		if ( !arguments.pagePosts.len() ) {
			html &= "<p>No posts yet.</p>"
		}

		for ( var post in arguments.pagePosts ) {
			html &= renderPostCard( post, arguments.basePath, arguments.imageManifest )
		}

		html &= renderPager( arguments.baseDir, arguments.pageNumber, arguments.totalPages, arguments.basePath )

		return html
	}

	/**
	 * Renders one post's summary card - featured image thumbnail (if set),
	 * linked title, date/authors/categories meta line, excerpt, "Read more".
	 *
	 * @post One enriched post struct
	 * @basePath Root-relative base path ending with `/`
	 * @imageManifest ImageVariantGenerator.buildManifest()'s own output - see build()'s own docblock
	 */
	private string function renderPostCard( required struct post, required string basePath, struct imageManifest = {} ) {
		var html = '<article class="blog-post-card' & ( ( arguments.post.draft ?: false ) ? ' blog-post-card--draft' : '' ) & '">'
		html &= renderDraftBadgeHtml( arguments.post )

		if ( len( trim( arguments.post.image ?: "" ) ) ) {
			html &= '<a href="' & arguments.basePath & arguments.post.urlPath & '">' & variables.responsiveImageProcessor.pictureTag( arguments.post.image, 'alt="" style="max-width:100%;height:auto;"', arguments.basePath, arguments.imageManifest ) & '</a>'
		}

		html &= '<h2><a href="' & arguments.basePath & arguments.post.urlPath & '">' & encodeForHTML( arguments.post.title ) & '</a></h2>'
		html &= '<p class="blog-post-meta">' & metaLine( arguments.post, arguments.basePath ) & '</p>'

		if ( len( trim( arguments.post.excerptHtml ?: "" ) ) ) {
			html &= arguments.post.excerptHtml
		}

		html &= '<p><a href="' & arguments.basePath & arguments.post.urlPath & '">Read more &rarr;</a></p>'
		html &= '</article><hr>'

		return html
	}

	/**
	 * Renders one post's own detail-page header - featured image, then the
	 * same meta line renderPostCard() uses. The draft badge (when one
	 * applies) is prepended separately, one level up - see enrichPosts()'s
	 * own contentHtml assembly - so it always sits above the featured image
	 * on both the card and the detail page, not wedged between the image
	 * and the meta line here.
	 *
	 * @post One enriched post struct
	 * @basePath Root-relative base path ending with `/`
	 * @imageManifest ImageVariantGenerator.buildManifest()'s own output - see build()'s own docblock
	 */
	private string function renderPostHeaderHtml( required struct post, required string basePath, struct imageManifest = {} ) {
		var html = ""

		if ( len( trim( arguments.post.image ?: "" ) ) ) {
			html &= variables.responsiveImageProcessor.pictureTag( arguments.post.image, 'alt="" style="max-width:100%;height:auto;" class="blog-post-featured-image"', arguments.basePath, arguments.imageManifest )
		}

		html &= '<p class="blog-post-meta">' & metaLine( arguments.post, arguments.basePath ) & '</p>'

		return html
	}

	/**
	 * A "🚧 Draft" banner, shown only when `post.draft` is `true` - which,
	 * since BlogDiscoverer.load() already filters drafts out of every real
	 * build, only ever happens at all when the caller opted into drafts
	 * (`bxSites serve`'s own local preview - see BuildPipeline.bx's own
	 * `includeDrafts`). "" (nothing rendered) for a published post, so this
	 * is always safe to call unconditionally.
	 *
	 * @post One enriched post struct
	 */
	private string function renderDraftBadgeHtml( required struct post ) {
		if ( !( arguments.post.draft ?: false ) ) {
			return ""
		}
		return '<p class="blog-draft-badge">🚧 Draft - not included in a real <code>bxSites build</code></p>'
	}

	/**
	 * The date/reading-time/authors/categories line shown on both a post
	 * card and a post's own detail page - authors/categories link to their
	 * own pages when one exists.
	 *
	 * @post One enriched post struct
	 * @basePath Root-relative base path ending with `/`
	 */
	private string function metaLine( required struct post, required string basePath ) {
		var parts = []

		if ( len( trim( arguments.post.dateDisplay ?: "" ) ) ) {
			parts.append( encodeForHTML( arguments.post.dateDisplay ) )
		}

		if ( isNumeric( arguments.post.readingTimeMinutes ?: "" ) ) {
			parts.append( arguments.post.readingTimeMinutes & " min read" )
		}

		var authorLinks = []
		for ( var author in ( arguments.post.resolvedAuthors ?: [] ) ) {
			authorLinks.append(
				len( author.id )
					? ( '<a href="' & arguments.basePath & 'blog/authors/' & author.id & '/index.html">' & encodeForHTML( author.name ) & '</a>' )
					: encodeForHTML( author.name )
			)
		}
		if ( authorLinks.len() ) {
			parts.append( "by " & authorLinks.toList( ", " ) )
		}

		var categoryLinks = []
		for ( var category in ( arguments.post.categories ?: [] ) ) {
			categoryLinks.append( '<a href="' & arguments.basePath & 'blog/category/' & slugify( category ) & '/index.html">' & encodeForHTML( category ) & '</a>' )
		}
		if ( categoryLinks.len() ) {
			parts.append( "in " & categoryLinks.toList( ", " ) )
		}

		return parts.toList( " &middot; " )
	}

	/**
	 * Renders a "Newer posts"/"Older posts" pager - empty when there's only
	 * one page.
	 *
	 * @baseDir The URL path segment this list lives under
	 * @pageNumber This page's own 1-based number
	 * @totalPages How many pages this list has in total
	 * @basePath Root-relative base path ending with `/`
	 */
	private string function renderPager( required string baseDir, required numeric pageNumber, required numeric totalPages, required string basePath ) {
		if ( arguments.totalPages <= 1 ) {
			return ""
		}

		var html = '<nav class="blog-pager" aria-label="Blog pagination">'
		if ( arguments.pageNumber > 1 ) {
			html &= '<a href="' & arguments.basePath & pageUrlPath( arguments.baseDir, arguments.pageNumber - 1 ) & '">&larr; Newer posts</a> '
		}
		if ( arguments.pageNumber < arguments.totalPages ) {
			html &= '<a href="' & arguments.basePath & pageUrlPath( arguments.baseDir, arguments.pageNumber + 1 ) & '">Older posts &rarr;</a>'
		}
		html &= '</nav>'

		return html
	}

	/**
	 * Renders one author's `/blog/authors/<id>/` page - avatar, title, bio,
	 * website/email/social links, then every one of their own posts as cards.
	 *
	 * @author One resolved author struct (BlogAuthorsLoader.load()'s own per-id shape)
	 * @authorPosts This author's own posts, newest first
	 * @basePath Root-relative base path ending with `/`
	 * @imageManifest ImageVariantGenerator.buildManifest()'s own output - see build()'s own docblock
	 */
	private string function renderAuthorPageHtml( required struct author, required array authorPosts, required string basePath, struct imageManifest = {} ) {
		var html = '<div class="blog-author-profile">'

		if ( len( trim( arguments.author.avatar ?: "" ) ) ) {
			html &= variables.responsiveImageProcessor.pictureTag( arguments.author.avatar, 'alt="' & encodeForHTML( arguments.author.name ) & '" style="max-width:120px;border-radius:50%;"', arguments.basePath, arguments.imageManifest )
		}
		if ( len( trim( arguments.author.title ?: "" ) ) ) {
			html &= '<p><em>' & encodeForHTML( arguments.author.title ) & '</em></p>'
		}
		if ( len( trim( arguments.author.bio ?: "" ) ) ) {
			html &= '<p>' & encodeForHTML( arguments.author.bio ) & '</p>'
		}

		var links = []
		if ( len( trim( arguments.author.url ?: "" ) ) ) {
			links.append( '<a href="' & attrEscapeUrl( arguments.author.url ) & '">Website</a>' )
		}
		if ( len( trim( arguments.author.email ?: "" ) ) ) {
			links.append( '<a href="mailto:' & attrEscapeUrl( arguments.author.email ) & '">Email</a>' )
		}
		for ( var socialName in ( arguments.author.socials ?: {} ) ) {
			links.append( '<a href="' & attrEscapeUrl( arguments.author.socials[ socialName ] ) & '">' & encodeForHTML( socialName ) & '</a>' )
		}
		if ( links.len() ) {
			html &= '<p>' & links.toList( " &middot; " ) & '</p>'
		}

		html &= '</div>'
		html &= renderAuthorPostsListHtml( arguments.authorPosts, arguments.basePath )

		return html
	}

	/**
	 * Renders an author page's own "Posts" section as a compact,
	 * client-side-searchable title list - just a date, a reading time, and
	 * a linked title per post - rather than repeating every post's own
	 * full card (image/excerpt/byline) a second time, which an author with
	 * more than a few posts turns into a long, heavy scroll. The full card
	 * treatment stays on the main `/blog/` list and every category/archive
	 * page, where it's the primary "browse and skim" surface; here the
	 * reader already knows whose posts these are.
	 *
	 * The search box is pure Alpine.js (already vendored/loaded on every
	 * page - see layout.bxm) filtering the server-rendered `<li>` list
	 * client-side by title substring, case-insensitive - no build step, no
	 * separate JSON index, and the full list still renders (and is fully
	 * crawlable/linkable) with JavaScript off, same as this project's own
	 * default search widget degrading gracefully.
	 *
	 * @posts This author's own posts, newest first
	 * @basePath Root-relative base path ending with `/`
	 */
	private string function renderAuthorPostsListHtml( required array posts, required string basePath ) {
		if ( !arguments.posts.len() ) {
			return '<h2>' & variables.iconResolver.resolve( "phosphor-duotone:newspaper" ) & ' Posts</h2><p>No posts yet.</p>'
		}

		var calendarIcon = variables.iconResolver.resolve( "phosphor-duotone:calendar" )
		var clockIcon = variables.iconResolver.resolve( "phosphor-duotone:clock" )

		var items = ""
		for ( var post in arguments.posts ) {
			// The searchable title lives in a plain `data-title` attribute
			// (HTML-attribute-escaped, same as the link text right next to
			// it), read by Alpine via $el.dataset - simpler and more
			// robust than inlining an escaped JS string literal into the
			// x-show expression itself, which would need a second,
			// JS-specific escaping pass on top of the HTML-attribute one.
			items &= '<li data-title="' & encodeForHTML( lCase( post.title ) ) & '" x-show="!q || $el.dataset.title.includes( q.toLowerCase() )"><a href="' & arguments.basePath & post.urlPath & '">' & encodeForHTML( post.title ) & '</a> <span class="blog-post-meta">' & calendarIcon & ' ' & post.dateDisplay & ' &middot; ' & clockIcon & ' ' & post.readingTimeMinutes & ' min read</span></li>'
		}

		var html = '<h2>' & variables.iconResolver.resolve( "phosphor-duotone:newspaper" ) & ' Posts</h2>'
		html &= '<div class="blog-author-posts" x-data="{ q: '''' }">'
		html &= '<input type="search" class="blog-author-search" x-model="q" placeholder="Search posts by title..." aria-label="Search posts by title">'
		html &= '<ul class="blog-author-posts-list">' & items & '</ul>'
		html &= '</div>'

		return html
	}

	/**
	 * Builds `/blog/stats/` - a handful of aggregate "cool cards" about the
	 * blog as a whole, computed purely from already-loaded posts (no
	 * separate analytics/tracking involved, nothing persisted between
	 * builds): total posts/words, average reading time, category/
	 * contributor/year counts, and three "spotlight" cards (longest post,
	 * most active category, most active author) each linked to the real
	 * page it's about. Always built, even for a zero-post blog (every
	 * number just reads 0) - the same "always render, never conditionally
	 * skip the page itself" precedent the main `/blog/` list already sets.
	 * Reuses the `.bxsites-cards`/`.bxsites-card` component the `::: cards`
	 * directive block already styles in every built-in theme, rather than
	 * inventing a separate stats-card component.
	 *
	 * @posts Enriched posts
	 * @categories categoryCounts()'s own output
	 * @years distinctYears()'s own output
	 * @authorIds distinctAuthorIds()'s own output
	 * @authors BlogAuthorsLoader.load()'s own output
	 * @basePath Root-relative base path ending with `/`
	 */
	private struct function buildStatsPage( required array posts, required array categories, required array years, required array authorIds, required struct authors, required string basePath ) {
		var totalPosts = arguments.posts.len()
		var totalWords = 0
		for ( var post in arguments.posts ) {
			totalWords += post.wordCount
		}
		var avgReadingTime = totalPosts ? round( totalWords / variables.wordsPerMinute / totalPosts ) : 0

		var cards = []
		cards.append( statCard( numberFormat( totalPosts, "9,999" ), totalPosts == 1 ? "Post" : "Posts" ) )
		cards.append( statCard( numberFormat( totalWords, "9,999" ), "Words Written" ) )
		cards.append( statCard( max( avgReadingTime, totalPosts ? 1 : 0 ) & " min", "Average Reading Time" ) )
		cards.append( statCard( arguments.categories.len(), arguments.categories.len() == 1 ? "Category" : "Categories" ) )
		cards.append( statCard( arguments.authorIds.len(), arguments.authorIds.len() == 1 ? "Contributor" : "Contributors" ) )
		cards.append( statCard( arguments.years.len(), arguments.years.len() == 1 ? "Year Active" : "Years Active" ) )

		if ( totalPosts ) {
			var longest = arguments.posts[ 1 ]
			for ( var post in arguments.posts ) {
				if ( post.wordCount > longest.wordCount ) {
					longest = post
				}
			}
			cards.append( statCard( longest.title, longest.readingTimeMinutes & " min read - Longest Post", arguments.basePath & longest.urlPath ) )
		}

		if ( arguments.categories.len() ) {
			var topCategory = arguments.categories[ 1 ]
			for ( var category in arguments.categories ) {
				if ( category.count > topCategory.count ) {
					topCategory = category
				}
			}
			cards.append( statCard( topCategory.name, topCategory.count & ( topCategory.count == 1 ? " post - Most Active Category" : " posts - Most Active Category" ), arguments.basePath & "blog/category/" & topCategory.slug & "/index.html" ) )
		}

		if ( arguments.authorIds.len() ) {
			var topAuthorId = ""
			var topAuthorCount = 0
			for ( var authorId in arguments.authorIds ) {
				var authorCount = arguments.posts.filter( post => postHasAuthorId( post, authorId ) ).len()
				if ( authorCount > topAuthorCount ) {
					topAuthorId = authorId
					topAuthorCount = authorCount
				}
			}
			if ( len( topAuthorId ) ) {
				cards.append( statCard( arguments.authors[ topAuthorId ].name, topAuthorCount & ( topAuthorCount == 1 ? " post - Most Active Author" : " posts - Most Active Author" ), arguments.basePath & "blog/authors/" & topAuthorId & "/index.html" ) )
			}
		}

		var cardsHtml = ""
		for ( var card in cards ) {
			cardsHtml &= card
		}

		return {
			title       : "Blog Stats",
			description : "Aggregate stats about the blog - " & totalPosts & " post" & ( totalPosts == 1 ? "" : "s" ) & " and counting.",
			contentHtml : '<div class="bxsites-cards">' & cardsHtml & "</div>",
			urlPath     : "blog/stats/index.html",
			ogImage     : "",
			tags        : [],
			hidden      : false
		}
	}

	/**
	 * Renders one `.bxsites-card` for buildStatsPage() - a big `number`
	 * over a `label`, optionally linked (an author/category/post
	 * "spotlight" card) via `href`.
	 *
	 * @number The stat's own headline value - already formatted (numberFormat(), a plain count, or free text like a post title)
	 * @label What the number is - plain text, HTML-escaped here
	 * @href When non-empty, wraps the card in a link to the real page the stat is about - "" (the default) renders a plain, non-interactive card
	 */
	private string function statCard( required string number, required string label, string href = "" ) {
		var body = '<div class="bxsites-card__title">' & encodeForHTML( arguments.number ) & '</div><div class="bxsites-card__body">' & encodeForHTML( arguments.label ) & "</div>"
		return len( arguments.href )
			? ( '<a class="bxsites-card" href="' & attrEscapeUrl( arguments.href ) & '">' & body & "</a>" )
			: ( '<div class="bxsites-card">' & body & "</div>" )
	}

	/**
	 * Splits a post's own `contentHtml` at its first `<!-- more -->` marker
	 * (GitBook/mkdocs-material's own excerpt convention - an HTML comment,
	 * so it's invisible if left in the full post's own rendered page too, no
	 * stripping needed there) into a excerpt `{ html, text }` pair; falls
	 * back to frontmatter `summary` when there's no marker, then to a plain-text
	 * truncation of the post's own body when there's no summary either.
	 *
	 * @contentHtml The post's own already-converted body HTML
	 * @summary The post's own frontmatter `summary`, if any
	 */
	private struct function computeExcerpt( required string contentHtml, required string summary ) {
		var markerPos = arguments.contentHtml.findNoCase( "<!-- more -->" )
		if ( markerPos > 0 ) {
			var html = left( arguments.contentHtml, markerPos - 1 )
			return { html : html, text : stripTags( html ) }
		}

		if ( len( trim( arguments.summary ) ) ) {
			return { html : '<p>' & encodeForHTML( arguments.summary ) & '</p>', text : arguments.summary }
		}

		var truncated = truncateText( stripTags( arguments.contentHtml ), 220 )
		return { html : '<p>' & encodeForHTML( truncated ) & '</p>', text : truncated }
	}

	/**
	 * A crude HTML-tag stripper for excerpt/description text - good enough
	 * for "plain text summary of this HTML", not a real sanitizer.
	 *
	 * @html Rendered HTML
	 */
	private string function stripTags( required string html ) {
		return trim( arguments.html.reReplace( "<[^>]+>", " ", "all" ).reReplace( "\s+", " ", "all" ) )
	}

	/**
	 * Truncates plain text to at most `maxLength` characters, backing off to
	 * the previous word boundary rather than cutting mid-word.
	 *
	 * @text Plain text (already HTML-tag-stripped)
	 * @maxLength Maximum length before the trailing ellipsis
	 */
	private string function truncateText( required string text, required numeric maxLength ) {
		if ( len( arguments.text ) <= arguments.maxLength ) {
			return arguments.text
		}
		return left( arguments.text, arguments.maxLength ).reReplace( "\s+\S*$", "", "one" ) & "…"
	}

	/**
	 * A rough word count off already-tag-stripped plain text - splits on
	 * whitespace runs, same "good enough for an estimate, not exact"
	 * standard as stripTags()/computeExcerpt() above. Backs both
	 * readingTimeMinutes (enrichPosts()) and the "Total Words"/"Longest
	 * Post" stats cards (buildStatsPage()).
	 *
	 * @plainText Already HTML-tag-stripped text (stripTags()'s own output)
	 */
	private numeric function countWords( required string plainText ) {
		var trimmed = trim( arguments.plainText )
		return len( trimmed ) ? listLen( trimmed, " " ) : 0
	}

	/**
	 * Every distinct calendar year `posts` has at least one post in,
	 * newest first - backs the automatic `blog/archive/<year>/` pages, the
	 * same by-convention shape as category pages (build()'s own loop).
	 *
	 * @posts Enriched posts
	 */
	private array function distinctYears( required array posts ) {
		var seen = {}
		var years = []
		for ( var post in arguments.posts ) {
			var yr = year( post.date )
			if ( seen.keyExists( yr ) ) {
				continue
			}
			seen[ yr ] = true
			years.append( yr )
		}
		years.sort( ( a, b ) => b - a )
		return years
	}

	/**
	 * A "Browse by year" links block, one entry per distinct year with its
	 * own post count, appended onto the main `/blog/` list page(s) only -
	 * never onto a category or archive-year page itself, to avoid the same
	 * block repeating on every one of them. "" (nothing rendered) when
	 * there's only one year total - a single-entry archive list isn't worth
	 * showing, the same reasoning renderPager() already skips a pager for
	 * one page.
	 *
	 * @years distinctYears()'s own output - build()'s already-computed value, not recomputed here
	 * @posts Enriched posts
	 * @basePath Root-relative base path ending with `/`
	 */
	private string function renderArchiveLinksHtml( required array years, required array posts, required string basePath ) {
		if ( arguments.years.len() < 2 ) {
			return ""
		}

		var html = '<div class="blog-archive-links"><h2>' & variables.iconResolver.resolve( "phosphor-duotone:archive" ) & ' Archive</h2><ul>'
		for ( var yr in arguments.years ) {
			var count = arguments.posts.filter( post => year( post.date ) == yr ).len()
			html &= '<li><a href="' & arguments.basePath & "blog/archive/" & yr & '/index.html">' & yr & "</a> (" & count & ")</li>"
		}
		html &= "</ul></div>"

		return html
	}

	/**
	 * Every distinct category used across `posts`, alphabetical - a post's
	 * `categories` list can repeat the same name with different casing
	 * across posts; the first-seen casing wins.
	 *
	 * @posts Enriched posts
	 */
	private array function distinctCategories( required array posts ) {
		var seen = {}
		var categories = []
		for ( var post in arguments.posts ) {
			for ( var category in ( post.categories ?: [] ) ) {
				var key = lCase( trim( category ) )
				if ( !len( key ) || seen.keyExists( key ) ) {
					continue
				}
				seen[ key ] = true
				categories.append( category )
			}
		}
		categories.sort( "textnocase" )
		return categories
	}

	/**
	 * distinctCategories() plus, per category, its own url slug and post
	 * count - build()'s single source of truth for both the "Browse by
	 * category" links block and the per-category `/blog/category/<slug>/feed.xml`
	 * files BuildPipeline.bx writes, so the two never drift out of sync
	 * with each other or with the actual category pages built below them.
	 *
	 * @posts Enriched posts
	 *
	 * @return Array of { name, slug, count }, alphabetical by name
	 */
	private array function categoryCounts( required array posts ) {
		var counts = []
		for ( var category in distinctCategories( arguments.posts ) ) {
			counts.append( {
				name  : category,
				slug  : slugify( category ),
				count : arguments.posts.filter( post => hasCategoryNoCase( post.categories ?: [], category ) ).len()
			} )
		}
		return counts
	}

	/**
	 * A "Browse by category" links block, the same shape/placement as
	 * renderArchiveLinksHtml() (main `/blog/` list page(s) only, "" when
	 * there's only one category total).
	 *
	 * @categories categoryCounts()'s own output
	 * @basePath Root-relative base path ending with `/`
	 */
	private string function renderCategoryLinksHtml( required array categories, required string basePath ) {
		if ( arguments.categories.len() < 2 ) {
			return ""
		}

		var html = '<div class="blog-category-links"><h2>' & variables.iconResolver.resolve( "phosphor-duotone:tag" ) & ' Categories</h2><ul>'
		for ( var category in arguments.categories ) {
			html &= '<li><a href="' & arguments.basePath & "blog/category/" & category.slug & '/index.html">' & encodeForHTML( category.name ) & "</a> (" & category.count & ")</li>"
		}
		html &= "</ul></div>"

		return html
	}

	/**
	 * A one-line link to `/blog/stats/` (buildStatsPage()), appended onto
	 * the main `/blog/` list page(s) alongside the archive/category links
	 * blocks - unlike those two, always rendered (there's always something
	 * to show on the stats page, even a blog with zero posts).
	 *
	 * @basePath Root-relative base path ending with `/`
	 */
	private string function renderStatsLinkHtml( required string basePath ) {
		return '<p><a href="' & arguments.basePath & 'blog/stats/index.html">' & variables.iconResolver.resolve( "phosphor-duotone:chart-bar" ) & ' View blog stats &rarr;</a></p>'
	}

	/**
	 * Every distinct resolved author id referenced across `posts` (a
	 * plain-string author with no matching authors.yml entry has no `id` -
	 * skipped here, since it has no page of its own to build).
	 *
	 * @posts Enriched posts
	 */
	private array function distinctAuthorIds( required array posts ) {
		var seen = {}
		var ids = []
		for ( var post in arguments.posts ) {
			for ( var author in ( post.resolvedAuthors ?: [] ) ) {
				if ( !len( author.id ) || seen.keyExists( lCase( author.id ) ) ) {
					continue
				}
				seen[ lCase( author.id ) ] = true
				ids.append( author.id )
			}
		}
		return ids
	}

	/**
	 * Whether `post` credits `authorId` among its own resolved authors.
	 *
	 * @post One enriched post struct
	 * @authorId The author id being filtered for
	 */
	private boolean function postHasAuthorId( required struct post, required string authorId ) {
		for ( var author in ( arguments.post.resolvedAuthors ?: [] ) ) {
			if ( len( author.id ) && compareNoCase( author.id, arguments.authorId ) == 0 ) {
				return true
			}
		}
		return false
	}

	/**
	 * Whether `categories` contains `category`, case-insensitively.
	 *
	 * @categories A post's own `categories` array
	 * @category The category being filtered for
	 */
	private boolean function hasCategoryNoCase( required array categories, required string category ) {
		for ( var c in arguments.categories ) {
			if ( compareNoCase( c, arguments.category ) == 0 ) {
				return true
			}
		}
		return false
	}

	/**
	 * Slugs a category name into its `blog/category/<slug>/` path segment -
	 * kept in sync with BlogFeedGenerator.bx's own identical slugify() by
	 * convention, the same duplication TagsIndexBuilder.bx's own tagSlug()
	 * already accepts for the same reason.
	 *
	 * @category The raw category text
	 */
	private string function slugify( required string category ) {
		return lCase( trim( arguments.category ) ).reReplace( "[^a-z0-9]+", "-", "all" ).reReplace( "(^-|-$)", "", "all" )
	}

	/**
	 * A minimal, attribute-safe escape for an author-authored URL (website/
	 * email/social link) - not encodeForHTML(), same reasoning as
	 * UpdatesFeedGenerator.bx's own attrEscape().
	 *
	 * @value The raw URL/email value
	 */
	private string function attrEscapeUrl( required string value ) {
		return arguments.value.replace( "&", "&amp;", "all" ).replace( '"', "&quot;", "all" ).replace( "<", "&lt;", "all" )
	}

}
