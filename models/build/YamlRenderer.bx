/**
 * Reads/writes YAML via bx-yaml's `yamlDeserialize()`/`yamlSerialize()` BIFs -
 * the same "delegate to a real module, don't hand-roll" approach
 * MarkdownRenderer.bx already takes for markdown (its own docblock explains
 * why in full).
 *
 * Has a hard runtime dependency on the bx-yaml module being activated
 * (box.json declares it as a dependency, 1.1.0 or later) - every caller
 * (ConfigLoader.bx, MkdocsMigrator.bx, BlogAuthorsLoader.bx) takes this class
 * behind a swappable seam for exactly that reason, the same shape
 * BuildPipeline.bx's own `setMarkdownRenderer()` already established - see
 * tests/support/FakeYamlRenderer.bx. YamlRendererSpec.bx covers the real
 * module's list shapes, which the fake cannot.
 */
class {

	/**
	 * Parses a YAML document into a BoxLang value (struct/array/scalar).
	 *
	 * @content Raw YAML text
	 */
	any function fromYaml( required string content ) {
		assertFixedSequences()
		return yamlDeserialize( arguments.content )
	}

	/**
	 * Serializes a BoxLang value into YAML text.
	 *
	 * @value The struct/array/scalar to serialize
	 */
	string function toYaml( required any value ) {
		return yamlSerialize( arguments.value )
	}

	/**
	 * bx-yaml 1.0.0 wrapped every YAML sequence in one extra array (`[ a, b ]`
	 * came back as `[ [ a, b ] ]`), which this class used to repair after the
	 * fact. 1.1.0 fixed it, and repairing a correct result would flatten a list
	 * that holds exactly one inner list, so the repair is gone. Parsing with the
	 * old module would now silently hand every caller double wrapped lists, so
	 * the first parse checks the installed module and fails loudly instead.
	 */
	private void function assertFixedSequences() {
		if ( variables.sequencesChecked ?: false ) {
			return
		}
		var probe = yamlDeserialize( "[ 1 ]" )
		if ( !isArray( probe ) || probe.len() != 1 || isArray( probe[ 1 ] ) ) {
			throw(
				type    = "BxSites.UnsupportedYamlModule",
				message = "The installed bx-yaml module wraps every YAML list in an extra array. bx-sites needs bx-yaml 1.1.0 or later.",
				detail  = "Update it with `install-bx-module bx-yaml`."
			)
		}
		variables.sequencesChecked = true
	}

}
