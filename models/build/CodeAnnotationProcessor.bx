/**
 * Extends fenced code blocks with mkdocs-style annotations in the info
 * string - `hl_lines`, `linenums`, `title`, `frame`, `insert` and `delete`:
 *
 *   ```bx hl_lines="2 4-6" linenums="1" title="app.bx"
 *   ...
 *   ```
 *
 *   ```bash frame="terminal" title="user@boxlang"
 *   ...
 *   ```
 *
 *   ```bx title="add.bx" insert="3-4" delete="7"
 *   ...
 *   ```
 *
 * `frame="terminal"` swaps the plain title bar for a macOS-style window
 * (three status dots, centered title) - the only other recognized value is
 * the default, `"code"` (today's plain bar; naming it is pure symmetry,
 * nothing needs to write it). `insert`/`delete` mark lines as added/removed
 * - same space/range syntax `hl_lines` already uses - rendered as a tinted
 * row plus a gutter marker. Spelled out in full deliberately, matching
 * every other attribute here (`hl_lines` predates this convention) - not
 * literal `+`/`-` line prefixes the way Expressive Code does it, since that
 * would mean stripping them back out again for the existing copy button;
 * keeping them as attributes leaves the fence's own content real,
 * unmodified, copy-pasteable source.
 *
 * bx-markdown/Flexmark only ever reads the first word of a fence's info
 * string (the language, for its `language-xxx` class) - anything after it
 * is passed through as literal text inside the `<code>` element rather
 * than being understood, and this module cannot fork Flexmark to teach it
 * these attributes. So, same two-phase shape as TabsProcessor.bx/
 * MathProtector.bx:
 *
 *  1. `extractAndStrip()` runs BEFORE conversion - it reads each fence's
 *     extra attributes, strips them back down to a bare `` ```language ``
 *     so bx-markdown's own language-class handling is unaffected, and
 *     records the parsed attributes in fence order (including an empty
 *     struct for fences with no extra attributes, so array position stays
 *     aligned with occurrence order).
 *  2. `applyToHtml()` runs AFTER conversion - it walks every rendered
 *     `<pre><code` in document order (one per fence, same order) and
 *     stamps the matching annotation's data onto the `<pre>` tag as
 *     `data-bxsites-*` attributes for the client-side widget
 *     (code-lines.js) to pick up.
 */
class {

	variables.attrPattern  = createObject( "java", "java.util.regex.Pattern" ).compile( '(\w+)="([^"]*)"' )
	variables.preCodePattern = createObject( "java", "java.util.regex.Pattern" ).compile( "<pre><code" )

	/**
	 * Reads and strips `hl_lines`/`linenums`/`title` off every fenced code
	 * block's info string, leaving a bare `` ```language `` fence behind.
	 *
	 * A line-by-line scan, not a regex over the whole text - CommonMark
	 * fences nest by marker length (a fence opened with 4+ backticks can
	 * only be closed by a line of 4+ backticks; a 3-backtick line inside it
	 * is just literal content, e.g. a doc page showing fence syntax as an
	 * example), so this tracks the currently-open fence's own character and
	 * length rather than toggling a plain in/out boolean on every fence-like
	 * line - which would miscount (and desync annotations from the actual
	 * rendered `<pre>` elements applyToHtml() later walks) the moment a page
	 * nests a fence inside a longer one. Marker length alone isn't quite
	 * enough though - a page can also nest a fence of the *same* length
	 * inside a longer one, indented as body content (e.g. a `=== "Title"`
	 * tab example's own nested snippet, indented 4 spaces same as an
	 * admonition body); an indented line's bare backticks would otherwise
	 * still match the outer fence's own close pattern. So, same as
	 * FenceTracker.bx (this can't reuse that class directly - it only
	 * reports "skip or not", not the lang/attrs a real opener needs
	 * parsed), a 4+ space/tab indent disqualifies a line from being a
	 * delimiter for the *currently tracked* (unindented) fence at all.
	 *
	 * @markdown The raw markdown body text
	 *
	 * @return { markdown: string with fence attributes stripped, annotations: array (one entry per fence, in order; empty struct when a fence has no extra attributes) }
	 */
	struct function extractAndStrip( required string markdown ) {
		var normalized = arguments.markdown.reReplace( char( 13 ) & char( 10 ), char( 10 ), "all" )
		var lines = listToArray( normalized, char( 10 ), true )
		var outputLines = []
		var annotations = []
		var fenceChar = ""
		var fenceLength = 0

		for ( var i = 1; i <= lines.len(); i++ ) {
			var line = lines[ i ]
			var trimmedLine = trim( line )
			var tooIndented = line.reFind( "^(\t| {4,})" ) > 0

			if ( fenceLength > 0 ) {
				if ( !tooIndented && trimmedLine.reFind( "^" & fenceChar & "{" & fenceLength & ",}$" ) ) {
					fenceLength = 0
					fenceChar = ""
				}
				outputLines.append( line )
				continue
			}

			if ( tooIndented || !trimmedLine.reFind( "^(```+|~~~+)" ) ) {
				outputLines.append( line )
				continue
			}

			var marker = trimmedLine.reReplace( "^(```+|~~~+).*", "\1", "one" )
			fenceChar = left( marker, 1 )
			fenceLength = len( marker )

			var rest = trim( mid( trimmedLine, fenceLength + 1, len( trimmedLine ) ) )
			var lang = rest.reReplace( "^(\S*).*", "\1", "one" )
			var attrs = trim( mid( rest, len( lang ) + 1, len( rest ) ) )

			if ( len( attrs ) ) {
				annotations.append( parseAttrs( attrs ) )
				outputLines.append( marker & lang )
			} else {
				annotations.append( {} )
				outputLines.append( line )
			}
		}

		return { markdown : outputLines.toList( char( 10 ) ), annotations : annotations }
	}

	/**
	 * Stamps each annotation from extractAndStrip() back onto its matching
	 * rendered `<pre>` tag, walked in the same document order as the fences.
	 *
	 * @html Already-rendered HTML (from Markdown() on extractAndStrip()'s output)
	 * @annotations extractAndStrip()'s own `annotations` array
	 *
	 * @return html with data-bxsites-* attributes stamped onto each annotated `<pre>` tag
	 */
	string function applyToHtml( required string html, required array annotations ) {
		var matcher = variables.preCodePattern.matcher( arguments.html )
		var buffer = createObject( "java", "java.lang.StringBuilder" ).init()
		var idx = 0

		while ( matcher.find() ) {
			idx++
			var annotation = ( idx <= arguments.annotations.len() ) ? arguments.annotations[ idx ] : {}
			var attrs = ""

			if ( !annotation.isEmpty() ) {
				if ( ( annotation.hlLines ?: [] ).len() ) {
					attrs &= ' data-bxsites-hl-lines="' & annotation.hlLines.toList( "," ) & '"'
				}
				if ( annotation.showLineNumbers ?: false ) {
					attrs &= ' data-bxsites-start-line="' & annotation.startLine & '"'
				}
				if ( len( annotation.title ?: "" ) ) {
					attrs &= ' data-bxsites-title="' & encodeForHTML( annotation.title ) & '"'
				}
				if ( ( annotation.frame ?: "" ) eq "terminal" ) {
					attrs &= ' data-bxsites-frame="terminal"'
				}
				if ( ( annotation.insertLines ?: [] ).len() ) {
					attrs &= ' data-bxsites-insert-lines="' & annotation.insertLines.toList( "," ) & '"'
				}
				if ( ( annotation.deleteLines ?: [] ).len() ) {
					attrs &= ' data-bxsites-delete-lines="' & annotation.deleteLines.toList( "," ) & '"'
				}
			}

			matcher.appendReplacement( buffer, quoteReplacement( "<pre" & attrs & "><code" ) )
		}
		matcher.appendTail( buffer )

		return buffer.toString()
	}

	/**
	 * Parses a fence's `key="value"` attributes into a normalized annotation
	 * struct (`hlLines`, `showLineNumbers`, `startLine`, `title`, `frame`,
	 * `insertLines`, `deleteLines`).
	 *
	 * @rest The fence info string with the language token already removed, e.g. `hl_lines="2 4-6" linenums="1" title="app.bx" frame="terminal" insert="3-4" delete="7"`
	 */
	private struct function parseAttrs( required string rest ) {
		var raw = {}
		var matcher = variables.attrPattern.matcher( arguments.rest )
		while ( matcher.find() ) {
			raw[ matcher.group( 1 ) ] = matcher.group( 2 )
		}

		var annotation = {
			hlLines : [],
			showLineNumbers : false,
			startLine : 1,
			title : trim( raw.title ?: "" ),
			frame : trim( raw.frame ?: "" ),
			insertLines : [],
			deleteLines : []
		}

		if ( len( trim( raw.hl_lines ?: "" ) ) ) {
			annotation.hlLines = expandLineRanges( raw.hl_lines )
		}

		if ( raw.keyExists( "linenums" ) ) {
			annotation.showLineNumbers = true
			annotation.startLine = val( trim( raw.linenums ) ) ? val( trim( raw.linenums ) ) : 1
		}

		// Bracket notation, not `raw.insert`/`raw.delete` - `insert`/`delete`
		// read fine as struct keys either way in practice, but bracket access
		// sidesteps any ambiguity with `delete` as a CFML/BoxLang statement
		// keyword rather than relying on it.
		if ( len( trim( raw[ "insert" ] ?: "" ) ) ) {
			annotation.insertLines = expandLineRanges( raw[ "insert" ] )
		}

		if ( len( trim( raw[ "delete" ] ?: "" ) ) ) {
			annotation.deleteLines = expandLineRanges( raw[ "delete" ] )
		}

		return annotation
	}

	/**
	 * Expands an `hl_lines` spec into a flat array of individual line numbers.
	 *
	 * @spec Space-separated line numbers and/or `A-B` ranges, e.g. `2 4-6`
	 */
	private array function expandLineRanges( required string spec ) {
		var lines = []
		for ( var token in listToArray( trim( arguments.spec ), " ", true ) ) {
			if ( token.reFind( "^\d+-\d+$" ) ) {
				var startNum = val( token.reReplace( "^(\d+)-(\d+)$", "\1", "one" ) )
				var endNum = val( token.reReplace( "^(\d+)-(\d+)$", "\2", "one" ) )
				for ( var n = startNum; n <= endNum; n++ ) {
					lines.append( n )
				}
			} else if ( token.reFind( "^\d+$" ) ) {
				lines.append( val( token ) )
			}
		}
		return lines
	}

	/**
	 * Escapes literal text for use as a `Matcher#appendReplacement` argument.
	 *
	 * @text Literal text to safely pass through java.util.regex.Matcher#appendReplacement, which otherwise treats `$` and `\` as backreference syntax
	 */
	private string function quoteReplacement( required string text ) {
		return createObject( "java", "java.util.regex.Matcher" ).quoteReplacement( arguments.text )
	}

}
