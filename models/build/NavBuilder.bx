/**
 * Builds a nested nav tree from a flat list of loaded pages - folder/file
 * structure becomes nav structure (module spec section 5, step 3). A
 * folder's own `index.md` becomes that folder's nav entry (its title, url
 * and order); a folder with no `index.md` is still a group node, just with
 * no link of its own. Hidden pages are excluded entirely - they are still
 * built, just never linked from the nav.
 *
 * An explicit `navConfig` (bxdocs.json's own `nav` array, or a project's
 * `docs/nav.json`) bypasses folder-inference entirely - see build()'s
 * docblock.
 */
class {

	/**
	 * Builds the nav tree - from an explicit `navConfig` when given,
	 * otherwise inferred from `pages`' own folder/file structure.
	 *
	 * @pages The array of page structs from DocsLoader.load()
	 * @navConfig An explicit nav tree to build from instead of inferring one
	 * from folder structure - each entry is either a bare docs/-relative
	 * path string (`"guides/setup.md"`, title/order/icon taken from that
	 * page), or an object `{ "title", "path", "icon", "children" }` (`path`,
	 * `icon` and `children` all optional - a `title`-only, path-less entry
	 * is an unlinked group heading, exactly like a folder with no
	 * `index.md` today). An explicit `icon` overrides the target page's
	 * own frontmatter `icon` (IconResolver.bx resolves either); omitted
	 * falls back to the page's own. Array position sets nav order; pages
	 * not referenced anywhere in `navConfig` are still built, just not
	 * linked from the nav (same as a `hidden` page). Empty (the default)
	 * means "infer from folder structure".
	 *
	 * @return Array of nav nodes, sorted (unless navConfig is given, which is already author-ordered): { title, url, order, icon, children }
	 */
	array function build( required array pages, array navConfig = [] ) {
		if ( arguments.navConfig.len() ) {
			return buildFromConfig( arguments.navConfig, indexPagesByPath( arguments.pages ) )
		}

		var root = { children : {} }

		for ( var page in arguments.pages ) {
			if ( page.hidden ) {
				continue
			}
			addPage( root, page )
		}

		// A root-level index.md (no parent folder) sets root.title/url/order
		// directly in addPage() below, since - unlike a nested folder's own
		// index.md - it has no children-map slot of its own to land in and
		// be picked up by toSortedArray(). Splice it in under a key no real
		// file/folder name can ever produce, so it sorts alongside its true
		// top-level siblings instead of being silently dropped from the nav.
		if ( len( root.url ?: "" ) ) {
			root.children[ "" ] = { title : root.title, url : root.url, order : root.order, icon : root.icon ?: "", children : {} }
		}

		return toSortedArray( root.children )
	}

	/**
	 * Indexes pages by their docs/-relative source path (case-insensitively,
	 * so a nav.json entry doesn't have to match a source file's exact case)
	 * for buildFromConfig()'s path lookups.
	 *
	 * @pages The array of page structs from DocsLoader.load()
	 */
	private struct function indexPagesByPath( required array pages ) {
		var byPath = {}
		for ( var page in arguments.pages ) {
			byPath[ lCase( page.relativePath ) ] = page
		}
		return byPath
	}

	/**
	 * Builds a nav tree from an explicit navConfig array, one node per entry.
	 *
	 * @navConfig The explicit nav tree - see build()'s docblock for its shape
	 * @pagesByPath Every loaded page, indexed by lowercased relativePath
	 */
	private array function buildFromConfig( required array navConfig, required struct pagesByPath ) {
		var nodes = []
		for ( var entry in arguments.navConfig ) {
			nodes.append( buildConfigNode( entry, arguments.pagesByPath ) )
		}
		return nodes
	}

	/**
	 * Builds a single navConfig entry (and, recursively, its children) into
	 * a nav node - a bare string entry is normalized to `{ path: entry }`
	 * first.
	 *
	 * @entry A bare path string, or a `{ title, path, children }` object
	 * @pagesByPath Every loaded page, indexed by lowercased relativePath
	 */
	private struct function buildConfigNode( required any entry, required struct pagesByPath ) {
		if ( isSimpleValue( arguments.entry ) ) {
			return buildConfigNode( { "path" : arguments.entry }, arguments.pagesByPath )
		}

		var path = trim( arguments.entry.path ?: "" )
		var page = len( path ) ? resolveConfigPage( path, arguments.pagesByPath ) : javacast( "null", "" )

		var children = []
		if ( isArray( arguments.entry.children ?: "" ) ) {
			for ( var child in arguments.entry.children ) {
				children.append( buildConfigNode( child, arguments.pagesByPath ) )
			}
		}

		var title = trim( arguments.entry.title ?: "" )
		if ( !len( title ) ) {
			title = isNull( page ) ? "" : page.title
		}

		var icon = trim( arguments.entry.icon ?: "" )
		if ( !len( icon ) && !isNull( page ) ) {
			icon = page.icon ?: ""
		}

		return { title : title, url : isNull( page ) ? "" : page.urlPath, order : 0, icon : icon, children : children }
	}

	/**
	 * Looks up a navConfig entry's `path` against the loaded pages, throwing
	 * `BxDocs.InvalidConfig` when it references a page that doesn't exist.
	 *
	 * @path A docs/-relative nav entry path, e.g. `"guides/setup.md"`
	 * @pagesByPath Every loaded page, indexed by lowercased relativePath
	 */
	private struct function resolveConfigPage( required string path, required struct pagesByPath ) {
		var key = lCase( trim( arguments.path ) )
		if ( !arguments.pagesByPath.keyExists( key ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "nav entry references [#arguments.path#], which doesn't match any file under docs/"
			)
		}
		return arguments.pagesByPath[ key ]
	}

	/**
	 * Walks a page's folder path into the (struct-keyed, still-unsorted)
	 * tree being built, creating group nodes for folders as needed.
	 *
	 * @root The synthetic root node (struct-keyed children map)
	 * @page A single visible page struct
	 */
	private void function addPage( required struct root, required struct page ) {
		var segments = listToArray( arguments.page.relativePath, "/" )
		var fileName = segments[ segments.len() ]
		var folders = segments.len() > 1 ? segments.slice( 1, segments.len() - 1 ) : []
		var isIndex = compareNoCase( fileName.reReplaceNoCase( "\.md$", "" ), "index" ) == 0

		var current = arguments.root
		for ( var folderName in folders ) {
			if ( !current.children.keyExists( folderName ) ) {
				current.children[ folderName ] = { title : folderName, url : "", order : 999999, icon : "", children : {} }
			}
			current = current.children[ folderName ]
		}

		if ( isIndex ) {
			current.title = arguments.page.title
			current.url   = arguments.page.urlPath
			current.order = arguments.page.order
			current.icon  = arguments.page.icon ?: ""
		} else {
			current.children[ fileName ] = {
				title    : arguments.page.title,
				url      : arguments.page.urlPath,
				order    : arguments.page.order,
				icon     : arguments.page.icon ?: "",
				children : {}
			}
		}
	}

	/**
	 * Recursively converts a struct-keyed children map into a sorted array.
	 *
	 * @childrenMap A struct mapping folder/file name -> node struct
	 */
	private array function toSortedArray( required struct childrenMap ) {
		var nodes = []
		for ( var key in arguments.childrenMap ) {
			var node = arguments.childrenMap[ key ]
			nodes.append( {
				title    : node.title,
				url      : node.url,
				order    : node.order,
				icon     : node.icon ?: "",
				children : toSortedArray( node.children )
			} )
		}

		nodes.sort( ( a, b ) => {
			if ( a.order != b.order ) {
				return a.order < b.order ? -1 : 1
			}
			return compareNoCase( a.title, b.title )
		} )

		return nodes
	}

	/**
	 * Flattens a nav tree into the linear "reading order" used for prev/next
	 * page links - a depth-first walk in the same sorted order `build()`
	 * already established. Folder-group nodes with no `url` of their own
	 * (no `index.md`) are skipped; their children are still visited.
	 *
	 * @nav A nav tree from build()
	 *
	 * @return Array of { title, url }, in reading order
	 */
	array function flatten( required array nav ) {
		var flat = []
		flattenInto( arguments.nav, flat )
		return flat
	}

	/**
	 * flatten()'s own recursive depth-first walk.
	 *
	 * @nodes A nav tree (or subtree) to walk
	 * @flat The accumulator array, appended to in place
	 */
	private void function flattenInto( required array nodes, required array flat ) {
		for ( var node in arguments.nodes ) {
			if ( len( node.url ) ) {
				arguments.flat.append( { title : node.title, url : node.url } )
			}
			if ( node.children.len() ) {
				flattenInto( node.children, arguments.flat )
			}
		}
	}

	/**
	 * Finds the ancestor chain (root -> ... -> the page itself) for a given
	 * page's url, for rendering breadcrumbs. Link-less folder-group nodes
	 * are walked through but never appear in the returned chain themselves
	 * (there's nothing to link to).
	 *
	 * @nav A nav tree from build()
	 * @urlPath The page's own urlPath to find
	 *
	 * @return Array of { title, url }, root-first, ending with the page itself - empty if not found (e.g. a hidden page)
	 */
	array function breadcrumbs( required array nav, required string urlPath ) {
		var path = []
		findPath( arguments.nav, arguments.urlPath, path )
		return path
	}

	/**
	 * Backtracking depth-first search for `urlPath`, building `path` in
	 * place as it descends and unwinding a branch once it's ruled out.
	 *
	 * @nodes A nav tree (or subtree) to search
	 * @urlPath The page's own urlPath to find
	 * @path The accumulator array, appended to (and unwound from) in place
	 *
	 * @return true once `urlPath` is found anywhere under `nodes`
	 */
	private boolean function findPath( required array nodes, required string urlPath, required array path ) {
		for ( var node in arguments.nodes ) {
			if ( len( node.url ) ) {
				arguments.path.append( { title : node.title, url : node.url } )
			}

			if ( node.url == arguments.urlPath ) {
				return true
			}

			if ( node.children.len() && findPath( node.children, arguments.urlPath, arguments.path ) ) {
				return true
			}

			if ( len( node.url ) ) {
				arguments.path.deleteAt( arguments.path.len() )
			}
		}

		return false
	}

}
