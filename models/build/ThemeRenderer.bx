/**
 * Resolves a theme folder and renders a single page through its `layout.bxm`
 * (module spec section 5, step 4; section 6 theme contract).
 *
 * The `ThemeProvider` contract (module spec section 6) a theme folder must
 * satisfy:
 *   - `layout.bxm` (required) - the outer HTML shell + nav; receives
 *     `variables.page`, `variables.nav`, `variables.siteConfig` and
 *     `variables.themeDir` in scope, and includes the sibling `page.bxm` via
 *     `#variables.themeDir#/page.bxm` (BoxLang's include scope-absorption
 *     carries those variables through automatically - no explicit hand-off).
 *   - `page.bxm` (required) - the article body; renders `variables.page.contentHtml`
 *     (the already-converted markdown, set by BuildPipeline before rendering).
 *     `variables.page.toc`, `.prevPage`, `.nextPage`, `.breadcrumbs`,
 *     `.editUrl`, `.lastUpdated`, `.description`, `.tags`, `.icon`,
 *     `.iconHtml`, `.summary`, `.ogImage` and `.urlPath` are always present too (defaulted by
 *     `renderPage()` below if the caller didn't set them - empty
 *     string/array when `bxsites.json`'s `repo.editUri`/`lastUpdated` aren't
 *     configured, or the page has no matching frontmatter key), so a
 *     theme's `page.bxm` never needs to guard their existence.
 *     `variables.basePath` (module spec section 4's `baseURL`,
 *     via BaseUrlResolver.bx) is always a root-relative path ending with
 *     `/` - every internal `href`/`src` a theme renders should be prefixed
 *     with it instead of a hardcoded `/`, so the site still works hosted
 *     from a sub-path.
 *   - `search.bxm` (optional, not yet enforced - module spec section 7,
 *     deferred to Phase 4) - the search UI partial, included when
 *     `bxsites.json`'s `search` is `true` (regardless of provider).
 *     `variables.siteConfig.searchProvider.provider` (defaulted to `"local"`
 *     by ConfigLoader.bx) tells it which UI to render - the built-in themes'
 *     own `search.bxm` render the local MiniSearch search box for `"local"`, an
 *     empty container for `"algolia"` (wired up by `layout.bxm` instead, via
 *     Algolia DocSearch), and nothing for any other provider name, which a
 *     project's own `theme/` override is then free to handle itself - see
 *     docs/guides/search.md.
 *   - `assets/` (optional) - theme CSS/JS, copied to `site/assets/theme/` by
 *     BuildPipeline's asset pipeline.
 *
 * `variables.versions` (`[ { label, url } ]`, "Latest" first) and
 * `variables.currentVersion` (the `label` being rendered right now) back
 * a version switcher for projects using the `docs/versions/` convention
 * (VersionsDiscoverer.bx) - empty/`"Latest"` for a project that isn't
 * versioned, so a theme only needs to render the switcher when
 * `variables.versions.len() gt 1`.
 *
 * `variables.locales` (`[ { code, label, url, dir, flag } ]`, the default locale
 * first) and `variables.currentLocale` (the `code` being rendered right
 * now) back a language switcher for projects using the `docs/i18n/`
 * convention (LocalesDiscoverer.bx) the same way - a theme only needs to
 * render it when `variables.locales.len() gt 1`. `variables.currentLocaleDir`
 * (`"ltr"`/`"rtl"`) is the current locale's own text direction, stamped
 * onto `<html dir="...">`. `variables.page.isFallbackContent` (defaulted to
 * `false` below if unset) is `true` for a page rendered in a locale that
 * has no translation for it yet - showing the default locale's own content
 * instead of a broken link, per mergeLocalePages()'s docblock; a theme's
 * `page.bxm` can check it to show a "not yet translated" notice.
 *
 * `functions` (module spec section 8, `docs/functions.bxs` - FunctionsLoader.bx)
 * - a project's own "magic functions", each named with a leading `$` - are
 * bound directly into this scope, unprefixed, right before `layout.bxm` is
 * included below: `functions = { "$greet" : <fn> }` makes `$greet(...)`
 * callable bare from `layout.bxm`/`page.bxm` (or any further sibling
 * `.bxm` a project's own `theme/` override includes), the same
 * include-scope-absorption trick this class already relies on for
 * `variables.page`/`variables.siteConfig` etc. - see docs/guides/variables-and-functions.md.
 */
class {

	/**
	 * The files every theme folder must provide (the required half of the
	 * `ThemeProvider` contract documented on this class).
	 */
	variables.requiredFiles = [ "layout.bxm", "page.bxm" ]

	/**
	 * Resolves the theme-chrome UI strings (search placeholder, "On this
	 * page", the 404 page, ...) for the locale being rendered right now -
	 * see StringsResolver.bx's own docblock.
	 */
	variables.stringsResolver = new "models.config.StringsResolver@bxsites"()

	/**
	 * Resolution order:
	 *   1. A project-level `theme/` override (module spec section 3), if it
	 *      satisfies the `ThemeProvider` contract - an all-or-nothing
	 *      override, wins outright over everything else.
	 *   2. `themes/<themeName>/` - a theme `install:theme` downloaded from
	 *      ForgeBox (ThemeInstaller.bx), letting a project carry several
	 *      installed themes side by side and switch between them purely by
	 *      name.
	 *   3. This module's own built-in `resources/themes/<themeName>`
	 *      (section 6).
	 *
	 * @themeName The configured theme name (bxsites.json's `theme.name`)
	 * @projectRoot Absolute path to the project root
	 *
	 * @return Absolute path to the resolved theme's own folder - or, for
	 *         a built-in theme (case 3 above), the virtual `/bxmodules/bxsites/...`
	 *         path builtInThemesDir() returns instead (see its own docblock)
	 */
	string function resolveThemeDir( required string themeName, required string projectRoot ) {
		var root = arguments.projectRoot.reReplace( "[\/]+$", "" )

		var projectTheme = root & "/theme"
		if ( directoryExists( projectTheme ) ) {
			return assertThemeProvider( projectTheme )
		}

		var installedTheme = root & "/themes/" & arguments.themeName
		if ( directoryExists( installedTheme ) ) {
			return assertThemeProvider( installedTheme )
		}

		var builtIn = builtInThemesDir() & "/" & arguments.themeName
		if ( directoryExists( builtIn ) ) {
			return assertThemeProvider( builtIn )
		}

		throw(
			type    = "BxSites.ThemeNotFound",
			message = "No theme found for [#arguments.themeName#] - looked in [#projectTheme#], [#installedTheme#] and [#builtIn#]"
		)
	}

	/**
	 * Validates that a resolved theme folder satisfies the `ThemeProvider`
	 * contract (this class's own docblock), so a broken/incomplete theme
	 * fails with one clear message up front instead of a confusing
	 * `include` error deep inside rendering.
	 *
	 * @themeDir Absolute path to a theme folder that exists
	 *
	 * @return The same themeDir, unchanged, if it satisfies the contract
	 */
	private string function assertThemeProvider( required string themeDir ) {
		var dir = arguments.themeDir
		var missing = variables.requiredFiles.filter( fileName => !fileExists( dir & "/" & fileName ) )

		if ( missing.len() ) {
			throw(
				type    = "BxSites.InvalidTheme",
				message = "Theme at [#dir#] is missing required file(s): #missing.toList( ', ' )#"
			)
		}

		return dir
	}

	/**
	 * Virtual path to this module's own bundled themes folder, via
	 * BoxLang's own automatic per-module mapping - `this.mapping =
	 * "bxsites"` in ModuleConfig.bx makes BoxLang register `/bxmodules/bxsites`
	 * pointing at this module's own root automatically, for every module,
	 * no `registerMapping()` of our own needed. Resolves the same way
	 * whether the module is fully activated or just loaded for a unit
	 * test, and cross-platform by construction (it's a virtual path, not
	 * an OS one).
	 */
	string function builtInThemesDir() {
		return "/bxmodules/bxsites/resources/themes"
	}

	/**
	 * Virtual path to this module's own shared (theme-independent) assets
	 * folder - exposed to every theme at render time as `variables.moduleAssetsDir`,
	 * so a theme can `<bx:include template="#variables.moduleAssetsDir#/icons.bxm">`
	 * for the shared repo/social icon partial rather than duplicating it.
	 * Same automatic `/bxmodules/bxsites` module mapping as `builtInThemesDir()`
	 * above - see its own docblock for why.
	 */
	private string function computeModuleAssetsDir() {
		return "/bxmodules/bxsites/resources/assets"
	}

	/**
	 * Turns a real, OS-native absolute path into a virtual path `include`/
	 * `<bx:include template="...">` can resolve, via one of the two
	 * mappings ModuleConfig.bx's `onLoad()` registers:
	 *  - `/bxApp`, onto the directory `bxSites` was invoked from
	 *    (`server.cli.executionPath`) - used whenever the given path is
	 *    under that directory (bxSites' own real usage always is), as a
	 *    tidy invocation-relative path.
	 *  - `/bxAppRoot`, onto the OS/drive root - the fallback for a path
	 *    outside that directory entirely (an explicit `--projectRoot`
	 *    elsewhere, or - only relevant to this module's own test suite -
	 *    a temp directory a spec created for its own throwaway fixtures,
	 *    since specs call this class directly, bypassing `main()` and its
	 *    `/bxApp` mapping).
	 * Either way, Windows' backslashes are normalized to forward slashes
	 * along the way - a no-op on Linux/Mac, where paths already look the
	 * way `include` expects.
	 *
	 * @path A real absolute filesystem path, in whatever format the current OS gives it
	 *
	 * @return A virtual path prefixed with whichever of the two mappings applies
	 */
	private string function toVirtualPath( required string path ) {
		var cwd = server.boxlang.cliMode ? server.cli.executionPath : server.java.executionPath
		var normalizedCwd = cwd.replace( char( 92 ), "/", "all" ).reReplace( "[\/]+$", "" )
		var normalizedPath = arguments.path.replace( char( 92 ), "/", "all" )

		if ( normalizedPath.left( len( normalizedCwd ) ) == normalizedCwd ) {
			// +2 (not +1) skips both the matched cwd prefix and the path
			// separator right after it - remaining is never negative here,
			// since a themeDir is always some real subdirectory deeper
			// than cwd itself, never cwd exactly.
			var remaining = len( normalizedPath ) - len( normalizedCwd ) - 1
			return remaining > 0 ? "/bxApp/" & normalizedPath.mid( len( normalizedCwd ) + 2, remaining ) : "/bxApp"
		}

		return "/bxAppRoot" & normalizedPath.reReplace( "^[A-Za-z]:", "" )
	}

	/**
	 * Renders one page through its theme's `layout.bxm`/`page.bxm`,
	 * defaulting `tags`/`icon`/`summary`/`ogImage` on `page` first if
	 * frontmatter left any of them unset.
	 *
	 * @page A page struct with an added `contentHtml` key (the already-converted markdown body)
	 * @nav The site's nav tree, from NavBuilder.build()
	 * @config The site's bxsites.json config
	 * @themeDir Absolute path to the resolved theme folder (from resolveThemeDir())
	 * @basePath Root-relative base path ending with `/` (BaseUrlResolver's `basePath`) - defaults to `/`
	 * @versions Version switcher entries as `[ { label, url } ]` ("Latest" first, then each discovered docs/versions/ folder) - empty when the project doesn't use versioning
	 * @currentVersion The `label` (from `versions`) of the version being rendered right now - `"Latest"` for the default/unversioned build
	 * @locales Language switcher entries as `[ { code, label, url, dir, flag } ]` (default locale first, then each discovered docs/i18n/ folder) - empty when the project doesn't use i18n
	 * @currentLocale The `code` (from `locales`) of the locale being rendered right now - the default locale's own code for an unlocalized build
	 * @currentLocaleDir `"ltr"`/`"rtl"` - the current locale's own text direction, stamped onto `<html dir="...">`
	 * @functions FunctionsLoader.load()'s own output (module spec section 8) - each `$`-prefixed magic function bound directly into this scope, bare-callable from `layout.bxm`/`page.bxm`
	 *
	 * @return The rendered page HTML
	 */
	string function renderPage( required struct page, required array nav, required struct config, required string themeDir, string basePath = "/", array versions = [], string currentVersion = "Latest", array locales = [], string currentLocale = "", string currentLocaleDir = "ltr", struct functions = {} ) {
		variables.page = arguments.page
		if ( !variables.page.keyExists( "toc" ) ) {
			variables.page.toc = []
		}
		if ( !variables.page.keyExists( "prevPage" ) ) {
			variables.page.prevPage = { title : "", url : "" }
		}
		if ( !variables.page.keyExists( "nextPage" ) ) {
			variables.page.nextPage = { title : "", url : "" }
		}
		if ( !variables.page.keyExists( "breadcrumbs" ) ) {
			variables.page.breadcrumbs = []
		}
		if ( !variables.page.keyExists( "editUrl" ) ) {
			variables.page.editUrl = ""
		}
		if ( !variables.page.keyExists( "lastUpdated" ) ) {
			variables.page.lastUpdated = ""
		}
		if ( !variables.page.keyExists( "description" ) ) {
			variables.page.description = ""
		}
		if ( !variables.page.keyExists( "tags" ) ) {
			variables.page.tags = []
		}
		if ( !variables.page.keyExists( "icon" ) ) {
			variables.page.icon = ""
		}
		if ( !variables.page.keyExists( "iconHtml" ) ) {
			variables.page.iconHtml = ""
		}
		if ( !variables.page.keyExists( "summary" ) ) {
			variables.page.summary = ""
		}
		if ( !variables.page.keyExists( "ogImage" ) ) {
			variables.page.ogImage = ""
		}
		if ( !variables.page.keyExists( "markdownUrl" ) ) {
			variables.page.markdownUrl = ""
		}
		if ( !variables.page.keyExists( "isFallbackContent" ) ) {
			variables.page.isFallbackContent = false
		}
		if ( !variables.page.keyExists( "urlPath" ) ) {
			variables.page.urlPath = ""
		}
		if ( !variables.page.keyExists( "canonicalUrl" ) ) {
			variables.page.canonicalUrl = ""
		}
		variables.nav = arguments.nav
		variables.siteConfig = arguments.config
		// `include` treats a leading "/" as relative to a registered
		// mapping, not the real OS filesystem. Resolving both of these
		// here (rather than at each individual `<bx:include template="...">`
		// call site inside layout.bxm/page.bxm/icons.bxm/etc.) fixes every
		// nested theme include across all built-in themes with zero
		// per-theme changes, since these two variables are the only thing
		// any theme ever builds an include path from.
		//
		// arguments.themeDir is either this module's own builtInThemesDir()
		// - already a virtual `/bxmodules/bxsites/...` path (BoxLang's own
		// automatic per-module mapping - see that function's own docblock)
		// and used as-is - or a real OS absolute path under a project's
		// own theme/ override, which toVirtualPath() below turns into a
		// working virtual path instead. moduleAssetsDir is always this
		// module's own bundled asset folder, so it's always the former
		// case.
		variables.themeDir = arguments.themeDir.left( 11 ) == "/bxmodules/"
			? arguments.themeDir
			: toVirtualPath( arguments.themeDir )
		variables.basePath = len( trim( arguments.basePath ) ) ? arguments.basePath : "/"
		variables.moduleAssetsDir = computeModuleAssetsDir()
		variables.versions = arguments.versions
		variables.currentVersion = arguments.currentVersion
		variables.locales = arguments.locales
		variables.currentLocale = arguments.currentLocale
		variables.currentLocaleDir = listFindNoCase( "ltr,rtl", arguments.currentLocaleDir ) ? arguments.currentLocaleDir : "ltr"
		variables.strings = variables.stringsResolver.resolve( variables.currentLocale, arguments.config.i18n ?: { "defaultLocale" : { "code" : "en", "label" : "English" }, "locales" : [] } )

		// Binds each loaded function (FunctionsLoader.bx - `$`-prefixed magic
		// functions and their own private, non-`$` helpers alike) directly
		// into this instance's own `variables` scope, so `layout.bxm`/`page.bxm`
		// (or a project's own `theme/` override) can call `$name(...)` bare,
		// exactly like they already read `variables.page`/`variables.siteConfig`.
		// Safe to overwrite unconditionally - FunctionsLoader.load() itself
		// already rejects a function name that collides with one of this
		// method's own reserved context keys (`page`/`nav`/`siteConfig`/etc. -
		// see its own `reservedNames`), so nothing loaded here can ever
		// silently shadow real page/site context.
		for ( var fnName in arguments.functions ) {
			variables[ fnName ] = arguments.functions[ fnName ]
		}

		// variables.themeDir was already turned into a working virtual
		// path above (either "/bxmodules/bxsites/..." or "/bxApp/..."),
		// so this resolves through one of BoxLang's own module mapping or
		// the one ModuleConfig.bx's onLoad() registers.
		var html = ""
		bx:savecontent variable="html" {
			include variables.themeDir & "/layout.bxm"
		}
		return html
	}

}
