/**
 * Wraps every rendered `<table>` in a `.bxsites-table-wrap` div so a theme
 * can give it horizontal scroll and a sticky header via plain CSS -
 * `overflow-x` alone on the `<table>` element itself doesn't work for a
 * sticky `<thead>` (the table becomes its own scroll container, and since
 * its height always exactly fits its own content, there's never a viewport
 * for the header to stick within) - it needs a separate wrapper element,
 * which bx-markdown/Flexmark's `tableOptions` has no way to emit (see
 * docs/guides/markdown.md#tables). This runs as a post-process pass after
 * `Markdown()` has already turned pipe-table syntax into real `<table>`
 * markup - same shape as CodeAnnotationProcessor.bx's `applyToHtml()`.
 *
 * Any table with `FILTER_ROW_THRESHOLD` or more data rows also gets a live
 * Alpine-powered filter input injected above it, in the same spirit as
 * BlogBuilder.bx's author-posts search - here driven by each row's own
 * `$el.textContent` rather than a precomputed attribute, since a table row
 * spans several cells worth of unpredictable content.
 */
class {

	variables.FILTER_ROW_THRESHOLD = 10

	/**
	 * Wraps each top-level `<table>...</table>` in the given HTML with a
	 * `<div class="bxsites-table-wrap">`. Depth-aware so a table nested
	 * inside another one (raw HTML in a cell - rare, but markdown does let
	 * raw block HTML pass through untouched) only gets one wrapper, around
	 * the outermost table.
	 */
	public string function wrap( required string html ) {
		var result = ""
		var pos = 1
		var totalLen = len( arguments.html )

		while ( pos <= totalLen ) {
			var tableStart = findNoCase( "<table", arguments.html, pos )
			if ( !tableStart ) {
				result &= mid( arguments.html, pos, totalLen - pos + 1 )
				break
			}

			result &= mid( arguments.html, pos, tableStart - pos )

			var closeEnd = findMatchingTableClose( arguments.html, tableStart )
			if ( !closeEnd ) {
				// No matching close tag (malformed/truncated HTML) - leave the
				// rest untouched rather than guess.
				result &= mid( arguments.html, tableStart, totalLen - tableStart + 1 )
				pos = totalLen + 1
				break
			}

			var tableHtml = mid( arguments.html, tableStart, closeEnd - tableStart + 1 )
			var tagged = tagFilterableRows( tableHtml )

			if ( tagged.filtered ) {
				result &= '<div class="bxsites-table-wrap" x-data="{ q: '''' }"><input type="search" class="bxsites-table-filter" x-model="q" placeholder="Filter table..." aria-label="Filter table">' & tagged.html & '</div>'
			} else {
				result &= '<div class="bxsites-table-wrap">' & tagged.html & '</div>'
			}

			pos = closeEnd + 1
		}

		return result
	}

	/**
	 * Counts the data rows in a single `<table>...</table>` (every `<tr>`
	 * after the `</thead>`, or every `<tr>` at all when there's no `<thead>`
	 * to exclude). When that count meets `FILTER_ROW_THRESHOLD`, tags each
	 * of those `<tr>` elements with an `x-show` bound to a shared Alpine `q`
	 * variable (owned by the wrapping div - see `wrap()`) so the filter
	 * input can hide non-matching rows client-side.
	 */
	private struct function tagFilterableRows( required string tableHtml ) {
		var headEnd = findNoCase( "</thead>", arguments.tableHtml )
		var bodyStart = headEnd ? headEnd + 8 : 1
		var head = headEnd ? left( arguments.tableHtml, headEnd + 7 ) : ""
		var body = mid( arguments.tableHtml, bodyStart, len( arguments.tableHtml ) - bodyStart + 1 )
		var rowCount = reMatchNoCase( "<tr(\s|>)", body ).len()

		if ( rowCount < variables.FILTER_ROW_THRESHOLD ) {
			return { html : arguments.tableHtml, filtered : false }
		}

		var taggedBody = reReplaceNoCase(
			body,
			"<tr(\s|>)",
			'<tr x-show="!q || $el.textContent.toLowerCase().includes( q.toLowerCase() )"\1',
			"all"
		)

		return { html : head & taggedBody, filtered : true }
	}

	/**
	 * Returns the string index of the last character of the `</table>` that
	 * matches the `<table` starting at `tableStart`, tracking nesting depth
	 * so an inner table's close tag isn't mistaken for the outer one's.
	 */
	private numeric function findMatchingTableClose( required string html, required numeric tableStart ) {
		var depth = 1
		var scanPos = arguments.tableStart + 6

		while ( depth > 0 ) {
			var nextOpen = findNoCase( "<table", arguments.html, scanPos )
			var nextClose = findNoCase( "</table>", arguments.html, scanPos )

			if ( !nextClose ) {
				return 0
			}

			if ( nextOpen && nextOpen < nextClose ) {
				depth++
				scanPos = nextOpen + 6
			} else {
				depth--
				scanPos = nextClose + 8
			}
		}

		return scanPos - 1
	}

}
