/**
 * Generates responsive image variants (resized + WebP) via bx-image
 * (the `image` BoxLang module - required alongside bx-markdown/bx-esapi,
 * see box.json), for every eligible raster image under a project's
 * `docs/assets/**`. Raster only - `.png`/`.jpg`/`.jpeg`; SVG (already
 * resolution-independent) and GIF (bx-image's resize path is
 * frame-unaware - resizing an animated GIF would flatten it to one frame)
 * are deliberately left out, copied through unprocessed by
 * BuildPipeline.bx's own existing `copyAssets()` step exactly as before -
 * see docs/guides/images.md's "What doesn't get resized" section.
 *
 * A source image is never upscaled - a configured width at or above the
 * image's own width is skipped for that image. `formats: ["webp"]` still
 * gets one full-size WebP re-encode even for an image with no smaller
 * configured width at all, so a small image benefits from WebP's own
 * compression without needing a responsive breakpoint to qualify.
 *
 * Every generated variant is cached on disk under `<projectRoot>/.cache/images/<hash>/`,
 * keyed by the *source* file's own content hash - `bxDocs clean` already
 * removes the whole `.cache/` directory, so this needs no cleanup logic of
 * its own. The cache is what makes re-running this once per doc tree
 * (BuildPipeline.bx calls copyAssets() once per version/locale, all
 * sharing the same `docs/assets/`) cheap after the first tree: later
 * trees just copy already-generated bytes instead of asking bx-image to
 * decode/resize/encode the same source image again - and the same cache
 * persists across `bxDocs serve` rebuilds, so saving an unrelated page
 * doesn't re-process every screenshot in the project.
 */
class {

	variables.fingerprinter = new "models.build.AssetFingerprinter@bxdocs"()
	variables.eligiblePattern = createObject( "java", "java.util.regex.Pattern" ).compile( "(?i)\.(png|jpe?g)$" )

	/**
	 * Walks `docsAssetsDir` for eligible images and builds a manifest of
	 * their responsive variants - generating into (or reusing from)
	 * `cacheDir` as needed. A no-op (empty manifest) when
	 * `imagesConfig.enabled` is `false`, or `docsAssetsDir` doesn't exist.
	 *
	 * @docsAssetsDir Absolute path to the project's `docs/assets/` directory
	 * @imagesConfig bxdocs.json's own `assets.images` struct (`enabled`, `widths`, `formats`)
	 * @cacheDir Absolute path to this project's own `.cache/images/` directory
	 *
	 * @return Struct keyed by docs-relative asset path (e.g. `"assets/screenshot.png"`), each `{ key, width, height, originalVariants: [ { width, format, fileName } ], webpVariants: [ ... ], cacheDir }`
	 */
	struct function buildManifest( required string docsAssetsDir, required struct imagesConfig, required string cacheDir ) {
		var manifest = {}

		if ( !arguments.imagesConfig.enabled || !directoryExists( arguments.docsAssetsDir ) ) {
			return manifest
		}

		var dir = arguments.docsAssetsDir.reReplace( "[\/]+$", "" )
		var files = directoryList( dir, true, "path" )
			.filter( path => variables.eligiblePattern.matcher( path ).find() )

		for ( var filePath in files ) {
			var key = "assets/" & filePath.reReplace( dir, "", "one" ).reReplace( "^[\/]", "" )
			manifest[ key ] = buildEntry( filePath, arguments.imagesConfig, arguments.cacheDir )
		}

		return manifest
	}

	/**
	 * Copies every manifest entry's already-generated (cached) variant files
	 * into one doc tree's own `site.../assets/` output - called once per
	 * tree by BuildPipeline.bx's `copyAssets()`, same as the plain
	 * `docs/assets/**` directoryCopy it sits alongside.
	 *
	 * @manifest buildManifest()'s own output
	 * @outputAssetsDir Absolute path to this tree's own `site.../assets/` directory (already exists)
	 */
	void function copyToOutput( required struct manifest, required string outputAssetsDir ) {
		for ( var key in arguments.manifest ) {
			var entry = arguments.manifest[ key ]
			var relativeKey = key.reReplace( "^assets[\/]", "" )
			var relativeDir = directoryOf( relativeKey )
			var destDir = arguments.outputAssetsDir & ( len( relativeDir ) ? "/" & relativeDir : "" )
			directoryCreate( destDir, true, true )

			for ( var variant in entry.originalVariants ) {
				fileCopy( entry.cacheDir & "/" & variant.fileName, destDir & "/" & variant.fileName )
			}
			for ( var variant in entry.webpVariants ) {
				fileCopy( entry.cacheDir & "/" & variant.fileName, destDir & "/" & variant.fileName )
			}
		}
	}

	/**
	 * Builds one image's own manifest entry - probes its real dimensions
	 * (so configured widths at or above it can be skipped), then generates
	 * (or reuses) every qualifying width x format variant.
	 *
	 * @filePath Absolute path to the source image
	 * @imagesConfig bxdocs.json's own `assets.images` struct
	 * @cacheDir Absolute path to this project's own `.cache/images/` directory
	 */
	private struct function buildEntry( required string filePath, required struct imagesConfig, required string cacheDir ) {
		var hash8 = variables.fingerprinter.hashOf( fileReadBinary( arguments.filePath ) )
		var baseName = getFileFromPath( arguments.filePath ).reReplace( "\.[^.]*$", "" )
		var originalExt = arguments.filePath.reReplace( "^.*\.", "" )

		var probe = imageRead( arguments.filePath )
		var originalWidth = probe.getWidth()
		var originalHeight = probe.getHeight()

		var qualifyingWidths = arguments.imagesConfig.widths.filter( w => w < originalWidth )

		var entryCacheDir = arguments.cacheDir & "/" & hash8
		directoryCreate( entryCacheDir, true, true )

		var originalVariants = []
		if ( containsNoCase( arguments.imagesConfig.formats, "original" ) ) {
			for ( var w in qualifyingWidths ) {
				originalVariants.append( generateVariant( arguments.filePath, entryCacheDir, baseName, w, originalExt, hash8 ) )
			}
		}

		var webpVariants = []
		if ( containsNoCase( arguments.imagesConfig.formats, "webp" ) ) {
			var webpWidths = duplicate( qualifyingWidths )
			webpWidths.append( originalWidth )
			for ( var w in webpWidths ) {
				webpVariants.append( generateVariant( arguments.filePath, entryCacheDir, baseName, w, "webp", hash8 ) )
			}
		}

		return {
			width            : originalWidth,
			height           : originalHeight,
			originalVariants : originalVariants,
			webpVariants     : webpVariants,
			cacheDir         : entryCacheDir
		}
	}

	/**
	 * Generates one width x format variant into `cacheDir`, unless a file
	 * already sits at that exact cached path (same source hash + width +
	 * format always produces the same bytes, so an existing file is
	 * reused rather than re-decoded/re-encoded).
	 *
	 * @sourcePath Absolute path to the original source image
	 * @cacheDir Absolute path to this source image's own cache subfolder (`.cache/images/<hash8>/`)
	 * @baseName The source file's own name, without extension
	 * @width Target width in pixels - `imageRead().scaleToFit(width)` fits to this, maintaining aspect ratio
	 * @format Output format - the source's own extension, or `"webp"`
	 * @hash8 The source file's own content-hash, folded into the variant's filename for a stable, cache-friendly name
	 */
	private struct function generateVariant( required string sourcePath, required string cacheDir, required string baseName, required numeric width, required string format, required string hash8 ) {
		var fileName = arguments.baseName & "-" & arguments.width & "w." & arguments.hash8 & "." & lCase( arguments.format )
		var cachedPath = arguments.cacheDir & "/" & fileName

		if ( !fileExists( cachedPath ) ) {
			imageRead( arguments.sourcePath ).scaleToFit( arguments.width ).write( cachedPath )
		}

		return { width : arguments.width, format : lCase( arguments.format ), fileName : fileName }
	}

	/**
	 * @relativePath A docs-relative path with no leading slash, e.g. "sub/dir/screenshot.png"
	 *
	 * @return Its directory, e.g. "sub/dir" - "" for a root-level file
	 */
	private string function directoryOf( required string relativePath ) {
		var segments = listToArray( arguments.relativePath, "/", true )
		segments.deleteAt( segments.len() )
		return segments.toList( "/" )
	}

	/**
	 * Case-insensitive array membership check - CFML/BoxLang array methods
	 * vary on whether a bare `.findNoCase()` member exists across engines,
	 * so this stays a plain loop rather than relying on one.
	 *
	 * @list Array of strings
	 * @value Value to look for, case-insensitively
	 */
	private boolean function containsNoCase( required array list, required string value ) {
		for ( var item in arguments.list ) {
			if ( compareNoCase( item, arguments.value ) == 0 ) {
				return true
			}
		}
		return false
	}

}
