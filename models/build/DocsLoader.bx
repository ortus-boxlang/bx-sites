/**
 * Walks a project's `docs/` directory and loads every `.md` file into a
 * page struct: frontmatter applied, a pretty-URL output path computed, and
 * `docs/assets/**` excluded (that tree is copied verbatim by the asset
 * pipeline instead - module spec section 5, step 1).
 */
class {

	variables.frontmatterParser = new "models.build.FrontmatterParser@bxsites"()
	variables.pathRelativizer = new "models.build.PathRelativizer@bxsites"()

	/**
	 * Names always excluded from content, on top of `load()`'s own
	 * caller-provided list (bxsites.yaml's own `exclude` key) - matched the
	 * same way, at the root of whichever tree is being walked. Covers
	 * repo/tooling directories and bx-sites' own config files that could
	 * otherwise get swept up as "content" when a project sets `source: .`
	 * (the whole repo is the docs), and is applied unconditionally in every
	 * source mode since none of these would ever legitimately be a page.
	 * Deliberately does NOT include README.md/LICENSE.md/CHANGELOG.md - a
	 * project is free to have a real content page at that exact path (this
	 * module's own docs/license.md, for one); a project scanning its whole
	 * repo via `source: .` and NOT wanting its root README/LICENSE/CHANGELOG
	 * published opts out of those by name via its own `exclude:` key instead.
	 */
	static.defaultExcludes = [
		".git", ".github", "boxlang_modules", "node_modules", "site", ".theme", ".themes",
		"bxsites.yaml", "bxsites.yml", "bxsites.toml", "bxsites.json", "box.json"
	]

	/**
	 * Walks every `.md` file under `docsDir` (excluding `docs/assets/**`,
	 * `docs/versions/**`, `docs/i18n/**`, `docs/blog/**`, `docs/includes/**`,
	 * `defaultExcludes` above, and `exclude` - each is its own separately
	 * loaded/built tree, not a page at all, or a project's own opt-out, not
	 * part of whichever tree `docsDir` itself is) and loads each into a page
	 * struct. Since every tree (the main tree, each version, each locale, each
	 * version's own locale) calls this with its own root, every exclusion is
	 * applied the same way at every level - `docs/versions/1.0/includes/**`,
	 * `docs/i18n/es/includes/**`, etc. - with no extra code per tree.
	 *
	 * @docsDir Absolute path to the project's docs/ directory
	 * @exclude Extra names to exclude, on top of `defaultExcludes` - bxsites.yaml's own `exclude` array (ConfigLoader.bx), matched the same way (a bare name at the root of `docsDir`, or a `/`-prefixed subtree under it)
	 *
	 * @return Array of page structs, sorted by [order] then [title]: { relativePath, sourcePath, urlPath, title, description, order, hidden, tags, redirectFrom, frontmatter, icon, summary, ogImage, layout, body }
	 */
	array function load( required string docsDir, array exclude = [] ) {
		var dir = variables.pathRelativizer.normalize( arguments.docsDir ).reReplace( "[\/]+$", "" )

		if ( !directoryExists( dir ) ) {
			throw( type = "BxSites.DocsDirNotFound", message = "No docs/ directory found at [#dir#]" )
		}

		var excludeNames = duplicate( static.defaultExcludes ).append( arguments.exclude, true )

		var pages = directoryList( dir, true, "path", "*.md" )
			.filter( path => !variables.pathRelativizer.relativeTo( dir, path ).reFindNoCase( "^assets[\/]" ) )
			.filter( path => !variables.pathRelativizer.relativeTo( dir, path ).reFindNoCase( "^versions[\/]" ) )
			.filter( path => !variables.pathRelativizer.relativeTo( dir, path ).reFindNoCase( "^i18n[\/]" ) )
			.filter( path => !variables.pathRelativizer.relativeTo( dir, path ).reFindNoCase( "^blog[\/]" ) )
			.filter( path => !variables.pathRelativizer.relativeTo( dir, path ).reFindNoCase( "^includes[\/]" ) )
			.filter( path => !isExcluded( variables.pathRelativizer.relativeTo( dir, path ), excludeNames ) )
			.map( path => loadFile( dir, path ) )

		pages.sort( ( a, b ) => {
			if ( a.order != b.order ) {
				return a.order < b.order ? -1 : 1
			}
			return compareNoCase( a.title, b.title )
		} )

		return pages
	}

	/**
	 * Reads one `.md` file, splits its frontmatter from its body, and
	 * derives its `urlPath` (folder-relative, `index.md` mapped to the
	 * folder itself) and title (frontmatter, else the filename).
	 *
	 * @docsDir Absolute path to the project's docs/ directory
	 * @filePath Absolute path to the .md file being loaded
	 */
	private struct function loadFile( required string docsDir, required string filePath ) {
		var relativePath = variables.pathRelativizer.relativeTo( arguments.docsDir, arguments.filePath )
		var parsed = variables.frontmatterParser.parse( fileRead( arguments.filePath ) )
		var fm = parsed.frontmatter

		return {
			relativePath : relativePath,
			sourcePath   : arguments.filePath,
			urlPath      : urlPathFor( relativePath ),
			title        : len( trim( fm.title ?: "" ) ) ? fm.title : titleFromFileName( relativePath ),
			description  : trim( fm.description ?: "" ),
			order        : isNumeric( fm.order ?: "" ) ? val( fm.order ) : 999999,
			hidden       : ( fm.hidden ?: false ) ? true : false,
			showToc      : ( fm.toc ?: true ) ? true : false,
			tags         : isArray( fm.tags ?: "" ) ? fm.tags : [],
			redirectFrom : isArray( fm.redirect_from ?: "" ) ? fm.redirect_from : [],
			// The raw, unfiltered frontmatter struct - every key above is
			// also just a named/defaulted/type-coerced read off this same
			// `fm`, so this is deliberately redundant with them (page.title
			// and page.frontmatter.title both work) rather than exposing
			// only whatever a project named beyond bx-sites' own known
			// keys. What this adds is any *custom* key a project's own
			// frontmatter sets (`product: BoxLang`, `release: 1.0.0`, ...) -
			// otherwise dropped entirely - reachable from markdown as
			// `{{ page.frontmatter.product }}` (BuildPipeline.bx's
			// convertMarkdown() merges `page` into VariablesProcessor.bx's
			// own `{{ dotted.path }}` lookup scope) and bare as
			// `page.frontmatter.product` from a magic function/theme
			// override, the same way `page.title` already is.
			frontmatter  : fm,
			icon         : trim( fm.icon ?: "" ),
			summary      : trim( fm.summary ?: "" ),
			ogImage      : trim( fm.ogImage ?: "" ),
			// Explicit theme body-template override, e.g. `layout: press-release`
			// - ThemeRenderer.renderPage()'s own docblock covers the full
			// resolution chain this feeds into. "" (unset) keeps a page on
			// its default/content-type-inferred body template.
			layout       : trim( fm.layout ?: "" ),
			body         : parsed.body
		}
	}

	/**
	 * True when `relativePath` sits under (or is exactly) one of
	 * `excludeNames` at the root of whichever tree is being walked - each
	 * name matches itself exactly (a root-level file, e.g. `README.md`) or
	 * as a directory prefix (`name/**`), case-insensitively, the same way
	 * the built-in `assets`/`versions`/`i18n`/`blog`/`includes` exclusions
	 * above do.
	 *
	 * @relativePath The docs/-relative path being tested
	 * @excludeNames Bare names (no slashes) to exclude
	 */
	private boolean function isExcluded( required string relativePath, required array excludeNames ) {
		for ( var name in arguments.excludeNames ) {
			var trimmedName = trim( name )
			if ( !len( trimmedName ) ) {
				continue
			}
			if ( arguments.relativePath.reFindNoCase( "^" & reEscape( trimmedName ) & "([\/]|$)" ) ) {
				return true
			}
		}
		return false
	}

	/**
	 * Converts a docs/-relative `.md` path into its pretty-URL output path:
	 * `index.md` stays `index.html` at the same folder depth; any other
	 * `name.md` becomes `name/index.html`, so the page serves at `/name/`.
	 *
	 * @relativePath The docs/-relative source path, e.g. "guides/setup.md"
	 */
	private string function urlPathFor( required string relativePath ) {
		var segments = listToArray( arguments.relativePath, "/" )
		var baseName = segments[ segments.len() ].reReplaceNoCase( "\.md$", "" )
		segments.deleteAt( segments.len() )

		if ( compareNoCase( baseName, "index" ) == 0 ) {
			segments.append( "index.html" )
		} else {
			segments.append( baseName )
			segments.append( "index.html" )
		}

		return segments.toList( "/" )
	}

	/**
	 * Derives a fallback title from a page's filename when frontmatter has none:
	 * `getting-started.md` -> "Getting Started".
	 *
	 * @relativePath The docs/-relative source path
	 */
	private string function titleFromFileName( required string relativePath ) {
		var segments = listToArray( arguments.relativePath, "/" )
		var baseName = segments[ segments.len() ].reReplaceNoCase( "\.md$", "" )
		return baseName
			.reReplace( "[-_]", " ", "all" )
			.reReplace( "\b(\w)", "\U\1", "all" )
	}

}
