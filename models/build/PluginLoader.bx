/**
 * Loads and invokes bx-sites plugins - the "plugin system based on BoxLang
 * modules" from the module spec: a plugin is nothing more than another
 * BoxLang module, installed as a sibling of bx-sites in the same runtime's
 * module registry (`box install` into the project, same as bx-markdown/
 * bx-esapi), that exposes a `models/BxSitesPlugin.bx` class. A project
 * opts a plugin in by BoxLang module name via `bxsites.json`'s `plugins`
 * array (module spec section 4) - installing a module alone never
 * activates it as a bx-sites plugin, same as mkdocs' own explicit
 * `plugins:` list.
 *
 * `discover()` is the only part of this class that touches the real
 * module system (`BoxRuntime.getModuleService()`) - it has no unit test
 * of its own for the same reason MarkdownRenderer.bx doesn't: a plain
 * `testbox run` has no second BoxLang module registered to discover. The
 * `applyOnX()` hook-invocation methods below take an already-resolved
 * `plugins` array instead, so they're fully unit-testable against plain
 * fake plugin objects - see PluginLoaderSpec.bx - and that's also the
 * seam BuildPipelineSpec.bx uses (BuildPipeline.setPlugins()) to test the
 * pipeline's own wiring without a real module.
 *
 * Every hook is optional - a plugin class implements only the ones it
 * cares about, checked with `structKeyExists()` (duck typing, the same
 * looseness BuildPipeline.bx already gives `setMarkdownRenderer()`), and
 * runs in `plugins` array order (bxsites.json's own `plugins` array order):
 *
 *   - `onConfig( config )` -> struct, right after ConfigLoader.load()
 *   - `onPageMarkdown( markdown, page, config )` -> string, before a page's Markdown() call
 *   - `onPageHtml( html, page, config )` -> string, after a page's Markdown() call
 *   - `onNav( nav, config )` -> array, after the nav tree is built
 *   - `onSearchIndex( entries, config )` -> array, after a search-index.json's entries are built, before it's written - entries are `{ title, url, headings, body, tags }`, the same shape SearchIndexer.bx itself produces
 *   - `onSitemap( pages, config )` -> array, right before sitemap.xml and llms.txt are both built from the same accumulated page list - a contributed entry only needs `{ urlPath, title, hidden }`, not DocsLoader's full page shape
 *   - `onBuildComplete( siteDir, config )` -> void, once after everything is written
 */
class {

	/**
	 * Resolves every opted-in plugin module name against the real BoxLang
	 * module registry and instantiates its `models/BxSitesPlugin.bx`.
	 *
	 * @pluginNames bxsites.json's own `plugins` array - BoxLang module names
	 *
	 * @return Array of { name, instance }, in the same order as pluginNames
	 */
	array function discover( required array pluginNames ) {
		var moduleService = getBoxRuntime().getModuleService()
		var plugins = []

		for ( var name in arguments.pluginNames ) {
			if ( !moduleService.hasModule( name ) ) {
				throw(
					type    = "BxSites.PluginNotFound",
					message = "bxsites.json [plugins] references [#name#], but no BoxLang module with that name is installed/activated."
				)
			}

			try {
				var instance = new "models.BxSitesPlugin@#name#"()
			} catch ( any e ) {
				throw(
					type    = "BxSites.InvalidPlugin",
					message = "Module [#name#] is listed in bxsites.json [plugins] but doesn't expose a models/BxSitesPlugin.bx class: #e.message#"
				)
			}

			plugins.append( { name : name, instance : instance } )
		}

		return plugins
	}

	/**
	 * Runs every plugin's `onConfig` hook, in array order, each one's
	 * return value feeding the next.
	 *
	 * @plugins discover()'s own output (or a test-provided equivalent)
	 * @config The site's bxsites.json config, already defaulted/validated
	 */
	struct function applyOnConfig( required array plugins, required struct config ) {
		var result = arguments.config
		for ( var plugin in arguments.plugins ) {
			if ( structKeyExists( plugin.instance, "onConfig" ) ) {
				result = plugin.instance.onConfig( result )
			}
		}
		return result
	}

	/**
	 * Runs every plugin's `onPageMarkdown` hook, in array order, each one's
	 * return value feeding the next.
	 *
	 * @plugins discover()'s own output (or a test-provided equivalent)
	 * @markdown A page's raw markdown body, already past bx-sites' own tabs/math/code-annotation pre-processing
	 * @page The page struct (DocsLoader.load() shape)
	 * @config The site's bxsites.json config
	 */
	string function applyOnPageMarkdown( required array plugins, required string markdown, required struct page, required struct config ) {
		var result = arguments.markdown
		for ( var plugin in arguments.plugins ) {
			if ( structKeyExists( plugin.instance, "onPageMarkdown" ) ) {
				result = plugin.instance.onPageMarkdown( result, arguments.page, arguments.config )
			}
		}
		return result
	}

	/**
	 * Runs every plugin's `onPageHtml` hook, in array order, each one's
	 * return value feeding the next.
	 *
	 * @plugins discover()'s own output (or a test-provided equivalent)
	 * @html A page's rendered HTML, already past bx-sites' own tabs/math/code-annotation post-processing
	 * @page The page struct (DocsLoader.load() shape)
	 * @config The site's bxsites.json config
	 */
	string function applyOnPageHtml( required array plugins, required string html, required struct page, required struct config ) {
		var result = arguments.html
		for ( var plugin in arguments.plugins ) {
			if ( structKeyExists( plugin.instance, "onPageHtml" ) ) {
				result = plugin.instance.onPageHtml( result, arguments.page, arguments.config )
			}
		}
		return result
	}

	/**
	 * Runs every plugin's `onNav` hook, in array order, each one's return
	 * value feeding the next.
	 *
	 * @plugins discover()'s own output (or a test-provided equivalent)
	 * @nav NavBuilder.build()'s own nav tree
	 * @config The site's bxsites.json config
	 */
	array function applyOnNav( required array plugins, required array nav, required struct config ) {
		var result = arguments.nav
		for ( var plugin in arguments.plugins ) {
			if ( structKeyExists( plugin.instance, "onNav" ) ) {
				result = plugin.instance.onNav( result, arguments.config )
			}
		}
		return result
	}

	/**
	 * Runs every plugin's `onSearchIndex` hook, in array order, each one's
	 * return value feeding the next - the same chaining `applyOnNav()` uses.
	 *
	 * @plugins discover()'s own output (or a test-provided equivalent)
	 * @entries SearchIndexer.build()'s own output - an array of `{ title, url, headings, body, tags }`
	 * @config The site's bxsites.json config
	 */
	array function applyOnSearchIndex( required array plugins, required array entries, required struct config ) {
		var result = arguments.entries
		for ( var plugin in arguments.plugins ) {
			if ( structKeyExists( plugin.instance, "onSearchIndex" ) ) {
				result = plugin.instance.onSearchIndex( result, arguments.config )
			}
		}
		return result
	}

	/**
	 * Runs every plugin's `onSitemap` hook, in array order, each one's
	 * return value feeding the next - the same chaining `applyOnNav()` uses.
	 * Fires once, against the site-wide accumulated page list right before
	 * both sitemap.xml and llms.txt are built from it - a contributed entry
	 * flows into both, not just the sitemap.
	 *
	 * @plugins discover()'s own output (or a test-provided equivalent)
	 * @pages The accumulated page list sitemap.xml/llms.txt are about to be built from - only `urlPath`/`title`/`hidden` need be present on a contributed entry
	 * @config The site's bxsites.json config
	 */
	array function applyOnSitemap( required array plugins, required array pages, required struct config ) {
		var result = arguments.pages
		for ( var plugin in arguments.plugins ) {
			if ( structKeyExists( plugin.instance, "onSitemap" ) ) {
				result = plugin.instance.onSitemap( result, arguments.config )
			}
		}
		return result
	}

	/**
	 * Runs every plugin's `onBuildComplete` hook, in array order - a
	 * side-effect-only hook with no return value.
	 *
	 * @plugins discover()'s own output (or a test-provided equivalent)
	 * @siteDir Absolute path to the finished build output directory
	 * @config The site's bxsites.json config
	 */
	void function applyOnBuildComplete( required array plugins, required string siteDir, required struct config ) {
		for ( var plugin in arguments.plugins ) {
			if ( structKeyExists( plugin.instance, "onBuildComplete" ) ) {
				plugin.instance.onBuildComplete( arguments.siteDir, arguments.config )
			}
		}
	}

	/**
	 * The running BoxRuntime singleton, reached the same way MarkdownRenderer.bx does.
	 */
	private any function getBoxRuntime() {
		return createObject( "java", "ortus.boxlang.runtime.BoxRuntime" ).getInstance()
	}

}
