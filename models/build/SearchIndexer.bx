/**
 * Builds the static search index (module spec section 5, step 5; section 7 -
 * "fully static, client-side, matches mkdocs' default (lunr.js)"). This
 * class only builds the JSON payload; BuildPipeline decides whether to call
 * it at all (bxsites.json's `search` flag) and where to write the result.
 */
class {

	variables.entryCache = new "models.build.BuildCache@bxsites"()

	/**
	 * Hidden pages are excluded, matching NavBuilder's own treatment of them
	 * - a page that isn't linked from the nav shouldn't be searchable either.
	 *
	 * @pages Array of page structs with an added `contentHtml` key (BuildPipeline sets this before calling)
	 *
	 * @return Array of { title, url, headings, body, tags } - the mkdocs-style search index entries (module spec section 5, step 5)
	 */
	array function build( required array pages ) {
		return arguments.pages
			.filter( page => !page.hidden )
			.map( page => buildEntry( page ) )
	}

	/**
	 * Builds one page's own search-index entry, reusing a cached entry
	 * (keyed by the page's own `sourcePath` + last-modified time) rather
	 * than re-extracting headings/stripping tags when that source file
	 * hasn't changed since the last time this same SearchIndexer instance
	 * built an entry for it - a plain one-shot `bxSites build`/`search-index`
	 * CLI run constructs a fresh SearchIndexer (and so a fresh, empty
	 * cache) every time, so this only actually saves work across
	 * DevServer.bx's own repeated in-process rebuild() calls, the same
	 * shape BuildPipeline.bx's own page-content cache already uses.
	 *
	 * @page A page struct with `contentHtml`/`sourcePath` already set
	 */
	private struct function buildEntry( required struct page ) {
		var sourcePath = arguments.page.sourcePath ?: ""
		var mtime = len( sourcePath ) ? createObject( "java", "java.io.File" ).init( sourcePath ).lastModified() : 0
		var cached = len( sourcePath ) ? variables.entryCache.get( sourcePath, mtime ) : {}
		if ( !cached.isEmpty() ) {
			return cached
		}

		var entry = {
			title    : arguments.page.title,
			url      : arguments.page.urlPath,
			headings : extractHeadings( arguments.page.contentHtml ),
			body     : truncate( stripTags( arguments.page.contentHtml ), 400 ),
			tags     : arguments.page.tags ?: []
		}

		if ( len( sourcePath ) ) {
			variables.entryCache.set( sourcePath, mtime, entry )
		}

		return entry
	}

	/**
	 * Discards every cached entry - BuildPipeline.bx's own clearDevCache()
	 * calls this alongside its own page-content cache's clear(), for a
	 * change a per-page mtime check can't detect (bxsites.json, a theme
	 * override, a plugin).
	 */
	void function clearCache() {
		variables.entryCache.clear()
	}

	/**
	 * Pulls every `h1`-`h6` heading's plain text out of a page's rendered HTML.
	 *
	 * @html Rendered page HTML (already-converted markdown)
	 *
	 * @return Array of heading text strings, in document order
	 */
	private array function extractHeadings( required string html ) {
		return reMatch( "<h[1-6][^>]*>.*?</h[1-6]>", arguments.html )
			.map( match => trim( stripTags( match ) ) )
			.filter( text => len( text ) )
	}

	/**
	 * Strips HTML tags and decodes the handful of entities bx-markdown's
	 * output commonly contains, collapsing whitespace down to single spaces.
	 *
	 * @html Rendered HTML
	 */
	private string function stripTags( required string html ) {
		var text = arguments.html.reReplace( "<[^>]+>", " ", "all" )
		text = text.replace( "&nbsp;", " ", "all" )
		text = text.replace( "&amp;", "&", "all" )
		text = text.replace( "&lt;", "<", "all" )
		text = text.replace( "&gt;", ">", "all" )
		text = text.replace( "&quot;", '"', "all" )
		text = text.replace( "&##39;", "'", "all" )
		return trim( text.reReplace( "[ \t\r\n]+", " ", "all" ) )
	}

	/**
	 * Cuts `text` to `maxLength`, appending an ellipsis when it was
	 * actually truncated.
	 *
	 * @text Plain text to truncate
	 * @maxLength Maximum length before truncating with an ellipsis
	 */
	private string function truncate( required string text, required numeric maxLength ) {
		if ( len( arguments.text ) <= arguments.maxLength ) {
			return arguments.text
		}
		return left( arguments.text, arguments.maxLength ) & "…"
	}

}
