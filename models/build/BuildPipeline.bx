/**
 * Orchestrates the full `build` verb end to end (module spec section 5):
 * load config -> load docs -> build nav -> convert markdown -> render
 * through the theme -> write site/ -> build the search index -> copy assets.
 * Also backs the standalone `search-index` verb (buildSearchIndex()).
 */
class {

	variables.configLoader     = new "models.config.ConfigLoader@bxdocs"()
	variables.docsLoader       = new "models.build.DocsLoader@bxdocs"()
	variables.navBuilder       = new "models.build.NavBuilder@bxdocs"()
	variables.themeRenderer    = new "models.build.ThemeRenderer@bxdocs"()
	variables.searchIndexer    = new "models.build.SearchIndexer@bxdocs"()
	variables.searchProviderRegistry = new "models.build.SearchProviderRegistry@bxdocs"()
	variables.pagefindIndexer  = new "models.build.PagefindIndexer@bxdocs"()
	variables.tableOfContents  = new "models.build.TableOfContents@bxdocs"()
	variables.baseUrlResolver  = new "models.build.BaseUrlResolver@bxdocs"()
	variables.sitemapGenerator = new "models.build.SitemapGenerator@bxdocs"()
	variables.llmsTxtGenerator = new "models.build.LlmsTxtGenerator@bxdocs"()
	variables.markdownRenderer = new "models.build.MarkdownRenderer@bxdocs"()
	variables.gitRevisionDate  = new "models.build.GitRevisionDate@bxdocs"()
	variables.versionsDiscoverer = new "models.build.VersionsDiscoverer@bxdocs"()
	variables.localesDiscoverer = new "models.build.LocalesDiscoverer@bxdocs"()
	variables.tagsIndexBuilder = new "models.build.TagsIndexBuilder@bxdocs"()
	variables.socialCardGenerator = new "models.build.SocialCardGenerator@bxdocs"()
	variables.tabsProcessor = new "models.build.TabsProcessor@bxdocs"()
	variables.mathProtector = new "models.build.MathProtector@bxdocs"()
	variables.codeAnnotationProcessor = new "models.build.CodeAnnotationProcessor@bxdocs"()
	variables.tryBoxLangProcessor = new "models.build.TryBoxLangProcessor@bxdocs"()
	variables.markdownLinkResolver = new "models.build.MarkdownLinkResolver@bxdocs"()
	variables.markdownPublisher = new "models.build.MarkdownPublisher@bxdocs"()
	variables.includeProcessor = new "models.build.IncludeProcessor@bxdocs"()
	variables.directiveBlockProcessor = new "models.build.DirectiveBlockProcessor@bxdocs"()
	variables.pageLinkResolver = new "models.build.PageLinkResolver@bxdocs"()
	variables.updatesFeedGenerator = new "models.build.UpdatesFeedGenerator@bxdocs"()
	variables.pluginLoader = new "models.build.PluginLoader@bxdocs"()
	variables.iconResolver = new "models.build.IconResolver@bxdocs"()
	variables.imageVariantGenerator = new "models.build.ImageVariantGenerator@bxdocs"()
	variables.responsiveImageProcessor = new "models.build.ResponsiveImageProcessor@bxdocs"()
	variables.assetBundler = new "models.build.AssetBundler@bxdocs"()
	variables.blogDiscoverer = new "models.build.BlogDiscoverer@bxdocs"()
	variables.blogAuthorsLoader = new "models.build.BlogAuthorsLoader@bxdocs"()
	variables.blogBuilder = new "models.build.BlogBuilder@bxdocs"()
	variables.blogFeedGenerator = new "models.build.BlogFeedGenerator@bxdocs"()
	variables.pluginsOverride = []
	variables.hasPluginsOverride = false

	/**
	 * Swaps in a fake/test markdown renderer. The real one (MarkdownRenderer.bx)
	 * depends on the bx-markdown module being activated, which this
	 * pipeline's own unit tests don't have - see MarkdownRenderer.bx's
	 * docblock for why that dependency is kept behind this seam.
	 *
	 * @renderer Any object exposing `toHtml( markdown, options = {} )`
	 */
	void function setMarkdownRenderer( required any renderer ) {
		variables.markdownRenderer = arguments.renderer
	}

	/**
	 * Swaps in a fake/test pagefind indexer. The real one (PagefindIndexer.bx)
	 * shells out to the external `pagefind` CLI, which this pipeline's own
	 * unit tests can't assume is installed - see PagefindIndexer.bx's own
	 * docblock for why it fails loud rather than degrading silently.
	 *
	 * @indexer Any object exposing `index( siteDir, bin = "pagefind", options = [] )`
	 */
	void function setPagefindIndexer( required any indexer ) {
		variables.pagefindIndexer = arguments.indexer
	}

	/**
	 * Swaps in a fake/test image variant generator. The real one
	 * (ImageVariantGenerator.bx) calls bx-image's own `imageRead()`/
	 * `.scaleToFit()`/`.write()`, which this pipeline's own unit tests
	 * can't assume is installed - same reasoning as setMarkdownRenderer()/
	 * setPagefindIndexer() above.
	 *
	 * @generator Any object exposing `buildManifest( docsAssetsDir, imagesConfig, cacheDir )` and `copyToOutput( manifest, outputAssetsDir )`
	 */
	void function setImageVariantGenerator( required any generator ) {
		variables.imageVariantGenerator = arguments.generator
	}

	/**
	 * Bypasses PluginLoader.discover() (real BoxLang module lookup - no
	 * unit test of its own, see PluginLoader.bx's docblock) with an
	 * already-resolved plugins list, so BuildPipelineSpec.bx can test the
	 * pipeline's own onConfig/onPageMarkdown/onPageHtml/onNav/onBuildComplete
	 * wiring against plain fake plugin objects without a real second
	 * BoxLang module registered.
	 *
	 * @plugins PluginLoader.discover()'s own output shape: array of { name, instance }
	 */
	void function setPlugins( required array plugins ) {
		variables.pluginsOverride = arguments.plugins
		variables.hasPluginsOverride = true
	}

	/**
	 * Runs the full `build` verb end to end: load config -> resolve plugins
	 * -> render the main doc tree, every `docs/versions/<name>/` tree (plus,
	 * by the same by-convention rule one level down, every
	 * `docs/versions/<name>/i18n/<code>/` tree composed onto it), and every
	 * top-level `docs/i18n/<code>/` tree -> copy assets -> write
	 * 404/tags/sitemap.xml/llms.txt -> fire `onBuildComplete`.
	 *
	 * Versions and locales compose one level: a `docs/versions/<name>/`
	 * tree's own default-locale render shows a language switcher too, listing
	 * only the locales that version itself has translations for
	 * (`docs/versions/<name>/i18n/<code>/`, discovered the same
	 * by-convention way as the top-level `docs/i18n/<code>/` - see
	 * LocalesDiscoverer.bx) - a version with no `i18n/` subfolder of its own
	 * renders exactly as before, no switcher shown. Both switchers always
	 * link to a tree's own homepage (never attempt to land on "the same page
	 * in the other tree" - see renderVersionSwitcher()/renderLocaleDropdown()
	 * in a theme's own layout.bxm), and each stays scoped to the axis it
	 * belongs to: the version switcher on a
	 * `versions/2.0/es/` page still lists every version (switching version
	 * always drops back to that version's own default locale, never
	 * assumes the target version has the same translation), while the
	 * locale switcher there only lists locales *that version itself*
	 * translates (switching locale always stays on the current version).
	 *
	 * @projectRoot Absolute path to the project root
	 * @includeDrafts Include blog posts whose frontmatter sets `draft: true` - `false` (the default) for a real build; DevServer.bx's own `bxDocs serve` passes `true` so a draft can be previewed locally (BlogBuilder.bx stamps a visible "🚧 Draft" badge on one whenever this is on) without it ever leaking into an actual `bxDocs build`
	 *
	 * @return { siteDir, pageCount }
	 */
	struct function build( required string projectRoot, boolean includeDrafts = false ) {
		var root = normalizeRoot( arguments.projectRoot )
		var config = variables.configLoader.load( root )
		var plugins = resolvePlugins( config )
		config = variables.pluginLoader.applyOnConfig( plugins, config )
		var assetPipeline = applyAssetPipeline( config, root )
		config = assetPipeline.config
		var imageManifest = variables.imageVariantGenerator.buildManifest( root & "/docs/assets", config.assets.images, root & "/.cache/images", config.assets.fingerprint )
		var urls = variables.baseUrlResolver.resolve( config.baseURL )
		var themeDir = variables.themeRenderer.resolveThemeDir( config.theme.name, root )
		var siteDir = root & "/site"

		if ( directoryExists( siteDir ) ) {
			directoryDelete( siteDir, true )
		}
		directoryCreate( siteDir, true, true )

		var versionNames = variables.versionsDiscoverer.discover( root & "/docs" )
		var versions = buildVersionsList( versionNames, urls.basePath )

		var localeNames = variables.localesDiscoverer.discover( root & "/docs" )
		var locales = buildLocalesList( localeNames, config.i18n, urls.basePath )
		var defaultLocaleCode = config.i18n.defaultLocale.code
		var defaultLocaleDir = config.i18n.defaultLocale.dir ?: "ltr"

		var navConfig = resolveExplicitNav( root & "/docs", config.nav )
		var mainPages = variables.docsLoader.load( root & "/docs" )
		// Loaded (frontmatter parsed, not yet markdown-converted) up front,
		// purely so the main tree's own nav can carry a "Blog" entry from
		// its very first render - see renderDocTree()'s own blogNavUrl
		// docblock. The full post-processing/rendering pass happens after
		// the main tree (and every version/locale tree) is done, alongside
		// the tags page/sitemap/llms.txt/search index, all of which fold
		// blog posts in too.
		var blogPosts = variables.blogDiscoverer.load( root & "/docs", arguments.includeDrafts )
		var blogNavUrl = blogPosts.len() ? "blog/index.html" : ""
		var mainResult = renderDocTree( mainPages, root & "/docs", config, themeDir, siteDir, urls.basePath, root, versions, "Latest", "", plugins, urls.absolute, imageManifest, navConfig, locales, defaultLocaleCode, defaultLocaleDir, blogNavUrl )
		var allPages = duplicate( mainResult.pages )
		copyAssets( root, themeDir, siteDir, config.theme.name, searchNeedsLocalIndex( config ), config.mermaid, config.math, imageManifest, assetPipeline.cssBundle, assetPipeline.jsBundle )

		for ( var versionName in versionNames ) {
			var versionDocsDir = root & "/docs/versions/" & versionName
			var versionOutputDir = siteDir & "/versions/" & versionName
			var versionBasePath = urls.basePath & "versions/" & versionName & "/"
			var versionPages = variables.docsLoader.load( versionDocsDir )

			var versionLocaleNames = variables.localesDiscoverer.discover( versionDocsDir )
			var versionLocales = buildLocalesList( versionLocaleNames, config.i18n, versionBasePath )

			var versionResult = renderDocTree(
				versionPages,
				versionDocsDir,
				config,
				themeDir,
				versionOutputDir,
				versionBasePath,
				root,
				versions,
				versionName,
				"versions/" & versionName & "/",
				plugins,
				urls.absolute,
				imageManifest,
				[],
				versionLocales,
				defaultLocaleCode,
				defaultLocaleDir
			)
			allPages.append( prefixPageUrls( versionResult.pages, "versions/" & versionName & "/" ), true )
			copyAssets( root, themeDir, versionOutputDir, config.theme.name, searchNeedsLocalIndex( config ), config.mermaid, config.math, imageManifest, assetPipeline.cssBundle, assetPipeline.jsBundle )

			for ( var versionLocale in versionLocales ) {
				if ( versionLocale.code == defaultLocaleCode ) {
					continue
				}
				var versionLocaleOutputDir = versionOutputDir & "/" & versionLocale.code
				var versionLocalePages = variables.docsLoader.load( versionDocsDir & "/i18n/" & versionLocale.code )
				var mergedVersionLocalePages = mergeLocalePages( versionPages, versionLocalePages, versionLocale.code, "versions/" & versionName & "/" )
				var versionLocaleResult = renderDocTree(
					mergedVersionLocalePages,
					versionDocsDir,
					config,
					themeDir,
					versionLocaleOutputDir,
					versionBasePath & versionLocale.code & "/",
					root,
					versions,
					versionName,
					"",
					plugins,
					urls.absolute,
					imageManifest,
					[],
					versionLocales,
					versionLocale.code,
					versionLocale.dir
				)
				allPages.append( prefixPageUrls( versionLocaleResult.pages, "versions/" & versionName & "/" & versionLocale.code & "/" ), true )
				copyAssets( root, themeDir, versionLocaleOutputDir, config.theme.name, searchNeedsLocalIndex( config ), config.mermaid, config.math, imageManifest, assetPipeline.cssBundle, assetPipeline.jsBundle )
			}
		}

		for ( var locale in locales ) {
			if ( locale.code == defaultLocaleCode ) {
				continue
			}
			var localeOutputDir = siteDir & "/" & locale.code
			var localePages = variables.docsLoader.load( root & "/docs/i18n/" & locale.code )
			var mergedPages = mergeLocalePages( mainPages, localePages, locale.code )
			var localeResult = renderDocTree(
				mergedPages,
				root & "/docs",
				config,
				themeDir,
				localeOutputDir,
				urls.basePath & locale.code & "/",
				root,
				[],
				"Latest",
				"",
				plugins,
				urls.absolute,
				imageManifest,
				navConfig,
				locales,
				locale.code,
				locale.dir
			)
			allPages.append( prefixPageUrls( localeResult.pages, locale.code & "/" ), true )
			copyAssets( root, themeDir, localeOutputDir, config.theme.name, searchNeedsLocalIndex( config ), config.mermaid, config.math, imageManifest, assetPipeline.cssBundle, assetPipeline.jsBundle )
		}

		var tagsPages = mainResult.pages

		if ( blogPosts.len() ) {
			// A featured image (frontmatter `image`) becomes a post's own
			// `og:image` when it hasn't set an explicit `ogImage` of its
			// own - resolved here, before assignOgImages() below, so a real
			// featured image always wins over an auto-generated text card
			// (assignOgImages() only generates one when `page.ogImage` is
			// still empty at the point it runs).
			for ( var post in blogPosts ) {
				if ( !len( trim( post.ogImage ) ) ) {
					post.ogImage = post.image
				}
			}

			convertMarkdown( blogPosts, config, plugins, urls.basePath, root & "/docs", imageManifest )
			assignTableOfContents( blogPosts )
			assignEditAndLastUpdated( blogPosts, config, root, "" )
			assignOgImages( blogPosts, config, siteDir )
			assignMarkdownUrl( blogPosts )
			assignIconHtml( blogPosts, root & "/docs" )

			var blogAuthors = variables.blogAuthorsLoader.load( root & "/docs" )
			var blogResult = variables.blogBuilder.build( blogPosts, blogAuthors, config.blog.postsPerPage, urls.basePath, imageManifest )

			for ( var post in blogResult.posts ) {
				writeRenderedPage( post, mainResult.nav, config, themeDir, siteDir, urls.basePath, versions, locales, defaultLocaleCode, defaultLocaleDir )
			}
			for ( var indexPage in blogResult.indexPages ) {
				writeRenderedPage( indexPage, mainResult.nav, config, themeDir, siteDir, urls.basePath, versions, locales, defaultLocaleCode, defaultLocaleDir )
			}

			variables.markdownPublisher.publish( blogResult.posts, siteDir )

			if ( len( urls.absolute ) && config.blog.feed ) {
				directoryCreate( siteDir & "/blog", true, true )
				fileWrite( siteDir & "/blog/feed.xml", variables.blogFeedGenerator.build( blogResult.posts, config.name, urls.absolute, "", config.blog.feedLimit ) )

				for ( var category in blogResult.categories ) {
					var categoryFeedDir = siteDir & "/blog/category/" & category.slug
					directoryCreate( categoryFeedDir, true, true )
					fileWrite( categoryFeedDir & "/feed.xml", variables.blogFeedGenerator.build( blogResult.posts, config.name, urls.absolute, category.name, config.blog.feedLimit ) )
				}
			}

			tagsPages = duplicate( mainResult.pages )
			tagsPages.append( blogResult.posts, true )

			allPages.append( blogResult.posts, true )
			allPages.append( blogResult.indexPages, true )

			if ( searchNeedsLocalIndex( config ) ) {
				writeSearchIndex( tagsPages, siteDir )
			}
		}

		write404Page( mainResult.nav, config, themeDir, siteDir, urls.basePath, versions, "Latest", locales, defaultLocaleCode )
		writeTagsPage( tagsPages, mainResult.nav, config, themeDir, siteDir, urls.basePath, versions, locales, defaultLocaleCode )

		if ( len( urls.absolute ) ) {
			fileWrite( siteDir & "/sitemap.xml", variables.sitemapGenerator.build( allPages, urls.absolute ) )
		}

		fileWrite( siteDir & "/llms.txt", variables.llmsTxtGenerator.build( allPages, config, urls.absolute, urls.basePath ) )

		if ( config.search && variables.searchProviderRegistry.usesPagefind( config.searchProvider.provider ) ) {
			variables.pagefindIndexer.index( siteDir, config.searchProvider.pagefind.bin, config.searchProvider.pagefind.options )
		}

		variables.pluginLoader.applyOnBuildComplete( plugins, siteDir, config )

		return { siteDir : siteDir, pageCount : mainResult.pages.len() }
	}

	/**
	 * Resolves this build's plugin list - PluginLoader.discover()'s real
	 * BoxLang-module lookup against `config.plugins`, unless setPlugins()
	 * already provided one (test seam - see its own docblock).
	 *
	 * @config The site's bxdocs.json config, already defaulted/validated
	 */
	private array function resolvePlugins( required struct config ) {
		if ( variables.hasPluginsOverride ) {
			return variables.pluginsOverride
		}
		return variables.pluginLoader.discover( arguments.config.plugins )
	}

	/**
	 * Bundles `extraCss`/`extraJs` into one fingerprinted file each
	 * (AssetBundler.bx), when `bxdocs.json`'s `assets.bundle` is on (the
	 * default) - rewriting `config.extraCss`/`extraJs` in place to a
	 * single-entry array pointing at the bundle, so every theme's own
	 * `layout.bxm` (`renderExtraCss()`/`renderExtraJs()`) needs no changes
	 * at all - it already just loops whatever's in those two arrays.
	 * Runs after plugins' own `onConfig` hook, so a plugin that mutates
	 * `extraCss`/`extraJs` still gets bundled; left completely untouched
	 * when `assets.bundle` is off, or when AssetBundler.bx itself declines
	 * to bundle (an external URL in the list, or a named file that
	 * doesn't exist - see its own docblock).
	 *
	 * @config The site's bxdocs.json config, already defaulted/validated and plugin-onConfig'd
	 * @root Absolute path to the project root
	 *
	 * @return `{ config, cssBundle, jsBundle }` - `cssBundle`/`jsBundle` are AssetBundler.bundle()'s own return shape (empty `cachedPath`/`fileName` when nothing was bundled), threaded through to copyAssets() so the actual bundle file lands in every tree's own output alongside the rewritten `config.extraCss`/`extraJs` URL
	 */
	private struct function applyAssetPipeline( required struct config, required string root ) {
		var emptyBundle = { bundleUrl : "", urls : [], cachedPath : "", fileName : "" }

		if ( !arguments.config.assets.bundle ) {
			return { config : arguments.config, cssBundle : emptyBundle, jsBundle : emptyBundle }
		}

		var docsDir = arguments.root & "/docs"
		var cacheDir = arguments.root & "/.cache/assets"

		var cssBundle = variables.assetBundler.bundleCss( arguments.config.extraCss, docsDir, cacheDir, arguments.config.assets.fingerprint )
		arguments.config.extraCss = len( cssBundle.bundleUrl ) ? [ cssBundle.bundleUrl ] : cssBundle.urls

		var jsBundle = variables.assetBundler.bundleJs( arguments.config.extraJs, docsDir, cacheDir, arguments.config.assets.fingerprint )
		arguments.config.extraJs = len( jsBundle.bundleUrl ) ? [ jsBundle.bundleUrl ] : jsBundle.urls

		return { config : arguments.config, cssBundle : cssBundle, jsBundle : jsBundle }
	}

	/**
	 * Renders and writes one self-contained doc tree from an already-loaded
	 * `pages` array - the project's own `docs/` (the "Latest"/default
	 * build), one `docs/versions/<name>/` folder in its own default locale
	 * (VersionsDiscoverer.bx), one top-level `docs/i18n/<code>/` folder
	 * merged against the default tree, or one `docs/versions/<name>/i18n/<code>/`
	 * folder merged against that version's own tree (LocalesDiscoverer.bx,
	 * mergeLocalePages() either way). All four are rendered the exact same
	 * way, just pre-loaded/rooted/output/base-pathed differently by the caller.
	 *
	 * @pages Already-loaded page structs for this tree - DocsLoader.load()'s own output for the main/version trees, or mergeLocalePages()'s output for a locale (top-level or version-nested) tree
	 * @docsDir Absolute path this tree's `custom:` icons and `::: include` sources resolve against - `<root>/docs` for the main tree and every top-level locale tree (translated pages don't need their own duplicated icon/include assets), `<root>/docs/versions/<name>` for a version tree and every locale tree nested under it
	 * @config The site's bxdocs.json config
	 * @themeDir Absolute path to the resolved theme folder
	 * @outputDir Absolute path to write this tree's pages to (`site/`, `site/versions/<name>/`, `site/<localeCode>/`, or `site/versions/<name>/<localeCode>/`)
	 * @basePath Root-relative base path ending with `/`, already namespaced under `versions/<name>/`/`<localeCode>/`/`versions/<name>/<localeCode>/` for a version/locale build
	 * @root Absolute path to the project root - git's working directory for the `lastUpdated` lookup
	 * @versions Version switcher entries as `[ { label, url } ]`, shared by every tree so the switcher is consistent everywhere
	 * @currentVersion Which `versions` entry this tree IS, for the switcher's own "selected" state
	 * @docsRelativePrefix Empty for the main/"Latest" tree or any locale tree (see assignEditAndLastUpdated() - a locale tree's own pages each carry their own `sourceRelativePath` instead, already namespaced under `versions/<name>/` by mergeLocalePages() when nested under a version); `"versions/<name>/"` for a version tree's own default-locale render
	 * @plugins resolvePlugins()'s own output, applied via onNav/onPageMarkdown/onPageHtml
	 * @absoluteUrl The absolute site URL, ending with `/` (BaseUrlResolver's `absolute`), or "" if unknown - gates `::: updates` feed.xml generation, same as sitemap.xml
	 * @imageManifest ImageVariantGenerator.buildManifest()'s own output, built once per build() call (docs/assets/** is identical across every tree) - threaded through to convertMarkdown() for the `<img>` -> `<picture>` rewrite
	 * @navConfig An explicit nav tree (NavBuilder.build()'s own `navConfig` shape) for this doc tree - empty (the default) infers nav from folder structure. Non-empty for the main tree and every top-level locale tree (a locale's nav always mirrors its own default tree's structure/navConfig - see mergeLocalePages()); always empty for a version tree and any locale tree nested under it, which infer their own from that version's own folder structure - see resolveExplicitNav()
	 * @locales Language switcher entries as `[ { code, label, url, dir, flag } ]`, the default locale first - only the locales *this specific tree* has translations for (top-level `docs/i18n/<code>/` for the main tree, `docs/versions/<name>/i18n/<code>/` for a version tree and its own nested locale trees), so switching locale always stays within the current version
	 * @currentLocale Which `locales` entry's `code` this tree IS, for the switcher's own "selected" state - the default locale's own code for the main tree and every version tree's own default-locale render (never "")
	 * @currentLocaleDir `"ltr"`/`"rtl"`, this tree's own locale direction - stamped onto `<html dir="...">`
	 * @blogNavUrl A synthetic "Blog" nav entry's own `url` (`"blog/index.html"`), appended to this tree's own nav when non-empty - "" (the default) adds nothing. Only ever passed for the main tree's own render (build()'s docblock) - a version/locale tree's nav stays exactly as its own folder structure infers, same as it already does for tags (no nav entry at all there either, see writeTagsPage()'s docblock)
	 *
	 * @return { pages, nav }
	 */
	private struct function renderDocTree(
		required array pages,
		required string docsDir,
		required struct config,
		required string themeDir,
		required string outputDir,
		required string basePath,
		required string root,
		required array versions,
		required string currentVersion,
		required string docsRelativePrefix,
		required array plugins,
		required string absoluteUrl,
		required struct imageManifest,
		array navConfig = [],
		array locales = [],
		string currentLocale = "",
		string currentLocaleDir = "ltr",
		string blogNavUrl = ""
	) {
		// Deep-copied rather than aliased - `pages` gets mutated in place
		// below (contentHtml/toc/editUrl/ogImage/... added per tree), and the
		// same page structs can be handed to more than one renderDocTree()
		// call (mainPages feeds both the main tree's own render AND every
		// locale tree's mergeLocalePages() fallback pages) - aliasing would
		// let one tree's own computed fields (an og:image path written under
		// its own outputDir, a basePath-specific contentHtml) leak into another.
		var pages = duplicate( arguments.pages )
		var nav = variables.navBuilder.build( pages, arguments.navConfig )
		nav = variables.pluginLoader.applyOnNav( arguments.plugins, nav, arguments.config )
		// Captured before the synthetic "Blog" nav node (if any) is appended
		// below, so a regular page's own prev/next chain (assignPrevNext(),
		// against this tree's own `pages` only) never jumps into the blog -
		// blog posts get their own chronological prev/next instead
		// (BlogBuilder.bx).
		var flatSequence = variables.navBuilder.flatten( nav )
		// Skip the synthetic node when the nav (folder-inferred, or a
		// custom nav/docs/nav.json) already carries its own entry
		// pointing at the blog index - the author placed/titled/iconed
		// it deliberately, so respect that instead of adding a duplicate.
		// blogNavUrl captured into a local first - an arrow function's own
		// `arguments` scope is its own (item/index/array, per array
		// .filter()'s own callback signature), not renderDocTree()'s, so
		// `arguments.blogNavUrl` inside the closure below would look up a
		// key that was never there.
		var blogNavUrl = arguments.blogNavUrl
		if ( len( blogNavUrl ) && !flatSequence.filter( n => n.url == blogNavUrl ).len() ) {
			nav.append( { title : "Blog", url : blogNavUrl, order : 999999, icon : "phosphor-duotone:newspaper", children : [] } )
		}
		assignNavIconHtml( nav, arguments.docsDir )

		directoryCreate( arguments.outputDir, true, true )

		convertMarkdown( pages, arguments.config, arguments.plugins, arguments.basePath, arguments.docsDir, arguments.imageManifest )
		variables.pageLinkResolver.resolve( pages, arguments.basePath )
		assignTableOfContents( pages )
		assignPrevNext( pages, flatSequence )
		assignBreadcrumbs( pages, nav )
		assignEditAndLastUpdated( pages, arguments.config, arguments.root, arguments.docsRelativePrefix )
		assignOgImages( pages, arguments.config, arguments.outputDir )
		assignMarkdownUrl( pages )
		assignIconHtml( pages, arguments.docsDir )

		for ( var page in pages ) {
			var html = variables.themeRenderer.renderPage(
				page, nav, arguments.config, arguments.themeDir, arguments.basePath, arguments.versions, arguments.currentVersion,
				arguments.locales, arguments.currentLocale, arguments.currentLocaleDir
			)
			var outputPath = arguments.outputDir & "/" & page.urlPath
			directoryCreate( getDirectoryFromPath( outputPath ), true, true )
			fileWrite( outputPath, html )

			if ( len( arguments.absoluteUrl ) && ( page.updatesFeedEntries ?: [] ).len() ) {
				var feedXml = variables.updatesFeedGenerator.build( page.updatesFeedEntries, page, arguments.config.name, arguments.absoluteUrl )
				fileWrite( getDirectoryFromPath( outputPath ) & "/feed.xml", feedXml )
			}
		}

		variables.markdownPublisher.publish( pages, arguments.outputDir )

		if ( searchNeedsLocalIndex( arguments.config ) ) {
			writeSearchIndex( pages, arguments.outputDir )
		}

		return { pages : pages, nav : nav }
	}

	/**
	 * Resolves the main tree's explicit nav override, if any - `bxdocs.json`'s
	 * own `nav` array wins when non-empty (it can get large for a big site,
	 * which is exactly why a project can move it out to its own file
	 * instead); otherwise a `docs/nav.json` file, if present, is used;
	 * otherwise empty, meaning "infer from folder structure" (NavBuilder.bx's
	 * default). Only ever consulted for the main tree - a `docs/versions/<name>/`
	 * tree always uses its own folder structure, even when the main tree has
	 * an explicit nav (see renderDocTree()'s docblock).
	 *
	 * @docsDir Absolute path to the main tree's own `docs/` directory
	 * @configNav The site's bxdocs.json `nav` array (already validated to be an array by ConfigLoader.bx)
	 *
	 * @return NavBuilder.build()'s `navConfig` shape - empty when neither source is set
	 */
	private array function resolveExplicitNav( required string docsDir, required array configNav ) {
		if ( arguments.configNav.len() ) {
			return arguments.configNav
		}

		var navJsonPath = arguments.docsDir & "/nav.json"
		if ( !fileExists( navJsonPath ) ) {
			return []
		}

		var parsed = ""
		try {
			parsed = jsonDeserialize( fileRead( navJsonPath ) )
		} catch ( any e ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "docs/nav.json is not valid JSON: #e.message#"
			)
		}

		if ( !isArray( parsed ) ) {
			throw(
				type    = "BxDocs.InvalidConfig",
				message = "docs/nav.json must contain a JSON array"
			)
		}

		return parsed
	}

	/**
	 * sitemap.xml/llms.txt are built once, from `allPages`, against the
	 * site-wide `siteUrl`/`basePath` - but a version tree's own pages carry
	 * `urlPath`s relative to their own `docs/versions/<name>/` root (e.g.
	 * `"index.html"`), not the site root. This rebuilds `urlPath` with the
	 * `versions/<name>/` prefix folded in, so those two generators produce
	 * correct locations for version pages without needing to know versioning
	 * exists at all.
	 *
	 * @pages A version tree's own pages (unmutated - copies are returned)
	 * @prefix e.g. `"versions/1.0/"`
	 */
	private array function prefixPageUrls( required array pages, required string prefix ) {
		return arguments.pages.map( function( page ) {
			var copy = duplicate( arguments.page )
			copy.urlPath = prefix & copy.urlPath
			return copy
		} )
	}

	/**
	 * Builds the version switcher's own entries - "Latest" (the project's
	 * regular `docs/`) first, then one per discovered `docs/versions/` folder.
	 *
	 * @versionNames VersionsDiscoverer.discover()'s own output, newest first
	 * @basePath The main/"Latest" build's own basePath
	 */
	private array function buildVersionsList( required array versionNames, required string basePath ) {
		var versions = [ { label : "Latest", url : arguments.basePath } ]
		for ( var versionName in arguments.versionNames ) {
			versions.append( { label : versionName, url : arguments.basePath & "versions/" & versionName & "/" } )
		}
		return versions
	}

	/**
	 * Rebuilds just the search index standalone (module spec section 2 -
	 * the `search-index` verb). Still loads docs and converts markdown (the
	 * index needs headings/body text), but never touches theme rendering or
	 * assets - it only ever writes `site/search-index.json`.
	 *
	 * @projectRoot Absolute path to the project root
	 *
	 * @return { skipped (true when bxdocs.json's `search` is off, or its `searchProvider` doesn't use the local index - see SearchProviderRegistry.bx), indexPath, pageCount }
	 */
	struct function buildSearchIndex( required string projectRoot ) {
		var root = normalizeRoot( arguments.projectRoot )
		var config = variables.configLoader.load( root )

		if ( !searchNeedsLocalIndex( config ) ) {
			return { skipped : true, indexPath : "", pageCount : 0 }
		}

		var plugins = resolvePlugins( config )
		config = variables.pluginLoader.applyOnConfig( plugins, config )

		var pages = variables.docsLoader.load( root & "/docs" )
		convertMarkdown( pages, config, plugins, "/", root & "/docs" )

		var siteDir = root & "/site"
		directoryCreate( siteDir, true, true )

		return {
			skipped   : false,
			indexPath : writeSearchIndex( pages, siteDir ),
			pageCount : pages.len()
		}
	}

	/**
	 * Converts every page's raw markdown body to HTML in place (adds a
	 * `contentHtml` key to each page struct), applying bxdocs.json's
	 * markdown passthrough options (bx-markdown's own `enableAdmonition`/
	 * `enableFootnotes`/`enableDefinitionLists`/etc. settings included -
	 * see ConfigLoader.bx's own default for `markdown.enableAdmonition`).
	 *
	 * Also runs three bx-docs-only extensions Flexmark itself has no
	 * concept of - content tabs, math spans, and fenced-code
	 * `hl_lines`/`linenums`/`title` annotations - each as a pre-process
	 * pass (protect the body from `Markdown()`'s own inline parsing) and a
	 * post-process pass (restore/apply against the rendered HTML). See
	 * TabsProcessor.bx/MathProtector.bx/CodeAnnotationProcessor.bx's own
	 * docblocks for why this shape is necessary.
	 *
	 * Also rewrites every relative `.md` link (`[Search](search.md)`,
	 * mkdocs' own file-relative-link convention, GitHub-readable and
	 * built-site-readable alike) into its built pretty-URL equivalent -
	 * see MarkdownLinkResolver.bx.
	 *
	 * Also turns every `` ```tryboxlang `` fenced block into a live
	 * try.boxlang.io editor embed (TryBoxLangProcessor.bx), extracted
	 * first - before every other pre-processor below - so its literal
	 * BoxLang source is never misread as tab/math/annotation/directive
	 * syntax of its own.
	 *
	 * Also splices in any `::: include src="..."` reusable content
	 * (IncludeProcessor.bx, run first - the only one of these that has to
	 * become real page markdown rather than an HTML-wrapped block) and
	 * every GitBook-style `:::` container block - expandable, cards,
	 * columns, stepper, updates, file, embed, page-link
	 * (DirectiveBlockProcessor.bx). A page whose `::: updates` block has
	 * entries gets `page.updatesFeedEntries` set too, consumed by
	 * `renderDocTree()` to write that page's own `feed.xml`.
	 *
	 * @pages Array of page structs from DocsLoader.load()
	 * @config The site's bxdocs.json config
	 * @basePath Root-relative base path ending with `/` - relative `.md` links are re-rooted under it, same as every other internal link the theme renders
	 * @docsDir Absolute path to this tree's own docs root - `::: include` paths are resolved against it
	 * @imageManifest ImageVariantGenerator.buildManifest()'s own output - defaults to empty, which makes the `<img>` -> `<picture>` rewrite (ResponsiveImageProcessor.bx) a no-op; buildSearchIndex() relies on exactly that default, since the search index has no use for it
	 */
	private void function convertMarkdown( required array pages, required struct config, array plugins = [], string basePath = "/", string docsDir = "", struct imageManifest = {} ) {
		for ( var page in arguments.pages ) {
			var markdown = variables.pluginLoader.applyOnPageMarkdown( arguments.plugins, page.body, page, arguments.config )
			markdown = variables.includeProcessor.process( markdown, arguments.docsDir, page.relativePath )

			var tryBoxLangExtracted = variables.tryBoxLangProcessor.extract( markdown )
			var tabsExtracted = variables.tabsProcessor.extract( tryBoxLangExtracted.markdown )
			var mathProtected = variables.mathProtector.protect( tabsExtracted.markdown )
			var codeExtracted = variables.codeAnnotationProcessor.extractAndStrip( mathProtected.markdown )
			var directivesExtracted = variables.directiveBlockProcessor.extract( codeExtracted.markdown )

			var html = variables.markdownRenderer.toHtml( directivesExtracted.markdown, arguments.config.markdown )
			html = variables.directiveBlockProcessor.restore( html, directivesExtracted.blocks, variables.markdownRenderer, arguments.config.markdown )
			html = variables.codeAnnotationProcessor.applyToHtml( html, codeExtracted.annotations )
			html = variables.mathProtector.restore( html, mathProtected.formulas )
			html = variables.tabsProcessor.restore( html, tabsExtracted.groups, variables.markdownRenderer, arguments.config.markdown )
			html = variables.tryBoxLangProcessor.restore( html, tryBoxLangExtracted.embeds )
			html = variables.markdownLinkResolver.resolve( html, page.relativePath, arguments.basePath )
			html = variables.responsiveImageProcessor.resolve( html, page.relativePath, arguments.basePath, arguments.imageManifest )

			html = variables.pluginLoader.applyOnPageHtml( arguments.plugins, html, page, arguments.config )

			page.contentHtml = html
			page.updatesFeedEntries = collectUpdatesFeedEntries( directivesExtracted.blocks, arguments.config.markdown )
		}
	}

	/**
	 * Flattens every top-level `::: updates` block's own `::: update`
	 * children into one feed-ready entry array - a page normally has at
	 * most one `::: updates` block, but more than one is merged rather
	 * than only honoring the first.
	 *
	 * @blocks convertMarkdown()'s own `directivesExtracted.blocks` for one page
	 * @markdownOptions Passthrough options forwarded to the renderer for each entry's own content
	 */
	private array function collectUpdatesFeedEntries( required array blocks, required struct markdownOptions ) {
		var entries = []
		for ( var block in arguments.blocks ) {
			if ( lCase( trim( block.type ) ) != "updates" ) {
				continue
			}
			entries.append( variables.directiveBlockProcessor.extractUpdateEntries( block, variables.markdownRenderer, arguments.markdownOptions ), true )
		}
		return entries
	}

	/**
	 * Adds a `toc` key (the "On this page" list, from TableOfContents.bx) to
	 * every page, built from its already-converted `contentHtml` - unless
	 * the page's own frontmatter set `toc: false` (DocsLoader.bx's
	 * `showToc`), in which case it's left empty, same as a page with fewer
	 * than 2 headings already renders. A landing/hero page is the main use
	 * case - it doesn't want a floating "On this page" box competing with
	 * its own hero content.
	 *
	 * @pages Array of page structs with `contentHtml` already set
	 */
	private void function assignTableOfContents( required array pages ) {
		for ( var page in arguments.pages ) {
			page.toc = ( page.showToc ?: true ) ? variables.tableOfContents.build( page.contentHtml ) : []
		}
	}

	/**
	 * Adds `prevPage`/`nextPage` keys (each `{ title, url }`, or `{ title:"", url:"" }`
	 * when there is none) to every page, based on its position in the nav's
	 * own reading order. A page not present in `flatSequence` (i.e. hidden)
	 * gets no prev/next at all - prev/next is a nav concept, and a hidden
	 * page isn't part of the nav.
	 *
	 * @pages Array of page structs
	 * @flatSequence NavBuilder.flatten()'s own output for this build
	 */
	private void function assignPrevNext( required array pages, required array flatSequence ) {
		var none = { title : "", url : "" }

		for ( var page in arguments.pages ) {
			page.prevPage = none
			page.nextPage = none

			for ( var i = 1; i <= arguments.flatSequence.len(); i++ ) {
				if ( arguments.flatSequence[ i ].url == page.urlPath ) {
					page.prevPage = i > 1 ? arguments.flatSequence[ i - 1 ] : none
					page.nextPage = i < arguments.flatSequence.len() ? arguments.flatSequence[ i + 1 ] : none
					break
				}
			}
		}
	}

	/**
	 * Adds a `breadcrumbs` key (root -> ... -> the page itself, from
	 * NavBuilder.breadcrumbs()) to every page. Empty for a hidden page - it
	 * isn't in the nav to begin with.
	 *
	 * @pages Array of page structs
	 * @nav The site's nav tree, from NavBuilder.build()
	 */
	private void function assignBreadcrumbs( required array pages, required array nav ) {
		for ( var page in arguments.pages ) {
			page.breadcrumbs = variables.navBuilder.breadcrumbs( arguments.nav, page.urlPath )
		}
	}

	/**
	 * Adds `editUrl` (a GitHub-style "edit this page" link, empty when
	 * `bxdocs.json`'s `repo.url`/`repo.editUri` aren't both set) and
	 * `lastUpdated` (an ISO date-time from `git log`, empty unless
	 * `lastUpdated` is turned on) to every page.
	 *
	 * @pages Array of page structs with `relativePath` already set (DocsLoader.load())
	 * @config The site's bxdocs.json config
	 * @root Absolute path to the project root - git's working directory for the `lastUpdated` lookup
	 * @docsRelativePrefix `page.relativePath` is relative to whichever docs tree was loaded (`docs/` or `docs/versions/<name>/`) - this is the bit in between, e.g. `"versions/1.0/"`, so the real `docs/`-relative path (for both the edit URL and the git lookup) can be rebuilt as `docsRelativePrefix & page.relativePath`. Empty for the main/"Latest" tree. Ignored for any page that carries its own `sourceRelativePath` instead (mergeLocalePages()'s own output) - a locale tree's pages don't all share one real physical prefix, since a translated page really lives under `docs/i18n/<code>/` while a fallback page really is the default tree's own file under plain `docs/`.
	 */
	private void function assignEditAndLastUpdated( required array pages, required struct config, required string root, string docsRelativePrefix = "" ) {
		var repoUrl = trim( arguments.config.repo.url ?: "" )
		var editUri = trim( arguments.config.repo.editUri ?: "" )
		var canEdit = len( repoUrl ) && len( editUri )

		for ( var page in arguments.pages ) {
			var pathFromDocsRoot = page.keyExists( "sourceRelativePath" ) ? page.sourceRelativePath : ( arguments.docsRelativePrefix & page.relativePath )
			page.editUrl = canEdit ? buildEditUrl( repoUrl, editUri, pathFromDocsRoot ) : ""
			page.lastUpdated = arguments.config.lastUpdated
				? variables.gitRevisionDate.forFile( arguments.root, "docs/" & pathFromDocsRoot )
				: ""
		}
	}

	/**
	 * Merges a locale's own translated pages onto the default tree's own
	 * page set, structurally - the output always has exactly the default
	 * tree's own pages, in its own order, matched by `relativePath` (a
	 * translated `docs/i18n/es/guides/setup.md` and the default tree's own
	 * `docs/guides/setup.md` both load with the identical `relativePath`
	 * `"guides/setup.md"`, since DocsLoader.bx computes it relative to
	 * whichever docsDir it was given - no rewriting needed to make them
	 * match). This is what guarantees a locale's nav is always the exact
	 * same shape as the default tree's - see renderDocTree()'s own docblock -
	 * and what lets the language switcher always land on the same page
	 * rather than that locale's homepage.
	 *
	 * A default-tree page with no translated counterpart is carried through
	 * unchanged (its own title/body/icon/order - untranslated, but real
	 * content, never a broken link) and stamped `isFallbackContent = true`
	 * so a theme's `page.bxm` can show a "not yet translated" notice - the
	 * fallback behavior this session settled on over an alternative of
	 * omitting untranslated pages entirely.
	 *
	 * @defaultPages The default tree's own already-loaded pages (DocsLoader.load()'s output for `<root>/docs`, or - composing with a version - `<root>/docs/versions/<name>/`)
	 * @localePages This locale's own already-loaded pages (DocsLoader.load()'s output for `<root>/docs/i18n/<code>`, or `<root>/docs/versions/<name>/i18n/<code>` when composing with a version)
	 * @localeCode This locale's own code, for building each translated page's own `sourceRelativePath`
	 * @docsRelativePrefix Prepended to every `sourceRelativePath`, `docs/`-relative - `""` (default) for the main tree, `"versions/<name>/"` when composing with a version, so edit-URL/last-updated lookups (assignEditAndLastUpdated()) resolve against the right source file either way
	 *
	 * @return Array of page structs, same shape/order as `defaultPages`, each additionally stamped `isFallbackContent` and `sourceRelativePath`
	 */
	private array function mergeLocalePages( required array defaultPages, required array localePages, required string localeCode, string docsRelativePrefix = "" ) {
		var localesByPath = {}
		for ( var localePage in arguments.localePages ) {
			localesByPath[ lCase( localePage.relativePath ) ] = localePage
		}

		var merged = []
		for ( var defaultPage in arguments.defaultPages ) {
			var key = lCase( defaultPage.relativePath )

			if ( localesByPath.keyExists( key ) ) {
				var translated = duplicate( localesByPath[ key ] )
				translated.isFallbackContent = false
				translated.sourceRelativePath = arguments.docsRelativePrefix & "i18n/" & arguments.localeCode & "/" & translated.relativePath
				merged.append( translated )
			} else {
				var fallback = duplicate( defaultPage )
				fallback.isFallbackContent = true
				fallback.sourceRelativePath = arguments.docsRelativePrefix & fallback.relativePath
				merged.append( fallback )
			}
		}

		return merged
	}

	/**
	 * Builds the language switcher's own entries - the default locale first
	 * (`bxdocs.json`'s `i18n.defaultLocale`, always the unprefixed `docs/`
	 * tree), then one per discovered `docs/i18n/` folder that's actually
	 * declared in `i18n.locales` (in the order declared there), then any
	 * remaining discovered folder not declared in config at all (using its
	 * bare code as its own label, alphabetically - graceful degradation
	 * rather than silently dropping it from the switcher).
	 *
	 * @localeNames LocalesDiscoverer.discover()'s own output, alphabetical
	 * @i18nConfig The site's bxdocs.json `i18n` struct
	 * @basePath The main/default-locale build's own basePath
	 *
	 * @return Array of `{ code, label, url, dir, flag }`, default locale first
	 */
	private array function buildLocalesList( required array localeNames, required struct i18nConfig, required string basePath ) {
		var defaultLocale = arguments.i18nConfig.defaultLocale
		var locales = [ {
			code  : defaultLocale.code,
			label : defaultLocale.label,
			dir   : defaultLocale.dir ?: "ltr",
			flag  : defaultLocale.flag ?: "",
			url   : arguments.basePath
		} ]
		var addedCodes = [ lCase( defaultLocale.code ) ]

		for ( var configured in arguments.i18nConfig.locales ) {
			if ( !arguments.localeNames.contains( configured.code ) ) {
				continue
			}
			locales.append( {
				code  : configured.code,
				label : configured.label,
				dir   : configured.dir ?: "ltr",
				flag  : configured.flag ?: "",
				url   : arguments.basePath & configured.code & "/"
			} )
			addedCodes.append( lCase( configured.code ) )
		}

		for ( var localeName in arguments.localeNames ) {
			if ( addedCodes.contains( lCase( localeName ) ) ) {
				continue
			}
			locales.append( { code : localeName, label : localeName, dir : "ltr", flag : "", url : arguments.basePath & localeName & "/" } )
		}

		return locales
	}

	/**
	 * Fills in each page's own `og:image` when `bxdocs.json`'s `generateOgImages`
	 * is on - a page with its own frontmatter `ogImage` keeps that untouched
	 * (it already wins); every other page gets a per-page social card
	 * rendered by SocialCardGenerator.bx (its title + the site name) under
	 * `<outputDir>/assets/og/`. A no-op entirely when `generateOgImages` is
	 * off - `page.ogImage` then stays whatever DocsLoader.bx read from
	 * frontmatter (usually empty), and layout.bxm's own `og:image` falls
	 * back to `bxdocs.json`'s site-wide `ogImage` in that case.
	 *
	 * @pages Array of page structs (already markdown-converted, titles final)
	 * @config The site's bxdocs.json config
	 * @outputDir Absolute path this tree's pages are being written under (`site/` or `site/versions/<name>/`)
	 */
	private void function assignOgImages( required array pages, required struct config, required string outputDir ) {
		if ( !arguments.config.generateOgImages ) {
			return
		}

		for ( var page in arguments.pages ) {
			if ( len( trim( page.ogImage ?: "" ) ) ) {
				continue
			}

			var relativePath = "assets/og/" & generatedOgImageFileName( page.urlPath )
			var outputPath = arguments.outputDir & "/" & relativePath
			directoryCreate( getDirectoryFromPath( outputPath ), true, true )
			variables.socialCardGenerator.generate( page.title, arguments.config.name, outputPath )
			page.ogImage = relativePath
		}
	}

	/**
	 * Derives a per-page social-card filename from its own `urlPath`, e.g.
	 * `"guides/setup/index.html"` -> `"guides-setup.png"`; the root
	 * `"index.html"` -> `"home.png"` (an empty base would otherwise collide
	 * with the site-wide default's own naming).
	 *
	 * @urlPath The page's own urlPath (DocsLoader.bx's pretty-URL output path)
	 */
	private string function generatedOgImageFileName( required string urlPath ) {
		var base = arguments.urlPath.reReplaceNoCase( "/?index\.html$", "", "one" )
		if ( !len( base ) ) {
			base = "home"
		}
		return base.reReplace( "[\/]", "-", "all" ) & ".png"
	}

	/**
	 * Fills in each page's own `markdownUrl` - where its raw `.md` source
	 * ends up once MarkdownPublisher.bx copies it alongside the built HTML
	 * (`site/guides/themes.md`, next to `site/guides/themes/index.html`) -
	 * so a theme's `page.bxm` can link to it ("View as Markdown"). Root-relative
	 * but not basePath-prefixed yet - same convention as `page.urlPath`/
	 * `prevPage.url`/`nextPage.url`, prefixed by the theme at render time.
	 *
	 * @pages Array of page structs (relativePath already set by DocsLoader.bx)
	 */
	private void function assignMarkdownUrl( required array pages ) {
		for ( var page in arguments.pages ) {
			page.markdownUrl = page.relativePath
		}
	}

	/**
	 * Resolves each page's own frontmatter `icon` into ready-to-embed HTML
	 * (IconResolver.bx) - a theme's `page.bxm` renders `page.iconHtml`
	 * directly next to the title, never touching `icon`/IconResolver.bx
	 * itself.
	 *
	 * @pages Array of page structs (`icon` already set by DocsLoader.bx)
	 * @docsDir Absolute path to this tree's own docs root - resolves a `custom:` icon against its `assets/icons/`
	 */
	private void function assignIconHtml( required array pages, required string docsDir ) {
		for ( var page in arguments.pages ) {
			page.iconHtml = variables.iconResolver.resolve( page.icon ?: "", arguments.docsDir )
		}
	}

	/**
	 * Resolves every nav node's own `icon` (NavBuilder.bx) into ready-to-embed
	 * HTML, recursively - a theme's `layout.bxm` renders each node's own
	 * `iconHtml` directly next to its title, never touching IconResolver.bx
	 * itself. Mutates `nodes` in place.
	 *
	 * @nodes A nav tree (or subtree) from NavBuilder.build()
	 * @docsDir Absolute path to this tree's own docs root - resolves a `custom:` icon against its `assets/icons/`
	 */
	private void function assignNavIconHtml( required array nodes, required string docsDir ) {
		for ( var node in arguments.nodes ) {
			node.iconHtml = variables.iconResolver.resolve( node.icon ?: "", arguments.docsDir )
			if ( node.children.len() ) {
				assignNavIconHtml( node.children, arguments.docsDir )
			}
		}
	}

	/**
	 * Joins a repo URL, an edit URI (e.g. `edit/main/docs/`) and a docs/-relative
	 * page path into one URL, tolerating either side's leading/trailing slashes.
	 *
	 * @repoUrl bxdocs.json's `repo.url`, non-empty
	 * @editUri bxdocs.json's `repo.editUri`, non-empty
	 * @relativePath The page's docs/-relative source path, e.g. "guides/setup.md"
	 */
	private string function buildEditUrl( required string repoUrl, required string editUri, required string relativePath ) {
		var base = arguments.repoUrl.reReplace( "[\/]+$", "" )
		var uri = arguments.editUri.reReplace( "^[\/]+|[\/]+$", "", "all" )
		return base & "/" & uri & "/" & arguments.relativePath
	}

	/**
	 * Renders one already-content-ready page - a blog post, or one of its
	 * synthetic list/category/author pages (BlogBuilder.bx's own output) -
	 * through the active theme and writes it to `siteDir` at its own
	 * `urlPath`. The same render-then-write shape renderDocTree()'s own
	 * per-page loop uses for a normal doc tree, pulled out here since the
	 * blog writes its pages outside that loop (build()'s own docblock).
	 *
	 * @page A page struct with `contentHtml`/`urlPath` already set
	 * @nav The main tree's own nav (already carrying its "Blog" entry - renderDocTree()'s own blogNavUrl)
	 * @config The site's config
	 * @themeDir Absolute path to the resolved theme folder
	 * @siteDir Absolute path to the build output directory
	 * @basePath Root-relative base path ending with `/`
	 * @versions Version switcher entries as `[ { label, url } ]`
	 * @locales Language switcher entries as `[ { code, label, url, dir, flag } ]`
	 * @currentLocale The default locale's own code - the blog is main-tree-only in v1, not rendered per-locale
	 * @currentLocaleDir The default locale's own direction
	 */
	private void function writeRenderedPage( required struct page, required array nav, required struct config, required string themeDir, required string siteDir, required string basePath, required array versions, required array locales, required string currentLocale, required string currentLocaleDir ) {
		var html = variables.themeRenderer.renderPage(
			arguments.page, arguments.nav, arguments.config, arguments.themeDir, arguments.basePath, arguments.versions, "Latest",
			arguments.locales, arguments.currentLocale, arguments.currentLocaleDir
		)
		var outputPath = arguments.siteDir & "/" & arguments.page.urlPath
		directoryCreate( getDirectoryFromPath( outputPath ), true, true )
		fileWrite( outputPath, html )
	}

	/**
	 * Renders a generic "page not found" page through the active theme and
	 * writes it to `site/404.html` - the filename GitHub Pages (and most
	 * static hosts) automatically serve for any unmatched path.
	 *
	 * @nav The site's nav tree
	 * @config The site's bxdocs.json config
	 * @themeDir Absolute path to the resolved theme folder
	 * @siteDir Absolute path to the build output directory
	 * @basePath Root-relative base path ending with `/`
	 * @versions Version switcher entries as `[ { label, url } ]`
	 * @currentVersion Always `"Latest"` - the 404 page is only ever written once, for the main site
	 * @locales Language switcher entries as `[ { code, label, url, dir, flag } ]` - not built per-locale in v1 (a 404 page's own "not found" message needs no translation to be useful), shown here only so the header renders the same everywhere
	 * @currentLocale The default locale's own code
	 */
	private void function write404Page( required array nav, required struct config, required string themeDir, required string siteDir, required string basePath, required array versions, required string currentVersion, array locales = [], string currentLocale = "" ) {
		var page = {
			title       : "Page Not Found",
			contentHtml : "<p>Sorry, that page doesn't exist. Try the search box, or head back to the homepage.</p>",
			toc         : [],
			prevPage    : { title : "", url : "" },
			nextPage    : { title : "", url : "" },
			breadcrumbs : []
		}

		var html = variables.themeRenderer.renderPage(
			page, arguments.nav, arguments.config, arguments.themeDir, arguments.basePath, arguments.versions, arguments.currentVersion,
			arguments.locales, arguments.currentLocale
		)
		fileWrite( arguments.siteDir & "/404.html", html )
	}

	/**
	 * Writes `site/tags/index.html` - every frontmatter `tags` value used
	 * anywhere in the main tree, each with a `##tag-<slug>` anchor and a list
	 * of every page carrying it (TagsIndexBuilder.bx). Skipped entirely when
	 * no page uses `tags` - no empty page for projects not using the feature.
	 * Version trees don't get their own tags page; tag badges on a version's
	 * pages still link to the main site's one.
	 *
	 * @pages The main tree's pages (already markdown-converted, `tags` included)
	 * @nav The main tree's nav
	 * @config The site's bxdocs.json config
	 * @themeDir Absolute path to the resolved theme folder
	 * @siteDir Absolute path to the build output directory
	 * @basePath Root-relative base path ending with `/`
	 * @versions Version switcher entries as `[ { label, url } ]`
	 * @locales Language switcher entries as `[ { code, label, url, dir, flag } ]` - like version trees, a locale doesn't get its own tags page in v1; tag badges on every locale's own pages still link to the main site's one
	 * @currentLocale The default locale's own code
	 */
	private void function writeTagsPage( required array pages, required array nav, required struct config, required string themeDir, required string siteDir, required string basePath, required array versions, array locales = [], string currentLocale = "" ) {
		var built = variables.tagsIndexBuilder.build( arguments.pages, arguments.basePath )
		if ( !built.hasTags ) {
			return
		}

		var page = {
			title       : "Tags",
			contentHtml : built.contentHtml,
			toc         : [],
			prevPage    : { title : "", url : "" },
			nextPage    : { title : "", url : "" },
			breadcrumbs : []
		}

		var html = variables.themeRenderer.renderPage(
			page, arguments.nav, arguments.config, arguments.themeDir, arguments.basePath, arguments.versions, "Latest",
			arguments.locales, arguments.currentLocale
		)
		directoryCreate( arguments.siteDir & "/tags", true, true )
		fileWrite( arguments.siteDir & "/tags/index.html", html )
	}

	/**
	 * Whether this build should produce/copy bx-docs' own static search
	 * index and lunr widget - `config.search` is the master on/off switch
	 * (module spec section 7); `config.searchProvider.provider` then decides
	 * whether the *local* index is actually needed (SearchProviderRegistry.bx) -
	 * `false` only for `algolia`, which is fed from its own hosted index
	 * instead of `search-index.json`.
	 *
	 * @config The site's bxdocs.json config, already defaulted/validated
	 */
	private boolean function searchNeedsLocalIndex( required struct config ) {
		return arguments.config.search
			&& variables.searchProviderRegistry.usesLocalIndex( arguments.config.searchProvider.provider )
	}

	/**
	 * Builds the search index from already-converted pages and writes it to
	 * `siteDir`.
	 *
	 * @pages Array of page structs with `contentHtml` already set
	 * @siteDir Absolute path to the build output directory (must already exist)
	 *
	 * @return Absolute path to the written search-index.json
	 */
	private string function writeSearchIndex( required array pages, required string siteDir ) {
		var searchIndex = variables.searchIndexer.build( arguments.pages )
		var indexPath = arguments.siteDir & "/search-index.json"
		fileWrite( indexPath, jsonSerialize( searchIndex ) )
		return indexPath
	}

	/**
	 * Copies theme assets to `site/assets/theme/`, this module's own shared
	 * scripts (the search widget when search is enabled; the copy-code
	 * button, tab widget, and code line-number/highlight widget
	 * unconditionally), the vendored third-party CSS/JS every built site
	 * needs with no CDN/internet access (module spec section 8 - highlight.js
	 * and Alpine.js always, Bootstrap's own CSS/JS for the `bootstrap` theme,
	 * lunr.js alongside search.js, mermaid.js alongside mermaid-init.js when
	 * `mermaid` is on), and a project's own `docs/assets/**` to
	 * `site/assets/` (module spec section 5, step 6).
	 *
	 * @root Absolute path to the project root
	 * @themeDir Absolute path to the resolved theme folder
	 * @siteDir Absolute path to the build output directory
	 * @themeName bxdocs.json's `theme.name` - selects which vendored theme-specific assets (currently just Bootstrap's own CSS/JS) to copy
	 * @searchEnabled Whether to copy the shared search.js/lunr widget - searchNeedsLocalIndex()'s own result, so this is only true for the `local` search provider (or one bx-docs doesn't otherwise know about), never `algolia`
	 * @mermaidEnabled Whether to copy the shared mermaid-init.js widget and the vendored mermaid.js bundle itself
	 * @mathEnabled Whether to copy the shared math-init.js (KaTeX auto-render) widget
	 * @imageManifest ImageVariantGenerator.buildManifest()'s own output - its already-generated variant files get copied into this tree's own site.../assets/, right alongside the plain docs/assets/** copy below; empty (the default) copies nothing extra
	 * @cssBundle AssetBundler.bundleCss()'s own output (via applyAssetPipeline()) - its cached bundle file gets copied into this tree's own site.../assets/ so the `<link>` config.extraCss now points at actually resolves; empty `cachedPath` (the default) copies nothing
	 * @jsBundle AssetBundler.bundleJs()'s own output - same as cssBundle, for the `<script>` config.extraJs now points at
	 */
	private void function copyAssets( required string root, required string themeDir, required string siteDir, required string themeName, required boolean searchEnabled, required boolean mermaidEnabled, boolean mathEnabled = false, struct imageManifest = {}, struct cssBundle = {}, struct jsBundle = {} ) {
		var themeAssetsDir = arguments.themeDir & "/assets"
		if ( directoryExists( themeAssetsDir ) ) {
			directoryCopy( themeAssetsDir, arguments.siteDir & "/assets/theme", true )
		}

		directoryCreate( arguments.siteDir & "/assets", true, true )
		fileCopy( moduleAssetsDir() & "/copy-code.js", arguments.siteDir & "/assets/copy-code.js" )
		fileCopy( moduleAssetsDir() & "/admonition-collapse.js", arguments.siteDir & "/assets/admonition-collapse.js" )
		fileCopy( moduleAssetsDir() & "/nav-toggle.js", arguments.siteDir & "/assets/nav-toggle.js" )
		fileCopy( moduleAssetsDir() & "/toc-collapse.js", arguments.siteDir & "/assets/toc-collapse.js" )
		fileCopy( moduleAssetsDir() & "/highlight-boxlang.js", arguments.siteDir & "/assets/highlight-boxlang.js" )
		fileCopy( moduleAssetsDir() & "/tabs.js", arguments.siteDir & "/assets/tabs.js" )
		fileCopy( moduleAssetsDir() & "/code-lines.js", arguments.siteDir & "/assets/code-lines.js" )
		directoryCopy( moduleAssetsDir() & "/fonts", arguments.siteDir & "/assets/fonts", true )
		directoryCopy( moduleAssetsDir() & "/vendor/highlight", arguments.siteDir & "/assets/vendor/highlight", true )
		directoryCopy( moduleAssetsDir() & "/vendor/alpine", arguments.siteDir & "/assets/vendor/alpine", true )

		if ( arguments.themeName == "bootstrap" ) {
			directoryCopy( moduleAssetsDir() & "/vendor/bootstrap", arguments.siteDir & "/assets/vendor/bootstrap", true )
		}

		if ( arguments.searchEnabled ) {
			fileCopy( moduleAssetsDir() & "/search.js", arguments.siteDir & "/assets/search.js" )
			directoryCopy( moduleAssetsDir() & "/vendor/lunr", arguments.siteDir & "/assets/vendor/lunr", true )
		}

		if ( arguments.mermaidEnabled ) {
			fileCopy( moduleAssetsDir() & "/mermaid-init.js", arguments.siteDir & "/assets/mermaid-init.js" )
			directoryCopy( moduleAssetsDir() & "/vendor/mermaid", arguments.siteDir & "/assets/vendor/mermaid", true )
		}

		if ( arguments.mathEnabled ) {
			fileCopy( moduleAssetsDir() & "/math-init.js", arguments.siteDir & "/assets/math-init.js" )
		}

		var docsAssetsDir = arguments.root & "/docs/assets"
		if ( directoryExists( docsAssetsDir ) ) {
			directoryCopy( docsAssetsDir, arguments.siteDir & "/assets", true )
		}

		if ( !arguments.imageManifest.isEmpty() ) {
			variables.imageVariantGenerator.copyToOutput( arguments.imageManifest, arguments.siteDir & "/assets" )
		}

		for ( var bundle in [ arguments.cssBundle, arguments.jsBundle ] ) {
			var cachedPath = bundle.cachedPath ?: ""
			if ( len( cachedPath ) ) {
				fileCopy( cachedPath, arguments.siteDir & "/assets/" & bundle.fileName )
			}
		}
	}

	/**
	 * Absolute path to this module's own shared (theme-independent) assets,
	 * found relative to this class's own file - the same approach
	 * ThemeRenderer.bx uses for its built-in themes folder.
	 */
	private string function moduleAssetsDir() {
		return getDirectoryFromPath( getCurrentTemplatePath() ).reReplace( "[\/]models[\/]build[\/]?$", "" ) & "/resources/assets"
	}

	/**
	 * Strips a trailing slash so every path built from `projectRoot`
	 * elsewhere in this class never ends up with a doubled `//`.
	 *
	 * @projectRoot A project root, trailing slash optional
	 */
	private string function normalizeRoot( required string projectRoot ) {
		return arguments.projectRoot.reReplace( "[\/]+$", "" )
	}

}
