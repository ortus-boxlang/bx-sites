/**
 * `page:rename` CLI verb - thin dispatcher over PageRenamer.rename().
 */
class {

	/**
	 * @options { projectRoot (required, absolute path), from (required, docs/-relative, ends in .md), to (required, docs/-relative, ends in .md) }
	 */
	struct function run( struct options = {} ) {
		var projectRoot = trim( arguments.options.projectRoot ?: "" )
		if ( !len( projectRoot ) ) {
			throw( type = "BxSites.MissingProjectRoot", message = "`page:rename` requires a project root" )
		}

		var from = trim( arguments.options.from ?: "" )
		if ( !len( from ) ) {
			throw( type = "BxSites.MissingFromPath", message = "`page:rename` requires --from=<relative path>.md" )
		}

		var to = trim( arguments.options.to ?: "" )
		if ( !len( to ) ) {
			throw( type = "BxSites.MissingToPath", message = "`page:rename` requires --to=<relative path>.md" )
		}

		var renamer = new "models.build.PageRenamer@bxsites"()
		var result = renamer.rename( docsDir : projectRoot & "/docs", from : from, to : to )

		return {
			exitCode : 0,
			message  : "Moved #from# to #to# (#result.filesUpdated# other file(s) had links rewritten)"
		}
	}

}
