/**
 * `plugin:new` CLI verb - thin dispatcher over PluginScaffolder.scaffold().
 */
class {

	/**
	 * @options { projectRoot (required, absolute path - used only as the default scaffold location's parent), name (required), dest (optional absolute/relative-to-cwd path override; defaults to <projectRoot>/<name>) }
	 */
	struct function run( struct options = {} ) {
		var projectRoot = trim( arguments.options.projectRoot ?: "" )
		if ( !len( projectRoot ) ) {
			throw( type = "BxDocs.MissingProjectRoot", message = "`plugin:new` requires a project root" )
		}

		var name = trim( arguments.options.name ?: "" )
		if ( !len( name ) ) {
			throw( type = "BxDocs.MissingPluginName", message = "`plugin:new` requires --name=<plugin name>" )
		}

		var dest = trim( arguments.options.dest ?: "" )
		var destDir = len( dest ) ? dest : ( projectRoot & "/" & name )

		var scaffolder = new "models.build.PluginScaffolder@bxdocs"()
		var result = scaffolder.scaffold( destDir : destDir, name : name )

		return {
			exitCode : 0,
			message  : 'Created plugin skeleton [#result.moduleName#] at #result.destDir# - box install it (or drop it into boxlang_modules/), then add "#result.moduleName#" to bxdocs.json''s [plugins] array'
		}
	}

}
