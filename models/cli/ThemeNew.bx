/**
 * `theme:new` CLI verb - thin dispatcher over ThemeScaffolder.scaffold().
 */
class {

	/**
	 * @options { projectRoot (required, absolute path), theme (required - "bootstrap", "material", or "tailwind") }
	 */
	struct function run( struct options = {} ) {
		var projectRoot = trim( arguments.options.projectRoot ?: "" )
		if ( !len( projectRoot ) ) {
			throw( type = "BxDocs.MissingProjectRoot", message = "`theme:new` requires a project root" )
		}

		var theme = trim( arguments.options.theme ?: "" )
		if ( !len( theme ) ) {
			throw( type = "BxDocs.MissingThemeName", message = "`theme:new` requires --theme=<bootstrap|material|tailwind>" )
		}

		var scaffolder = new "models.build.ThemeScaffolder@bxdocs"()
		var result = scaffolder.scaffold( projectRoot : projectRoot, theme : theme )

		return {
			exitCode : 0,
			message  : "Copied the #theme# theme into #result.themeDir# - edit it freely, BX Docs picks up a project-level theme/ automatically"
		}
	}

}
