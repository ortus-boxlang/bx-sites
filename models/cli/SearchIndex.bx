/**
 * `search-index` CLI verb - stub for now. Search is explicitly deferred:
 * the static index builder and client search UI land in Phase 4 of the
 * module spec; this verb only validates dispatch wiring.
 */
class {

	/**
	 * @options { projectRoot (required, absolute path) }
	 */
	struct function run( struct options = {} ) {
		var projectRoot = trim( arguments.options.projectRoot ?: "" )
		if ( !len( projectRoot ) ) {
			throw( type = "BxDocs.MissingProjectRoot", message = "`search-index` requires a project root" )
		}

		return {
			exitCode : 1,
			message  : "`search-index` is not implemented yet (Phase 4 of the module spec - search comes later)."
		}
	}

}
