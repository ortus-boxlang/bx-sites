/**
 * `search-index` CLI verb - thin dispatcher over BuildPipeline.buildSearchIndex().
 * Rebuilds just `site/search-index.json` standalone; `build` also runs this
 * same step automatically (module spec section 2).
 */
class {

	/**
	 * Dispatches the `search-index` verb to BuildPipeline.buildSearchIndex().
	 *
	 * @options { projectRoot (required, absolute path) }
	 */
	struct function run( struct options = {} ) {
		var projectRoot = trim( arguments.options.projectRoot ?: "" )
		if ( !len( projectRoot ) ) {
			throw( type = "BxSites.MissingProjectRoot", message = "`search-index` requires a project root" )
		}

		var pipeline = new "models.build.BuildPipeline@bxsites"()
		var result = pipeline.buildSearchIndex( projectRoot )

		if ( result.skipped ) {
			return {
				exitCode : 0,
				message  : "Search is disabled in bxsites.json ([search]: false) - nothing to index"
			}
		}

		return {
			exitCode : 0,
			message  : "Indexed #result.pageCount# page(s) to #result.indexPath#"
		}
	}

}
