/**
 * `i18n:new` CLI verb - thin dispatcher over LocaleScaffolder.scaffold().
 */
class {

	/**
	 * @options { projectRoot (required, absolute path), code (required, e.g. "es", "pt-BR") }
	 */
	struct function run( struct options = {} ) {
		var projectRoot = trim( arguments.options.projectRoot ?: "" )
		if ( !len( projectRoot ) ) {
			throw( type = "BxSites.MissingProjectRoot", message = "`i18n:new` requires a project root" )
		}

		var code = trim( arguments.options.code ?: "" )
		if ( !len( code ) ) {
			throw( type = "BxSites.MissingLocaleCode", message = "`i18n:new` requires --code=<locale>" )
		}

		var sourceDirName = new "models.config.SourceDirResolver@bxsites"().name( projectRoot )
		var scaffolder = new "models.build.LocaleScaffolder@bxsites"()
		var result = scaffolder.scaffold( docsDir : projectRoot & "/" & sourceDirName, code : code )

		return {
			exitCode : 0,
			message  : "Created #sourceDirName#/i18n/#code# at #result.localeDir#" & ( result.seededIndex ? " (seeded with a copy of the default index.md - translate it, then build)" : " (no default #sourceDirName#/index.md to seed from - add pages yourself)" )
		}
	}

}
