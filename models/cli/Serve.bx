/**
 * `serve` CLI verb - builds the project, serves `site/` locally, and
 * watches for changes with live reload (module spec section 2), reacting
 * to a change via BoxLang's own native `watcherNew()`/`schedulerNew()`
 * rather than polling. Runs in the foreground until interrupted (Ctrl+C) -
 * see DevServer.bx for the actual server/watch/rebuild logic this only
 * drives.
 */
class {

	/**
	 * Dispatches the `serve` verb to DevServer.start(), blocking until
	 * interrupted.
	 *
	 * @options { projectRoot (required, absolute path), port (default 8080), host (default 127.0.0.1) }
	 */
	struct function run( struct options = {} ) {
		var projectRoot = trim( arguments.options.projectRoot ?: "" )
		if ( !len( projectRoot ) ) {
			throw( type = "BxSites.MissingProjectRoot", message = "`serve` requires a project root" )
		}

		var port = isNumeric( arguments.options.port ?: "" ) ? val( arguments.options.port ) : 8080
		var host = len( trim( arguments.options.host ?: "" ) ) ? arguments.options.host : "127.0.0.1"

		var devServer = new "models.build.DevServer@bxsites"()
		var started = devServer.start( projectRoot, port, host )
		devServer.startWatching()

		println( "Serving #projectRoot# at #started.url# (Ctrl+C to stop)" )

		try {
			while ( true ) {
				sleep( 1000 )
			}
		} finally {
			devServer.stop()
		}

		return { exitCode : 0, message : "" }
	}

}
