/**
 * `serve` CLI verb - stub for now. Build-then-serve-with-live-reload lands
 * in Phase 5 of the module spec, once `build` (Phase 2) exists to serve
 * output from; this verb only validates dispatch wiring.
 */
class {

	/**
	 * @options { projectRoot (required, absolute path) }
	 */
	struct function run( struct options = {} ) {
		var projectRoot = trim( arguments.options.projectRoot ?: "" )
		if ( !len( projectRoot ) ) {
			throw( type = "BxDocs.MissingProjectRoot", message = "`serve` requires a project root" )
		}

		return {
			exitCode : 1,
			message  : "`serve` is not implemented yet (Phase 5 of the module spec)."
		}
	}

}
