/**
 * `clean` CLI verb - recursively removes a project's `site/` build output
 * and `.cache/` directories, without touching anything else (docs/,
 * bxsites.json, theme/, etc. are never touched). Asks for confirmation
 * first unless `--force` is passed.
 */
class {

	variables.confirm = new "models.cli.Confirm@bxsites"()

	/**
	 * Replaces the confirmation prompt - specs use this, since the default
	 * reads stdin.
	 *
	 * @prompter Closure taking the prompt text and returning the user's answer
	 */
	void function setPrompter( required any prompter ) {
		variables.confirm.setPrompter( arguments.prompter )
	}

	/**
	 * Dispatches the `clean` verb - removes `site/` and `.cache/`.
	 *
	 * @options { projectRoot (required, absolute path), force (boolean - skip the confirmation prompt) }
	 */
	struct function run( struct options = {} ) {
		var projectRoot = trim( arguments.options.projectRoot ?: "" )
		if ( !len( projectRoot ) ) {
			throw( type = "BxSites.MissingProjectRoot", message = "`clean` requires a project root" )
		}

		var root = projectRoot.reReplace( "[\\\/]+$", "" )
		var targets = [ "site", ".cache" ].filter( ( folder ) => directoryExists( root & "/" & folder ) )

		if ( !targets.len() ) {
			return { exitCode : 0, message : "Nothing to clean" }
		}

		if ( !( arguments.options.force ?: false ) ) {
			var folderList = targets.map( ( folder ) => folder & "/" ).toList( " and " )
			var answer = variables.confirm.ask( "Delete #folderList# in #root#?" )
			if ( answer == "unanswered" ) {
				return { exitCode : 1, message : "No answer to the confirmation prompt. Nothing was deleted - pass --force to clean without asking." }
			}
			if ( answer == "no" ) {
				return { exitCode : 0, message : "Cancelled. Nothing was deleted." }
			}
		}

		for ( var folder in targets ) {
			directoryDelete( root & "/" & folder, true )
		}

		return {
			exitCode : 0,
			message  : "Removed: #targets.toList( ', ' )#"
		}
	}

}
