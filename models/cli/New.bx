/**
 * `new` CLI verb - thin dispatcher over ProjectScaffolder. CLI-agnostic:
 * takes an already-parsed options struct (see ModuleConfig.bx's main()),
 * never touches raw argv or the current working directory itself.
 */
class {

	/**
	 * The theme names this module ships built-in support for (module spec section 6).
	 */
	variables.builtInThemes = [ "bootstrap", "material", "tailwind", "docsy", "slate", "docusaurus", "justthedocs", "vuepress", "gitbook", "notion" ]

	/**
	 * Dispatches the `new` verb to ProjectScaffolder.scaffold(), after
	 * validating `--theme` and `--source` against the supported values.
	 *
	 * @options { projectRoot (required, absolute path), name, theme (defaults to "bootstrap"), description, format ("yaml" default, "toml", or "json") }
	 * @options { projectRoot (required, absolute path), name, theme (defaults to "bootstrap"), description, format ("yaml" default, "toml", or "json"), source ("docs" default or "src") }
	 */
	struct function run( struct options = {} ) {
		var projectRoot = trim( arguments.options.projectRoot ?: "" )
		if ( !len( projectRoot ) ) {
			throw( type = "BxSites.MissingProjectRoot", message = "`new` requires a target directory" )
		}

		var theme = trim( len( arguments.options.theme ?: "" ) ? arguments.options.theme : "bootstrap" )
		if ( !variables.builtInThemes.contains( theme ) ) {
			throw(
				type    = "BxSites.UnknownTheme",
				message = "Unknown theme [#theme#] - must be one of [#variables.builtInThemes.toList( ', ' )#]"
			)
		}

		var name = trim( arguments.options.name ?: "" )
		if ( !len( name ) ) {
			var segments = listToArray( projectRoot.reReplace( "[\/]+$", "" ), "/" )
			name = segments.len() ? segments[ segments.len() ] : "bx-sites-site"
		}

		var format = trim( len( arguments.options.format ?: "" ) ? arguments.options.format : "yaml" )
		var hasDocsShortcut = arguments.options.docs ?: false
		var hasSiteShortcut = arguments.options.site ?: false
		if ( hasDocsShortcut && hasSiteShortcut ) {
			throw(
				type    = "BxSites.InvalidSource",
				message = "Use only one of --docs or --site"
			)
		}

		var source = lCase( trim( len( arguments.options.source ?: "" ) ? arguments.options.source : "docs" ) )
		if ( !len( arguments.options.source ?: "" ) && hasDocsShortcut ) {
			source = "docs"
		} else if ( !len( arguments.options.source ?: "" ) && hasSiteShortcut ) {
			source = "src"
		}
		if ( ![ "docs", "src" ].contains( source ) ) {
			throw(
				type    = "BxSites.InvalidSource",
				message = "Unknown source folder [#source#] - must be one of: docs, src"
			)
		}

		var scaffolder = new "models.build.ProjectScaffolder@bxsites"()
		var result = scaffolder.scaffold( projectRoot, name, theme, arguments.options.description ?: "", format, source )

		return {
			exitCode : 0,
			message  : "Created new BX Sites project [#name#] at #result.projectRoot# (theme: #theme#, config: #result.configPath.listLast( '/' )#)"
		}
	}

}
