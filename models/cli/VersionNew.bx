/**
 * `version:new` CLI verb - thin dispatcher over VersionScaffolder.scaffold().
 */
class {

	/**
	 * @options { projectRoot (required, absolute path), name (required, e.g. "2.0") }
	 */
	struct function run( struct options = {} ) {
		var projectRoot = trim( arguments.options.projectRoot ?: "" )
		if ( !len( projectRoot ) ) {
			throw( type = "BxDocs.MissingProjectRoot", message = "`version:new` requires a project root" )
		}

		var name = trim( arguments.options.name ?: "" )
		if ( !len( name ) ) {
			throw( type = "BxDocs.MissingVersionName", message = "`version:new` requires --name=<version>" )
		}

		var scaffolder = new "models.build.VersionScaffolder@bxdocs"()
		var result = scaffolder.scaffold( docsDir : projectRoot & "/docs", name : name )

		return {
			exitCode : 0,
			message  : "Created docs/versions/#name# (#result.copiedCount# file(s) copied from the current default docs) at #result.versionDir#"
		}
	}

}
