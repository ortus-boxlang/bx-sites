/**
 * `version:new` CLI verb - thin dispatcher over VersionScaffolder.scaffold().
 */
class {

	/**
	 * @options { projectRoot (required, absolute path), name (required, e.g. "2.0") }
	 */
	struct function run( struct options = {} ) {
		var projectRoot = trim( arguments.options.projectRoot ?: "" )
		if ( !len( projectRoot ) ) {
			throw( type = "BxSites.MissingProjectRoot", message = "`version:new` requires a project root" )
		}

		var name = trim( arguments.options.name ?: "" )
		if ( !len( name ) ) {
			throw( type = "BxSites.MissingVersionName", message = "`version:new` requires --name=<version>" )
		}

		var sourceDirName = new "models.config.SourceDirResolver@bxsites"().name( projectRoot )
		var scaffolder = new "models.build.VersionScaffolder@bxsites"()
		var result = scaffolder.scaffold( docsDir : projectRoot & "/" & sourceDirName, name : name )

		return {
			exitCode : 0,
			message  : "Created #sourceDirName#/versions/#name# (#result.copiedCount# file(s) copied from the current default #sourceDirName#) at #result.versionDir#"
		}
	}

}
