/**
 * `page:new` CLI verb - thin dispatcher over PageScaffolder.scaffold().
 */
class {

	/**
	 * @options { projectRoot (required, absolute path), path (required, docs/-relative, ends in .md), title, description, icon, tags (comma-separated), order }
	 */
	struct function run( struct options = {} ) {
		var projectRoot = trim( arguments.options.projectRoot ?: "" )
		if ( !len( projectRoot ) ) {
			throw( type = "BxDocs.MissingProjectRoot", message = "`page:new` requires a project root" )
		}

		var path = trim( arguments.options.path ?: "" )
		if ( !len( path ) ) {
			throw( type = "BxDocs.MissingPagePath", message = "`page:new` requires --path=<relative path>.md" )
		}

		var scaffolder = new "models.build.PageScaffolder@bxdocs"()
		var result = scaffolder.scaffold(
			docsDir     : projectRoot & "/docs",
			path        : path,
			title       : trim( arguments.options.title ?: "" ),
			description : trim( arguments.options.description ?: "" ),
			icon        : trim( arguments.options.icon ?: "" ),
			tags        : trim( arguments.options.tags ?: "" ),
			order       : trim( arguments.options.order ?: "" )
		)

		return {
			exitCode : 0,
			message  : "Created new page at #result.path#"
		}
	}

}
