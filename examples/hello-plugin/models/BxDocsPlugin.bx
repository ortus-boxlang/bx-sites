/**
 * A minimal, working bx-docs plugin - see ../../../docs/guides/plugins.md.
 * Implements two of the five optional hooks; the other three
 * (onConfig/onPageMarkdown/onNav) are simply omitted, which is exactly
 * how BX Docs expects a plugin that doesn't need them to look.
 */
class {

	/**
	 * @html A page's rendered HTML, already past bx-docs' own tabs/math/code-annotation post-processing
	 * @page The page struct (title, urlPath, tags, etc.)
	 * @config The site's bxdocs.json config
	 */
	string function onPageHtml( required string html, required struct page, required struct config ) {
		return arguments.html & char( 10 ) & "<!-- rendered by hello-plugin -->"
	}

	/**
	 * @siteDir Absolute path to the finished build output directory
	 * @config The site's bxdocs.json config
	 */
	void function onBuildComplete( required string siteDir, required struct config ) {
		fileWrite(
			arguments.siteDir & "/hello-plugin.txt",
			"hello-plugin ran against [" & ( arguments.config.name ?: "" ) & "] on " & dateTimeFormat( now(), "iso" )
		)
	}

}
