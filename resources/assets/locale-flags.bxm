<bx:script>
	/**
	 * Shared flag-emoji lookup for the language switcher - `<bx:include>`d
	 * via `#variables.moduleAssetsDir#/locale-flags.bxm` (ThemeRenderer.bx
	 * exposes that path at render time), the same convention icons.bxm
	 * already uses for the shared repo/social icon lookup.
	 *
	 * A locale's own `bxsites.json` `i18n.locales[].flag` (a literal emoji)
	 * always wins when set; this is only the fallback for the common case
	 * of a locale `code` (`es`, `pt-BR`, `zh-Hans`) that maps onto one
	 * obvious, uncontroversial flag. A `code` with no obvious flag (a
	 * constructed/regional code, or genuine ambiguity a project would
	 * rather pick itself) falls back to a plain globe glyph rather than
	 * guessing - the same "always render *something*" philosophy
	 * IconResolver.bx's own fallback already follows.
	 */
	function bxsitesLocaleFlag( required string code ) {
		var flags = {
			"en" : "🇺🇸", "es" : "🇪🇸", "fr" : "🇫🇷", "de" : "🇩🇪", "it" : "🇮🇹",
			"pt" : "🇵🇹", "pt-br" : "🇧🇷", "nl" : "🇳🇱", "ru" : "🇷🇺", "uk" : "🇺🇦",
			"ja" : "🇯🇵", "ko" : "🇰🇷", "zh" : "🇨🇳", "zh-hans" : "🇨🇳", "zh-hant" : "🇹🇼",
			"ar" : "🇸🇦", "he" : "🇮🇱", "hi" : "🇮🇳", "tr" : "🇹🇷", "pl" : "🇵🇱",
			"sv" : "🇸🇪", "da" : "🇩🇰", "no" : "🇳🇴", "fi" : "🇫🇮", "cs" : "🇨🇿",
			"el" : "🇬🇷", "th" : "🇹🇭", "vi" : "🇻🇳", "id" : "🇮🇩", "ro" : "🇷🇴",
			"hu" : "🇭🇺", "bg" : "🇧🇬", "sk" : "🇸🇰", "hr" : "🇭🇷", "lt" : "🇱🇹",
			"lv" : "🇱🇻", "et" : "🇪🇪", "sr" : "🇷🇸", "fa" : "🇮🇷", "ur" : "🇵🇰",
			"bn" : "🇧🇩", "ms" : "🇲🇾", "fil" : "🇵🇭", "sw" : "🇰🇪"
		}

		var key = lCase( trim( arguments.code ) )
		if ( flags.keyExists( key ) ) {
			return flags[ key ]
		}

		var baseKey = listFirst( key, "-" )
		return flags.keyExists( baseKey ) ? flags[ baseKey ] : "🌐"
	}
</bx:script>
