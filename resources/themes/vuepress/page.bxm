<bx:script>
	function renderBreadcrumbs( required array crumbs ) {
		if ( !arguments.crumbs.len() ) {
			return ""
		}
		var html = '<nav class="vp-breadcrumb" aria-label="breadcrumb"><ol>'
		for ( var i = 1; i <= arguments.crumbs.len(); i++ ) {
			var crumb = arguments.crumbs[ i ]
			if ( i == arguments.crumbs.len() ) {
				html &= '<li class="vp-breadcrumb__item vp-breadcrumb__item--active" aria-current="page">' & encodeForHTML( crumb.title ) & '</li>'
			} else {
				html &= '<li class="vp-breadcrumb__item"><a href="' & variables.basePath & crumb.url & '">' & encodeForHTML( crumb.title ) & '</a></li>'
			}
		}
		html &= '</ol></nav>'
		return html
	}

	/**
	 * The GitBook-style page-actions dropdown (`bxsites.json`'s `pageActions:
	 * true` - `theme.options.pageActionsPosition` picks top/bottom). A native
	 * `<details>`/`<summary>` disclosure needs no JS to open/close (same as
	 * `::: expandable` - DirectiveBlockProcessor.bx's own `renderExpandable()`);
	 * `page-actions-init.js` only wires up the individual actions themselves.
	 *
	 * "Copy link"/"Open in ChatGPT"/"Open in Claude" all need a real,
	 * publicly-reachable URL - silently omitted whenever `page.canonicalUrl`
	 * is empty (no full `baseURL` configured), the same requirement
	 * `<link rel="canonical">` itself already has.
	 */
	function renderPageActions() {
		var markdownHref = len( variables.page.markdownUrl ?: "" ) ? variables.basePath & variables.page.markdownUrl : ""
		var canonicalUrl = trim( variables.page.canonicalUrl ?: "" )
		var editUrl = trim( variables.page.editUrl ?: "" )

		// Every item's own icon + two-line "title / hint" label, the hint in
		// a smaller, muted line under the title - external true also appends
		// a small "opens in a new tab" arrow next to the title, for any item
		// whose <a> carries target="_blank" (every one except the three
		// in-page buttons: copy-markdown, copy-link, print).
		var itemLabel = function( required string icon, required string title, required string hint, boolean external = false ) {
			return bxsitesIcon( arguments.icon )
				& '<span class="bxsites-page-actions__item-text">'
				& '<span class="bxsites-page-actions__item-title">' & encodeForHTML( arguments.title ) & ( arguments.external ? ' <span class="bxsites-page-actions__item-external" aria-hidden="true">&##8599;</span>' : '' ) & '</span>'
				& '<span class="bxsites-page-actions__item-hint">' & encodeForHTML( arguments.hint ) & '</span>'
				& '</span>'
		}

		var items = sb{ "" }
		if ( len( markdownHref ) ) {
			items &= '<button type="button" class="bxsites-page-actions__item" data-bxsites-action="copy-markdown" data-bxsites-markdown-url="' & bxsitesUrlAttr( markdownHref ) & '">' & itemLabel( "copy", variables.strings.copyPageMarkdown, variables.strings.copyPageMarkdownHint ) & '</button>'
		}
		if ( len( canonicalUrl ) ) {
			items &= '<button type="button" class="bxsites-page-actions__item" data-bxsites-action="copy-link" data-bxsites-page-url="' & bxsitesUrlAttr( canonicalUrl ) & '">' & itemLabel( "link", variables.strings.copyPageLink, variables.strings.copyPageLinkHint ) & '</button>'
		}
		if ( len( markdownHref ) ) {
			items &= '<a class="bxsites-page-actions__item" href="' & bxsitesUrlAttr( markdownHref ) & '" target="_blank" rel="noopener noreferrer">' & itemLabel( "markdown", variables.strings.viewAsMarkdown, variables.strings.viewAsMarkdownHint, true ) & '</a>'
		}
		if ( len( canonicalUrl ) ) {
			items &= '<div class="bxsites-page-actions__divider" role="separator"></div>'
			items &= '<a class="bxsites-page-actions__item" href="' & bxsitesUrlAttr( "https://chatgpt.com/?q=" & urlEncodedFormat( "Read " & canonicalUrl & " so I can ask questions about it." ) ) & '" target="_blank" rel="noopener noreferrer">' & itemLabel( "sparkle", variables.strings.openInChatGPT, variables.strings.openInChatGPTHint, true ) & '</a>'
			items &= '<a class="bxsites-page-actions__item" href="' & bxsitesUrlAttr( "https://claude.ai/new?q=" & urlEncodedFormat( "Read " & canonicalUrl & " so I can ask questions about it." ) ) & '" target="_blank" rel="noopener noreferrer">' & itemLabel( "sparkle", variables.strings.openInClaude, variables.strings.openInClaudeHint, true ) & '</a>'
			items &= '<div class="bxsites-page-actions__divider" role="separator"></div>'
		}
		if ( len( editUrl ) ) {
			items &= '<a class="bxsites-page-actions__item" href="' & bxsitesUrlAttr( editUrl ) & '" target="_blank" rel="noopener noreferrer">' & itemLabel( "github", variables.strings.editOnGitHub, variables.strings.editOnGitHubHint, true ) & '</a>'
			items &= '<div class="bxsites-page-actions__divider" role="separator"></div>'
		}
		items &= '<button type="button" class="bxsites-page-actions__item" data-bxsites-action="print">' & itemLabel( "print", variables.strings.exportAsPdf, variables.strings.exportAsPdfHint ) & '</button>'
		if ( len( canonicalUrl ) ) {
			items &= '<div class="bxsites-page-actions__divider" role="separator"></div>'
			items &= '<a class="bxsites-page-actions__item" href="' & bxsitesUrlAttr( "https://x.com/intent/tweet?url=" & urlEncodedFormat( canonicalUrl ) & "&text=" & urlEncodedFormat( variables.page.title ) ) & '" target="_blank" rel="noopener noreferrer">' & itemLabel( "x", variables.strings.shareOnX, variables.strings.shareOnXHint, true ) & '</a>'
			items &= '<a class="bxsites-page-actions__item" href="' & bxsitesUrlAttr( "https://www.linkedin.com/sharing/share-offsite/?url=" & urlEncodedFormat( canonicalUrl ) ) & '" target="_blank" rel="noopener noreferrer">' & itemLabel( "linkedin", variables.strings.shareOnLinkedIn, variables.strings.shareOnLinkedInHint, true ) & '</a>'
			items &= '<a class="bxsites-page-actions__item" href="' & bxsitesUrlAttr( "https://www.facebook.com/sharer/sharer.php?u=" & urlEncodedFormat( canonicalUrl ) ) & '" target="_blank" rel="noopener noreferrer">' & itemLabel( "facebook", variables.strings.shareOnFacebook, variables.strings.shareOnFacebookHint, true ) & '</a>'
		}

		return '<div class="bxsites-page-actions">'
			& '<details class="bxsites-page-actions__disclosure">'
			& '<summary class="bxsites-page-actions__button" aria-label="' & encodeForHTML( variables.strings.pageActionsAriaLabel ) & '">'
			& '<span>' & encodeForHTML( variables.strings.pageActionsButton ) & '</span>' & bxsitesIcon( "chevron-down" )
			& '<kbd class="bxsites-page-actions__kbd" aria-hidden="true">C</kbd>'
			& '</summary>'
			& '<div class="bxsites-page-actions__panel">' & items & '</div>'
			& '</details>'
			& '</div>'
	}

	function renderPageMeta( required string editUrl, required string lastUpdated, required string markdownUrl ) {
		var html = '<div class="page-meta">'
		if ( len( arguments.editUrl ) ) {
			// A minimal attribute-safe escape, not encodeForHTML() - that also
			// entity-escapes "safe" characters like "/" (its exact range is
			// locale/JVM-dependent), needlessly noisy in a plain URL attribute.
			var escapedEditUrl = arguments.editUrl.replace( "&", "&amp;", "all" ).replace( '"', "&quot;", "all" ).replace( "<", "&lt;", "all" )
			html &= '<a href="' & escapedEditUrl & '" target="_blank" rel="noopener noreferrer">' & bxsitesIcon( "edit" ) & ' ' & encodeForHTML( variables.strings.editThisPage ) & '</a>'
		}
		if ( len( arguments.markdownUrl ) ) {
			// Same reasoning as escapedEditUrl above.
			var escapedMarkdownUrl = arguments.markdownUrl.replace( "&", "&amp;", "all" ).replace( '"', "&quot;", "all" ).replace( "<", "&lt;", "all" )
			html &= '<a href="' & variables.basePath & escapedMarkdownUrl & '" download>' & bxsitesIcon( "markdown" ) & ' ' & encodeForHTML( variables.strings.downloadMarkdown ) & '</a>'
		}
		if ( len( arguments.lastUpdated ) ) {
			html &= '<span class="page-meta__item">' & bxsitesIcon( "clock" ) & ' ' & encodeForHTML( variables.strings.lastUpdated ) & ' ' & encodeForHTML( dateTimeFormat( arguments.lastUpdated, "medium" ) ) & '</span>'
		}
		html &= '</div>'
		return html
	}

	// @hideAtXl true for the sticky-position variant's own mobile/tablet
	// fallback - a right-hand rail can't fit below 1200px (see
	// style.css's own `.vp-toc-sidebar` breakpoint), so this renders as a
	// collapsible bar pinned to the top of the viewport while scrolling
	// instead (VitePress/GitBook's own mobile "On this page" treatment) -
	// hidden again once the rail takes over, rather than leaving the TOC
	// inaccessible below that width.
	function renderToc( required array toc, boolean hideAtXl = false ) {
		var listHtml = '<ul>'
		for ( var item in arguments.toc ) {
			listHtml &= '<li class="vp-toc__item vp-toc__item--' & item.level & '"><a href="##' & item.id & '">' & encodeForHTML( item.text ) & '</a></li>'
		}
		listHtml &= '</ul>'

		if ( arguments.hideAtXl ) {
			return '<details class="bxsites-toc-mobile vp-toc--mobile"><summary class="vp-toc--mobile__summary">' & bxsitesIcon( "outline" ) & ' ' & encodeForHTML( variables.strings.onThisPage ) & '</summary>' & listHtml & '</details>'
		}

		return '<nav class="vp-toc bxsites-toc" aria-label="' & encodeForHTML( variables.strings.onThisPage ) & '"><div class="vp-toc__title bxsites-toc__title">' & bxsitesIcon( "outline" ) & ' ' & encodeForHTML( variables.strings.onThisPage ) & '</div>' & listHtml & '</nav>'
	}

	function tagSlug( required string tag ) {
		var slug = createObject( "java", "java.util.regex.Pattern" ).compile( "[^\p{L}\p{N}]+" ).matcher( lCase( trim( arguments.tag ) ) ).replaceAll( "-" )
		return slug.reReplace( "(^-|-$)", "", "all" )
	}

	function renderTags( required array tags ) {
		if ( !arguments.tags.len() ) {
			return ""
		}
		var html = '<div class="page-tags">'
		for ( var tag in arguments.tags ) {
			html &= '<a class="page-tag" href="' & variables.basePath & 'tags/index.html##tag-' & tagSlug( tag ) & '">' & encodeForHTML( tag ) & '</a>'
		}
		html &= '</div>'
		return html
	}

	// buildLocalesList() (BuildPipeline.bx) always puts the default locale first.
	function defaultLocaleLabel() {
		return variables.locales.len() ? variables.locales[ 1 ].label : ""
	}
</bx:script>
<bx:output>
			<article class="vp-card">
<bx:if variables.pageActionsEnabled and variables.pageActionsPosition == 'top'>
	#renderPageActions()#
</bx:if>
<bx:if variables.page.isFallbackContent>
				<p class="fallback-notice">#bxsitesIcon( 'globe' )# #encodeForHTML( variables.stringsResolver.format( variables.strings.notTranslatedNotice, { "locale" : defaultLocaleLabel() } ) )#</p>
</bx:if>
<bx:if variables.breadcrumbsEnabled and variables.page.breadcrumbs.len() gt 1>
	#renderBreadcrumbs( variables.page.breadcrumbs )#
</bx:if>
				<h1 class="vp-title" id="page-title"><a href="##page-title" id="page-title" class="anchor"></a>
<bx:if len( variables.page.iconHtml )>
	<span class="page-icon">#variables.page.iconHtml#</span>
</bx:if>
#encodeForHTML( variables.page.title )#</h1>
<bx:if len( variables.page.summary )>
	<p class="page-summary">#encodeForHTML( variables.page.summary )#</p>
</bx:if>
<bx:if variables.page.tags.len() gt 0>
	#renderTags( variables.page.tags )#
</bx:if>
<bx:if ( len( variables.page.editUrl ) or len( variables.page.lastUpdated ) or len( variables.page.markdownUrl ) ) and variables.pageMetaPosition == 'top'>
	#renderPageMeta( variables.page.editUrl, variables.page.lastUpdated, variables.page.markdownUrl )#
</bx:if>
<bx:if variables.page.toc.len() gt 0 and variables.tocPosition == 'top'>
	#renderToc( variables.page.toc )#
</bx:if>
<bx:if variables.page.toc.len() gt 0 and variables.tocPosition == 'sticky'>
	#renderToc( variables.page.toc, true )#
</bx:if>
				<div class="vp-content-body">
				#variables.page.contentHtml#
			</div>
<bx:if ( len( variables.page.editUrl ) or len( variables.page.lastUpdated ) or len( variables.page.markdownUrl ) ) and variables.pageMetaPosition == 'bottom'>
	#renderPageMeta( variables.page.editUrl, variables.page.lastUpdated, variables.page.markdownUrl )#
</bx:if>
			</article>
<bx:if len( variables.page.prevPage.url ) or len( variables.page.nextPage.url )>
			<nav class="vp-page-nav" aria-label="#encodeForHTML( variables.strings.pageNavigation )#">
<bx:if len( variables.page.prevPage.url )>
				<a class="vp-page-nav__card vp-page-nav__card--prev" href="#variables.basePath##variables.page.prevPage.url#">
					<span class="vp-page-nav__icon">#bxsitesIcon( "chevron-down" )#</span>
					<span class="vp-page-nav__text">
						<span class="vp-page-nav__label">#encodeForHTML( variables.strings.pagePrevious )#</span>
						<span class="vp-page-nav__title">#encodeForHTML( variables.page.prevPage.title )#</span>
					</span>
				</a>
</bx:if>
<bx:if !len( variables.page.prevPage.url )>
				<span></span>
</bx:if>
<bx:if len( variables.page.nextPage.url )>
				<a class="vp-page-nav__card vp-page-nav__card--next" href="#variables.basePath##variables.page.nextPage.url#">
					<span class="vp-page-nav__text">
						<span class="vp-page-nav__label">#encodeForHTML( variables.strings.pageNext )#</span>
						<span class="vp-page-nav__title">#encodeForHTML( variables.page.nextPage.title )#</span>
					</span>
					<span class="vp-page-nav__icon">#bxsitesIcon( "chevron-down" )#</span>
				</a>
</bx:if>
			</nav>
</bx:if>
<bx:if variables.pageActionsEnabled and variables.pageActionsPosition == 'bottom'>
	#renderPageActions()#
</bx:if>


</bx:output>
