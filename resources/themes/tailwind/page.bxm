<bx:script>
	function renderBreadcrumbs( required array crumbs ) {
		if ( !arguments.crumbs.len() ) {
			return ""
		}
		var html = '<nav class="mb-4 text-sm text-slate-500" aria-label="breadcrumb"><ol class="flex flex-wrap items-center gap-1">'
		for ( var i = 1; i <= arguments.crumbs.len(); i++ ) {
			var crumb = arguments.crumbs[ i ]
			if ( i > 1 ) {
				html &= '<li aria-hidden="true">/</li>'
			}
			if ( i == arguments.crumbs.len() ) {
				html &= '<li class="font-semibold text-slate-700" aria-current="page">' & encodeForHTML( crumb.title ) & '</li>'
			} else {
				html &= '<li><a class="hover:text-cyan-700" href="' & variables.basePath & crumb.url & '">' & encodeForHTML( crumb.title ) & '</a></li>'
			}
		}
		html &= '</ol></nav>'
		return html
	}

	function renderPageMeta( required string editUrl, required string lastUpdated, required string markdownUrl ) {
		var html = '<div class="page-meta mb-4 flex flex-wrap items-center gap-4 text-xs text-slate-500">'
		if ( len( arguments.editUrl ) ) {
			html &= '<a class="inline-flex items-center gap-1 hover:text-cyan-700" href="' & encodeForHTML( arguments.editUrl ) & '" target="_blank" rel="noopener noreferrer">' & bxdocsIcon( "edit" ) & ' Edit this page</a>'
		}
		if ( len( arguments.markdownUrl ) ) {
			// A minimal attribute-safe escape, not encodeForHTML() - that also
			// entity-escapes "safe" characters like "/" (its exact range is
			// locale/JVM-dependent), needlessly noisy in a plain URL attribute.
			var escapedMarkdownUrl = arguments.markdownUrl.replace( "&", "&amp;", "all" ).replace( '"', "&quot;", "all" ).replace( "<", "&lt;", "all" )
			html &= '<a class="inline-flex items-center gap-1 hover:text-cyan-700" href="' & variables.basePath & escapedMarkdownUrl & '" download>' & bxdocsIcon( "markdown" ) & ' Download Markdown</a>'
		}
		if ( len( arguments.lastUpdated ) ) {
			html &= '<span class="inline-flex items-center gap-1">' & bxdocsIcon( "clock" ) & ' Last updated ' & encodeForHTML( dateTimeFormat( arguments.lastUpdated, "medium" ) ) & '</span>'
		}
		html &= '</div>'
		return html
	}

	function renderToc( required array toc ) {
		var html = '<nav class="mb-6 rounded border border-slate-200 bg-cyan-50/40 px-4 py-3 text-sm">'
		html &= '<div class="mb-1 text-xs font-semibold uppercase tracking-wide text-slate-500">On this page</div><ul class="space-y-1">'
		for ( var item in arguments.toc ) {
			var indent = item.level == 3 ? " ml-4" : ""
			html &= '<li class="' & indent & '"><a class="text-slate-700 hover:text-cyan-700" href="##' & item.id & '">' & encodeForHTML( item.text ) & '</a></li>'
		}
		html &= '</ul></nav>'
		return html
	}

	function tagSlug( required string tag ) {
		return lCase( trim( arguments.tag ) ).reReplace( "[^a-z0-9]+", "-", "all" ).reReplace( "(^-|-$)", "", "all" )
	}

	function renderTags( required array tags ) {
		if ( !arguments.tags.len() ) {
			return ""
		}
		var html = '<div class="mb-4 flex flex-wrap gap-2">'
		for ( var tag in arguments.tags ) {
			html &= '<a class="rounded-full bg-cyan-50 px-3 py-1 text-xs font-semibold text-cyan-700 hover:bg-cyan-100" href="' & variables.basePath & 'tags/index.html##tag-' & tagSlug( tag ) & '">' & encodeForHTML( tag ) & '</a>'
		}
		html &= '</div>'
		return html
	}
</bx:script>
<bx:output>			<article class="rounded-lg bg-white p-8 shadow-sm ring-1 ring-slate-200">
</bx:output><bx:if condition="#variables.page.breadcrumbs.len() gt 1#"><bx:output>#renderBreadcrumbs( variables.page.breadcrumbs )#</bx:output></bx:if><bx:output>
				<h1 class="mb-6 border-b-4 border-[##FFF500] pb-2 text-2xl font-bold"></bx:output><bx:if condition="#len( variables.page.iconHtml )#"><bx:output><span class="page-icon">#variables.page.iconHtml#</span> </bx:output></bx:if><bx:output>#encodeForHTML( variables.page.title )#</h1>
</bx:output><bx:if condition="#len( variables.page.summary )#"><bx:output>				<p class="mb-6 -mt-4 text-lg text-slate-500">#encodeForHTML( variables.page.summary )#</p>
</bx:output></bx:if><bx:if condition="#variables.page.tags.len() gt 0#"><bx:output>#renderTags( variables.page.tags )#</bx:output></bx:if><bx:if condition="#len( variables.page.editUrl ) or len( variables.page.lastUpdated ) or len( variables.page.markdownUrl )#"><bx:output>#renderPageMeta( variables.page.editUrl, variables.page.lastUpdated, variables.page.markdownUrl )#</bx:output></bx:if><bx:output>
</bx:output><bx:if condition="#variables.page.toc.len() gt 0#"><bx:output>#renderToc( variables.page.toc )#</bx:output></bx:if><bx:output>
				<div class="prose max-w-none">
					#variables.page.contentHtml#
				</div>
			</article>
</bx:output><bx:if condition="#len( variables.page.prevPage.url ) or len( variables.page.nextPage.url )#"><bx:output>
			<nav class="mt-8 flex justify-between border-t border-slate-200 pt-4 text-sm font-semibold" aria-label="Page navigation">
</bx:output><bx:if condition="#len( variables.page.prevPage.url )#"><bx:output>
				<a class="text-cyan-700 hover:text-cyan-900" href="#variables.basePath##variables.page.prevPage.url#">&larr; #encodeForHTML( variables.page.prevPage.title )#</a>
</bx:output></bx:if><bx:if condition="#!len( variables.page.prevPage.url )#"><bx:output>
				<span></span>
</bx:output></bx:if><bx:if condition="#len( variables.page.nextPage.url )#"><bx:output>
				<a class="text-cyan-700 hover:text-cyan-900" href="#variables.basePath##variables.page.nextPage.url#">#encodeForHTML( variables.page.nextPage.title )# &rarr;</a>
</bx:output></bx:if><bx:output>
			</nav>
</bx:output></bx:if><bx:output>
</bx:output>
