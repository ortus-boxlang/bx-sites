<bx:script>
	function renderBreadcrumbs( required array crumbs ) {
		if ( !arguments.crumbs.len() ) {
			return ""
		}
		var html = '<nav class="mb-4 text-sm text-slate-500" aria-label="breadcrumb"><ol class="flex flex-wrap items-center gap-1">'
		for ( var i = 1; i <= arguments.crumbs.len(); i++ ) {
			var crumb = arguments.crumbs[ i ]
			if ( i > 1 ) {
				html &= '<li aria-hidden="true">/</li>'
			}
			if ( i == arguments.crumbs.len() ) {
				html &= '<li class="font-semibold text-slate-700" aria-current="page">' & encodeForHTML( crumb.title ) & '</li>'
			} else {
				html &= '<li><a class="hover:text-cyan-700" href="' & variables.basePath & crumb.url & '">' & encodeForHTML( crumb.title ) & '</a></li>'
			}
		}
		html &= '</ol></nav>'
		return html
	}

	function renderPageMeta( required string editUrl, required string lastUpdated, required string markdownUrl, boolean isBottom = false ) {
		var positionClass = arguments.isBottom ? "mt-8 border-t border-slate-200 pt-4" : "mb-4"
		var html = '<div class="page-meta ' & positionClass & ' flex flex-wrap items-center gap-4 text-xs text-slate-500">'
		if ( len( arguments.editUrl ) ) {
			// A minimal attribute-safe escape, not encodeForHTML() - that also
			// entity-escapes "safe" characters like "/" (its exact range is
			// locale/JVM-dependent), needlessly noisy in a plain URL attribute.
			var escapedEditUrl = arguments.editUrl.replace( "&", "&amp;", "all" ).replace( '"', "&quot;", "all" ).replace( "<", "&lt;", "all" )
			html &= '<a class="inline-flex items-center gap-1 hover:text-cyan-700" href="' & escapedEditUrl & '" target="_blank" rel="noopener noreferrer">' & bxsitesIcon( "edit" ) & ' Edit this page</a>'
		}
		if ( len( arguments.markdownUrl ) ) {
			// Same reasoning as escapedEditUrl above.
			var escapedMarkdownUrl = arguments.markdownUrl.replace( "&", "&amp;", "all" ).replace( '"', "&quot;", "all" ).replace( "<", "&lt;", "all" )
			html &= '<a class="inline-flex items-center gap-1 hover:text-cyan-700" href="' & variables.basePath & escapedMarkdownUrl & '" download>' & bxsitesIcon( "markdown" ) & ' Download Markdown</a>'
		}
		if ( len( arguments.lastUpdated ) ) {
			html &= '<span class="inline-flex items-center gap-1">' & bxsitesIcon( "clock" ) & ' Last updated ' & encodeForHTML( dateTimeFormat( arguments.lastUpdated, "medium" ) ) & '</span>'
		}
		html &= '</div>'
		return html
	}

	// @hideAtXl true for the sticky-position variant's own mobile/tablet
	// fallback - the right-hand rail (layout.bxm's own "hidden ... xl:block")
	// can't fit below xl, so this renders as a collapsible bar pinned to
	// the top of the viewport while scrolling instead (VitePress/GitBook's
	// own mobile "On this page" treatment), hidden again once the rail
	// takes over at xl+ via the same "xl:hidden" utility, rather than
	// leaving the TOC inaccessible below xl.
	function renderToc( required array toc, boolean hideAtXl = false ) {
		var listHtml = '<ul class="space-y-1">'
		for ( var item in arguments.toc ) {
			var indent = item.level == 3 ? " ml-4" : ""
			listHtml &= '<li class="' & indent & '"><a class="text-slate-700 hover:text-cyan-700" href="##' & item.id & '">' & encodeForHTML( item.text ) & '</a></li>'
		}
		listHtml &= '</ul>'

		if ( arguments.hideAtXl ) {
			return '<details class="bxsites-toc-mobile group sticky top-0 z-10 mb-6 max-h-screen overflow-y-auto rounded border border-slate-200 bg-cyan-50/95 text-sm backdrop-blur xl:hidden">' &
				'<summary class="flex list-none items-center justify-between gap-2 px-4 py-3 text-xs font-semibold uppercase tracking-wide text-slate-500">' &
				'On this page<span class="h-1.5 w-1.5 shrink-0 rotate-45 border-b-2 border-r-2 border-current transition-transform group-open:-rotate-[135deg]"></span>' &
				'</summary><div class="px-4 pb-3">' & listHtml & '</div></details>'
		}

		return '<nav class="mb-6 rounded border border-slate-200 bg-cyan-50/40 px-4 py-3 text-sm"><div class="mb-1 text-xs font-semibold uppercase tracking-wide text-slate-500">On this page</div>' &
			listHtml & '</nav>'
	}

	function tagSlug( required string tag ) {
		var slug = createObject( "java", "java.util.regex.Pattern" ).compile( "[^\p{L}\p{N}]+" ).matcher( lCase( trim( arguments.tag ) ) ).replaceAll( "-" )
		return slug.reReplace( "(^-|-$)", "", "all" )
	}

	function renderTags( required array tags ) {
		if ( !arguments.tags.len() ) {
			return ""
		}
		var html = '<div class="mb-4 flex flex-wrap gap-2">'
		for ( var tag in arguments.tags ) {
			html &= '<a class="rounded-full bg-cyan-50 px-3 py-1 text-xs font-semibold text-cyan-700 hover:bg-cyan-100" href="' & variables.basePath & 'tags/index.html##tag-' & tagSlug( tag ) & '">' & encodeForHTML( tag ) & '</a>'
		}
		html &= '</div>'
		return html
	}

	// buildLocalesList() (BuildPipeline.bx) always puts the default locale first.
	function defaultLocaleLabel() {
		return variables.locales.len() ? variables.locales[ 1 ].label : ""
	}
</bx:script>
<bx:output>			<article class="rounded-lg bg-white p-8 shadow-sm ring-1 ring-slate-200">
</bx:output><bx:if condition="#variables.page.isFallbackContent#"><bx:output>
				<p class="fallback-notice mb-6 flex items-center gap-2 rounded border border-amber-300 bg-amber-50 px-4 py-2 text-sm text-amber-900">#bxsitesIcon( 'globe' )# This page hasn't been translated yet - showing the #encodeForHTML( defaultLocaleLabel() )# version.</p>
</bx:output></bx:if><bx:if condition="#variables.page.breadcrumbs.len() gt 1#"><bx:output>#renderBreadcrumbs( variables.page.breadcrumbs )#</bx:output></bx:if><bx:output>
				<h1 class="relative mb-6 border-b-4 border-[##FFF500] pb-2 text-2xl font-bold" id="page-title"><a href="##page-title" id="page-title" class="anchor"></a></bx:output><bx:if condition="#len( variables.page.iconHtml )#"><bx:output><span class="page-icon">#variables.page.iconHtml#</span> </bx:output></bx:if><bx:output>#encodeForHTML( variables.page.title )#</h1>
</bx:output><bx:if condition="#len( variables.page.summary )#"><bx:output>				<p class="mb-6 -mt-4 text-lg text-slate-500">#encodeForHTML( variables.page.summary )#</p>
</bx:output></bx:if><bx:if condition="#variables.page.tags.len() gt 0#"><bx:output>#renderTags( variables.page.tags )#</bx:output></bx:if><bx:if condition="#( len( variables.page.editUrl ) or len( variables.page.lastUpdated ) or len( variables.page.markdownUrl ) ) and variables.pageMetaPosition == 'top'#"><bx:output>#renderPageMeta( variables.page.editUrl, variables.page.lastUpdated, variables.page.markdownUrl )#</bx:output></bx:if><bx:output>
</bx:output><bx:if condition="#variables.page.toc.len() gt 0 and variables.tocPosition == 'top'#"><bx:output>#renderToc( variables.page.toc )#</bx:output></bx:if><bx:if condition="#variables.page.toc.len() gt 0 and variables.tocPosition == 'sticky'#"><bx:output>#renderToc( variables.page.toc, true )#</bx:output></bx:if><bx:output>
				<div class="prose max-w-none">
					#variables.page.contentHtml#
				</div>
</bx:output><bx:if condition="#( len( variables.page.editUrl ) or len( variables.page.lastUpdated ) or len( variables.page.markdownUrl ) ) and variables.pageMetaPosition == 'bottom'#"><bx:output>#renderPageMeta( variables.page.editUrl, variables.page.lastUpdated, variables.page.markdownUrl, true )#</bx:output></bx:if><bx:output>
			</article>
</bx:output><bx:if condition="#len( variables.page.prevPage.url ) or len( variables.page.nextPage.url )#"><bx:output>
			<nav class="mt-8 flex justify-between border-t border-slate-200 pt-4 text-sm font-semibold" aria-label="Page navigation">
</bx:output><bx:if condition="#len( variables.page.prevPage.url )#"><bx:output>
				<a class="text-cyan-700 hover:text-cyan-900" href="#variables.basePath##variables.page.prevPage.url#">&larr; #encodeForHTML( variables.page.prevPage.title )#</a>
</bx:output></bx:if><bx:if condition="#!len( variables.page.prevPage.url )#"><bx:output>
				<span></span>
</bx:output></bx:if><bx:if condition="#len( variables.page.nextPage.url )#"><bx:output>
				<a class="text-cyan-700 hover:text-cyan-900" href="#variables.basePath##variables.page.nextPage.url#">#encodeForHTML( variables.page.nextPage.title )# &rarr;</a>
</bx:output></bx:if><bx:output>
			</nav>
</bx:output></bx:if><bx:output>
</bx:output>
