	<input type="search" id="bxdocs-search-input" class="w-full rounded border border-slate-300 px-3 py-1.5 text-sm" placeholder="Search docs..." aria-label="Search">
	<ul id="bxdocs-search-results" class="bxdocs-search-results absolute z-10 mt-1 w-full rounded border border-slate-200 bg-white shadow-lg"></ul>
</div>
</bx:output>
