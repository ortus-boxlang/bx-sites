<bx:if condition="#variables.searchProviderName eq 'algolia'#"><bx:output><div id="bxsites-search-algolia" class="bxsites-search-algolia"></div>
</bx:output></bx:if><bx:if condition="#variables.searchProviderName eq 'pagefind'#"><bx:output><div id="bxsites-search-pagefind" class="bxsites-search-pagefind"></div>
</bx:output></bx:if><bx:if condition="#variables.searchProviderName eq 'local'#"><bx:output><div class="bxsites-search relative">
	<input type="search" id="bxsites-search-input" class="w-full rounded border border-slate-300 px-3 py-1.5 text-sm" placeholder="Search docs..." aria-label="Search">
	<kbd class="bxsites-search-kbd" aria-hidden="true">Ctrl K</kbd>
	<ul id="bxsites-search-results" class="bxsites-search-results absolute z-10 mt-1 w-full rounded border border-slate-200 bg-white shadow-lg"></ul>
</div>
</bx:output></bx:if>
