<bx:output>
<bx:if variables.searchProviderName eq 'algolia'><div id="bxsites-search-algolia" class="bxsites-search-algolia"></div>
</bx:if><bx:if variables.searchProviderName eq 'pagefind'><div id="bxsites-search-pagefind" class="bxsites-search-pagefind"></div>
</bx:if><bx:if variables.searchProviderName eq 'local'><div class="bxsites-search relative">
	<input type="search" id="bxsites-search-input" class="w-full rounded border border-slate-300 px-3 py-1.5 text-sm" placeholder="#encodeForHTML( variables.strings.searchPlaceholder )#" aria-label="#encodeForHTML( variables.strings.searchAriaLabel )#">
	<kbd class="bxsites-search-kbd" aria-hidden="true">Ctrl K</kbd>
	<ul id="bxsites-search-results" class="bxsites-search-results absolute z-10 mt-1 w-full rounded border border-slate-200 bg-white shadow-lg"></ul>
</div>
</bx:if>

</bx:output>
