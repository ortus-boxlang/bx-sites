<bx:script>
	/**
	 * Renders the sidebar navigation tree as nested <ul>/<li> markup.
	 * A node is "active" when its URL matches the current page's own
	 * `urlPath` (or, on a course lesson page, the course index URL).
	 * URL-less nodes render as disabled <span>s. With `navCollapsible`,
	 * parent nodes get a toggle button and their child list starts
	 * collapsed unless the subtree contains the active page or
	 * `navExpandAll` is on. `nested`/`collapsed` track recursion state.
	 */
	function renderNavList( required array nodes, boolean nested = false, boolean collapsed = false ) {
		var html = sb{ "<ul class=""nav flex-column" & ( arguments.nested ? " nav--nested bxsites-nav-nested" : "" ) & """" & ( arguments.collapsed ? " hidden" : "" ) & ">" }
		for ( var node in arguments.nodes ) {
			var isActive = len( node.url ) && ( node.url == variables.page.urlPath || ( len( variables.page.course.id ) && node.url == variables.page.course.indexUrl ) )
			var linkClass = "nav-link" & ( isActive ? " active" : "" )
			var labelHtml = ( len( node.iconHtml ?: "" ) ? node.iconHtml & " " : "" ) & encodeForHTML( node.title )
			var linkOrSpan = len( node.url )
				? "<a class=""" & linkClass & """ href=""" & bxsitesNavHref( node.url, variables.basePath ) & """>" & labelHtml & "</a>"
				: "<span class=""nav-link disabled"">" & labelHtml & "</span>"

			if ( node.children.len() && variables.navCollapsible ) {
				var open = variables.navExpandAll || navContainsActive( node )
				html &= "<li class=""nav-item nav-item--group"">"
				html &= "<div class=""nav-group-header"">" & linkOrSpan
				html &= "<button type=""button"" class=""nav-toggle"" aria-expanded=""" & ( open ? "true" : "false" ) & """ aria-label=""" & encodeForHTML( variables.stringsResolver.format( variables.strings.toggleSection, { "title" : node.title } ) ) & """><span class=""nav-toggle__icon"" aria-hidden=""true"">" & bxsitesIcon( "chevron-down" ) & "</span></button>"
				html &= "</div>"
				html &= renderNavList( node.children, true, !open )
				html &= "</li>"
				continue
			}

			html &= "<li class=""nav-item"">" & linkOrSpan
			if ( node.children.len() ) {
				html &= renderNavList( node.children, true )
			}
			html &= "</li>"
		}
		html &= "</ul>"
		return html
	}

	/**
	 * True when the given nav node (or any descendant) is the current
	 * page - renderNavList() uses this to decide whether a collapsible
	 * group should start open. Same active definition as renderNavList()
	 * itself uses (page URL match, or course index URL on lesson pages).
	 */
	boolean function navContainsActive( required struct node ) {
		if ( len( arguments.node.url ) && ( arguments.node.url == variables.page.urlPath || ( len( variables.page.course.id ) && arguments.node.url == variables.page.course.indexUrl ) ) ) {
			return true
		}
		for ( var child in arguments.node.children ) {
			if ( navContainsActive( child ) ) {
				return true
			}
		}
		return false
	}

	/**
	 * Renders the footer's/social row icon anchors - one anchor per entry
	 * in bxsites.yaml's own `social` list. `icon` picks the glyphs via
	 * bxsitesIcon() (icons.bxm); `label` (or the icon name as fallback)
	 * goes into aria-label/title. Empty list renders nothing.
	 */
	function renderSocialLinks( required array links ) {
		var html = sb{ "" }
		for ( var link in arguments.links ) {
			html &= '<a class="social-link" href="' & bxsitesUrlAttr( link.url ) & '" target="_blank" rel="noopener noreferrer" aria-label="' & encodeForHTML( link.label ?: link.icon ?: "Link" ) & '" title="' & encodeForHTML( link.label ?: link.icon ?: "Link" ) & '">' & bxsitesIcon( link.icon ?: "generic" ) & '</a>'
		}
		return html
	}

	/**
	 * A flag-icon dropdown - the trigger button shows the
	 * current locale's own flag, opening a menu listing every locale by
	 * its own flag + label. A locale's `flag` (bxsites.json's own
	 * `i18n.locales[].flag`) wins when set; bxsitesLocaleFlag() falls back
	 * to a built-in language-code lookup otherwise (locale-flags.bxm).
	 * Alpine (already loaded for the dark-mode toggle) drives open/close -
	 * no new JS dependency.
	 */
	function renderLocaleDropdown( required array locales, required string currentLocale ) {
		var current = locales[ 1 ]
		for ( var l in arguments.locales ) {
			if ( l.code == arguments.currentLocale ) {
				current = l
				break
			}
		}
		var currentFlag = len( current.flag ?: "" ) ? current.flag : bxsitesLocaleFlag( current.code )

		var html = sb{ '<div class="locale-dropdown" x-data="{ open: false }" @click.outside="open = false" @keydown.escape.window="open = false">' }
		html &= '<button type="button" class="locale-dropdown__trigger" @click="open = !open" aria-haspopup="true" :aria-expanded="open" aria-label="' & encodeForHTML( variables.stringsResolver.format( variables.strings.language, { "label" : current.label } ) ) & '">'
		html &= '<span class="locale-dropdown__flag" aria-hidden="true">' & currentFlag & '</span>'
		html &= '<span class="locale-dropdown__caret" aria-hidden="true">▾</span>'
		html &= '</button>'
		html &= '<ul class="locale-dropdown__menu" x-show="open" x-cloak role="menu">'
		for ( var l in arguments.locales ) {
			var flag = len( l.flag ?: "" ) ? l.flag : bxsitesLocaleFlag( l.code )
			var active = l.code == arguments.currentLocale
			html &= '<li role="none"><a role="menuitem" class="locale-dropdown__item' & ( active ? ' locale-dropdown__item--active' : '' ) & '" href="' & bxsitesUrlAttr( l.url ) & '">'
			html &= '<span class="locale-dropdown__flag" aria-hidden="true">' & flag & '</span> ' & encodeForHTML( l.label )
			html &= '</a></li>'
		}
		html &= '</ul></div>'
		return html
	}

	/**
	 * Resolves a config URL (favicon/ogImage/extraCss/extraJs/theme style)
	 * for the head's own <link>/<script> tags. Absolute URLs with a scheme
	 * (https:, urn:, etc.) pass through untouched (regex protects scheme
	 * chars like "+" and "." too); everything else gets prefixed with the
	 * site's own basePath. Used by most head-asset helpers below.
	 */
	function resolveAssetUrl( required string url ) {
		return arguments.url.reFindNoCase( "^[a-z][a-z0-9+.\-]*://" ) ? arguments.url : variables.basePath & arguments.url
	}

	/**
	 * Emits `article:published_time` and one `article:author` <meta> tag
	 * per element of page.articleAuthorUrls - Open Graph extras for blog
	 * posts (byline data comes from BlogBuilder.bx). Returns "" when the
	 * page has no publishedTime, so the head stays clean on plain docs.
	 */
	function renderArticleMeta() {
		if ( !len( trim( variables.page.publishedTime ?: "" ) ) ) {
			return ""
		}
		var html = sb{ '<meta property="article:published_time" content="' & encodeForHTML( variables.page.publishedTime ) & '">' }
		for ( var authorUrl in ( variables.page.articleAuthorUrls ?: [] ) ) {
			html &= '<meta property="article:author" content="' & encodeForHTML( authorUrl ) & '">'
		}
		return html
	}

	/**
	 * Builds the header/footer brand mark. With a `theme.logo` configured,
	 * emits an <img> (empty alt - decorative) followed by the site name in
	 * a <span>; the bare fallback is the ⚡ glyph plus the site name. Runs
	 * the logo through resolveAssetUrl() so a base path site still finds it.
	 */
	function renderBrandMark() {
		var logo = trim( variables.siteConfig.theme.logo ?: "" )
		var name = encodeForHTML( variables.siteConfig.name )
		if ( len( logo ) ) {
			return '<img class="brand-logo" src="' & resolveAssetUrl( logo ) & '" alt=""><span class="brand-name">' & name & '</span>'
		}
		return '⚡ ' & name
	}

	/**
	 * Emits one <link rel="stylesheet"> per entry of bxsites.yaml's own
	 * `extraCss` list, resolved through resolveAssetUrl() (absolute URLs
	 * keep working, relative paths get the basePath). Returns "" for an
	 * empty list so the head stays clean.
	 */
	function renderExtraCss( required array urls ) {
		var html = sb{ "" }
		for ( var url in arguments.urls ) {
			html &= '<link rel="stylesheet" href="' & resolveAssetUrl( url ) & '">'
		}
		return html
	}

	/**
	 * Emits one deferred <script> per entry of bxsites.yaml's own
	 * `extraJs` list, resolved through resolveAssetUrl(). Deferred so the
	 * raw `</body>`-end position alone can't block parsing; matching the
	 * layouts' own pattern of always-in-list scripts. "" when empty.
	 */
	function renderExtraJs( required array urls ) {
		var html = sb{ "" }
		for ( var url in arguments.urls ) {
			html &= '<script src="' & resolveAssetUrl( url ) & '" defer></script>'
		}
		return html
	}
</bx:script>
