<bx:include template="#variables.moduleAssetsDir#/icons.bxm">
<bx:include template="#variables.moduleAssetsDir#/locale-flags.bxm">
<bx:script>
	/**
	 * Recursively renders a nav tree (module spec section 5, step 4) as a
	 * nested Bootstrap nav list. A node with no `url` (a folder with no
	 * `index.md`) renders as a disabled section heading instead of a link.
	 * `nested` marks every level below the top one with `nav--nested` so
	 * style.css can indent it - without that, a child `<ul>` shares the
	 * exact same class as the top-level list and reads as one flat list.
	 */
	function renderNavList( required array nodes, boolean nested = false ) {
		var html = "<ul class=""nav flex-column" & ( arguments.nested ? " nav--nested" : "" ) & """>"
		for ( var node in arguments.nodes ) {
			if ( !len( node.url ) && node.children.len() && variables.navCollapsible ) {
				html &= "<li class=""nav-item""><details class=""nav-section""" & ( variables.navExpandAll ? " open" : "" ) & "><summary class=""nav-link"">" & ( len( node.iconHtml ?: "" ) ? node.iconHtml & " " : "" ) & encodeForHTML( node.title ) & "</summary>" & renderNavList( node.children, true ) & "</details></li>"
				continue
			}
			html &= "<li class=""nav-item"">"
			if ( len( node.url ) ) {
				html &= "<a class=""nav-link"" href=""" & variables.basePath & node.url & """>" & ( len( node.iconHtml ?: "" ) ? node.iconHtml & " " : "" ) & encodeForHTML( node.title ) & "</a>"
			} else {
				html &= "<span class=""nav-link disabled"">" & ( len( node.iconHtml ?: "" ) ? node.iconHtml & " " : "" ) & encodeForHTML( node.title ) & "</span>"
			}
			if ( node.children.len() ) {
				html &= renderNavList( node.children, true )
			}
			html &= "</li>"
		}
		html &= "</ul>"
		return html
	}

	function renderSocialLinks( required array links ) {
		var html = ""
		for ( var link in arguments.links ) {
			html &= '<a class="social-link" href="' & encodeForHTML( link.url ) & '" target="_blank" rel="noopener noreferrer" aria-label="' & encodeForHTML( link.label ?: link.icon ?: "Link" ) & '" title="' & encodeForHTML( link.label ?: link.icon ?: "Link" ) & '">' & bxdocsIcon( link.icon ?: "generic" ) & '</a>'
		}
		return html
	}

	function renderVersionSwitcher( required array versions, required string currentVersion ) {
		var html = '<select class="version-switcher form-select form-select-sm" onchange="location.href=this.value" aria-label="Version">'
		for ( var v in arguments.versions ) {
			var selected = v.label == arguments.currentVersion ? " selected" : ""
			html &= '<option value="' & encodeForHTML( v.url ) & '"' & selected & '>' & encodeForHTML( v.label ) & '</option>'
		}
		html &= '</select>'
		return html
	}

	/**
	 * A GitBook-style flag-icon dropdown - the trigger button shows the
	 * current locale's own flag, opening a menu listing every locale by
	 * its own flag + label. A locale's `flag` (bxdocs.json's own
	 * `i18n.locales[].flag`) wins when set; bxdocsLocaleFlag() falls back
	 * to a built-in language-code lookup otherwise (locale-flags.bxm).
	 * Alpine (already loaded for the dark-mode toggle) drives open/close -
	 * no new JS dependency.
	 */
	function renderLocaleDropdown( required array locales, required string currentLocale ) {
		var current = locales[ 1 ]
		for ( var l in arguments.locales ) {
			if ( l.code == arguments.currentLocale ) {
				current = l
				break
			}
		}
		var currentFlag = len( current.flag ?: "" ) ? current.flag : bxdocsLocaleFlag( current.code )

		var html = '<div class="locale-dropdown" x-data="{ open: false }" @click.outside="open = false" @keydown.escape.window="open = false">'
		html &= '<button type="button" class="locale-dropdown__trigger" @click="open = !open" aria-haspopup="true" :aria-expanded="open" aria-label="Language: ' & encodeForHTML( current.label ) & '">'
		html &= '<span class="locale-dropdown__flag" aria-hidden="true">' & currentFlag & '</span>'
		html &= '<span class="locale-dropdown__caret" aria-hidden="true">▾</span>'
		html &= '</button>'
		html &= '<ul class="locale-dropdown__menu" x-show="open" x-cloak role="menu">'
		for ( var l in arguments.locales ) {
			var flag = len( l.flag ?: "" ) ? l.flag : bxdocsLocaleFlag( l.code )
			var active = l.code == arguments.currentLocale
			html &= '<li role="none"><a role="menuitem" class="locale-dropdown__item' & ( active ? ' locale-dropdown__item--active' : '' ) & '" href="' & encodeForHTML( l.url ) & '">'
			html &= '<span class="locale-dropdown__flag" aria-hidden="true">' & flag & '</span> ' & encodeForHTML( l.label )
			html &= '</a></li>'
		}
		html &= '</ul></div>'
		return html
	}

	// resolves a bxdocs.json asset path (logo/favicon/ogImage/extraCss/extraJs) - left
	// alone when it's already an absolute URL, otherwise prefixed with basePath
	function resolveAssetUrl( required string url ) {
		return arguments.url.reFindNoCase( "^[a-z][a-z0-9+.\-]*://" ) ? arguments.url : variables.basePath & arguments.url
	}

	function renderBrandMark() {
		var logo = trim( variables.siteConfig.theme.logo ?: "" )
		var name = encodeForHTML( variables.siteConfig.name )
		if ( len( logo ) ) {
			return '<img class="brand-logo" src="' & resolveAssetUrl( logo ) & '" alt=""><span class="brand-name">' & name & '</span>'
		}
		return '⚡ ' & name
	}

	function renderExtraCss( required array urls ) {
		var html = ""
		for ( var url in arguments.urls ) {
			html &= '<link rel="stylesheet" href="' & resolveAssetUrl( url ) & '">'
		}
		return html
	}

	function renderExtraJs( required array urls ) {
		var html = ""
		for ( var url in arguments.urls ) {
			html &= '<script src="' & resolveAssetUrl( url ) & '" defer></script>'
		}
		return html
	}

	// module spec section 7 - search is fully static/client-side and opt-out via bxdocs.json
	variables.searchEnabled = ( variables.siteConfig.search ?: false ) ? true : false
	variables.repoUrl = trim( variables.siteConfig.repo.url ?: "" )
	variables.socialLinks = variables.siteConfig.social ?: []
	variables.footerEnabled = ( variables.siteConfig.footer ?: false ) ? true : false
	variables.navCollapsible = ( variables.siteConfig.theme.options.navCollapsible ?: false ) ? true : false
	variables.navExpandAll = ( variables.siteConfig.theme.options.navExpandAll ?: true ) ? true : false
	variables.faviconUrl = trim( variables.siteConfig.theme.favicon ?: "" )
	variables.ogImageUrl = len( trim( variables.page.ogImage ?: "" ) ) ? trim( variables.page.ogImage ) : trim( variables.siteConfig.ogImage ?: "" )
	variables.ogDescription = len( variables.page.description ?: "" ) ? variables.page.description : ( variables.siteConfig.description ?: "" )
	variables.analyticsProvider = trim( variables.siteConfig.analytics.provider ?: "" )
	variables.analyticsId = trim( variables.siteConfig.analytics.id ?: "" )
	variables.mermaidEnabled = ( variables.siteConfig.mermaid ?: false ) ? true : false
	variables.mathEnabled = ( variables.siteConfig.math ?: false ) ? true : false
</bx:script>
<bx:output><!doctype html>
<html lang="#encodeForHTML( variables.currentLocale.len() ? variables.currentLocale : 'en' )#" dir="#encodeForHTML( variables.currentLocaleDir )#">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>#encodeForHTML( variables.page.title )# - #encodeForHTML( variables.siteConfig.name )#</title>
	<meta property="og:type" content="website">
	<meta property="og:site_name" content="#encodeForHTML( variables.siteConfig.name )#">
	<meta property="og:title" content="#encodeForHTML( variables.page.title )#">
</bx:output><bx:if condition="#len( variables.ogDescription )#"><bx:output>
	<meta name="description" content="#encodeForHTML( variables.ogDescription )#">
	<meta property="og:description" content="#encodeForHTML( variables.ogDescription )#">
</bx:output></bx:if><bx:if condition="#len( variables.ogImageUrl )#"><bx:output>
	<meta property="og:image" content="#resolveAssetUrl( variables.ogImageUrl )#">
	<meta name="twitter:card" content="summary_large_image">
</bx:output></bx:if><bx:if condition="#len( variables.faviconUrl )#"><bx:output>
	<link rel="icon" href="#resolveAssetUrl( variables.faviconUrl )#">
</bx:output></bx:if><bx:output>
	<script>
		( function () {
			var configuredMode = "#variables.siteConfig.theme.options.colorMode ?: 'auto'#";
			var stored = localStorage.getItem( "bxdocs-theme" );
			var prefersDark = window.matchMedia( "(prefers-color-scheme: dark)" ).matches;
			var wantsDark = stored ? stored === "dark" : ( configuredMode === "dark" || ( configuredMode === "auto" && prefersDark ) );
			if ( wantsDark ) {
				document.documentElement.setAttribute( "data-theme", "dark" );
			}
		} )();
	</script>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@11/build/styles/github.min.css">
	<link rel="stylesheet" href="#variables.basePath#assets/theme/style.css">
	#renderExtraCss( variables.siteConfig.extraCss ?: [] )#
</bx:output><bx:if condition="#variables.mathEnabled#"><bx:output>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css">
</bx:output></bx:if><bx:if condition="#variables.analyticsProvider == 'google'#"><bx:output>
	<script async src="https://www.googletagmanager.com/gtag/js?id=#encodeForHTML( variables.analyticsId )#"></script>
	<script>
		window.dataLayer = window.dataLayer || [];
		function gtag(){dataLayer.push(arguments);}
		gtag('js', new Date());
		gtag('config', '#variables.analyticsId#');
	</script>
</bx:output></bx:if><bx:if condition="#variables.searchEnabled#"><bx:output>
	<script>window.__BXDOCS_BASE_PATH__ = "#variables.basePath#";</script>
	<script src="https://cdn.jsdelivr.net/npm/lunr@2.3.9/lunr.min.js"></script>
	<script src="#variables.basePath#assets/search.js" defer></script>
</bx:output></bx:if><bx:output>
	<script src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.1/dist/cdn.min.js" defer></script>
</head>
<body x-data="{ dark: document.documentElement.getAttribute( 'data-theme' ) === 'dark' }" x-init="$watch( 'dark', v => { document.documentElement.setAttribute( 'data-theme', v ? 'dark' : 'light' ); localStorage.setItem( 'bxdocs-theme', v ? 'dark' : 'light' ) } )">
	<nav class="navbar navbar-expand-lg brand-navbar">
		<div class="container-fluid navbar-row">
			<a class="navbar-brand brand-mark" href="#variables.basePath#">#renderBrandMark()#</a>
			<div class="navbar-controls">
</bx:output><bx:if condition="#variables.searchEnabled#"><bx:include template="#variables.themeDir#/search.bxm"></bx:if><bx:output>
</bx:output><bx:if condition="#variables.versions.len() gt 1#"><bx:output>
				#renderVersionSwitcher( variables.versions, variables.currentVersion )#
</bx:output></bx:if><bx:if condition="#variables.locales.len() gt 1#"><bx:output>
				#renderLocaleDropdown( variables.locales, variables.currentLocale )#
</bx:output></bx:if><bx:if condition="#len( variables.repoUrl )#"><bx:output>
				<a class="repo-link" href="#encodeForHTML( variables.repoUrl )#" target="_blank" rel="noopener noreferrer" aria-label="Repository" title="Repository">#bxdocsIcon( "github" )#</a>
</bx:output></bx:if><bx:output>
				<button type="button" class="theme-toggle" @click="dark = !dark" aria-label="Toggle dark mode">
					<span x-show="!dark">&##127769;</span>
					<span x-show="dark" x-cloak>&##9728;&##65039;</span>
				</button>
				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="##bxdocs-sidebar" aria-controls="bxdocs-sidebar" aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>
			</div>
		</div>
	</nav>
	<div class="container-fluid">
		<div class="row">
			<aside class="col-lg-3 col-xl-2 sidebar collapse d-lg-block" id="bxdocs-sidebar">
				#renderNavList( variables.nav )#
			</aside>
			<main class="col-lg-9 col-xl-10 content">
</bx:output><bx:include template="#variables.themeDir#/page.bxm"><bx:output>
			</main>
		</div>
	</div>
</bx:output><bx:if condition="#variables.footerEnabled#"><bx:output>
	<footer class="bxdocs-footer">
		<div class="container-fluid bxdocs-footer__inner">
			<div class="bxdocs-footer__copy">&copy; #year( now() )# #encodeForHTML( variables.siteConfig.name )#</div>
</bx:output><bx:if condition="#variables.socialLinks.len() gt 0#"><bx:output>
			<div class="bxdocs-footer__social">#renderSocialLinks( variables.socialLinks )#</div>
</bx:output></bx:if><bx:output>
			<div class="bxdocs-footer__credit">Built with <a href="https://github.com/ortus-boxlang/bx-docs" target="_blank" rel="noopener noreferrer">BX Docs</a></div>
		</div>
	</footer>
</bx:output></bx:if><bx:output>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
	<script src="https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@11/build/highlight.min.js"></script>
	<script src="#variables.basePath#assets/highlight-boxlang.js"></script>
	<script>hljs.highlightAll();</script>
	<script src="#variables.basePath#assets/code-lines.js"></script>
	<script src="#variables.basePath#assets/copy-code.js" defer></script>
	<script src="#variables.basePath#assets/admonition-collapse.js" defer></script>
	<script src="#variables.basePath#assets/tabs.js" defer></script>
</bx:output><bx:if condition="#variables.mermaidEnabled#"><bx:output>
	<script src="https://cdn.jsdelivr.net/npm/mermaid@10.9.1/dist/mermaid.min.js"></script>
	<script src="#variables.basePath#assets/mermaid-init.js"></script>
</bx:output></bx:if><bx:if condition="#variables.mathEnabled#"><bx:output>
	<script src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js"></script>
	<script src="#variables.basePath#assets/math-init.js"></script>
</bx:output></bx:if><bx:output>
	#renderExtraJs( variables.siteConfig.extraJs ?: [] )#
</body>
</html>
</bx:output>
