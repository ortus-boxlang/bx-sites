<bx:script>
	function renderBreadcrumbs( required array crumbs ) {
		if ( !arguments.crumbs.len() ) {
			return ""
		}
		var html = '<nav class="breadcrumb-nav mb-3" aria-label="breadcrumb"><ol class="breadcrumb">'
		for ( var i = 1; i <= arguments.crumbs.len(); i++ ) {
			var crumb = arguments.crumbs[ i ]
			if ( i == arguments.crumbs.len() ) {
				html &= '<li class="breadcrumb-item active" aria-current="page">' & encodeForHTML( crumb.title ) & '</li>'
			} else {
				html &= '<li class="breadcrumb-item"><a href="' & variables.basePath & crumb.url & '">' & encodeForHTML( crumb.title ) & '</a></li>'
			}
		}
		html &= '</ol></nav>'
		return html
	}

	function renderPageMeta( required string editUrl, required string lastUpdated, required string markdownUrl ) {
		var html = '<div class="page-meta">'
		if ( len( arguments.editUrl ) ) {
			html &= '<a href="' & encodeForHTML( arguments.editUrl ) & '" target="_blank" rel="noopener noreferrer">' & bxdocsIcon( "edit" ) & ' Edit this page</a>'
		}
		if ( len( arguments.markdownUrl ) ) {
			// A minimal attribute-safe escape, not encodeForHTML() - that also
			// entity-escapes "safe" characters like "/" (its exact range is
			// locale/JVM-dependent), needlessly noisy in a plain URL attribute.
			var escapedMarkdownUrl = arguments.markdownUrl.replace( "&", "&amp;", "all" ).replace( '"', "&quot;", "all" ).replace( "<", "&lt;", "all" )
			html &= '<a href="' & variables.basePath & escapedMarkdownUrl & '" download>' & bxdocsIcon( "markdown" ) & ' Download Markdown</a>'
		}
		if ( len( arguments.lastUpdated ) ) {
			html &= '<span class="page-meta__item">' & bxdocsIcon( "clock" ) & ' Last updated ' & encodeForHTML( dateTimeFormat( arguments.lastUpdated, "medium" ) ) & '</span>'
		}
		html &= '</div>'
		return html
	}

	function renderToc( required array toc ) {
		var html = '<nav class="toc mb-4" aria-label="On this page">'
		html &= '<div class="toc-title">On this page</div><ul class="list-unstyled">'
		for ( var item in arguments.toc ) {
			html &= '<li class="toc-level-' & item.level & '"><a href="##' & item.id & '">' & encodeForHTML( item.text ) & '</a></li>'
		}
		html &= '</ul></nav>'
		return html
	}

	function tagSlug( required string tag ) {
		return lCase( trim( arguments.tag ) ).reReplace( "[^a-z0-9]+", "-", "all" ).reReplace( "(^-|-$)", "", "all" )
	}

	function renderTags( required array tags ) {
		if ( !arguments.tags.len() ) {
			return ""
		}
		var html = '<div class="page-tags mb-3">'
		for ( var tag in arguments.tags ) {
			html &= '<a class="page-tag" href="' & variables.basePath & 'tags/index.html##tag-' & tagSlug( tag ) & '">' & encodeForHTML( tag ) & '</a>'
		}
		html &= '</div>'
		return html
	}

	// The default locale's own label - a fallback page (mergeLocalePages(),
	// BuildPipeline.bx) is showing that content untranslated, so the notice
	// names what the reader is actually looking at. buildLocalesList()
	// (BuildPipeline.bx) always puts the default locale first.
	function defaultLocaleLabel() {
		return variables.locales.len() ? variables.locales[ 1 ].label : ""
	}
</bx:script>
<bx:output>				<article class="page-content">
</bx:output><bx:if condition="#variables.page.isFallbackContent#"><bx:output>
					<p class="fallback-notice">#bxdocsIcon( 'globe' )# This page hasn't been translated yet - showing the #encodeForHTML( defaultLocaleLabel() )# version.</p>
</bx:output></bx:if><bx:if condition="#variables.page.breadcrumbs.len() gt 1#"><bx:output>#renderBreadcrumbs( variables.page.breadcrumbs )#</bx:output></bx:if><bx:output>
					<h1 class="page-title"></bx:output><bx:if condition="#len( variables.page.iconHtml )#"><bx:output><span class="page-icon">#variables.page.iconHtml#</span> </bx:output></bx:if><bx:output>#encodeForHTML( variables.page.title )#</h1>
</bx:output><bx:if condition="#len( variables.page.summary )#"><bx:output>					<p class="page-summary">#encodeForHTML( variables.page.summary )#</p>
</bx:output></bx:if><bx:if condition="#variables.page.tags.len() gt 0#"><bx:output>#renderTags( variables.page.tags )#</bx:output></bx:if><bx:if condition="#len( variables.page.editUrl ) or len( variables.page.lastUpdated ) or len( variables.page.markdownUrl )#"><bx:output>#renderPageMeta( variables.page.editUrl, variables.page.lastUpdated, variables.page.markdownUrl )#</bx:output></bx:if><bx:output>
</bx:output><bx:if condition="#variables.page.toc.len() gt 0#"><bx:output>#renderToc( variables.page.toc )#</bx:output></bx:if><bx:output>
					#variables.page.contentHtml#
				</article>
</bx:output><bx:if condition="#len( variables.page.prevPage.url ) or len( variables.page.nextPage.url )#"><bx:output>
				<nav class="page-nav d-flex justify-content-between" aria-label="Page navigation">
</bx:output><bx:if condition="#len( variables.page.prevPage.url )#"><bx:output>
					<a class="page-nav__prev" href="#variables.basePath##variables.page.prevPage.url#">&larr; #encodeForHTML( variables.page.prevPage.title )#</a>
</bx:output></bx:if><bx:if condition="#!len( variables.page.prevPage.url )#"><bx:output>
					<span></span>
</bx:output></bx:if><bx:if condition="#len( variables.page.nextPage.url )#"><bx:output>
					<a class="page-nav__next" href="#variables.basePath##variables.page.nextPage.url#">#encodeForHTML( variables.page.nextPage.title )# &rarr;</a>
</bx:output></bx:if><bx:output>
				</nav>
</bx:output></bx:if><bx:output>
</bx:output>
