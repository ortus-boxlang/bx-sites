<bx:if condition="#variables.searchProviderName eq 'algolia'#"><bx:output><div id="bxdocs-search-algolia" class="bxdocs-search-algolia"></div>
</bx:output></bx:if><bx:if condition="#variables.searchProviderName eq 'local'#"><bx:output><div class="bxdocs-search md-search">
	<input type="search" id="bxdocs-search-input" class="md-search__input" placeholder="Search docs..." aria-label="Search">
	<ul id="bxdocs-search-results" class="bxdocs-search-results"></ul>
</div>
</bx:output></bx:if>
