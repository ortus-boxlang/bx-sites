<bx:script>
	function renderBreadcrumbs( required array crumbs ) {
		if ( !arguments.crumbs.len() ) {
			return ""
		}
		var html = '<nav class="docsy-breadcrumb" aria-label="breadcrumb"><ol>'
		for ( var i = 1; i <= arguments.crumbs.len(); i++ ) {
			var crumb = arguments.crumbs[ i ]
			if ( i == arguments.crumbs.len() ) {
				html &= '<li class="docsy-breadcrumb__item docsy-breadcrumb__item--active" aria-current="page">' & encodeForHTML( crumb.title ) & '</li>'
			} else {
				html &= '<li class="docsy-breadcrumb__item"><a href="' & variables.basePath & crumb.url & '">' & encodeForHTML( crumb.title ) & '</a></li>'
			}
		}
		html &= '</ol></nav>'
		return html
	}

	function renderPageMeta( required string editUrl, required string lastUpdated, required string markdownUrl ) {
		var html = '<div class="page-meta">'
		if ( len( arguments.editUrl ) ) {
			// A minimal attribute-safe escape, not encodeForHTML() - that also
			// entity-escapes "safe" characters like "/" (its exact range is
			// locale/JVM-dependent), needlessly noisy in a plain URL attribute.
			var escapedEditUrl = arguments.editUrl.replace( "&", "&amp;", "all" ).replace( '"', "&quot;", "all" ).replace( "<", "&lt;", "all" )
			html &= '<a href="' & escapedEditUrl & '" target="_blank" rel="noopener noreferrer">' & bxsitesIcon( "edit" ) & ' ' & encodeForHTML( variables.strings.editThisPage ) & '</a>'
		}
		if ( len( arguments.markdownUrl ) ) {
			// Same reasoning as escapedEditUrl above.
			var escapedMarkdownUrl = arguments.markdownUrl.replace( "&", "&amp;", "all" ).replace( '"', "&quot;", "all" ).replace( "<", "&lt;", "all" )
			html &= '<a href="' & variables.basePath & escapedMarkdownUrl & '" download>' & bxsitesIcon( "markdown" ) & ' ' & encodeForHTML( variables.strings.downloadMarkdown ) & '</a>'
		}
		if ( len( arguments.lastUpdated ) ) {
			html &= '<span class="page-meta__item">' & bxsitesIcon( "clock" ) & ' ' & encodeForHTML( variables.strings.lastUpdated ) & ' ' & encodeForHTML( dateTimeFormat( arguments.lastUpdated, "medium" ) ) & '</span>'
		}
		html &= '</div>'
		return html
	}

	// @hideAtXl true for the sticky-position variant's own mobile/tablet
	// fallback - a right-hand rail can't fit below 1200px (see
	// style.css's own `.docsy-toc-sidebar` breakpoint), so this renders as a
	// collapsible bar pinned to the top of the viewport while scrolling
	// instead (VitePress/GitBook's own mobile "On this page" treatment) -
	// hidden again once the rail takes over, rather than leaving the TOC
	// inaccessible below that width.
	function renderToc( required array toc, boolean hideAtXl = false ) {
		var listHtml = '<ul>'
		for ( var item in arguments.toc ) {
			listHtml &= '<li class="docsy-toc__item docsy-toc__item--' & item.level & '"><a href="##' & item.id & '">' & encodeForHTML( item.text ) & '</a></li>'
		}
		listHtml &= '</ul>'

		if ( arguments.hideAtXl ) {
			return '<details class="bxsites-toc-mobile docsy-toc--mobile"><summary class="docsy-toc--mobile__summary">' & encodeForHTML( variables.strings.onThisPage ) & '</summary>' & listHtml & '</details>'
		}

		return '<nav class="docsy-toc" aria-label="' & encodeForHTML( variables.strings.onThisPage ) & '"><div class="docsy-toc__title">' & encodeForHTML( variables.strings.onThisPage ) & '</div>' & listHtml & '</nav>'
	}

	function tagSlug( required string tag ) {
		var slug = createObject( "java", "java.util.regex.Pattern" ).compile( "[^\p{L}\p{N}]+" ).matcher( lCase( trim( arguments.tag ) ) ).replaceAll( "-" )
		return slug.reReplace( "(^-|-$)", "", "all" )
	}

	function renderTags( required array tags ) {
		if ( !arguments.tags.len() ) {
			return ""
		}
		var html = '<div class="page-tags">'
		for ( var tag in arguments.tags ) {
			html &= '<a class="page-tag" href="' & variables.basePath & 'tags/index.html##tag-' & tagSlug( tag ) & '">' & encodeForHTML( tag ) & '</a>'
		}
		html &= '</div>'
		return html
	}

	// buildLocalesList() (BuildPipeline.bx) always puts the default locale first.
	function defaultLocaleLabel() {
		return variables.locales.len() ? variables.locales[ 1 ].label : ""
	}
</bx:script>
<bx:output>			<article class="docsy-card">
</bx:output><bx:if condition="#variables.page.isFallbackContent#"><bx:output>
				<p class="fallback-notice">#bxsitesIcon( 'globe' )# #encodeForHTML( variables.stringsResolver.format( variables.strings.notTranslatedNotice, { "locale" : defaultLocaleLabel() } ) )#</p>
</bx:output></bx:if><bx:if condition="#variables.page.breadcrumbs.len() gt 1#"><bx:output>#renderBreadcrumbs( variables.page.breadcrumbs )#</bx:output></bx:if><bx:output>
				<h1 class="docsy-title" id="page-title"><a href="##page-title" id="page-title" class="anchor"></a></bx:output><bx:if condition="#len( variables.page.iconHtml )#"><bx:output><span class="page-icon">#variables.page.iconHtml#</span> </bx:output></bx:if><bx:output>#encodeForHTML( variables.page.title )#</h1>
</bx:output><bx:if condition="#len( variables.page.summary )#"><bx:output>				<p class="page-summary">#encodeForHTML( variables.page.summary )#</p>
</bx:output></bx:if><bx:if condition="#variables.page.tags.len() gt 0#"><bx:output>#renderTags( variables.page.tags )#</bx:output></bx:if><bx:if condition="#( len( variables.page.editUrl ) or len( variables.page.lastUpdated ) or len( variables.page.markdownUrl ) ) and variables.pageMetaPosition == 'top'#"><bx:output>#renderPageMeta( variables.page.editUrl, variables.page.lastUpdated, variables.page.markdownUrl )#</bx:output></bx:if><bx:output>
</bx:output><bx:if condition="#variables.page.toc.len() gt 0 and variables.tocPosition == 'top'#"><bx:output>#renderToc( variables.page.toc )#</bx:output></bx:if><bx:if condition="#variables.page.toc.len() gt 0 and variables.tocPosition == 'sticky'#"><bx:output>#renderToc( variables.page.toc, true )#</bx:output></bx:if><bx:output>
				<div class="docsy-content-body">
				#variables.page.contentHtml#
			</div>
</bx:output><bx:if condition="#( len( variables.page.editUrl ) or len( variables.page.lastUpdated ) or len( variables.page.markdownUrl ) ) and variables.pageMetaPosition == 'bottom'#"><bx:output>#renderPageMeta( variables.page.editUrl, variables.page.lastUpdated, variables.page.markdownUrl )#</bx:output></bx:if><bx:output>
			</article>
</bx:output><bx:if condition="#len( variables.page.prevPage.url ) or len( variables.page.nextPage.url )#"><bx:output>
			<nav class="docsy-page-nav" aria-label="#encodeForHTML( variables.strings.pageNavigation )#">
</bx:output><bx:if condition="#len( variables.page.prevPage.url )#"><bx:output>
				<a class="docsy-page-nav__prev" href="#variables.basePath##variables.page.prevPage.url#">&larr; #encodeForHTML( variables.page.prevPage.title )#</a>
</bx:output></bx:if><bx:if condition="#!len( variables.page.prevPage.url )#"><bx:output>
				<span></span>
</bx:output></bx:if><bx:if condition="#len( variables.page.nextPage.url )#"><bx:output>
				<a class="docsy-page-nav__next" href="#variables.basePath##variables.page.nextPage.url#">#encodeForHTML( variables.page.nextPage.title )# &rarr;</a>
</bx:output></bx:if><bx:output>
			</nav>
</bx:output></bx:if><bx:output>
</bx:output>
