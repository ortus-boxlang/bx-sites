{
    "name":"BX Docs",
    "version":"1.0.0",
    "location":"https://downloads.ortussolutions.com/ortussolutions/boxlang-modules/bx-docs/@build.version@/bx-docs-@build.version@.zip",
    "author":"Ortus Solutions",
    "homepage":"https://github.com/ortus-boxlang/bx-docs",
    "documentation":"https://github.com/ortus-boxlang/bx-docs",
    "repository":{
        "type":"git",
        "URL":"https://github.com/ortus-boxlang/bx-docs"
    },
    "bugs":"https://ortussolutions.atlassian.net/browse/BLMODULES",
    "slug":"bx-docs",
    "shortDescription":"Static documentation site generator for BoxLang, built on bx-markdown",
    "type":"boxlang-modules",
    "keywords":[
        "boxlang",
        "docs",
        "documentation",
        "static-site",
        "markdown"
    ],
    "boxlang":{
        "minimumVersion":"1.0.0",
        "moduleName":"bxdocs",
        "executable":"bxDocs"
    },
    "private":false,
    "license":[
        {
            "type":"Apache-2.0",
            "URL":"https://www.apache.org/licenses/LICENSE-2.0"
        }
    ],
    "dependencies":{
        "bx-markdown":"*",
        "bx-esapi":"*"
    },
    "devDependencies":{
        "commandbox-boxlang":"*",
        "commandbox-cfformat":"*",
        "commandbox-docbox":"*",
        "testbox":"*"
    },
    "ignore":[
        "**/.*",
        "settings.gradle",
        "gradlew.bat",
        "gradlew",
        "build.gradle",
        "/src/**",
        "gradle/**",
        "/examples/**"
    ],
    "installPaths":{
        "testbox":"testbox/"
    }
}
