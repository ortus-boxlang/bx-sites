# Tab completion for bxSites, for PowerShell 5.1 and 7+.
# Generated by tools/generate-completions.bxs from the verb table in ModuleConfig.bx, do not edit.
# Load it from your profile ($PROFILE):
#   . "<module folder>\completions\bxSites.ps1"

Register-ArgumentCompleter -Native -CommandName 'bxSites', 'bxsites' -ScriptBlock {
	param( $wordToComplete, $commandAst, $cursorPosition )

	$verbs = @{
@@VERBS@@
	}
	$options = @{
@@OPTIONS@@
	}
	$globals = @( '--help', '-h', '--version', '-v' )

	# the words typed before the one under the cursor (the command name is the first); an empty word is not in the AST
	$typed = @( $commandAst.CommandElements | ForEach-Object { $_.ToString() } )
	if ( $wordToComplete -ne '' ) {
		$typed = @( $typed | Select-Object -SkipLast 1 )
	}

	function New-BxSitesResult( [string] $Text, [string] $Tip ) {
		if ( -not $Tip ) { $Tip = $Text }
		[System.Management.Automation.CompletionResult]::new( $Text, $Text, 'ParameterValue', $Tip )
	}

	# bxSites <verb>
	if ( $typed.Count -le 1 ) {
		if ( $wordToComplete -like '-*' ) {
			foreach ( $g in $globals ) {
				if ( $g -like "$wordToComplete*" ) { New-BxSitesResult $g }
			}
		} else {
			foreach ( $name in ( @( $verbs.Keys ) | Sort-Object ) ) {
				if ( $name -like "$wordToComplete*" ) { New-BxSitesResult $name $verbs[ $name ] }
			}
		}
		return
	}

	# bxSites page <new|rename>: a colon verb written as two words
	if ( $typed.Count -eq 2 -and -not $verbs.ContainsKey( $typed[ 1 ] ) -and $wordToComplete -notlike '-*' ) {
		foreach ( $name in ( @( $verbs.Keys ) | Sort-Object ) ) {
			if ( $name -like "$( $typed[ 1 ] ):$wordToComplete*" ) {
				$second = $name.Substring( $typed[ 1 ].Length + 1 )
				New-BxSitesResult $second $verbs[ $name ]
			}
		}
		return
	}

	$verb = $typed[ 1 ]
	if ( $typed.Count -ge 3 -and $verbs.ContainsKey( "$( $typed[ 1 ] ):$( $typed[ 2 ] )" ) ) {
		$verb = "$( $typed[ 1 ] ):$( $typed[ 2 ] )"
	}
	$verbOptions = if ( $options.ContainsKey( $verb ) ) { @( $options[ $verb ] ) } else { @() }

	# --flag=<value>
	if ( $wordToComplete -match '^(--[^=]+)=(.*)$' ) {
		$flag = $Matches[ 1 ]
		$part = $Matches[ 2 ]
		$option = $verbOptions | Where-Object { "--$( $_.Name )" -eq $flag } | Select-Object -First 1
		if ( $option -and $option.Choices.Count ) {
			foreach ( $choice in $option.Choices ) {
				if ( $choice -like "$part*" ) { New-BxSitesResult "$flag=$choice" $choice }
			}
		} elseif ( $option -and $option.File ) {
			foreach ( $item in @( Get-ChildItem -Path "$part*" -ErrorAction SilentlyContinue ) ) {
				$path = Resolve-Path -LiteralPath $item.FullName -Relative
				if ( $item.PSIsContainer ) { $path += [System.IO.Path]::DirectorySeparatorChar }
				if ( $path -match '\s' ) { $path = "'$path'" }
				New-BxSitesResult "$flag=$path" $path
			}
		}
		return
	}

	# --flag
	if ( $wordToComplete -like '-*' ) {
		foreach ( $option in $verbOptions ) {
			$text = if ( $option.Value -and -not $option.Name.EndsWith( ':' ) ) { "--$( $option.Name )=" } else { "--$( $option.Name )" }
			if ( $text -like "$wordToComplete*" ) { New-BxSitesResult $text }
		}
		foreach ( $g in $globals ) {
			if ( $g -like "$wordToComplete*" ) { New-BxSitesResult $g }
		}
		return
	}

	# the argument that follows the verb
	switch ( $options[ "${verb}:positional" ] ) {
		'dir' {
			foreach ( $item in @( Get-ChildItem -Directory -Path "$wordToComplete*" -ErrorAction SilentlyContinue ) ) {
				$path = ( Resolve-Path -LiteralPath $item.FullName -Relative ) + [System.IO.Path]::DirectorySeparatorChar
				if ( $path -match '\s' ) { $path = "'$path'" }
				New-BxSitesResult $path
			}
		}
		'verbs' {
			foreach ( $name in ( @( $verbs.Keys ) | Sort-Object ) ) {
				if ( $name -like "$wordToComplete*" ) { New-BxSitesResult $name $verbs[ $name ] }
			}
		}
	}
}
