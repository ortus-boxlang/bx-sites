# Tab completion for bxSites, for bash (and zsh, through bashcompinit).
# Generated by tools/generate-completions.bxs from the verb table in ModuleConfig.bx, do not edit.
# install-bx-module installs it from the "completions" setting in box.json. Without the installer, load it with:
#   source <module folder>/completions/bxSites.bash

# bash splits words on ":" too, so for "page:ne" it only replaces "ne": drop what comes before the last colon
_bxsites_trim_colon() {
	[[ "$COMP_WORDBREAKS" == *:* && "$1" == *:* ]] || return 0
	local prefix="${1%"${1##*:}"}" i
	for i in "${!COMPREPLY[@]}"; do
		COMPREPLY[i]="${COMPREPLY[i]#"$prefix"}"
	done
}

_bxsites_complete() {
	local line="${COMP_LINE:0:COMP_POINT}"
	local -a words
	read -ra words <<< "$line"
	if [[ "$line" =~ [[:space:]]$ ]]; then
		words+=("")
	fi
	local count=${#words[@]}
	local cur="${words[count-1]}"
	local verbs="@@VERBS@@"
	local globals="--help -h --version -v"
	COMPREPLY=()

	# bxSites <verb>
	if (( count <= 2 )); then
		if [[ "$cur" == -* ]]; then
			COMPREPLY=($(compgen -W "$globals" -- "$cur"))
		else
			COMPREPLY=($(compgen -W "$verbs" -- "$cur"))
			_bxsites_trim_colon "$cur"
		fi
		return 0
	fi

	# bxSites page <new|rename>: a colon verb written as two words
	if (( count == 3 )) && [[ " $verbs " != *" ${words[1]} "* ]]; then
		local seconds=""
		case "${words[1]}" in
@@SECOND_CASES@@
		esac
		if [[ -n "$seconds" && "$cur" != -* ]]; then
			COMPREPLY=($(compgen -W "$seconds" -- "$cur"))
			return 0
		fi
	fi

	local verb="${words[1]}"
	if (( count >= 4 )) && [[ " $verbs " == *" ${words[1]}:${words[2]} "* ]]; then
		verb="${words[1]}:${words[2]}"
	fi

	# --flag=<value>: bash replaces only what follows the "="
	if [[ "$cur" == --*=* ]]; then
		local flag="${cur%%=*}" part="${cur#*=}"
		case "$verb $flag" in
@@VALUE_CASES@@
		esac
		return 0
	fi

	if [[ "$cur" == -* ]]; then
		local flags=""
		case "$verb" in
@@FLAG_CASES@@
		esac
		COMPREPLY=($(compgen -W "$flags $globals" -- "$cur"))
		if (( ${#COMPREPLY[@]} == 1 )) && [[ "${COMPREPLY[0]}" == *[=:] ]]; then
			compopt -o nospace 2>/dev/null
		fi
		return 0
	fi

	case "$verb" in
@@POSITIONAL_CASES@@
	esac
	return 0
}

complete -F _bxsites_complete bxSites bxsites
