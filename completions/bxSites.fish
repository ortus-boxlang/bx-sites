# Tab completion for bxSites, for fish.
# Generated by tools/generate-completions.bxs from the verb table in ModuleConfig.bx, do not edit.
# Install it with:  cp <module folder>/completions/bxSites.fish ~/.config/fish/completions/

function __bxsites_needs_verb
    set -l words (commandline -opc)
    test (count $words) -eq 1
end

# the verb being completed: "page new" counts as "page:new"
function __bxsites_verb
    set -l words (commandline -opc)
    test (count $words) -ge 2; or return 1
    if test (count $words) -ge 3; and contains -- "$words[2]:$words[3]" agents:sync blog:drafts blog:find i18n:new i18n:status install:plugin install:theme page:new page:rename plugin:new post:new search:query skills:install theme:import theme:new version:new
        echo "$words[2]:$words[3]"
    else
        echo $words[2]
    end
end

function __bxsites_using_verb
    test (__bxsites_verb) = "$argv[1]"
end

function __bxsites_using_group
    set -l words (commandline -opc)
    test (count $words) -eq 2; and test "$words[2]" = "$argv[1]"
end

