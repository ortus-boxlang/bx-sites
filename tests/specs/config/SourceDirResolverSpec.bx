/**
 * Exercises SourceDirResolver.bx directly against temp project directories -
 * the docs/-or-src/ source folder detection BuildPipeline.bx and every
 * scaffolding CLI verb now goes through instead of hardcoding `root & "/docs"`.
 */
class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "config.SourceDirResolver", function() {

			beforeEach( function() {
				variables.resolver = new "models.config.SourceDirResolver@bxsites"();
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			it( "resolves to docs/ when only docs/ exists", function() {
				var dir = createTempDirectory( prefix = "bxsites-sourcedir-docs-" );
				tempDirs.append( dir );
				directoryCreate( dir & "/docs", true, true );

				expect( resolver.name( dir ) ).toBe( "docs" );
				expect( resolver.resolve( dir ) ).toBe( dir & "/docs" );
			} );

			it( "resolves to src/ when only src/ exists", function() {
				var dir = createTempDirectory( prefix = "bxsites-sourcedir-src-" );
				tempDirs.append( dir );
				directoryCreate( dir & "/src", true, true );

				expect( resolver.name( dir ) ).toBe( "src" );
				expect( resolver.resolve( dir ) ).toBe( dir & "/src" );
			} );

			it( "prefers docs/ over src/ when both exist", function() {
				var dir = createTempDirectory( prefix = "bxsites-sourcedir-both-" );
				tempDirs.append( dir );
				directoryCreate( dir & "/docs", true, true );
				directoryCreate( dir & "/src", true, true );

				expect( resolver.name( dir ) ).toBe( "docs" );
			} );

			it( "defaults to docs/ when neither exists yet", function() {
				var dir = createTempDirectory( prefix = "bxsites-sourcedir-neither-" );
				tempDirs.append( dir );

				expect( resolver.name( dir ) ).toBe( "docs" );
				expect( resolver.resolve( dir ) ).toBe( dir & "/docs" );
			} );

			it( "never resolves to site/, even when only site/ exists", function() {
				var dir = createTempDirectory( prefix = "bxsites-sourcedir-siteonly-" );
				tempDirs.append( dir );
				directoryCreate( dir & "/site", true, true );

				expect( resolver.name( dir ) ).toBe( "docs" );
				expect( resolver.resolve( dir ) ).toBe( dir & "/docs" );
			} );

			it( "tolerates a trailing slash on projectRoot", function() {
				var dir = createTempDirectory( prefix = "bxsites-sourcedir-trailing-" );
				tempDirs.append( dir );
				directoryCreate( dir & "/src", true, true );

				expect( resolver.resolve( dir & "/" ) ).toBe( dir & "/src" );
			} );

			it( "honors an explicit source over auto-detection", function() {
				var dir = createTempDirectory( prefix = "bxsites-sourcedir-explicit-" );
				tempDirs.append( dir );
				directoryCreate( dir & "/docs", true, true );
				directoryCreate( dir & "/content", true, true );

				expect( resolver.name( dir, "content" ) ).toBe( "content" );
				expect( resolver.resolve( dir, "content" ) ).toBe( dir & "/content" );
			} );

			it( "resolves an explicit source of '.' to the project root itself, not <root>/.", function() {
				var dir = createTempDirectory( prefix = "bxsites-sourcedir-dot-" );
				tempDirs.append( dir );

				expect( resolver.name( dir, "." ) ).toBe( "." );
				expect( resolver.resolve( dir, "." ) ).toBe( dir );
			} );

			describe( "nameConfigured() / resolveConfigured() - the strict, config-loading pair", function() {

				it( "honors bxsites.yaml's own [source] key", function() {
					var dir = createTempDirectory( prefix = "bxsites-sourcedir-cfg-explicit-" );
					tempDirs.append( dir );
					directoryCreate( dir & "/content", true, true );
					fileWrite( dir & "/bxsites.yaml", 'name: "Test"' & char( 10 ) & "source: content" & char( 10 ) );

					expect( resolver.nameConfigured( dir ) ).toBe( "content" );
					expect( resolver.resolveConfigured( dir ) ).toBe( dir & "/content" );
				} );

				it( "resolves [source]: . to the project root itself", function() {
					var dir = createTempDirectory( prefix = "bxsites-sourcedir-cfg-dot-" );
					tempDirs.append( dir );
					fileWrite( dir & "/index.md", "Home" );
					fileWrite( dir & "/bxsites.yaml", 'name: "Test"' & char( 10 ) & "source: ." & char( 10 ) );

					expect( resolver.nameConfigured( dir ) ).toBe( "." );
					expect( resolver.resolveConfigured( dir ) ).toBe( dir );
				} );

				it( "auto-detects docs/src when [source] is unset but one of them exists on disk", function() {
					var dir = createTempDirectory( prefix = "bxsites-sourcedir-cfg-autodetect-" );
					tempDirs.append( dir );
					directoryCreate( dir & "/src", true, true );
					fileWrite( dir & "/bxsites.yaml", 'name: "Test"' & char( 10 ) );

					expect( resolver.nameConfigured( dir ) ).toBe( "src" );
					expect( resolver.resolveConfigured( dir ) ).toBe( dir & "/src" );
				} );

				it( "throws BxSites.SourceNotConfigured when [source] is unset and neither docs/ nor src/ exists", function() {
					var dir = createTempDirectory( prefix = "bxsites-sourcedir-cfg-none-" );
					tempDirs.append( dir );
					fileWrite( dir & "/bxsites.yaml", 'name: "Test"' & char( 10 ) );

					expect( function() {
						resolver.nameConfigured( dir );
					} ).toThrow( "BxSites.SourceNotConfigured" );
					expect( function() {
						resolver.resolveConfigured( dir );
					} ).toThrow( "BxSites.SourceNotConfigured" );
				} );

				it( "rejects [source]: site outright - that name is reserved for the build output", function() {
					var dir = createTempDirectory( prefix = "bxsites-sourcedir-cfg-site-" );
					tempDirs.append( dir );
					fileWrite( dir & "/bxsites.yaml", 'name: "Test"' & char( 10 ) & "source: site" & char( 10 ) );

					expect( function() {
						resolver.nameConfigured( dir );
					} ).toThrow( "BxSites.InvalidConfig" );
				} );

				it( "throws BxSites.ConfigNotFound when no bxsites.yaml/.toml/.json exists at all", function() {
					var dir = createTempDirectory( prefix = "bxsites-sourcedir-cfg-missing-" );
					tempDirs.append( dir );

					expect( function() {
						resolver.nameConfigured( dir );
					} ).toThrow( "BxSites.ConfigNotFound" );
				} );

			} );

		} );
	}

}
