/**
 * Exercises the bxdocs.json loader/validator directly against temp project
 * directories - no CLI dispatch involved (see ModuleConfigCliSpec.bx for that).
 */
class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "config.ConfigLoader", function() {

			beforeEach( function() {
				variables.loader = new "models.config.ConfigLoader@bxdocs"();
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			private function newProjectDir( string configJson = "" ) {
				var dir = createTempDirectory( prefix = "bxdocs-configloader-" );
				tempDirs.append( dir );
				if ( len( arguments.configJson ) ) {
					fileWrite( dir & "/bxdocs.json", arguments.configJson );
				}
				return dir;
			}

			it( "throws BxDocs.ConfigNotFound when bxdocs.json is missing", function() {
				var dir = newProjectDir();
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxDocs.ConfigNotFound" );
			} );

			it( "throws BxDocs.InvalidConfig for malformed JSON", function() {
				var dir = newProjectDir( "{ not valid json" );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxDocs.InvalidConfig" );
			} );

			it( "throws BxDocs.InvalidConfig when [name] is missing", function() {
				var dir = newProjectDir( '{"description":"no name here"}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxDocs.InvalidConfig" );
			} );

			it( "applies defaults for description, baseURL, theme, search, nav, markdown, repo, social, footer and lastUpdated", function() {
				var dir = newProjectDir( '{"name":"My Docs"}' );
				var config = loader.load( dir );

				expect( config.name ).toBe( "My Docs" );
				expect( config.description ).toBe( "" );
				expect( config.baseURL ).toBe( "/" );
				expect( config.theme.name ).toBe( "bootstrap" );
				expect( config.theme.options ).toBeStruct();
				expect( config.search ).toBeTrue();
				expect( config.nav ).toBeArray();
				expect( config.markdown ).toBeStruct();
				expect( config.markdown.enableAdmonition ).toBeTrue();
				expect( config.repo.url ).toBe( "" );
				expect( config.repo.editUri ).toBe( "" );
				expect( config.social ).toBeArray();
				expect( config.social.len() ).toBe( 0 );
				expect( config.footer ).toBeFalse();
				expect( config.lastUpdated ).toBeFalse();
			} );

			it( "deep-merges a partial [theme] override, keeping default options", function() {
				var dir = newProjectDir( '{"name":"My Docs","theme":{"name":"material"}}' );
				var config = loader.load( dir );

				expect( config.theme.name ).toBe( "material" );
				expect( config.theme.options ).toBeStruct();
			} );

			it( "preserves user-supplied values that override defaults", function() {
				var dir = newProjectDir( '{"name":"My Docs","baseURL":"/docs/","search":false}' );
				var config = loader.load( dir );

				expect( config.baseURL ).toBe( "/docs/" );
				expect( config.search ).toBeFalse();
			} );

			it( "deep-merges a partial [markdown] override, keeping the enableAdmonition default", function() {
				var dir = newProjectDir( '{"name":"My Docs","markdown":{"enableFootnotes":true}}' );
				var config = loader.load( dir );

				expect( config.markdown.enableAdmonition ).toBeTrue();
				expect( config.markdown.enableFootnotes ).toBeTrue();
			} );

			it( "allows overriding the enableAdmonition default to false", function() {
				var dir = newProjectDir( '{"name":"My Docs","markdown":{"enableAdmonition":false}}' );
				var config = loader.load( dir );

				expect( config.markdown.enableAdmonition ).toBeFalse();
			} );

			it( "preserves a user-supplied [nav] array", function() {
				var dir = newProjectDir( '{"name":"My Docs","nav":[{"title":"Home","path":"index.md"}]}' );
				var config = loader.load( dir );

				expect( config.nav ).toBeArray();
				expect( config.nav.len() ).toBe( 1 );
				expect( config.nav[ 1 ].title ).toBe( "Home" );
			} );

			it( "throws BxDocs.InvalidConfig when [nav] is not an array", function() {
				var dir = newProjectDir( '{"name":"My Docs","nav":{"title":"Home"}}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxDocs.InvalidConfig" );
			} );

			it( "throws BxDocs.InvalidConfig when [search] is not a boolean", function() {
				var dir = newProjectDir( '{"name":"My Docs","search":"not-a-boolean-at-all"}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxDocs.InvalidConfig" );
			} );

			it( "throws BxDocs.InvalidConfig when [theme.name] is explicitly blank", function() {
				var dir = newProjectDir( '{"name":"My Docs","theme":{"name":"","options":{}}}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxDocs.InvalidConfig" );
			} );

			it( "defaults [theme.name] to bootstrap when [theme] is present but has no [name] key at all", function() {
				var dir = newProjectDir( '{"name":"My Docs","theme":{"options":{"foo":"bar"}}}' );
				var config = loader.load( dir );

				expect( config.theme.name ).toBe( "bootstrap" );
				expect( config.theme.options.foo ).toBe( "bar" );
			} );

			it( "accepts [theme.options.colorMode] of light, dark or auto, defaulting to auto when absent", function() {
				var dir = newProjectDir( '{"name":"My Docs"}' );
				expect( loader.load( dir ).theme.options.colorMode ?: "auto" ).toBe( "auto" );

				for ( var mode in [ "light", "dark", "auto" ] ) {
					var modeDir = newProjectDir( '{"name":"My Docs","theme":{"options":{"colorMode":"' & mode & '"}}}' );
					expect( loader.load( modeDir ).theme.options.colorMode ).toBe( mode );
				}
			} );

			it( "throws BxDocs.InvalidConfig when [theme.options.colorMode] isn't light, dark or auto", function() {
				var dir = newProjectDir( '{"name":"My Docs","theme":{"options":{"colorMode":"purple"}}}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxDocs.InvalidConfig" );
			} );

			it( "exposes the v1 built-in theme names", function() {
				expect( loader.getBuiltInThemes() ).toBe( [ "bootstrap", "material", "tailwind" ] );
			} );

			it( "deep-merges a partial [repo] override, keeping the default empty editUri", function() {
				var dir = newProjectDir( '{"name":"My Docs","repo":{"url":"https://github.com/acme/docs"}}' );
				var config = loader.load( dir );

				expect( config.repo.url ).toBe( "https://github.com/acme/docs" );
				expect( config.repo.editUri ).toBe( "" );
			} );

			it( "preserves a user-supplied [social] array", function() {
				var dir = newProjectDir( '{"name":"My Docs","social":[{"url":"https://twitter.com/acme","icon":"twitter"}]}' );
				var config = loader.load( dir );

				expect( config.social.len() ).toBe( 1 );
				expect( config.social[ 1 ].url ).toBe( "https://twitter.com/acme" );
			} );

			it( "throws BxDocs.InvalidConfig when a [social] entry has no [url]", function() {
				var dir = newProjectDir( '{"name":"My Docs","social":[{"icon":"twitter"}]}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxDocs.InvalidConfig" );
			} );

			it( "throws BxDocs.InvalidConfig when [footer] is not a boolean", function() {
				var dir = newProjectDir( '{"name":"My Docs","footer":"yes please"}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxDocs.InvalidConfig" );
			} );

			it( "throws BxDocs.InvalidConfig when [lastUpdated] is not a boolean", function() {
				var dir = newProjectDir( '{"name":"My Docs","lastUpdated":"yes please"}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxDocs.InvalidConfig" );
			} );

			it( "applies defaults for [theme.logo], [theme.favicon], [analytics], [ogImage], [extraCss] and [extraJs]", function() {
				var dir = newProjectDir( '{"name":"My Docs"}' );
				var config = loader.load( dir );

				expect( config.theme.logo ).toBe( "" );
				expect( config.theme.favicon ).toBe( "" );
				expect( config.analytics.provider ).toBe( "" );
				expect( config.analytics.id ).toBe( "" );
				expect( config.ogImage ).toBe( "" );
				expect( config.extraCss ).toBeArray();
				expect( config.extraCss.len() ).toBe( 0 );
				expect( config.extraJs ).toBeArray();
				expect( config.extraJs.len() ).toBe( 0 );
			} );

			it( "preserves user-supplied [theme.logo] and [theme.favicon]", function() {
				var dir = newProjectDir( '{"name":"My Docs","theme":{"logo":"assets/logo.svg","favicon":"assets/favicon.ico"}}' );
				var config = loader.load( dir );

				expect( config.theme.logo ).toBe( "assets/logo.svg" );
				expect( config.theme.favicon ).toBe( "assets/favicon.ico" );
			} );

			it( "throws BxDocs.InvalidConfig when [theme.logo] isn't a string", function() {
				var dir = newProjectDir( '{"name":"My Docs","theme":{"logo":["not","a","string"]}}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxDocs.InvalidConfig" );
			} );

			it( "accepts boolean [theme.options.navCollapsible] and [theme.options.navExpandAll]", function() {
				var dir = newProjectDir( '{"name":"My Docs","theme":{"options":{"navCollapsible":true,"navExpandAll":false}}}' );
				var config = loader.load( dir );

				expect( config.theme.options.navCollapsible ).toBeTrue();
				expect( config.theme.options.navExpandAll ).toBeFalse();
			} );

			it( "throws BxDocs.InvalidConfig when [theme.options.navCollapsible] isn't a boolean", function() {
				var dir = newProjectDir( '{"name":"My Docs","theme":{"options":{"navCollapsible":["not","a","boolean"]}}}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxDocs.InvalidConfig" );
			} );

			it( "accepts [theme.options.tocPosition] of top or sticky, defaulting to top when absent", function() {
				var dir = newProjectDir( '{"name":"My Docs"}' );
				expect( loader.load( dir ).theme.options.tocPosition ?: "top" ).toBe( "top" );

				for ( var position in [ "top", "sticky" ] ) {
					var positionDir = newProjectDir( '{"name":"My Docs","theme":{"options":{"tocPosition":"' & position & '"}}}' );
					expect( loader.load( positionDir ).theme.options.tocPosition ).toBe( position );
				}
			} );

			it( "throws BxDocs.InvalidConfig when [theme.options.tocPosition] isn't top or sticky", function() {
				var dir = newProjectDir( '{"name":"My Docs","theme":{"options":{"tocPosition":"bottom"}}}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxDocs.InvalidConfig" );
			} );

			it( "accepts [theme.options.pageMetaPosition] of top or bottom, defaulting to bottom when absent", function() {
				var dir = newProjectDir( '{"name":"My Docs"}' );
				expect( loader.load( dir ).theme.options.pageMetaPosition ?: "bottom" ).toBe( "bottom" );

				for ( var position in [ "top", "bottom" ] ) {
					var positionDir = newProjectDir( '{"name":"My Docs","theme":{"options":{"pageMetaPosition":"' & position & '"}}}' );
					expect( loader.load( positionDir ).theme.options.pageMetaPosition ).toBe( position );
				}
			} );

			it( "throws BxDocs.InvalidConfig when [theme.options.pageMetaPosition] isn't top or bottom", function() {
				var dir = newProjectDir( '{"name":"My Docs","theme":{"options":{"pageMetaPosition":"middle"}}}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxDocs.InvalidConfig" );
			} );

			it( "preserves a user-supplied Google [analytics] block", function() {
				var dir = newProjectDir( '{"name":"My Docs","analytics":{"provider":"google","id":"G-ABC123"}}' );
				var config = loader.load( dir );

				expect( config.analytics.provider ).toBe( "google" );
				expect( config.analytics.id ).toBe( "G-ABC123" );
			} );

			it( "throws BxDocs.InvalidConfig when [analytics.provider] isn't google", function() {
				var dir = newProjectDir( '{"name":"My Docs","analytics":{"provider":"plausible","id":"abc"}}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxDocs.InvalidConfig" );
			} );

			it( "throws BxDocs.InvalidConfig when [analytics.provider] is set without an [analytics.id]", function() {
				var dir = newProjectDir( '{"name":"My Docs","analytics":{"provider":"google"}}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxDocs.InvalidConfig" );
			} );

			it( "throws BxDocs.InvalidConfig when [analytics.id] contains invalid characters", function() {
				var dir = newProjectDir( '{"name":"My Docs","analytics":{"provider":"google","id":"G-ABC 123!"}}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxDocs.InvalidConfig" );
			} );

			it( "preserves a user-supplied [ogImage]", function() {
				var dir = newProjectDir( '{"name":"My Docs","ogImage":"assets/social-card.png"}' );
				var config = loader.load( dir );

				expect( config.ogImage ).toBe( "assets/social-card.png" );
			} );

			it( "throws BxDocs.InvalidConfig when [ogImage] isn't a string", function() {
				var dir = newProjectDir( '{"name":"My Docs","ogImage":["not","a","string"]}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxDocs.InvalidConfig" );
			} );

			it( "preserves user-supplied [extraCss] and [extraJs] arrays", function() {
				var dir = newProjectDir( '{"name":"My Docs","extraCss":["assets/extra.css"],"extraJs":["assets/extra.js"]}' );
				var config = loader.load( dir );

				expect( config.extraCss ).toBe( [ "assets/extra.css" ] );
				expect( config.extraJs ).toBe( [ "assets/extra.js" ] );
			} );

			it( "throws BxDocs.InvalidConfig when an [extraCss] entry is empty", function() {
				var dir = newProjectDir( '{"name":"My Docs","extraCss":[""]}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxDocs.InvalidConfig" );
			} );

			it( "defaults [mermaid] to false", function() {
				var dir = newProjectDir( '{"name":"My Docs"}' );
				expect( loader.load( dir ).mermaid ).toBeFalse();
			} );

			it( "preserves a user-supplied [mermaid]", function() {
				var dir = newProjectDir( '{"name":"My Docs","mermaid":true}' );
				expect( loader.load( dir ).mermaid ).toBeTrue();
			} );

			it( "throws BxDocs.InvalidConfig when [mermaid] is not a boolean", function() {
				var dir = newProjectDir( '{"name":"My Docs","mermaid":"yes please"}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxDocs.InvalidConfig" );
			} );

			it( "defaults [math] to false", function() {
				var dir = newProjectDir( '{"name":"My Docs"}' );
				expect( loader.load( dir ).math ).toBeFalse();
			} );

			it( "preserves a user-supplied [math]", function() {
				var dir = newProjectDir( '{"name":"My Docs","math":true}' );
				expect( loader.load( dir ).math ).toBeTrue();
			} );

			it( "throws BxDocs.InvalidConfig when [math] is not a boolean", function() {
				var dir = newProjectDir( '{"name":"My Docs","math":"yes please"}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxDocs.InvalidConfig" );
			} );

			it( "defaults [plugins] to an empty array", function() {
				var dir = newProjectDir( '{"name":"My Docs"}' );
				expect( loader.load( dir ).plugins ).toBeArray();
				expect( loader.load( dir ).plugins.len() ).toBe( 0 );
			} );

			it( "preserves a user-supplied [plugins] array of module names", function() {
				var dir = newProjectDir( '{"name":"My Docs","plugins":["someBxModule"]}' );
				expect( loader.load( dir ).plugins ).toBe( [ "someBxModule" ] );
			} );

			it( "throws BxDocs.InvalidConfig when [plugins] is not an array", function() {
				var dir = newProjectDir( '{"name":"My Docs","plugins":"someBxModule"}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxDocs.InvalidConfig" );
			} );

			it( "throws BxDocs.InvalidConfig when a [plugins] entry is an empty string", function() {
				var dir = newProjectDir( '{"name":"My Docs","plugins":[""]}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxDocs.InvalidConfig" );
			} );

			it( "defaults [i18n] to an English default locale and no other locales", function() {
				var dir = newProjectDir( '{"name":"My Docs"}' );
				var i18n = loader.load( dir ).i18n;
				expect( i18n.defaultLocale ).toBe( { "code" : "en", "label" : "English" } );
				expect( i18n.locales ).toBeArray();
				expect( i18n.locales.len() ).toBe( 0 );
			} );

			it( "preserves a user-supplied [i18n.locales] array", function() {
				var dir = newProjectDir( '{"name":"My Docs","i18n":{"locales":[{"code":"es","label":"Español"},{"code":"ar","label":"العربية","dir":"rtl"}]}}' );
				var locales = loader.load( dir ).i18n.locales;
				expect( locales.len() ).toBe( 2 );
				expect( locales[ 1 ].code ).toBe( "es" );
				expect( locales[ 2 ].dir ).toBe( "rtl" );
			} );

			it( "preserves a user-supplied [i18n.defaultLocale]", function() {
				var dir = newProjectDir( '{"name":"My Docs","i18n":{"defaultLocale":{"code":"fr","label":"Français"}}}' );
				expect( loader.load( dir ).i18n.defaultLocale ).toBe( { "code" : "fr", "label" : "Français" } );
			} );

			it( "throws BxDocs.InvalidConfig when [i18n] is not an object", function() {
				var dir = newProjectDir( '{"name":"My Docs","i18n":"es"}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxDocs.InvalidConfig" );
			} );

			it( "throws BxDocs.InvalidConfig when [i18n.locales] is not an array", function() {
				var dir = newProjectDir( '{"name":"My Docs","i18n":{"locales":"es"}}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxDocs.InvalidConfig" );
			} );

			it( "throws BxDocs.InvalidConfig when a locale entry is missing [code] or [label]", function() {
				var dir = newProjectDir( '{"name":"My Docs","i18n":{"locales":[{"code":"es"}]}}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxDocs.InvalidConfig" );
			} );

			it( "throws BxDocs.InvalidConfig when a locale [code] contains characters other than letters/digits/hyphens", function() {
				var dir = newProjectDir( '{"name":"My Docs","i18n":{"locales":[{"code":"es/../etc","label":"Bad"}]}}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxDocs.InvalidConfig" );
			} );

			it( "accepts a BCP-47-shaped locale [code] with a region subtag", function() {
				var dir = newProjectDir( '{"name":"My Docs","i18n":{"locales":[{"code":"pt-BR","label":"Português"}]}}' );
				expect( loader.load( dir ).i18n.locales[ 1 ].code ).toBe( "pt-BR" );
			} );

			it( "throws BxDocs.InvalidConfig when a locale [dir] isn't ltr or rtl", function() {
				var dir = newProjectDir( '{"name":"My Docs","i18n":{"locales":[{"code":"es","label":"Español","dir":"sideways"}]}}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxDocs.InvalidConfig" );
			} );

			it( "preserves a user-supplied locale [flag] override", function() {
				var dir = newProjectDir( '{"name":"My Docs","i18n":{"locales":[{"code":"es","label":"Español","flag":"🇲🇽"}]}}' );
				expect( loader.load( dir ).i18n.locales[ 1 ].flag ).toBe( "🇲🇽" );
			} );

			it( "throws BxDocs.InvalidConfig when a locale [flag] isn't a string", function() {
				var dir = newProjectDir( '{"name":"My Docs","i18n":{"locales":[{"code":"es","label":"Español","flag":["not","a","string"]}]}}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxDocs.InvalidConfig" );
			} );

			it( "throws BxDocs.InvalidConfig when two locales share the same code (case-insensitively)", function() {
				var dir = newProjectDir( '{"name":"My Docs","i18n":{"locales":[{"code":"es","label":"Español"},{"code":"ES","label":"Duplicate"}]}}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxDocs.InvalidConfig" );
			} );

			it( "throws BxDocs.InvalidConfig when a locale reuses the default locale's own code", function() {
				var dir = newProjectDir( '{"name":"My Docs","i18n":{"locales":[{"code":"en","label":"Duplicate default"}]}}' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxDocs.InvalidConfig" );
			} );

		} );
	}

}
