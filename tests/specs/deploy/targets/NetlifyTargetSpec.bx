/**
 * deploy.targets.NetlifyTarget - guard clauses plus a fully real, offline
 * zip-then-unzip round trip of `buildZipArchive()` (no HTTP, no Netlify
 * account). An actual `POST .../deploys` call against the live Netlify API
 * has NOT been exercised anywhere in this repo - there is no real Netlify
 * site/personal-access-token available in this plain unit-test
 * environment - matching this repo's existing honesty pattern for
 * untestable-without-real-credentials code (see GhDeploySpec.bx's own
 * docblock).
 */
class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "deploy.targets.NetlifyTarget", function() {

			beforeEach( function() {
				variables.target = new "models.deploy.targets.NetlifyTarget@bxsites"();
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			private function newTempDir() {
				var dir = createTempDirectory( prefix = "bxsites-netlifytarget-" );
				tempDirs.append( dir );
				return dir;
			}

			it( "throws BxSites.InvalidDeployConfig when siteId is missing", function() {
				expect( function() {
					target.deploy( { authTokenEnvVar : "NETLIFY_TOKEN" }, { siteDir : newTempDir() } );
				} ).toThrow( "BxSites.InvalidDeployConfig" );
			} );

			it( "throws BxSites.InvalidDeployConfig when authTokenEnvVar is missing", function() {
				expect( function() {
					target.deploy( { siteId : "abc123" }, { siteDir : newTempDir() } );
				} ).toThrow( "BxSites.InvalidDeployConfig" );
			} );

			it( "throws BxSites.SiteNotBuilt when siteDir doesn't exist", function() {
				var root = newTempDir();
				expect( function() {
					target.deploy(
						{ siteId : "abc123", authTokenEnvVar : "NETLIFY_TOKEN" },
						{ siteDir : root & "/site" }
					);
				} ).toThrow( "BxSites.SiteNotBuilt" );
			} );

			it( "throws BxSites.MissingCredentials when the authTokenEnvVar env var isn't set", function() {
				var siteDir = newTempDir();
				fileWrite( siteDir & "/index.html", "hi" );

				expect( function() {
					target.deploy(
						{ siteId : "abc123", authTokenEnvVar : "BXSITES_TEST_NETLIFY_TOKEN_DOES_NOT_EXIST" },
						{ siteDir : siteDir }
					);
				} ).toThrow( "BxSites.MissingCredentials" );
			} );

			describe( "buildZipArchive()", function() {

				it( "zips the whole directory with no wrapping top-level folder, preserving exact file bytes", function() {
					var siteDir = newTempDir();
					directoryCreate( siteDir & "/assets/css", true, true );
					fileWrite( siteDir & "/index.html", "<h1>Home</h1>" );
					fileWrite( siteDir & "/assets/css/style.css", "body{color:red}" );
					fileWrite( siteDir & "/assets/nested.txt", "nested content" );

					var zipBytes = target.buildZipArchive( siteDir );
					expect( isBinary( zipBytes ) ).toBeTrue();
					expect( zipBytes.len() ).toBeGT( 0 );

					var entries = unzipEntries( zipBytes );

					// exactly these 3 entries, with paths relative to siteDir's own
					// contents - no wrapping top-level folder (e.g. no
					// "<tempdir-basename>/index.html")
					expect( entries.count() ).toBe( 3 );
					expect( entries.keyExists( "index.html" ) ).toBeTrue();
					expect( entries.keyExists( "assets/css/style.css" ) ).toBeTrue();
					expect( entries.keyExists( "assets/nested.txt" ) ).toBeTrue();

					expect( entries[ "index.html" ] ).toBe( "<h1>Home</h1>" );
					expect( entries[ "assets/css/style.css" ] ).toBe( "body{color:red}" );
					expect( entries[ "assets/nested.txt" ] ).toBe( "nested content" );
				} );

				it( "round-trips binary (non-text) file content exactly", function() {
					var siteDir = newTempDir();
					directoryCreate( siteDir, true, true );

					// build some non-UTF8-safe bytes (0..255) and write them via real Java I/O
					var out = createObject( "java", "java.io.ByteArrayOutputStream" ).init();
					for ( var i = 0; i <= 255; i++ ) {
						out.write( javaCast( "int", i ) );
					}
					var rawBytes = out.toByteArray();
					var fos = createObject( "java", "java.io.FileOutputStream" ).init( siteDir & "/image.bin" );
					fos.write( rawBytes );
					fos.close();

					var zipBytes = target.buildZipArchive( siteDir );
					var rawEntries = unzipRawEntries( zipBytes );

					expect( rawEntries.keyExists( "image.bin" ) ).toBeTrue();
					expect( rawEntries[ "image.bin" ].len() ).toBe( rawBytes.len() );
					for ( var i = 1; i <= rawBytes.len(); i++ ) {
						if ( rawBytes[ i ] != rawEntries[ "image.bin" ][ i ] ) {
							expect( false ).toBeTrue( "byte mismatch at index #i#" );
						}
					}
				} );

				it( "filters out directory entries - only real files end up in the zip", function() {
					var siteDir = newTempDir();
					directoryCreate( siteDir & "/empty-subdir", true, true );
					fileWrite( siteDir & "/index.html", "hi" );

					var zipBytes = target.buildZipArchive( siteDir );
					var entries = unzipEntries( zipBytes );

					expect( entries.count() ).toBe( 1 );
					expect( entries.keyExists( "index.html" ) ).toBeTrue();
				} );

			} );

		} );
	}

	/**
	 * Unzips `zipBytes` (via `java.util.zip.ZipInputStream`) into a
	 * { entryName : utf8Content } struct, for asserting on text content.
	 */
	private struct function unzipEntries( required binary zipBytes ) {
		var raw = unzipRawEntries( arguments.zipBytes );
		var result = {};
		for ( var name in raw ) {
			result[ name ] = createObject( "java", "java.lang.String" ).init( raw[ name ], "UTF-8" );
		}
		return result;
	}

	/**
	 * Unzips `zipBytes` into a { entryName : rawBytes } struct, for
	 * asserting on exact binary content.
	 */
	private struct function unzipRawEntries( required binary zipBytes ) {
		var bais = createObject( "java", "java.io.ByteArrayInputStream" ).init( arguments.zipBytes );
		var zis = createObject( "java", "java.util.zip.ZipInputStream" ).init( bais );
		var result = {};

		var entry = zis.getNextEntry();
		while ( !isNull( entry ) ) {
			result[ entry.getName() ] = zis.readAllBytes();
			zis.closeEntry();
			entry = zis.getNextEntry();
		}
		zis.close();
		return result;
	}

}
