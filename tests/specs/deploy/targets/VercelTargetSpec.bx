/**
 * deploy.targets.VercelTarget - guard clauses plus a fully real,
 * offline-verifiable `buildFileManifest()`/`sha1Hex()`: genuine SHA1
 * digests over real fixture file content, cross-checked against an
 * independently computed digest (no Vercel account involved, no stand-in
 * values). The actual two-step live API flow (`POST /v2/files` then
 * `POST /v13/deployments`) has NOT been exercised anywhere in this repo -
 * there is no real Vercel account/token available in this plain unit-test
 * environment - matching this repo's existing honesty pattern for
 * untestable-without-real-credentials code (see GhDeploySpec.bx's own
 * docblock).
 */
class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "deploy.targets.VercelTarget", function() {

			beforeEach( function() {
				variables.target = new "models.deploy.targets.VercelTarget@bxsites"();
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			private function newTempDir() {
				var dir = createTempDirectory( prefix = "bxsites-verceltarget-" );
				tempDirs.append( dir );
				return dir;
			}

			it( "throws BxSites.InvalidDeployConfig when projectId is missing", function() {
				expect( function() {
					target.deploy( { authTokenEnvVar : "VERCEL_TOKEN" }, { siteDir : newTempDir() } );
				} ).toThrow( "BxSites.InvalidDeployConfig" );
			} );

			it( "throws BxSites.InvalidDeployConfig when authTokenEnvVar is missing", function() {
				expect( function() {
					target.deploy( { projectId : "prj_abc" }, { siteDir : newTempDir() } );
				} ).toThrow( "BxSites.InvalidDeployConfig" );
			} );

			it( "throws BxSites.SiteNotBuilt when siteDir doesn't exist", function() {
				var root = newTempDir();
				expect( function() {
					target.deploy(
						{ projectId : "prj_abc", authTokenEnvVar : "VERCEL_TOKEN" },
						{ siteDir : root & "/site" }
					);
				} ).toThrow( "BxSites.SiteNotBuilt" );
			} );

			it( "throws BxSites.MissingCredentials when the authTokenEnvVar env var isn't set", function() {
				var siteDir = newTempDir();
				fileWrite( siteDir & "/index.html", "hi" );

				expect( function() {
					target.deploy(
						{ projectId : "prj_abc", authTokenEnvVar : "BXSITES_TEST_VERCEL_TOKEN_DOES_NOT_EXIST" },
						{ siteDir : siteDir }
					);
				} ).toThrow( "BxSites.MissingCredentials" );
			} );

			describe( "sha1Hex()", function() {

				it( "computes the real, independently-verifiable SHA1 digest of known content", function() {
					// echo -n "hello world" | shasum
					expect( target.sha1Hex( "hello world".getBytes() ) ).toBe( "2aae6c35c94fcfb415dbe95f408b9ce91ee846ed" );
					// sha1("") is a well-known constant
					expect( target.sha1Hex( "".getBytes() ) ).toBe( "da39a3ee5e6b4b0d3255bfef95601890afd80709" );
				} );

			} );

			describe( "buildFileManifest()", function() {

				it( "computes real SHA1 digests, sizes, and slash-normalized relative paths for every file", function() {
					var siteDir = newTempDir();
					directoryCreate( siteDir & "/assets/css", true, true );
					fileWrite( siteDir & "/index.html", "<h1>Home</h1>" );
					fileWrite( siteDir & "/assets/css/style.css", "body{color:red}" );

					var manifest = target.buildFileManifest( siteDir );
					expect( manifest.len() ).toBe( 2 );

					var byFile = {};
					for ( var entry in manifest ) {
						byFile[ entry.file ] = entry;
					}

					expect( byFile.keyExists( "index.html" ) ).toBeTrue();
					expect( byFile.keyExists( "assets/css/style.css" ) ).toBeTrue();

					expect( byFile[ "index.html" ].size ).toBe( len( "<h1>Home</h1>" ) );
					expect( byFile[ "index.html" ].sha ).toBe( target.sha1Hex( "<h1>Home</h1>".getBytes() ) );
					expect( byFile[ "assets/css/style.css" ].sha ).toBe( target.sha1Hex( "body{color:red}".getBytes() ) );
				} );

				it( "excludes directory entries - only real files get a manifest entry", function() {
					var siteDir = newTempDir();
					directoryCreate( siteDir & "/empty-subdir", true, true );
					fileWrite( siteDir & "/index.html", "hi" );

					var manifest = target.buildFileManifest( siteDir );
					expect( manifest.len() ).toBe( 1 );
					expect( manifest[ 1 ].file ).toBe( "index.html" );
				} );

			} );

		} );
	}

}
