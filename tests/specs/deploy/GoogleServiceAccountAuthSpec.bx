/**
 * Exercises GoogleServiceAccountAuth's pure (no-HTTP) pieces for real and
 * fully offline: base64url encoding against known test vectors, and the
 * complete JWT-building + RS256-signing path against a throwaway RSA
 * keypair generated in this spec itself (the signature is cryptographically
 * verified against that keypair's own public key, not just structurally
 * checked). `getAccessToken()`'s final HTTP call to a real Google token
 * endpoint is NOT covered here - there's no live GCP/Firebase account in
 * this sandbox to exchange a JWT with - only guard-clause behavior around
 * reading/parsing the key file is covered for that half of the flow.
 */
class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "deploy.GoogleServiceAccountAuth", function() {

			beforeEach( function() {
				variables.auth = new "models.deploy.GoogleServiceAccountAuth@bxsites"();
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			private function newTempDir() {
				var dir = createTempDirectory( prefix = "bxsites-googleauth-" );
				tempDirs.append( dir );
				return dir;
			}

			/**
			 * Generates a real throwaway RSA keypair via Java interop and PEM-encodes
			 * the private key the same shape a real GCP service-account JSON key
			 * carries it in, so buildJwt()'s real RS256-signing path can be
			 * exercised (and its signature cryptographically verified) without any
			 * real Google credentials.
			 */
			private struct function generateTestKeyPair() {
				var kpg = createObject( "java", "java.security.KeyPairGenerator" ).getInstance( "RSA" );
				kpg.initialize( javaCast( "int", 2048 ) );
				var keyPair = kpg.generateKeyPair();
				var b64 = binaryEncode( keyPair.getPrivate().getEncoded(), "base64" );
				var pem = "-----BEGIN PRIVATE KEY-----" & char( 10 ) & b64 & char( 10 ) & "-----END PRIVATE KEY-----" & char( 10 );
				return { privateKeyPem : pem, publicKey : keyPair.getPublic() };
			}

			/** Reverses our own base64url encoding back to standard base64 (restoring padding) so a spec can plain-base64-decode a JWT segment. */
			private string function base64UrlToBase64( required string value ) {
				var padded = arguments.value.replace( "-", "+", "all" ).replace( "_", "/", "all" );
				while ( len( padded ) % 4 != 0 ) {
					padded &= "=";
				}
				return padded;
			}

			describe( "base64UrlEncode()", function() {

				it( "matches a known base64url test vector", function() {
					var bytes = charsetDecode( "any carnal pleasure.", "utf-8" );
					expect( auth.base64UrlEncode( bytes ) ).toBe( "YW55IGNhcm5hbCBwbGVhc3VyZS4" );
				} );

				it( "substitutes +/ and strips padding relative to standard base64", function() {
					// Standard base64 "//5+/w==" decodes to bytes whose base64url
					// form is deterministic: "//5+/w==" -> substitute "/"->"_",
					// "+"->"-", drop the "==" padding -> "__5-_w".
					var bytes = binaryDecode( "//5+/w==", "base64" );
					expect( auth.base64UrlEncode( bytes ) ).toBe( "__5-_w" );
				} );

				it( "is deterministic", function() {
					var bytes = charsetDecode( "same input every time", "utf-8" );
					expect( auth.base64UrlEncode( bytes ) ).toBe( auth.base64UrlEncode( bytes ) );
				} );

			} );

			describe( "buildJwt()", function() {

				it( "produces a 3-segment token with the exact expected header and claims", function() {
					var keyPair = generateTestKeyPair();
					var serviceAccountKey = {
						"client_email" : "test-sa@my-project.iam.gserviceaccount.com",
						"private_key"  : keyPair.privateKeyPem,
						"token_uri"    : "https://oauth2.googleapis.com/token"
					};
					var issuedAt = 1700000000;

					var jwt = auth.buildJwt( serviceAccountKey, "https://www.googleapis.com/auth/devstorage.read_write", issuedAt );
					var parts = listToArray( jwt, "." );
					expect( parts.len() ).toBe( 3 );

					var header = jsonDeserialize( charsetEncode( binaryDecode( base64UrlToBase64( parts[ 1 ] ), "base64" ), "utf-8" ) );
					var claims = jsonDeserialize( charsetEncode( binaryDecode( base64UrlToBase64( parts[ 2 ] ), "base64" ), "utf-8" ) );

					expect( header.alg ).toBe( "RS256" );
					expect( header.typ ).toBe( "JWT" );
					expect( claims.iss ).toBe( serviceAccountKey.client_email );
					expect( claims.scope ).toBe( "https://www.googleapis.com/auth/devstorage.read_write" );
					expect( claims.aud ).toBe( serviceAccountKey.token_uri );
					expect( claims.iat ).toBe( issuedAt );
					expect( claims.exp ).toBe( issuedAt + 3600 );
				} );

				it( "produces a signature that verifies against the signing key's own matching public key", function() {
					var keyPair = generateTestKeyPair();
					var serviceAccountKey = {
						"client_email" : "test-sa@my-project.iam.gserviceaccount.com",
						"private_key"  : keyPair.privateKeyPem,
						"token_uri"    : "https://oauth2.googleapis.com/token"
					};

					var jwt = auth.buildJwt( serviceAccountKey, "some-scope", 1700000000 );
					var parts = listToArray( jwt, "." );
					var signingInput = parts[ 1 ] & "." & parts[ 2 ];
					var signatureBytes = binaryDecode( base64UrlToBase64( parts[ 3 ] ), "base64" );

					var verifier = createObject( "java", "java.security.Signature" ).getInstance( "SHA256withRSA" );
					verifier.initVerify( keyPair.publicKey );
					verifier.update( charsetDecode( signingInput, "utf-8" ) );

					expect( verifier.verify( signatureBytes ) ).toBeTrue();
				} );

				it( "produces a different signature for a different signing key (not a fixed/faked value)", function() {
					var keyPairA = generateTestKeyPair();
					var keyPairB = generateTestKeyPair();
					var serviceAccountKeyA = { "client_email" : "a@x.iam.gserviceaccount.com", "private_key" : keyPairA.privateKeyPem, "token_uri" : "https://oauth2.googleapis.com/token" };
					var serviceAccountKeyB = { "client_email" : "a@x.iam.gserviceaccount.com", "private_key" : keyPairB.privateKeyPem, "token_uri" : "https://oauth2.googleapis.com/token" };

					var jwtA = auth.buildJwt( serviceAccountKeyA, "scope", 1700000000 );
					var jwtB = auth.buildJwt( serviceAccountKeyB, "scope", 1700000000 );

					expect( jwtA ).notToBe( jwtB );
				} );

			} );

			describe( "readServiceAccountKey()", function() {

				it( "throws BxSites.MissingServiceAccountKey when the file doesn't exist", function() {
					var dir = newTempDir();
					expect( function() {
						auth.readServiceAccountKey( dir & "/does-not-exist.json" );
					} ).toThrow( "BxSites.MissingServiceAccountKey" );
				} );

				it( "throws BxSites.InvalidServiceAccountKey when the file isn't valid JSON", function() {
					var dir = newTempDir();
					var path = dir & "/key.json";
					fileWrite( path, "not json at all {{{" );

					expect( function() {
						auth.readServiceAccountKey( path );
					} ).toThrow( "BxSites.InvalidServiceAccountKey" );
				} );

				it( "throws BxSites.InvalidServiceAccountKey when a required field is missing", function() {
					var dir = newTempDir();
					var path = dir & "/key.json";
					fileWrite( path, jsonSerialize( { "client_email" : "a@b.iam.gserviceaccount.com" } ) );

					expect( function() {
						auth.readServiceAccountKey( path );
					} ).toThrow( "BxSites.InvalidServiceAccountKey" );
				} );

				it( "unescapes a PEM private_key's literal backslash-n sequences into real newlines via JSON parsing", function() {
					var dir = newTempDir();
					var path = dir & "/key.json";
					// Written as RAW JSON TEXT (not built via jsonSerialize() of a
					// BoxLang string, since BoxLang string literals don't interpret
					// backslash escapes at all - see this repo's AGENTS.md). This is
					// exactly the on-disk shape a real downloaded GCP key file has:
					// a literal two-character "\n" escape sequence inside the JSON
					// string value, which jsonDeserialize() (a real JSON parser) is
					// expected to unescape into an actual newline character.
					var rawJson = '{"client_email":"a@b.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\nabc\n-----END PRIVATE KEY-----\n","token_uri":"https://oauth2.googleapis.com/token"}';
					fileWrite( path, rawJson );

					var key = auth.readServiceAccountKey( path );

					expect( key.client_email ).toBe( "a@b.iam.gserviceaccount.com" );
					expect( key.token_uri ).toBe( "https://oauth2.googleapis.com/token" );
					expect( key.private_key ).toInclude( char( 10 ) );
					expect( key.private_key ).notToInclude( "\n" & "abc" );
					expect( key.private_key ).toInclude( char( 10 ) & "abc" );
				} );

			} );

		} );
	}

}
