class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "cli.Clean", function() {

			beforeEach( function() {
				variables.verb = new "models.cli.Clean@bxsites"();
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			private function newProjectDir() {
				var dir = createTempDirectory( prefix = "bxsites-cli-clean-" );
				tempDirs.append( dir );
				return dir;
			}

			it( "throws BxSites.MissingProjectRoot when projectRoot is blank", function() {
				expect( function() {
					verb.run( {} );
				} ).toThrow( "BxSites.MissingProjectRoot" );
			} );

			it( "removes site/ and .cache/ when present, and reports what it removed", function() {
				var dir = newProjectDir();
				directoryCreate( dir & "/site", true, true );
				directoryCreate( dir & "/.cache", true, true );

				var result = verb.run( { projectRoot : dir, force : true } );

				expect( result.exitCode ).toBe( 0 );
				expect( directoryExists( dir & "/site" ) ).toBeFalse();
				expect( directoryExists( dir & "/.cache" ) ).toBeFalse();
				expect( result.message ).toInclude( "site" );
				expect( result.message ).toInclude( ".cache" );
			} );

			it( "leaves docs/ and bxsites.json alone", function() {
				var dir = newProjectDir();
				directoryCreate( dir & "/docs", true, true );
				fileWrite( dir & "/bxsites.json", '{"name":"Keep Me"}' );
				directoryCreate( dir & "/site", true, true );

				verb.run( { projectRoot : dir, force : true } );

				expect( directoryExists( dir & "/docs" ) ).toBeTrue();
				expect( fileExists( dir & "/bxsites.json" ) ).toBeTrue();
			} );

			it( "reports nothing to clean when there is no site/ or .cache/", function() {
				var dir = newProjectDir();
				var result = verb.run( { projectRoot : dir } );

				expect( result.exitCode ).toBe( 0 );
				expect( result.message ).toBe( "Nothing to clean" );
			} );

			it( "asks for confirmation without --force, and deletes on yes", function() {
				var dir = newProjectDir();
				directoryCreate( dir & "/site", true, true );
				var asked = [];
				verb.setPrompter( ( message ) => {
					asked.append( message );
					return "y";
				} );

				var result = verb.run( { projectRoot : dir } );

				expect( asked.len() ).toBe( 1 );
				expect( asked[ 1 ] ).toInclude( "site/" );
				expect( asked[ 1 ] ).toInclude( dir );
				expect( directoryExists( dir & "/site" ) ).toBeFalse();
				expect( result.message ).toInclude( "Removed" );
			} );

			it( "deletes nothing when the confirmation is declined or left blank", function() {
				var dir = newProjectDir();
				directoryCreate( dir & "/site", true, true );

				for ( var answer in [ "n", "", "maybe" ] ) {
					var reply = answer;
					verb.setPrompter( ( message ) => reply );

					var result = verb.run( { projectRoot : dir } );

					expect( result.exitCode ).toBe( 0 );
					expect( result.message ).toInclude( "Cancelled" );
					expect( directoryExists( dir & "/site" ) ).toBeTrue();
				}
			} );

			it( "fails with a --force hint when the prompt can't be answered (no stdin)", function() {
				var dir = newProjectDir();
				directoryCreate( dir & "/site", true, true );
				verb.setPrompter( ( message ) => {
					throw( type = "BoxRuntimeException", message = "Error reading from the CLI" );
				} );

				var result = verb.run( { projectRoot : dir } );

				expect( result.exitCode ).toBe( 1 );
				expect( result.message ).toInclude( "--force" );
				expect( directoryExists( dir & "/site" ) ).toBeTrue();
			} );

			it( "doesn't prompt when there is nothing to clean", function() {
				var dir = newProjectDir();
				verb.setPrompter( ( message ) => {
					throw( type = "Test.ShouldNotPrompt" );
				} );

				expect( verb.run( { projectRoot : dir } ).message ).toBe( "Nothing to clean" );
			} );

		} );
	}

}
