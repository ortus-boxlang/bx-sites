class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "cli.SearchIndex", function() {

			beforeEach( function() {
				variables.verb = new "models.cli.SearchIndex@bxdocs"();
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			it( "throws BxDocs.MissingProjectRoot when projectRoot is blank", function() {
				expect( function() {
					verb.run( {} );
				} ).toThrow( "BxDocs.MissingProjectRoot" );
			} );

			it( "throws BxDocs.ConfigNotFound when the project has no bxdocs.json", function() {
				var dir = createTempDirectory( prefix = "bxdocs-cli-searchindex-" );
				tempDirs.append( dir );

				expect( function() {
					verb.run( { projectRoot : dir } );
				} ).toThrow( "BxDocs.ConfigNotFound" );
			} );

			it( "reports search as disabled without error when bxdocs.json turns it off", function() {
				var dir = createTempDirectory( prefix = "bxdocs-cli-searchindex-" );
				tempDirs.append( dir );
				directoryCreate( dir & "/docs", true, true );
				fileWrite( dir & "/bxdocs.json", '{"name":"Test Site","search":false}' );

				var result = verb.run( { projectRoot : dir } );

				expect( result.exitCode ).toBe( 0 );
				expect( result.message ).toInclude( "disabled" );
			} );

		} );
	}

}
