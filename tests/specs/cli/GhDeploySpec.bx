/**
 * cli.GhDeploy only covers guard clauses here, matching cli.Build's own
 * spec (BuildSpec.bx) - a full successful run needs a real bx-markdown
 * module activation (MarkdownRenderer.bx's hard dependency, see its own
 * docblock), which this plain unit-test environment doesn't have. The
 * actual git push mechanics are fully covered against real throwaway
 * repositories in GhPagesDeployerSpec.bx instead, and real end-to-end
 * build behavior (with an injectable fake markdown renderer) in
 * BuildPipelineSpec.bx.
 */
class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "cli.GhDeploy", function() {

			beforeEach( function() {
				variables.verb = new "models.cli.GhDeploy@bxsites"();
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			it( "throws BxSites.MissingProjectRoot when projectRoot is blank", function() {
				expect( function() {
					verb.run( {} );
				} ).toThrow( "BxSites.MissingProjectRoot" );
			} );

			it( "throws BxSites.ConfigNotFound when the project has no bxsites.json", function() {
				var dir = createTempDirectory( prefix = "bxsites-cli-ghdeploy-" );
				tempDirs.append( dir );

				expect( function() {
					verb.run( { projectRoot : dir } );
				} ).toThrow( "BxSites.ConfigNotFound" );
			} );

			it( "throws BxSites.NotAGitRepo when the project has no .git, even with a valid bxsites.json", function() {
				var dir = createTempDirectory( prefix = "bxsites-cli-ghdeploy-" );
				tempDirs.append( dir );
				directoryCreate( dir & "/docs", true, true );
				fileWrite( dir & "/bxsites.json", '{"name":"Test Site"}' );
				fileWrite( dir & "/docs/index.md", "Home" );

				expect( function() {
					verb.run( { projectRoot : dir } );
				} ).toThrow( "BxSites.NotAGitRepo" );
			} );

		} );
	}

}
