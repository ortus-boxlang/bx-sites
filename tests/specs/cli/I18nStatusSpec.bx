class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "cli.I18nStatus", function() {

			beforeEach( function() {
				variables.verb = new "models.cli.I18nStatus@bxsites"();
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			private string function newProjectRoot() {
				var dir = createTempDirectory( prefix = "bxsites-cli-i18nstatus-" );
				tempDirs.append( dir );
				directoryCreate( dir & "/docs", true, true );
				fileWrite( dir & "/docs/index.md", "Home" );
				return dir;
			}

			it( "throws BxSites.MissingProjectRoot when projectRoot is blank", function() {
				expect( function() {
					verb.run( {} );
				} ).toThrow( "BxSites.MissingProjectRoot" );
			} );

			it( "always exits 0 and reports no locales when there's no docs/i18n/", function() {
				var projectRoot = newProjectRoot();

				var result = verb.run( { projectRoot : projectRoot } );

				expect( result.exitCode ).toBe( 0 );
				expect( result.message ).toInclude( "No docs/i18n/ locales found" );
			} );

			it( "reports per-locale translated/missing counts", function() {
				var projectRoot = newProjectRoot();
				directoryCreate( projectRoot & "/docs/i18n/es", true, true );
				fileWrite( projectRoot & "/docs/i18n/es/index.md", "Inicio" );

				var result = verb.run( { projectRoot : projectRoot } );

				expect( result.message ).toInclude( "es: 1/1 translated (100%)" );
			} );

		} );
	}

}
