class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "cli.New", function() {

			beforeEach( function() {
				variables.verb = new "models.cli.New@bxdocs"();
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			private function newTargetDir() {
				var parent = createTempDirectory( prefix = "bxdocs-cli-new-" );
				tempDirs.append( parent );
				return parent & "/my-docs";
			}

			it( "throws BxDocs.MissingProjectRoot when projectRoot is blank", function() {
				expect( function() {
					verb.run( {} );
				} ).toThrow( "BxDocs.MissingProjectRoot" );
			} );

			it( "scaffolds a project defaulting to the bootstrap theme and bxdocs.yaml, returning exitCode 0", function() {
				var dir = newTargetDir();
				var result = verb.run( { projectRoot : dir } );

				expect( result.exitCode ).toBe( 0 );
				expect( fileExists( dir & "/bxdocs.yaml" ) ).toBeTrue();
				expect( fileExists( dir & "/bxdocs.json" ) ).toBeFalse();
				expect( result.message ).toInclude( "bootstrap" );
			} );

			it( "honors an explicit --format=json, scaffolding bxdocs.json instead", function() {
				var dir = newTargetDir();
				var result = verb.run( { projectRoot : dir, format : "json" } );

				expect( fileExists( dir & "/bxdocs.json" ) ).toBeTrue();
				expect( fileExists( dir & "/bxdocs.yaml" ) ).toBeFalse();

				var config = new "models.config.ConfigLoader@bxdocs"().load( dir );
				expect( config.theme.name ).toBe( "bootstrap" );
			} );

			it( "derives the site name from the target directory name when --name is omitted", function() {
				var dir = newTargetDir();
				// format: "json" here (and in the two tests below) only to
				// keep this test's own re-load through ConfigLoader on the
				// core jsonDeserialize() path rather than real bx-yaml BIFs -
				// unrelated to what this test is actually asserting (name/
				// theme derivation, not config format); see YamlRenderer.bx's
				// docblock.
				verb.run( { projectRoot : dir, format : "json" } );

				var config = new "models.config.ConfigLoader@bxdocs"().load( dir );
				expect( config.name ).toBe( "my-docs" );
			} );

			it( "honors an explicit --name", function() {
				var dir = newTargetDir();
				verb.run( { projectRoot : dir, name : "Custom Name", format : "json" } );

				var config = new "models.config.ConfigLoader@bxdocs"().load( dir );
				expect( config.name ).toBe( "Custom Name" );
			} );

			it( "honors an explicit --theme", function() {
				var dir = newTargetDir();
				verb.run( { projectRoot : dir, theme : "tailwind", format : "json" } );

				var config = new "models.config.ConfigLoader@bxdocs"().load( dir );
				expect( config.theme.name ).toBe( "tailwind" );
			} );

			it( "throws BxDocs.UnknownTheme for a theme outside the built-in set", function() {
				var dir = newTargetDir();
				expect( function() {
					verb.run( { projectRoot : dir, theme : "not-a-real-theme" } );
				} ).toThrow( "BxDocs.UnknownTheme" );
			} );

		} );
	}

}
