class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "cli.Migrate", function() {

			beforeEach( function() {
				variables.verb = new "models.cli.Migrate@bxsites"();
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			it( "throws BxSites.MissingProjectRoot when projectRoot is blank", function() {
				expect( function() {
					verb.run( { source : "/tmp/wherever" } );
				} ).toThrow( "BxSites.MissingProjectRoot" );
			} );

			it( "throws BxSites.MissingMigrateSource when --source is blank", function() {
				var dir = createTempDirectory( prefix = "bxsites-cli-migrate-" );
				tempDirs.append( dir );

				expect( function() {
					verb.run( { projectRoot : dir } );
				} ).toThrow( "BxSites.MissingMigrateSource" );
			} );

			it( "throws BxSites.MigrateSourceNotFound when --source doesn't exist", function() {
				var dir = createTempDirectory( prefix = "bxsites-cli-migrate-" );
				tempDirs.append( dir );

				expect( function() {
					verb.run( { projectRoot : dir, source : dir & "/no-such-dir" } );
				} ).toThrow( "BxSites.MigrateSourceNotFound" );
			} );

			it( "migrates a GitBook export into the project's docs/ tree, creating docs/ if needed", function() {
				var projectRoot = createTempDirectory( prefix = "bxsites-cli-migrate-project-" );
				var source = createTempDirectory( prefix = "bxsites-cli-migrate-source-" );
				tempDirs.append( projectRoot );
				tempDirs.append( source );

				fileWrite( source & "/SUMMARY.md", "* [Home](README.md)" );
				fileWrite( source & "/README.md", "Welcome." );

				var result = verb.run( { projectRoot : projectRoot, source : source } );

				expect( result.exitCode ).toBe( 0 );
				expect( result.message ).toInclude( "Migrated 1 page(s)" );
				expect( fileExists( projectRoot & "/docs/index.md" ) ).toBeTrue();
				expect( fileExists( projectRoot & "/docs/nav.json" ) ).toBeTrue();
			} );

			it( "defaults --from to gitbook when it's not passed", function() {
				var projectRoot = createTempDirectory( prefix = "bxsites-cli-migrate-project-" );
				var source = createTempDirectory( prefix = "bxsites-cli-migrate-source-" );
				tempDirs.append( projectRoot );
				tempDirs.append( source );

				fileWrite( source & "/SUMMARY.md", "* [Home](README.md)" );
				fileWrite( source & "/README.md", "Welcome." );

				var result = verb.run( { projectRoot : projectRoot, source : source, from : "" } );

				expect( result.exitCode ).toBe( 0 );
				expect( fileExists( projectRoot & "/docs/nav.json" ) ).toBeTrue();
			} );

			it( "throws BxSites.InvalidMigrateSource when --from isn't gitbook or mkdocs", function() {
				var projectRoot = createTempDirectory( prefix = "bxsites-cli-migrate-project-" );
				var source = createTempDirectory( prefix = "bxsites-cli-migrate-source-" );
				tempDirs.append( projectRoot );
				tempDirs.append( source );

				expect( function() {
					verb.run( { projectRoot : projectRoot, source : source, from : "docusaurus" } );
				} ).toThrow( "BxSites.InvalidMigrateSource" );
			} );

			it( "migrates an mkdocs project into a complete bx-sites project when --from=mkdocs", function() {
				var projectRoot = createTempDirectory( prefix = "bxsites-cli-migrate-project-" );
				var source = createTempDirectory( prefix = "bxsites-cli-migrate-mkdocs-source-" );
				tempDirs.append( projectRoot );
				tempDirs.append( source );

				directoryCreate( source & "/docs", true, true );
				fileWrite( source & "/mkdocs.yml", "site_name: My Docs" );
				fileWrite( source & "/docs/index.md", "Welcome." );

				var result = verb.run( { projectRoot : projectRoot, source : source, from : "mkdocs" } );

				expect( result.exitCode ).toBe( 0 );
				expect( result.message ).toInclude( "Migrated 1 page(s)" );
				expect( fileExists( projectRoot & "/bxsites.yaml" ) ).toBeTrue();
				expect( fileExists( projectRoot & "/docs/index.md" ) ).toBeTrue();
				expect( yamlDeserialize( fileRead( projectRoot & "/bxsites.yaml" ) ).name ).toBe( "My Docs" );
			} );

		} );
	}

}
