class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "cli.ThemeNew", function() {

			beforeEach( function() {
				variables.verb = new "models.cli.ThemeNew@bxsites"();
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			private string function newProjectRoot() {
				var dir = createTempDirectory( prefix = "bxsites-cli-themenew-" );
				tempDirs.append( dir );
				return dir;
			}

			it( "throws BxSites.MissingProjectRoot when projectRoot is blank", function() {
				expect( function() {
					verb.run( { theme : "bootstrap" } );
				} ).toThrow( "BxSites.MissingProjectRoot" );
			} );

			it( "throws BxSites.MissingThemeName when theme is blank", function() {
				expect( function() {
					verb.run( { projectRoot : newProjectRoot() } );
				} ).toThrow( "BxSites.MissingThemeName" );
			} );

			it( "exits 0 and copies the theme into project theme/", function() {
				var projectRoot = newProjectRoot();

				var result = verb.run( { projectRoot : projectRoot, theme : "tailwind" } );

				expect( result.exitCode ).toBe( 0 );
				expect( fileExists( projectRoot & "/theme/layout.bxm" ) ).toBeTrue();
			} );

		} );
	}

}
