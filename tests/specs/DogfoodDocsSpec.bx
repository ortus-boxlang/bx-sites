/**
 * Confirms this repository's own dogfooded `bxsites.yaml` + `docs/` (module
 * spec Phase 5 - "docs + examples for bx-sites itself") actually build
 * cleanly through the real pipeline, using the same fake markdown renderer
 * and fake image-variant-generator seams as BuildPipelineSpec.bx (neither
 * bx-markdown nor bx-image is installed in this module's own unit-test CI
 * job - see .github/workflows/tests.yml). Builds into a temp copy so it
 * never leaves a stray `site/` in the working tree.
 */
class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "Dogfooded docs (this repo's own docs/ + bxsites.yaml)", function() {

			beforeEach( function() {
				variables.repoRoot = getDirectoryFromPath( getCurrentTemplatePath() ).reReplace( "[\/]tests[\/]specs[\/]?$", "" )
				variables.tempRoot = createTempDirectory( prefix = "bxsites-dogfood-" )
				directoryCopy( variables.repoRoot & "/docs", variables.tempRoot & "/docs", true )
				fileCopy( variables.repoRoot & "/bxsites.yaml", variables.tempRoot & "/bxsites.yaml" )

				variables.pipeline = new "models.build.BuildPipeline@bxsites"()
				variables.pipeline.setMarkdownRenderer( new "tests.support.FakeMarkdownRenderer@bxsites"() )
				variables.pipeline.setImageVariantGenerator( new "tests.support.FakeImageVariantGenerator@bxsites"() )
			} );

			afterEach( function() {
				if ( directoryExists( variables.tempRoot ) ) {
					directoryDelete( variables.tempRoot, true )
				}
			} );

			it( "loads and validates bxsites.yaml", function() {
				var config = new "models.config.ConfigLoader@bxsites"().load( repoRoot )
				expect( config.name ).toBe( "BX Sites" )
				expect( config.theme.name ).toBe( "bootstrap" )
			} );

			it( "builds every dogfooded page without error, with a non-empty nav", function() {
				var result = pipeline.build( tempRoot )

				expect( result.pageCount ).toBeGTE( 5 )
				expect( fileExists( tempRoot & "/site/index.html" ) ).toBeTrue()
				expect( fileExists( tempRoot & "/site/getting-started/index.html" ) ).toBeTrue()
				expect( fileExists( tempRoot & "/site/guides/themes/index.html" ) ).toBeTrue()

				var nav = new "models.build.NavBuilder@bxsites"().build( new "models.build.DocsLoader@bxsites"().load( tempRoot & "/docs" ) )
				expect( nav.len() ).toBeGT( 0 )
			} );

			it( "builds a non-empty search index for the dogfooded docs", function() {
				pipeline.build( tempRoot )

				expect( fileExists( tempRoot & "/site/search-index.json" ) ).toBeTrue()
				var index = jsonDeserialize( fileRead( tempRoot & "/site/search-index.json" ) )
				expect( index.len() ).toBeGTE( 5 )
			} );

		} );
	}

}
