class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "build.NavBuilder", function() {

			beforeEach( function() {
				variables.navBuilder = new "models.build.NavBuilder@bxdocs"();
			} );

			private struct function page(
				string relativePath,
				string title,
				numeric order = 999999,
				boolean hidden = false,
				string urlPath = ""
			) {
				return {
					relativePath : arguments.relativePath,
					title        : arguments.title,
					order        : arguments.order,
					hidden       : arguments.hidden,
					urlPath      : len( arguments.urlPath ) ? arguments.urlPath : arguments.relativePath.reReplaceNoCase( "\.md$", "/index.html" )
				};
			}

			it( "returns an empty nav for an empty page list", function() {
				expect( navBuilder.build( [] ) ).toBeArray();
				expect( navBuilder.build( [] ).len() ).toBe( 0 );
			} );

			it( "builds flat top-level nav entries for flat pages, sorted by order", function() {
				var pages = [
					page( relativePath = "b.md", title = "B", order = 2 ),
					page( relativePath = "a.md", title = "A", order = 1 )
				];

				var nav = navBuilder.build( pages );

				expect( nav.len() ).toBe( 2 );
				expect( nav[ 1 ].title ).toBe( "A" );
				expect( nav[ 2 ].title ).toBe( "B" );
			} );

			it( "excludes hidden pages entirely", function() {
				var pages = [
					page( relativePath = "visible.md", title = "Visible" ),
					page( relativePath = "secret.md", title = "Secret", hidden = true )
				];

				var nav = navBuilder.build( pages );

				expect( nav.len() ).toBe( 1 );
				expect( nav[ 1 ].title ).toBe( "Visible" );
			} );

			it( "groups nested pages under a folder node with no link when the folder has no index.md", function() {
				var pages = [
					page( relativePath = "guides/setup.md", title = "Setup", urlPath = "guides/setup/index.html" )
				];

				var nav = navBuilder.build( pages );

				expect( nav.len() ).toBe( 1 );
				expect( nav[ 1 ].title ).toBe( "guides" );
				expect( nav[ 1 ].url ).toBe( "" );
				expect( nav[ 1 ].children.len() ).toBe( 1 );
				expect( nav[ 1 ].children[ 1 ].title ).toBe( "Setup" );
				expect( nav[ 1 ].children[ 1 ].url ).toBe( "guides/setup/index.html" );
			} );

			it( "uses a folder's index.md as that folder's own nav entry", function() {
				var pages = [
					page( relativePath = "guides/index.md", title = "Guides Home", order = 1, urlPath = "guides/index.html" ),
					page( relativePath = "guides/setup.md", title = "Setup", order = 2, urlPath = "guides/setup/index.html" )
				];

				var nav = navBuilder.build( pages );

				expect( nav.len() ).toBe( 1 );
				expect( nav[ 1 ].title ).toBe( "Guides Home" );
				expect( nav[ 1 ].url ).toBe( "guides/index.html" );
				expect( nav[ 1 ].children.len() ).toBe( 1 );
				expect( nav[ 1 ].children[ 1 ].title ).toBe( "Setup" );
			} );

			it( "sorts sibling nodes (folders and pages together) by order then title", function() {
				var pages = [
					page( relativePath = "zeta.md", title = "Zeta", order = 1 ),
					page( relativePath = "alpha/index.md", title = "Alpha Group", order = 0, urlPath = "alpha/index.html" )
				];

				var nav = navBuilder.build( pages );

				expect( nav[ 1 ].title ).toBe( "Alpha Group" );
				expect( nav[ 2 ].title ).toBe( "Zeta" );
			} );

			it( "includes a root-level index.md as its own top-level nav entry (regression)", function() {
				var pages = [
					page( relativePath = "index.md", title = "Home", order = 1, urlPath = "index.html" ),
					page( relativePath = "about.md", title = "About", order = 2 )
				];

				var nav = navBuilder.build( pages );

				expect( nav.len() ).toBe( 2 );
				expect( nav[ 1 ].title ).toBe( "Home" );
				expect( nav[ 1 ].url ).toBe( "index.html" );
				expect( nav[ 2 ].title ).toBe( "About" );
			} );

			it( "flatten() returns an empty array for an empty nav", function() {
				expect( navBuilder.flatten( [] ) ).toBeArray();
				expect( navBuilder.flatten( [] ).len() ).toBe( 0 );
			} );

			it( "flatten() walks the tree depth-first in reading order, skipping link-less folder groups", function() {
				var pages = [
					page( relativePath = "index.md", title = "Home", order = 1, urlPath = "index.html" ),
					page( relativePath = "guides/setup.md", title = "Setup", order = 1, urlPath = "guides/setup/index.html" ),
					page( relativePath = "guides/deploy.md", title = "Deploy", order = 2, urlPath = "guides/deploy/index.html" ),
					page( relativePath = "about.md", title = "About", order = 2 )
				];

				var flat = navBuilder.flatten( navBuilder.build( pages ) );

				// top-level order: Home(1), About(2), guides-group(999999, no index.md) - then
				// its children Setup/Deploy in place of the group itself, since it has no url
				expect( flat.len() ).toBe( 4 );
				expect( flat[ 1 ].title ).toBe( "Home" );
				expect( flat[ 2 ].title ).toBe( "About" );
				expect( flat[ 3 ].title ).toBe( "Setup" );
				expect( flat[ 4 ].title ).toBe( "Deploy" );
			} );

			it( "breadcrumbs() returns just the page itself for a top-level page", function() {
				var pages = [ page( relativePath = "about.md", title = "About" ) ];
				var nav = navBuilder.build( pages );

				var crumbs = navBuilder.breadcrumbs( nav, "about/index.html" );

				expect( crumbs.len() ).toBe( 1 );
				expect( crumbs[ 1 ].title ).toBe( "About" );
			} );

			it( "breadcrumbs() includes a link-less folder group ancestor by title only", function() {
				var pages = [ page( relativePath = "guides/setup.md", title = "Setup", urlPath = "guides/setup/index.html" ) ];
				var nav = navBuilder.build( pages );

				var crumbs = navBuilder.breadcrumbs( nav, "guides/setup/index.html" );

				expect( crumbs.len() ).toBe( 1 );
				expect( crumbs[ 1 ].title ).toBe( "Setup" );
			} );

			it( "breadcrumbs() returns the full root-first ancestor chain for a nested page under a real folder index.md", function() {
				var pages = [
					page( relativePath = "guides/index.md", title = "Guides", order = 1, urlPath = "guides/index.html" ),
					page( relativePath = "guides/setup.md", title = "Setup", order = 2, urlPath = "guides/setup/index.html" )
				];
				var nav = navBuilder.build( pages );

				var crumbs = navBuilder.breadcrumbs( nav, "guides/setup/index.html" );

				expect( crumbs.len() ).toBe( 2 );
				expect( crumbs[ 1 ].title ).toBe( "Guides" );
				expect( crumbs[ 1 ].url ).toBe( "guides/index.html" );
				expect( crumbs[ 2 ].title ).toBe( "Setup" );
			} );

			it( "breadcrumbs() returns an empty array for a url not present in the nav (e.g. a hidden page)", function() {
				var pages = [ page( relativePath = "about.md", title = "About" ) ];
				var nav = navBuilder.build( pages );

				expect( navBuilder.breadcrumbs( nav, "secret/index.html" ) ).toBeArray();
				expect( navBuilder.breadcrumbs( nav, "secret/index.html" ).len() ).toBe( 0 );
			} );

			it( "breadcrumbs() doesn't leak a sibling branch's ancestor after backtracking", function() {
				var pages = [
					page( relativePath = "guides/index.md", title = "Guides", order = 1, urlPath = "guides/index.html" ),
					page( relativePath = "guides/setup.md", title = "Setup", order = 2, urlPath = "guides/setup/index.html" ),
					page( relativePath = "about.md", title = "About", order = 2 )
				];
				var nav = navBuilder.build( pages );

				var crumbs = navBuilder.breadcrumbs( nav, "about/index.html" );

				expect( crumbs.len() ).toBe( 1 );
				expect( crumbs[ 1 ].title ).toBe( "About" );
			} );

		} );
	}

}
