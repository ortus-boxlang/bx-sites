class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "build.TableWrapProcessor", function() {

			beforeEach( function() {
				variables.processor = new "models.build.TableWrapProcessor@bxsites"()
			} );

			it( "leaves HTML with no table untouched", function() {
				var html = "<p>No tables here.</p>"
				expect( processor.wrap( html ) ).toBe( html )
			} );

			it( "wraps a single table in a bxsites-table-wrap div", function() {
				var html = "<p>Before.</p><table><thead><tr><th>A</th></tr></thead><tbody><tr><td>1</td></tr></tbody></table><p>After.</p>"
				var result = processor.wrap( html )
				expect( result ).toBe( '<p>Before.</p><div class="bxsites-table-wrap"><table><thead><tr><th>A</th></tr></thead><tbody><tr><td>1</td></tr></tbody></table></div><p>After.</p>' )
			} );

			it( "wraps each of multiple sibling tables independently", function() {
				var html = "<table><tr><td>1</td></tr></table><p>Between.</p><table><tr><td>2</td></tr></table>"
				var result = processor.wrap( html )
				expect( result ).toBe( '<div class="bxsites-table-wrap"><table><tr><td>1</td></tr></table></div><p>Between.</p><div class="bxsites-table-wrap"><table><tr><td>2</td></tr></table></div>' )
			} );

			it( "preserves a table's own attributes (e.g. tableOptions.className)", function() {
				var html = '<table class="table"><tr><td>1</td></tr></table>'
				var result = processor.wrap( html )
				expect( result ).toBe( '<div class="bxsites-table-wrap"><table class="table"><tr><td>1</td></tr></table></div>' )
			} );

			it( "wraps only the outer table when one table is nested inside another (raw HTML in a cell)", function() {
				var html = "<table><tr><td>outer<table><tr><td>inner</td></tr></table></td></tr></table>"
				var result = processor.wrap( html )
				expect( result ).toBe( '<div class="bxsites-table-wrap"><table><tr><td>outer<table><tr><td>inner</td></tr></table></td></tr></table></div>' )
			} );

			it( "leaves an unterminated table tag untouched rather than guessing", function() {
				var html = "<p>Before.</p><table><tr><td>no closing tag"
				expect( processor.wrap( html ) ).toBe( html )
			} );

			describe( "row filter (>= 10 data rows)", function() {

				private string function tableWithRows( required numeric rowCount ) {
					var rows = ""
					for ( var i = 1; i <= arguments.rowCount; i++ ) {
						rows &= "<tr><td>Row #i#</td></tr>"
					}
					return "<table><thead><tr><th>Name</th></tr></thead><tbody>" & rows & "</tbody></table>"
				}

				it( "adds no filter input or x-show for a table with fewer than 10 data rows", function() {
					var result = processor.wrap( tableWithRows( 9 ) )
					expect( result ).notToInclude( "bxsites-table-filter" )
					expect( result ).notToInclude( "x-show" )
					expect( result ).toInclude( '<div class="bxsites-table-wrap"><table>' )
				} );

				it( "adds a filter input and x-data on the wrap div for a table with exactly 10 data rows", function() {
					var result = processor.wrap( tableWithRows( 10 ) )
					expect( result ).toInclude( 'x-data="{ q: '''' }"' )
					expect( result ).toInclude( 'x-model="q"' )
					expect( result ).toInclude( 'class="bxsites-table-filter"' )
				} );

				it( "tags every data row with x-show bound to q, but leaves the header row untouched", function() {
					var result = processor.wrap( tableWithRows( 10 ) )
					expect( result ).toInclude( '<thead><tr><th>Name</th></tr></thead>' )
					expect( result.reMatchNoCase( "<tr x-show=" ).len() ).toBe( 10 )
				} );

				it( "does not tag rows when there's no thead, still counting all <tr> as data rows", function() {
					var rows = ""
					for ( var i = 1; i <= 10; i++ ) {
						rows &= "<tr><td>Row #i#</td></tr>"
					}
					var result = processor.wrap( "<table>" & rows & "</table>" )
					expect( result.reMatchNoCase( "<tr x-show=" ).len() ).toBe( 10 )
				} );

				it( "preserves a tagged row's own attributes", function() {
					var rows = ""
					for ( var i = 1; i <= 10; i++ ) {
						rows &= '<tr class="row-#i#"><td>Row #i#</td></tr>'
					}
					var result = processor.wrap( "<table><thead><tr><th>Name</th></tr></thead><tbody>" & rows & "</tbody></table>" )
					expect( result ).toInclude( '<tr x-show="!q || $el.textContent.toLowerCase().includes( q.toLowerCase() )" class="row-1">' )
				} );

			} );

		} );
	}

}
