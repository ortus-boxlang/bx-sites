class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "build.UpdatesFeedGenerator", function() {

			beforeEach( function() {
				variables.generator = new "models.build.UpdatesFeedGenerator@bxsites"();
				variables.page = { title : "Changelog", urlPath : "changelog/index.html" };
			} );

			// encodeForHTML()'s exact escaping range for "safe" ASCII
			// punctuation (e.g. "/", ":") is environment-dependent
			// (locale/JVM-charset-driven) - both the escaped numeric-entity
			// form and the raw character are equally valid, equivalent XML,
			// so the <link> assertion below compares against decoded output
			// rather than pinning one form.
			private string function htmlDecode( required string text ) {
				var matcher = createObject( "java", "java.util.regex.Pattern" ).compile( '&##x([0-9a-fA-F]+);' ).matcher( arguments.text )
				var buffer = createObject( "java", "java.lang.StringBuilder" ).init()
				while ( matcher.find() ) {
					var codepoint = createObject( "java", "java.lang.Integer" ).parseInt( matcher.group( 1 ), 16 )
					var chars = createObject( "java", "java.lang.String" ).valueOf( createObject( "java", "java.lang.Character" ).toChars( codepoint ) )
					matcher.appendReplacement( buffer, createObject( "java", "java.util.regex.Matcher" ).quoteReplacement( chars ) )
				}
				matcher.appendTail( buffer )
				return buffer.toString()
			}

			it( "renders a valid RSS 2.0 shell with the page's title/link", function() {
				var xml = htmlDecode( generator.build( [], page, "BX Sites", "https://example.com/" ) );

				expect( xml ).toInclude( '<rss version="2.0">' );
				expect( xml ).toInclude( "<title>BX Sites - Changelog</title>" );
				expect( xml ).toInclude( "<link>https://example.com/changelog/index.html</link>" );
			} );

			it( "sorts entries newest date first regardless of input order", function() {
				var entries = [
					{ date : "2026-01-01", tags : [], contentHtml : "<p>Old.</p>" },
					{ date : "2026-02-01", tags : [], contentHtml : "<p>New.</p>" }
				];

				var xml = generator.build( entries, page, "BX Sites", "https://example.com/" );

				expect( xml.find( "New." ) ).toBeLT( xml.find( "Old." ) );
			} );

			it( "renders one <category> per tag and none when an entry has no tags", function() {
				var entries = [
					{ date : "2026-01-01", tags : [ "feature", "fix" ], contentHtml : "<p>A.</p>" },
					{ date : "2026-01-02", tags : [], contentHtml : "<p>B.</p>" }
				];

				var xml = generator.build( entries, page, "BX Sites", "https://example.com/" );

				expect( xml ).toInclude( "<category>feature</category>" );
				expect( xml ).toInclude( "<category>fix</category>" );
			} );

			it( "HTML-escapes an entry's rendered content in <description>", function() {
				var entries = [ { date : "2026-01-01", tags : [], contentHtml : "<p>A & B</p>" } ];

				var xml = generator.build( entries, page, "BX Sites", "https://example.com/" );

				expect( xml ).toInclude( "&lt;p&gt;" );
				expect( xml ).notToInclude( "<p>A & B</p>" );
			} );

		} );
	}

}
