/**
 * SocialCardGenerator.bx renders real PNGs with bx-image, so these specs
 * exercise the actual renderer rather than a fake - the module is a plain
 * dependency, with nothing to seam around.
 */
class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "build.SocialCardGenerator", function() {

			beforeEach( function() {
				variables.generator = new "models.build.SocialCardGenerator@bxsites"();
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			// bx-image has no pixel getter, so read the packed ARGB int off its BufferedImage
			private struct function pixelAt( required any image, required numeric x, required numeric y ) {
				var rgb = arguments.image.getBufferedImage().getRGB( arguments.x, arguments.y );
				return { red : bitAnd( bitSHRN( rgb, 16 ), 255 ), green : bitAnd( bitSHRN( rgb, 8 ), 255 ), blue : bitAnd( rgb, 255 ) };
			}

			private function newOutputPath() {
				var dir = createTempDirectory( prefix = "bxsites-socialcard-" );
				tempDirs.append( dir );
				return dir & "/card.png";
			}

			it( "writes a 1200x630 PNG file", function() {
				var outputPath = newOutputPath();

				generator.generate( "A Page Title", "My Site", outputPath );

				expect( fileExists( outputPath ) ).toBeTrue();

				var image = imageRead( outputPath );
				expect( image.getWidth() ).toBe( 1200 );
				expect( image.getHeight() ).toBe( 630 );
			} );

			it( "still produces a valid PNG for a title long enough to wrap and truncate", function() {
				var outputPath = newOutputPath();
				var longTitle = "A Genuinely Very Long Page Title That Will Need To Wrap Across Several Lines And Then Get Truncated With An Ellipsis Because It Just Keeps Going On And On";

				generator.generate( longTitle, "My Site", outputPath );

				var image = imageRead( outputPath );
				expect( image.getWidth() ).toBe( 1200 );
				expect( image.getHeight() ).toBe( 630 );
			} );

			it( "renders a card with every option set and a raster logo", function() {
				var outputPath = newOutputPath();
				var logoPath = getDirectoryFromPath( outputPath ) & "logo.png";
				imageNew( "", 64, 32, "argb", "red" ).write( logoPath );

				generator.generate( "A Page Title", "My Site", outputPath, {
					description : "What this page is about, in a sentence or two.",
					section     : "Getting Started",
					url         : "example.com/getting-started/page",
					logoPath    : logoPath,
					background  : "##101820",
					accent      : "##f0a",
					accentEnd   : "##00DBFF",
					text        : "##ffffff",
					muted       : "##99aab5"
				} );

				var image = imageRead( outputPath );
				expect( image.getWidth() ).toBe( 1200 );
				expect( image.getHeight() ).toBe( 630 );
			} );

			it( "paints the accent gradient along the bottom edge", function() {
				var outputPath = newOutputPath();

				generator.generate( "Title", "My Site", outputPath, { accent : "##ff0000", accentEnd : "##0000ff" } );

				var image = imageRead( outputPath );
				var left = pixelAt( image, 2, 625 );
				var right = pixelAt( image, 1197, 625 );
				expect( left.red ).toBeGT( left.blue );
				expect( right.blue ).toBeGT( right.red );
			} );

			it( "falls back to the default colors for an invalid color value", function() {
				var outputPath = newOutputPath();

				generator.generate( "Title", "My Site", outputPath, { accent : "not-a-color", background : "##12" } );

				expect( fileExists( outputPath ) ).toBeTrue();
			} );

			it( "ignores a logo or font that is missing or not a raster image", function() {
				var outputPath = newOutputPath();
				var notAnImage = getDirectoryFromPath( outputPath ) & "logo.svg";
				fileWrite( notAnImage, "<svg xmlns='http://www.w3.org/2000/svg'/>" );

				generator.generate( "Title", "My Site", outputPath, {
					logoPath : notAnImage,
					fontPath : getDirectoryFromPath( outputPath ) & "missing.ttf"
				} );
				expect( fileExists( outputPath ) ).toBeTrue();

				generator.generate( "Title", "My Site", outputPath, { logoPath : getDirectoryFromPath( outputPath ) & "missing.png" } );
				expect( fileExists( outputPath ) ).toBeTrue();
			} );

			it( "produces a valid PNG for an empty title", function() {
				var outputPath = newOutputPath();

				generator.generate( "", "My Site", outputPath );

				expect( fileExists( outputPath ) ).toBeTrue();
			} );

		} );
	}

}
