/**
 * Exercises MkdocsYamlParser.bx directly against the YAML shapes real
 * mkdocs.yml files actually use - not a general YAML conformance suite.
 */
class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "build.MkdocsYamlParser", function() {

			beforeEach( function() {
				variables.parser = new "models.build.MkdocsYamlParser@bxdocs"();
			} );

			it( "parses flat scalars - string, quoted string, number, boolean", function() {
				var doc = parser.parse( 'site_name: My Docs' & char( 10 ) & 'site_description: "A great project"' & char( 10 ) & 'strict: true' & char( 10 ) & 'port: 8000' );

				expect( doc.site_name ).toBe( "My Docs" );
				expect( doc.site_description ).toBe( "A great project" );
				expect( doc.strict ).toBeTrue();
				expect( doc.port ).toBe( 8000 );
			} );

			it( "does not mistake a URL's own colon for the key/value split", function() {
				var doc = parser.parse( "site_url: https://example.com/docs/" );
				expect( doc.site_url ).toBe( "https://example.com/docs/" );
			} );

			it( "parses a nested map", function() {
				var doc = parser.parse( "theme:" & char( 10 ) & "  name: material" & char( 10 ) & "  palette:" & char( 10 ) & "    primary: indigo" );

				expect( doc.theme.name ).toBe( "material" );
				expect( doc.theme.palette.primary ).toBe( "indigo" );
			} );

			it( "parses a flat list of scalars", function() {
				var doc = parser.parse( "markdown_extensions:" & char( 10 ) & "  - admonition" & char( 10 ) & "  - footnotes" );

				expect( doc.markdown_extensions ).toBeArray();
				expect( doc.markdown_extensions ).toBe( [ "admonition", "footnotes" ] );
			} );

			it( "parses an inline list", function() {
				var doc = parser.parse( "extra_css: [assets/extra.css, assets/brand.css]" );
				expect( doc.extra_css ).toBe( [ "assets/extra.css", "assets/brand.css" ] );
			} );

			it( "parses mkdocs' own nav shorthand - a list of single-key maps", function() {
				var doc = parser.parse( "nav:" & char( 10 ) & "  - Home: index.md" & char( 10 ) & "  - About: about.md" );

				expect( doc.nav ).toBeArray();
				expect( doc.nav.len() ).toBe( 2 );
				expect( doc.nav[ 1 ].Home ).toBe( "index.md" );
				expect( doc.nav[ 2 ].About ).toBe( "about.md" );
			} );

			it( "parses a nested nav group (a single-key map whose value is itself a list)", function() {
				var yaml = "nav:" & char( 10 ) &
					"  - Home: index.md" & char( 10 ) &
					"  - Guide:" & char( 10 ) &
					"      - Setup: guide/setup.md" & char( 10 ) &
					"      - Advanced: guide/advanced.md" & char( 10 ) &
					"  - About: about.md";
				var doc = parser.parse( yaml );

				expect( doc.nav.len() ).toBe( 3 );
				expect( doc.nav[ 1 ].Home ).toBe( "index.md" );
				expect( doc.nav[ 2 ].Guide ).toBeArray();
				expect( doc.nav[ 2 ].Guide.len() ).toBe( 2 );
				expect( doc.nav[ 2 ].Guide[ 1 ].Setup ).toBe( "guide/setup.md" );
				expect( doc.nav[ 2 ].Guide[ 2 ].Advanced ).toBe( "guide/advanced.md" );
				expect( doc.nav[ 3 ].About ).toBe( "about.md" );
			} );

			it( "parses a list of maps with their own config (markdown_extensions with options)", function() {
				var yaml = "markdown_extensions:" & char( 10 ) &
					"  - admonition" & char( 10 ) &
					"  - pymdownx.tabbed:" & char( 10 ) &
					"      alternate_style: true";
				var doc = parser.parse( yaml );

				expect( doc.markdown_extensions[ 1 ] ).toBe( "admonition" );
				expect( doc.markdown_extensions[ 2 ][ "pymdownx.tabbed" ].alternate_style ).toBeTrue();
			} );

			it( "ignores full-line and trailing comments", function() {
				var doc = parser.parse( "# a comment" & char( 10 ) & "site_name: My Docs # trailing comment" );
				expect( doc.site_name ).toBe( "My Docs" );
			} );

			it( "does not treat a # inside a quoted value as a comment", function() {
				var doc = parser.parse( 'site_name: "Docs # Not A Comment"' );
				expect( doc.site_name ).toBe( "Docs # Not A Comment" );
			} );

			it( "skips blank lines", function() {
				var doc = parser.parse( "site_name: My Docs" & char( 10 ) & char( 10 ) & char( 10 ) & "strict: true" );
				expect( doc.site_name ).toBe( "My Docs" );
				expect( doc.strict ).toBeTrue();
			} );

			it( "returns an empty struct for empty content", function() {
				expect( parser.parse( "" ) ).toBeStruct();
				expect( parser.parse( "" ).isEmpty() ).toBeTrue();
			} );

		} );
	}

}
