class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "build.ResponsiveImageProcessor", function() {

			beforeEach( function() {
				variables.processor = new "models.build.ResponsiveImageProcessor@bxdocs"();
			} );

			private struct function entry( array originalVariants = [], array webpVariants = [] ) {
				return { width : 1600, height : 900, originalVariants : arguments.originalVariants, webpVariants : arguments.webpVariants };
			}

			it( "leaves html untouched when the manifest is empty", function() {
				var html = '<img src="assets/screenshot.png" alt="A screenshot">';

				var result = processor.resolve( html, "index.md", "/", {} );

				expect( result ).toBe( html );
			} );

			it( "leaves an <img> untouched when its src has no manifest entry", function() {
				var html = '<img src="assets/unprocessed.svg" alt="Logo">';
				var manifest = { "assets/screenshot.png" : entry( [ { width : 800, format : "png", fileName : "screenshot-800w.abc123.png" } ] ) };

				var result = processor.resolve( html, "index.md", "/", manifest );

				expect( result ).toBe( html );
			} );

			it( "leaves an <img> untouched when its manifest entry has no variants at all (image too small to qualify)", function() {
				var html = '<img src="assets/tiny.png" alt="Tiny">';
				var manifest = { "assets/tiny.png" : entry() };

				var result = processor.resolve( html, "index.md", "/", manifest );

				expect( result ).toBe( html );
			} );

			it( "leaves an external or root-relative <img> src untouched even if it would otherwise resolve to a manifest key", function() {
				var manifest = { "assets/screenshot.png" : entry( [ { width : 800, format : "png", fileName : "screenshot-800w.abc123.png" } ] ) };

				var external = '<img src="https://example.com/assets/screenshot.png" alt="External">';
				expect( processor.resolve( external, "index.md", "/", manifest ) ).toBe( external );

				var rootRelative = '<img src="/assets/screenshot.png" alt="Root relative">';
				expect( processor.resolve( rootRelative, "index.md", "/", manifest ) ).toBe( rootRelative );
			} );

			it( "rewrites a matched <img> into a <picture> with only an img srcset when there are no webp variants", function() {
				var html = '<img src="assets/screenshot.png" alt="A screenshot" class="shadow">';
				var manifest = {
					"assets/screenshot.png" : entry( [
						{ width : 400, format : "png", fileName : "screenshot-400w.abc123.png" },
						{ width : 800, format : "png", fileName : "screenshot-800w.abc123.png" }
					] )
				};

				var result = processor.resolve( html, "index.md", "/", manifest );

				expect( result ).toStartWith( "<picture>" );
				expect( result ).toEndWith( "</picture>" );
				expect( result ).notToInclude( "image/webp" );
				expect( result ).toInclude( 'src="/assets/screenshot.png"' );
				expect( result ).toInclude( 'srcset="/assets/screenshot-400w.abc123.png 400w, /assets/screenshot-800w.abc123.png 800w"' );
				expect( result ).toInclude( 'sizes="(min-width: 800px) 800px, 100vw"' );
				// Other original attributes survive untouched.
				expect( result ).toInclude( 'alt="A screenshot"' );
				expect( result ).toInclude( 'class="shadow"' );
			} );

			it( "adds a webp <source> when webp variants exist, ahead of the fallback <img>", function() {
				var html = '<img src="assets/screenshot.png" alt="A screenshot">';
				var manifest = {
					"assets/screenshot.png" : entry(
						[],
						[ { width : 1600, format : "webp", fileName : "screenshot-1600w.abc123.webp" } ]
					)
				};

				var result = processor.resolve( html, "index.md", "/", manifest );

				expect( result ).toInclude( '<source type="image/webp" srcset="/assets/screenshot-1600w.abc123.webp 1600w">' );
				expect( result.find( "<source" ) < result.find( "<img" ) ).toBeTrue();
				// No same-format variants - the fallback <img> tag itself (not the
				// <source> above it) keeps its plain src, no srcset of its own.
				var imgTag = result.reReplace( "^.*(<img[^>]*>).*$", "\1", "one" );
				expect( imgTag ).notToInclude( "srcset" );
				expect( imgTag ).toInclude( 'src="/assets/screenshot.png"' );
			} );

			it( "resolves a nested page's relative src against its own docs-relative directory, not the site output directory", function() {
				var html = '<img src="../assets/screenshot.png" alt="A screenshot">';
				var manifest = { "assets/screenshot.png" : entry( [ { width : 800, format : "png", fileName : "screenshot-800w.abc123.png" } ] ) };

				// "guides/setup.md" -> directory "guides" -> "../assets/screenshot.png" resolves to "assets/screenshot.png"
				var result = processor.resolve( html, "guides/setup.md", "/", manifest );

				expect( result ).toInclude( 'src="/assets/screenshot.png"' );
				expect( result ).toInclude( "screenshot-800w.abc123.png" );
			} );

			it( "prefixes every rewritten URL with a non-root basePath", function() {
				var html = '<img src="assets/screenshot.png" alt="A screenshot">';
				var manifest = { "assets/screenshot.png" : entry( [ { width : 800, format : "png", fileName : "screenshot-800w.abc123.png" } ] ) };

				var result = processor.resolve( html, "index.md", "/my-docs/", manifest );

				expect( result ).toInclude( 'src="/my-docs/assets/screenshot.png"' );
				expect( result ).toInclude( "/my-docs/assets/screenshot-800w.abc123.png" );
			} );

			it( "rewrites variant URLs under the same subdirectory as the original, for a nested asset", function() {
				var html = '<img src="assets/sub/screenshot.png" alt="Nested">';
				var manifest = { "assets/sub/screenshot.png" : entry( [ { width : 800, format : "png", fileName : "screenshot-800w.abc123.png" } ] ) };

				var result = processor.resolve( html, "index.md", "/", manifest );

				expect( result ).toInclude( "/assets/sub/screenshot-800w.abc123.png" );
			} );

			it( "rewrites more than one eligible <img> in the same page", function() {
				var html = '<img src="assets/a.png" alt="A"><p>text</p><img src="assets/b.png" alt="B">';
				var manifest = {
					"assets/a.png" : entry( [ { width : 800, format : "png", fileName : "a-800w.aaa111.png" } ] ),
					"assets/b.png" : entry( [ { width : 800, format : "png", fileName : "b-800w.bbb222.png" } ] )
				};

				var result = processor.resolve( html, "index.md", "/", manifest );

				expect( result ).toInclude( "a-800w.aaa111.png" );
				expect( result ).toInclude( "b-800w.bbb222.png" );
				expect( result ).toInclude( "<p>text</p>" );
			} );

		} );
	}

}
