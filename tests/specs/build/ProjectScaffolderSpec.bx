class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "build.ProjectScaffolder", function() {

			beforeEach( function() {
				variables.scaffolder = new "models.build.ProjectScaffolder@bxsites"();
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			private function newTargetDir() {
				var parent = createTempDirectory( prefix = "bxsites-scaffolder-" );
				tempDirs.append( parent );
				return parent & "/my-site";
			}

			it( "creates docs/index.md and bxsites.yaml by default", function() {
				var dir = newTargetDir();
				var result = scaffolder.scaffold( dir, "My Site", "bootstrap" );

				expect( fileExists( dir & "/docs/index.md" ) ).toBeTrue();
				expect( fileExists( dir & "/bxsites.yaml" ) ).toBeTrue();
				expect( directoryExists( dir & "/docs/assets" ) ).toBeTrue();
				expect( result.projectRoot ).toBe( dir );
				expect( result.configPath ).toBe( dir & "/bxsites.yaml" );
			} );

			it( "writes a bxsites.yaml with the requested name/description/theme, and ConfigLoader resolves it as this project's config file", function() {
				var dir = newTargetDir();
				scaffolder.scaffold( dir, "My Site", "material", "A cool site" );

				// A content substring check, not a real yamlDeserialize()
				// round trip - real bx-yaml BIFs aren't safely callable in a
				// bare unit test (YamlRenderer.bx's own docblock); this is a
				// unit-level spec (BlogAuthorsLoaderSpec.bx/ConfigLoaderSpec.bx's
				// own JSON-only fixtures make the same choice), so it stays
				// this side of that boundary rather than exercising it.
				var yaml = fileRead( dir & "/bxsites.yaml" );
				expect( yaml ).toInclude( "My Site" );
				expect( yaml ).toInclude( "A cool site" );
				expect( yaml ).toInclude( "material" );
				expect( new "models.config.ConfigLoader@bxsites"().configPathFor( dir ) ).toBe( dir & "/bxsites.yaml" );
			} );

			it( "escapes quotes in the site name/description so the YAML stays valid", function() {
				var dir = newTargetDir();
				scaffolder.scaffold( dir, 'Say "Hi"', "bootstrap", 'Quote: "hello"' );

				var yaml = fileRead( dir & "/bxsites.yaml" );
				expect( yaml ).toInclude( 'name: "Say \"Hi\""' );
				expect( yaml ).toInclude( 'description: "Quote: \"hello\""' );
			} );

			it( "scaffolds bxsites.json instead when format is json", function() {
				var dir = newTargetDir();
				var result = scaffolder.scaffold( dir, "My Site", "bootstrap", "", "json" );

				expect( fileExists( dir & "/bxsites.json" ) ).toBeTrue();
				expect( fileExists( dir & "/bxsites.yaml" ) ).toBeFalse();
				expect( result.configPath ).toBe( dir & "/bxsites.json" );

				var config = new "models.config.ConfigLoader@bxsites"().load( dir );
				expect( config.name ).toBe( "My Site" );
			} );

			it( "scaffolds bxsites.toml instead when format is toml", function() {
				var dir = newTargetDir();
				var result = scaffolder.scaffold( dir, "My Site", "bootstrap", "", "toml" );

				expect( fileExists( dir & "/bxsites.toml" ) ).toBeTrue();
				expect( fileExists( dir & "/bxsites.yaml" ) ).toBeFalse();
				expect( result.configPath ).toBe( dir & "/bxsites.toml" );

				var config = new "models.config.ConfigLoader@bxsites"().load( dir );
				expect( config.name ).toBe( "My Site" );
			} );

			it( "escapes quotes in the site name/description so the scaffolded JSON stays valid", function() {
				var dir = newTargetDir();
				scaffolder.scaffold( dir, 'Say "Hi"', "bootstrap", 'Quote: "hello"', "json" );

				var config = new "models.config.ConfigLoader@bxsites"().load( dir );
				expect( config.name ).toBe( 'Say "Hi"' );
				expect( config.description ).toBe( 'Quote: "hello"' );
			} );

			it( "throws BxSites.InvalidFormat for an unknown format", function() {
				var dir = newTargetDir();
				expect( function() {
					scaffolder.scaffold( dir, "My Site", "bootstrap", "", "ini" );
				} ).toThrow( "BxSites.InvalidFormat" );
			} );

			it( "refuses to overwrite a project that already has a bxsites.yaml", function() {
				var dir = newTargetDir();
				scaffolder.scaffold( dir, "My Site", "bootstrap" );

				expect( function() {
					scaffolder.scaffold( dir, "My Site", "bootstrap" );
				} ).toThrow( "BxSites.ProjectAlreadyExists" );
			} );

			it( "refuses to scaffold bxsites.yaml over a project that already has a bxsites.json", function() {
				var dir = newTargetDir();
				scaffolder.scaffold( dir, "My Site", "bootstrap", "", "json" );

				expect( function() {
					scaffolder.scaffold( dir, "My Site", "bootstrap" );
				} ).toThrow( "BxSites.ProjectAlreadyExists" );
			} );

		} );
	}

}
