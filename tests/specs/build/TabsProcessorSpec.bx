class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "build.TabsProcessor", function() {

			beforeEach( function() {
				variables.processor = new "models.build.TabsProcessor@bxsites"();
				variables.fakeRenderer = new "tests.support.FakeMarkdownRenderer@bxsites"();
			} );

			it( "leaves markdown with no tab blocks untouched", function() {
				var md = "Just a paragraph." & char( 10 ) & char( 10 ) & "Another one.";
				var result = processor.extract( md );

				expect( result.markdown ).toBe( md );
				expect( result.groups ).toBeArray();
				expect( result.groups.len() ).toBe( 0 );
			} );

			it( "extracts a tab group into a single placeholder div and records each tab's dedented content", function() {
				var md = '=== "Java"' & char( 10 ) &
					"    line one" & char( 10 ) &
					"    line two" & char( 10 ) &
					char( 10 ) &
					'=== "BoxLang"' & char( 10 ) &
					"    println( 1 )";

				var result = processor.extract( md );

				expect( result.groups.len() ).toBe( 1 );
				var group = result.groups[ 1 ];
				expect( group.tabs.len() ).toBe( 2 );
				expect( group.tabs[ 1 ].title ).toBe( "Java" );
				expect( group.tabs[ 1 ].content ).toBe( "line one" & char( 10 ) & "line two" );
				expect( group.tabs[ 2 ].title ).toBe( "BoxLang" );
				expect( group.tabs[ 2 ].content ).toBe( "println( 1 )" );

				expect( result.markdown ).toInclude( '<div class="bxsites-raw-block" data-bxsites-token="' & group.token & '"></div>' );
				expect( result.markdown ).notToInclude( "===" );
			} );

			it( "dedents tab-indented lines by a leading tab as well as 4 spaces", function() {
				var md = '=== "A"' & char( 10 ) & char( 9 ) & "tabbed line";
				var result = processor.extract( md );

				expect( result.groups[ 1 ].tabs[ 1 ].content ).toBe( "tabbed line" );
			} );

			it( "preserves a blank line inside a single tab's own content", function() {
				var md = '=== "A"' & char( 10 ) &
					"    first para" & char( 10 ) &
					char( 10 ) &
					"    second para";

				var result = processor.extract( md );

				expect( result.groups[ 1 ].tabs[ 1 ].content ).toBe( "first para" & char( 10 ) & char( 10 ) & "second para" );
			} );

			it( "stops a tab group at the first non-indented, non-blank line", function() {
				var md = '=== "A"' & char( 10 ) &
					"    inside tab" & char( 10 ) &
					char( 10 ) &
					"Outside the tabs entirely.";

				var result = processor.extract( md );

				expect( result.markdown ).toInclude( "Outside the tabs entirely." );
				expect( result.groups[ 1 ].tabs[ 1 ].content ).toBe( "inside tab" );
			} );

			it( "restores a placeholder with the assembled tab widget, rendering each tab's own content", function() {
				var md = '=== "Java"' & char( 10 ) & "    hello java" & char( 10 ) & char( 10 ) &
					'=== "BoxLang"' & char( 10 ) & "    hello bx";
				var extracted = processor.extract( md );
				var html = "<p>before</p>" & char( 10 ) &
					'<div class="bxsites-raw-block" data-bxsites-token="' & extracted.groups[ 1 ].token & '"></div>' &
					char( 10 ) & "<p>after</p>";

				var restored = processor.restore( html, extracted.groups, fakeRenderer );

				expect( restored ).notToInclude( "data-bxsites-token" );
				expect( restored ).toInclude( '<div class="bxsites-tabs" data-bxsites-tabgroup role="tablist">' );
				expect( restored ).toInclude( '<button type="button" class="bxsites-tab-btn bxsites-tab-btn--active" data-bxsites-tab="1">Java</button>' );
				expect( restored ).toInclude( '<button type="button" class="bxsites-tab-btn" data-bxsites-tab="2">BoxLang</button>' );
				expect( restored ).toInclude( "<p>hello java</p>" );
				expect( restored ).toInclude( "<p>hello bx</p>" );
				expect( restored ).toInclude( "<p>before</p>" );
				expect( restored ).toInclude( "<p>after</p>" );
			} );

			it( "marks only the first tab panel/button active", function() {
				var md = '=== "A"' & char( 10 ) & "    a" & char( 10 ) & char( 10 ) & '=== "B"' & char( 10 ) & "    b";
				var extracted = processor.extract( md );
				var html = '<div class="bxsites-raw-block" data-bxsites-token="' & extracted.groups[ 1 ].token & '"></div>';

				var restored = processor.restore( html, extracted.groups, fakeRenderer );

				expect( restored ).toInclude( 'class="bxsites-tab-panel bxsites-tab-panel--active" data-bxsites-tab="1"' );
				expect( restored ).toInclude( 'class="bxsites-tab-panel" data-bxsites-tab="2"' );
			} );

			it( "extracts every tab in a group nested inside a list item, whose own headers need extra indentation just to stay part of that item", function() {
				// A real docs.md pattern: `  - some option - description:` followed by
				// a blank line, then a tab group whose headers are indented 4 spaces
				// (to remain part of the list item's own content) and whose body
				// lines are indented 4 further (8 total) to be read as that header's
				// own content. Before the fix, the second header's own indentation
				// made isTabBodyLine() misread it as more body content of the first
				// tab, silently dropping the whole second tab.
				var md = "  - `some.option` - description text." & char( 10 ) &
					char( 10 ) &
					'    === "YAML"' & char( 10 ) &
					"        some: yaml" & char( 10 ) &
					char( 10 ) &
					'    === "JSON"' & char( 10 ) &
					'        { "some": "json" }' & char( 10 ) &
					"  - next item";

				var result = processor.extract( md );

				expect( result.groups.len() ).toBe( 1 );
				var group = result.groups[ 1 ];
				expect( group.tabs.len() ).toBe( 2 );
				expect( group.tabs[ 1 ].title ).toBe( "YAML" );
				expect( group.tabs[ 1 ].content ).toBe( "some: yaml" );
				expect( group.tabs[ 2 ].title ).toBe( "JSON" );
				expect( group.tabs[ 2 ].content ).toBe( '{ "some": "json" }' );
				expect( result.markdown ).notToInclude( "===" );
				expect( result.markdown ).toInclude( "  - next item" );
			} );

			it( "keeps a nested tab group's placeholder indented to stay inside its enclosing list item", function() {
				var md = "  - `some.option` - description text." & char( 10 ) &
					char( 10 ) &
					'    === "YAML"' & char( 10 ) &
					"        some: yaml" & char( 10 ) &
					"  - next item";

				var result = processor.extract( md );

				var group = result.groups[ 1 ];
				expect( result.markdown ).toInclude( '    <div class="bxsites-raw-block" data-bxsites-token="' & group.token & '"></div>' );
			} );

		} );
	}

}
