class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "build.VersionsDiscoverer", function() {

			beforeEach( function() {
				variables.discoverer = new "models.build.VersionsDiscoverer@bxdocs"();
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			private function newDocsDir() {
				var dir = createTempDirectory( prefix = "bxdocs-versionsdiscoverer-" );
				tempDirs.append( dir );
				return dir;
			}

			it( "returns an empty array when docs/versions/ doesn't exist", function() {
				var docsDir = newDocsDir();

				expect( discoverer.discover( docsDir ) ).toBeArray();
				expect( discoverer.discover( docsDir ).len() ).toBe( 0 );
			} );

			it( "returns an empty array when docs/versions/ exists but is empty", function() {
				var docsDir = newDocsDir();
				directoryCreate( docsDir & "/versions", true, true );

				expect( discoverer.discover( docsDir ).len() ).toBe( 0 );
			} );

			it( "lists each direct subfolder of docs/versions/, ignoring loose files", function() {
				var docsDir = newDocsDir();
				directoryCreate( docsDir & "/versions/1.0", true, true );
				directoryCreate( docsDir & "/versions/2.0", true, true );
				fileWrite( docsDir & "/versions/readme.txt", "not a version" );

				var versions = discoverer.discover( docsDir );

				expect( versions.len() ).toBe( 2 );
				expect( versions ).toInclude( "1.0" );
				expect( versions ).toInclude( "2.0" );
			} );

			it( "sorts numerically (newest first), not lexicographically", function() {
				var docsDir = newDocsDir();
				directoryCreate( docsDir & "/versions/2.0", true, true );
				directoryCreate( docsDir & "/versions/10.0", true, true );
				directoryCreate( docsDir & "/versions/9.0", true, true );

				var versions = discoverer.discover( docsDir );

				expect( versions ).toBe( [ "10.0", "9.0", "2.0" ] );
			} );

			it( "sorts multi-segment semver-like names correctly", function() {
				var docsDir = newDocsDir();
				directoryCreate( docsDir & "/versions/1.2.0", true, true );
				directoryCreate( docsDir & "/versions/1.10.0", true, true );
				directoryCreate( docsDir & "/versions/1.9.0", true, true );

				var versions = discoverer.discover( docsDir );

				expect( versions ).toBe( [ "1.10.0", "1.9.0", "1.2.0" ] );
			} );

		} );
	}

}
