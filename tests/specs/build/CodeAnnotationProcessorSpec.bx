class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "build.CodeAnnotationProcessor", function() {

			beforeEach( function() {
				variables.processor = new "models.build.CodeAnnotationProcessor@bxsites"();
			} );

			it( "leaves a plain fence with no extra attributes untouched and records an empty annotation", function() {
				var md = "```bx" & char( 10 ) & "println( 1 )" & char( 10 ) & "```";
				var result = processor.extractAndStrip( md );

				expect( result.markdown ).toBe( md );
				expect( result.annotations.len() ).toBe( 1 );
				expect( result.annotations[ 1 ].isEmpty() ).toBeTrue();
			} );

			it( "strips hl_lines/linenums/title attributes back down to a bare language fence", function() {
				var md = '```bx hl_lines="2" linenums="5" title="app.bx"' & char( 10 ) & "a" & char( 10 ) & "b" & char( 10 ) & "```";
				var result = processor.extractAndStrip( md );

				expect( result.markdown ).toStartWith( "```bx" & char( 10 ) );
				expect( result.markdown ).notToInclude( "hl_lines" );
				expect( result.annotations.len() ).toBe( 1 );

				var annotation = result.annotations[ 1 ];
				expect( annotation.hlLines ).toBe( [ 2 ] );
				expect( annotation.showLineNumbers ).toBeTrue();
				expect( annotation.startLine ).toBe( 5 );
				expect( annotation.title ).toBe( "app.bx" );
			} );

			it( "expands a hl_lines range like 4-6 alongside discrete numbers", function() {
				var md = '```bx hl_lines="2 4-6"' & char( 10 ) & "x" & char( 10 ) & "```";
				var result = processor.extractAndStrip( md );

				expect( result.annotations[ 1 ].hlLines ).toBe( [ 2, 4, 5, 6 ] );
			} );

			it( "parses frame/insert/delete attributes alongside the existing trio", function() {
				var md = '```bx title="add.bx" frame="terminal" insert="3-4" delete="7"' & char( 10 ) & "x" & char( 10 ) & "```";
				var result = processor.extractAndStrip( md );

				var annotation = result.annotations[ 1 ];
				expect( annotation.frame ).toBe( "terminal" );
				expect( annotation.insertLines ).toBe( [ 3, 4 ] );
				expect( annotation.deleteLines ).toBe( [ 7 ] );
			} );

			it( "defaults frame to an empty string and insert/delete to empty arrays when absent", function() {
				var md = '```bx hl_lines="1"' & char( 10 ) & "x" & char( 10 ) & "```";
				var result = processor.extractAndStrip( md );

				var annotation = result.annotations[ 1 ];
				expect( annotation.frame ).toBe( "" );
				expect( annotation.insertLines ).toBe( [] );
				expect( annotation.deleteLines ).toBe( [] );
			} );

			it( "tracks annotations in fence order across multiple fences, including untouched ones", function() {
				var md = '```bx title="a.bx"' & char( 10 ) & "1" & char( 10 ) & "```" & char( 10 ) & char( 10 ) &
					"```" & char( 10 ) & "plain" & char( 10 ) & "```" & char( 10 ) & char( 10 ) &
					'```js linenums="1"' & char( 10 ) & "2" & char( 10 ) & "```";

				var result = processor.extractAndStrip( md );

				expect( result.annotations.len() ).toBe( 3 );
				expect( result.annotations[ 1 ].title ).toBe( "a.bx" );
				expect( result.annotations[ 2 ].isEmpty() ).toBeTrue();
				expect( result.annotations[ 3 ].showLineNumbers ).toBeTrue();
			} );

			it( "treats a shorter fence nested inside a longer one as literal content, not a real fence (regression)", function() {
				var md = '````markdown' & char( 10 ) &
					'```bx hl_lines="2" title="add.bx"' & char( 10 ) &
					'line1' & char( 10 ) &
					'line2' & char( 10 ) &
					'```' & char( 10 ) &
					'````' & char( 10 ) & char( 10 ) &
					'```bx hl_lines="2" title="add.bx"' & char( 10 ) &
					'line1' & char( 10 ) &
					'line2' & char( 10 ) &
					'```';

				var result = processor.extractAndStrip( md );

				expect( result.annotations.len() ).toBe( 2 );
				expect( result.annotations[ 1 ].isEmpty() ).toBeTrue();
				expect( result.annotations[ 2 ].title ).toBe( "add.bx" );
				expect( result.annotations[ 2 ].hlLines ).toBe( [ 2 ] );
				expect( result.markdown ).toInclude( '```bx hl_lines="2" title="add.bx"' & char( 10 ) & 'line1' );
			} );

			it( "treats a same-length fence nested inside another, indented as body content, as literal too (regression)", function() {
				// Same shape as docs/guides/markdown.md's own "Content Tabs" section:
				// a 3-backtick fence showing `=== "Title"` syntax as a literal example,
				// itself containing a 4-space-indented nested 3-backtick fence - the
				// same marker length as the outer one, so only the indentation (not
				// the length) tells them apart.
				var md = '```markdown' & char( 10 ) &
					'=== "Java"' & char( 10 ) &
					'    ```java' & char( 10 ) &
					'    System.out.println( 1 );' & char( 10 ) &
					'    ```' & char( 10 ) &
					'```' & char( 10 ) & char( 10 ) &
					'```bx hl_lines="2" title="add.bx"' & char( 10 ) &
					'line1' & char( 10 ) &
					'line2' & char( 10 ) &
					'```';

				var result = processor.extractAndStrip( md );

				expect( result.annotations.len() ).toBe( 2 );
				expect( result.annotations[ 1 ].isEmpty() ).toBeTrue();
				expect( result.annotations[ 2 ].title ).toBe( "add.bx" );
				expect( result.annotations[ 2 ].hlLines ).toBe( [ 2 ] );
				// The real second fence's attrs are stripped back to a bare
				// language fence (its own attrs now live in annotations[2]
				// instead) - the indented nested example inside the first
				// fence is untouched literal content throughout, per the
				// `annotations[1]` isEmpty() check above.
				expect( result.markdown ).toInclude( '```bx' & char( 10 ) & 'line1' & char( 10 ) & 'line2' );
				expect( result.markdown ).notToInclude( "hl_lines" );
			} );

			it( "stamps data-bxsites-* attributes onto the matching <pre> in document order", function() {
				var html = '<pre><code class="language-bx">a' & char( 10 ) & '</code></pre>' & char( 10 ) &
					'<pre><code>plain' & char( 10 ) & '</code></pre>';
				var annotations = [ { hlLines : [ 1 ], showLineNumbers : true, startLine : 3, title : "app.bx" }, {} ];

				var result = processor.applyToHtml( html, annotations );

				expect( result ).toInclude( '<pre data-bxsites-hl-lines="1" data-bxsites-start-line="3" data-bxsites-title="app.bx"><code class="language-bx">' );
				expect( result ).toInclude( '<pre><code>plain' );
			} );

			it( 'stamps data-bxsites-frame only for frame="terminal", and data-bxsites-insert-lines/delete-lines when set', function() {
				var html = '<pre><code>a' & char( 10 ) & '</code></pre>' & char( 10 ) &
					'<pre><code>b' & char( 10 ) & '</code></pre>';
				var annotations = [
					{ hlLines : [], showLineNumbers : false, startLine : 1, title : "", frame : "terminal", insertLines : [ 3, 4 ], deleteLines : [ 7 ] },
					{ hlLines : [], showLineNumbers : false, startLine : 1, title : "", frame : "code", insertLines : [], deleteLines : [] }
				];

				var result = processor.applyToHtml( html, annotations );

				expect( result ).toInclude( '<pre data-bxsites-frame="terminal" data-bxsites-insert-lines="3,4" data-bxsites-delete-lines="7"><code>a' );
				// frame="code" is the plain-bar default - no data-bxsites-frame at all, same as omitting it.
				expect( result ).toInclude( '<pre><code>b' );
				expect( result ).notToInclude( 'data-bxsites-frame="code"' );
			} );

		} );
	}

}
