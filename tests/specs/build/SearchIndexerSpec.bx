class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "build.SearchIndexer", function() {

			beforeEach( function() {
				variables.indexer = new "models.build.SearchIndexer@bxsites"();
			} );

			private struct function page(
				string title,
				string urlPath,
				string contentHtml,
				boolean hidden = false
			) {
				return {
					title       : arguments.title,
					urlPath     : arguments.urlPath,
					contentHtml : arguments.contentHtml,
					hidden      : arguments.hidden
				};
			}

			it( "returns an empty index for an empty page list", function() {
				expect( indexer.build( [] ) ).toBeArray();
				expect( indexer.build( [] ).len() ).toBe( 0 );
			} );

			it( "builds one entry per page with title, url, headings and stripped body text", function() {
				var pages = [
					page(
						title       = "Getting Started",
						urlPath     = "getting-started/index.html",
						contentHtml = "<h1>Getting Started</h1><p>Hello <strong>World</strong>!</p><h2>Install</h2><p>Run the installer.</p>"
					)
				];

				var index = indexer.build( pages );

				expect( index.len() ).toBe( 1 );
				expect( index[ 1 ].title ).toBe( "Getting Started" );
				expect( index[ 1 ].url ).toBe( "getting-started/index.html" );
				expect( index[ 1 ].headings ).toBe( [ "Getting Started", "Install" ] );
				expect( index[ 1 ].body ).toInclude( "Hello World" );
				expect( index[ 1 ].body ).toInclude( "Run the installer." );
				expect( index[ 1 ].body ).notToInclude( "<" );
			} );

			it( "excludes hidden pages", function() {
				var pages = [
					page( title = "Visible", urlPath = "a/index.html", contentHtml = "<p>Visible</p>" ),
					page( title = "Secret", urlPath = "b/index.html", contentHtml = "<p>Secret</p>", hidden = true )
				];

				var index = indexer.build( pages );

				expect( index.len() ).toBe( 1 );
				expect( index[ 1 ].title ).toBe( "Visible" );
			} );

			it( "returns an empty headings array for a page with no headings", function() {
				var pages = [ page( title = "Plain", urlPath = "plain/index.html", contentHtml = "<p>Just a paragraph.</p>" ) ];

				var index = indexer.build( pages );

				expect( index[ 1 ].headings ).toBeArray();
				expect( index[ 1 ].headings.len() ).toBe( 0 );
			} );

			it( "truncates long body text with an ellipsis", function() {
				var longText = "";
				for ( var i = 1; i <= 200; i++ ) {
					longText &= "word "
				}
				var pages = [ page( title = "Long", urlPath = "long/index.html", contentHtml = "<p>" & longText & "</p>" ) ];

				var index = indexer.build( pages );

				expect( len( index[ 1 ].body ) ).toBeLTE( 401 );
				expect( index[ 1 ].body ).toEndWith( "…" );
			} );

			it( "collapses whitespace and decodes common HTML entities in the body text", function() {
				var pages = [
					page(
						title       = "Entities",
						urlPath     = "entities/index.html",
						contentHtml = "<p>Fish &amp; Chips" & char( 10 ) & char( 10 ) & "   &quot;great&quot;   deal</p>"
					)
				];

				var index = indexer.build( pages );

				expect( index[ 1 ].body ).toBe( 'Fish & Chips "great" deal' );
			} );

		} );
	}

}
