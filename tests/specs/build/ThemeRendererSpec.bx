class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "build.ThemeRenderer", function() {

			beforeEach( function() {
				variables.renderer = new "models.build.ThemeRenderer@bxdocs"();
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			private function newProjectRoot() {
				var dir = createTempDirectory( prefix = "bxdocs-themerenderer-" );
				tempDirs.append( dir );
				return dir;
			}

			it( "resolves the built-in bootstrap theme by name", function() {
				var themeDir = renderer.resolveThemeDir( "bootstrap", newProjectRoot() );

				expect( fileExists( themeDir & "/layout.bxm" ) ).toBeTrue();
				expect( fileExists( themeDir & "/page.bxm" ) ).toBeTrue();
			} );

			it( "throws BxDocs.ThemeNotFound for an unknown theme with no project override", function() {
				var root = newProjectRoot();
				expect( function() {
					renderer.resolveThemeDir( "not-a-real-theme", root );
				} ).toThrow( "BxDocs.ThemeNotFound" );
			} );

			it( "prefers a project-level theme/ override that satisfies the ThemeProvider contract", function() {
				var root = newProjectRoot();
				directoryCreate( root & "/theme", true, true );
				fileWrite( root & "/theme/layout.bxm", "<bx:output>custom layout</bx:output>" );
				fileWrite( root & "/theme/page.bxm", "<bx:output>custom page</bx:output>" );

				var themeDir = renderer.resolveThemeDir( "bootstrap", root );

				expect( themeDir ).toBe( root & "/theme" );
			} );

			it( "throws BxDocs.InvalidTheme when a project theme/ override is missing page.bxm", function() {
				var root = newProjectRoot();
				directoryCreate( root & "/theme", true, true );
				fileWrite( root & "/theme/layout.bxm", "<bx:output>custom layout</bx:output>" );

				expect( function() {
					renderer.resolveThemeDir( "bootstrap", root );
				} ).toThrow( "BxDocs.InvalidTheme" );
			} );

			it( "resolves each built-in theme (bootstrap, material, tailwind) with a valid ThemeProvider contract", function() {
				var root = newProjectRoot();
				for ( var themeName in [ "bootstrap", "material", "tailwind" ] ) {
					var themeDir = renderer.resolveThemeDir( themeName, root );
					expect( fileExists( themeDir & "/layout.bxm" ) ).toBeTrue();
					expect( fileExists( themeDir & "/page.bxm" ) ).toBeTrue();
				}
			} );

			it( "renders a page through the built-in bootstrap theme, including title, nav and content", function() {
				var root = newProjectRoot();
				var themeDir = renderer.resolveThemeDir( "bootstrap", root );

				var page = {
					title       : "My Page",
					contentHtml : "<p>Hello World</p>"
				};
				var nav = [
					{ title : "My Page", url : "index.html", order : 1, children : [] },
					{ title : "guides", url : "", order : 2, children : [
						{ title : "Setup", url : "guides/setup/index.html", order : 1, children : [] }
					] }
				];
				var config = { name : "My Site" };

				var html = renderer.renderPage( page, nav, config, themeDir );

				expect( html ).toInclude( "My Page" );
				expect( html ).toInclude( "My Site" );
				expect( html ).toInclude( "<p>Hello World</p>" );
				expect( html ).toInclude( 'href="/index.html"' );
				expect( html ).toInclude( "guides" );
				expect( html ).toInclude( 'href="/guides/setup/index.html"' );
				expect( html ).toInclude( "<!doctype html>" );
			} );

			it( "renders a page through every built-in theme without error", function() {
				var root = newProjectRoot();
				var page = { title : "My Page", contentHtml : "<p>Hello World</p>" };
				var nav = [ { title : "My Page", url : "index.html", order : 1, children : [] } ];
				var config = { name : "My Site" };

				for ( var themeName in [ "bootstrap", "material", "tailwind" ] ) {
					var themeDir = renderer.resolveThemeDir( themeName, root );
					var html = renderer.renderPage( page, nav, config, themeDir );

					expect( html ).toInclude( "<!doctype html>" );
					expect( html ).toInclude( "My Page" );
					expect( html ).toInclude( "My Site" );
					expect( html ).toInclude( "<p>Hello World</p>" );
					expect( html ).toInclude( 'href="/index.html"' );
				}
			} );

			it( "HTML-escapes the page title and site name", function() {
				var root = newProjectRoot();
				var themeDir = renderer.resolveThemeDir( "bootstrap", root );

				var page = { title : '<script>alert(1)</script>', contentHtml : "<p>Body</p>" };
				var html = renderer.renderPage( page, [], { name : "Safe & Sound" }, themeDir );

				expect( html ).notToInclude( "<script>alert(1)</script>" );
				expect( html ).toInclude( "Safe &amp; Sound" );
			} );

			it( "prefixes nav, asset and brand links with a non-default basePath", function() {
				var root = newProjectRoot();
				var themeDir = renderer.resolveThemeDir( "bootstrap", root );

				var page = { title : "My Page", contentHtml : "<p>Body</p>" };
				var nav = [ { title : "My Page", url : "index.html", order : 1, children : [] } ];
				var html = renderer.renderPage( page, nav, { name : "My Site" }, themeDir, "/my-docs/" );

				expect( html ).toInclude( 'href="/my-docs/index.html"' );
				expect( html ).toInclude( 'href="/my-docs/assets/theme/style.css"' );
				expect( html ).toInclude( 'href="/my-docs/"' );
			} );

			it( "includes Alpine.js and a dark-mode toggle, and the copy-code script, in every built-in theme", function() {
				var root = newProjectRoot();
				var page = { title : "My Page", contentHtml : "<p>Body</p>" };
				var nav = [ { title : "My Page", url : "index.html", order : 1, children : [] } ];
				var config = { name : "My Site" };

				for ( var themeName in [ "bootstrap", "material", "tailwind" ] ) {
					var themeDir = renderer.resolveThemeDir( themeName, root );
					var html = renderer.renderPage( page, nav, config, themeDir );

					expect( html ).toInclude( "alpinejs" );
					expect( html ).toInclude( "theme-toggle" );
					expect( html ).toInclude( "data-theme" );
					expect( html ).toInclude( "assets/copy-code.js" );
				}
			} );

			it( "renders breadcrumbs when the page has more than one, and skips them otherwise", function() {
				var root = newProjectRoot();
				var themeDir = renderer.resolveThemeDir( "bootstrap", root );
				var nav = [ { title : "My Page", url : "index.html", order : 1, children : [] } ];
				var config = { name : "My Site" };

				var withCrumbs = {
					title       : "Setup",
					contentHtml : "<p>Body</p>",
					breadcrumbs : [
						{ title : "Guides", url : "guides/index.html" },
						{ title : "Setup", url : "guides/setup/index.html" }
					]
				};
				var htmlWithCrumbs = renderer.renderPage( withCrumbs, nav, config, themeDir );
				expect( htmlWithCrumbs ).toInclude( "breadcrumb-nav" );
				expect( htmlWithCrumbs ).toInclude( ">Guides<" );

				var withoutCrumbs = { title : "My Page", contentHtml : "<p>Body</p>" };
				var htmlWithoutCrumbs = renderer.renderPage( withoutCrumbs, nav, config, themeDir );
				expect( htmlWithoutCrumbs ).notToInclude( "breadcrumb-nav" );
			} );

		} );
	}

}
