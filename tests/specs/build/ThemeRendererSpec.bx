class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "build.ThemeRenderer", function() {

			beforeEach( function() {
				variables.renderer = new "models.build.ThemeRenderer@bxdocs"();
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			private function newProjectRoot() {
				var dir = createTempDirectory( prefix = "bxdocs-themerenderer-" );
				tempDirs.append( dir );
				return dir;
			}

			it( "resolves the built-in bootstrap theme by name", function() {
				var themeDir = renderer.resolveThemeDir( "bootstrap", newProjectRoot() );

				expect( fileExists( themeDir & "/layout.bxm" ) ).toBeTrue();
				expect( fileExists( themeDir & "/page.bxm" ) ).toBeTrue();
			} );

			it( "throws BxDocs.ThemeNotFound for an unknown theme with no project override", function() {
				var root = newProjectRoot();
				expect( function() {
					renderer.resolveThemeDir( "not-a-real-theme", root );
				} ).toThrow( "BxDocs.ThemeNotFound" );
			} );

			it( "prefers a project-level theme/ override that satisfies the ThemeProvider contract", function() {
				var root = newProjectRoot();
				directoryCreate( root & "/theme", true, true );
				fileWrite( root & "/theme/layout.bxm", "<bx:output>custom layout</bx:output>" );
				fileWrite( root & "/theme/page.bxm", "<bx:output>custom page</bx:output>" );

				var themeDir = renderer.resolveThemeDir( "bootstrap", root );

				expect( themeDir ).toBe( root & "/theme" );
			} );

			it( "throws BxDocs.InvalidTheme when a project theme/ override is missing page.bxm", function() {
				var root = newProjectRoot();
				directoryCreate( root & "/theme", true, true );
				fileWrite( root & "/theme/layout.bxm", "<bx:output>custom layout</bx:output>" );

				expect( function() {
					renderer.resolveThemeDir( "bootstrap", root );
				} ).toThrow( "BxDocs.InvalidTheme" );
			} );

			it( "resolves each built-in theme (bootstrap, material, tailwind) with a valid ThemeProvider contract", function() {
				var root = newProjectRoot();
				for ( var themeName in [ "bootstrap", "material", "tailwind" ] ) {
					var themeDir = renderer.resolveThemeDir( themeName, root );
					expect( fileExists( themeDir & "/layout.bxm" ) ).toBeTrue();
					expect( fileExists( themeDir & "/page.bxm" ) ).toBeTrue();
				}
			} );

			it( "renders a page through the built-in bootstrap theme, including title, nav and content", function() {
				var root = newProjectRoot();
				var themeDir = renderer.resolveThemeDir( "bootstrap", root );

				var page = {
					title       : "My Page",
					contentHtml : "<p>Hello World</p>"
				};
				var nav = [
					{ title : "My Page", url : "index.html", order : 1, children : [] },
					{ title : "guides", url : "", order : 2, children : [
						{ title : "Setup", url : "guides/setup/index.html", order : 1, children : [] }
					] }
				];
				var config = { name : "My Site" };

				var html = renderer.renderPage( page, nav, config, themeDir );

				expect( html ).toInclude( "My Page" );
				expect( html ).toInclude( "My Site" );
				expect( html ).toInclude( "<p>Hello World</p>" );
				expect( html ).toInclude( 'href="/index.html"' );
				expect( html ).toInclude( "guides" );
				expect( html ).toInclude( 'href="/guides/setup/index.html"' );
				expect( html ).toInclude( "<!doctype html>" );
			} );

			it( "renders a page through every built-in theme without error", function() {
				var root = newProjectRoot();
				var page = { title : "My Page", contentHtml : "<p>Hello World</p>" };
				var nav = [ { title : "My Page", url : "index.html", order : 1, children : [] } ];
				var config = { name : "My Site" };

				for ( var themeName in [ "bootstrap", "material", "tailwind" ] ) {
					var themeDir = renderer.resolveThemeDir( themeName, root );
					var html = renderer.renderPage( page, nav, config, themeDir );

					expect( html ).toInclude( "<!doctype html>" );
					expect( html ).toInclude( "My Page" );
					expect( html ).toInclude( "My Site" );
					expect( html ).toInclude( "<p>Hello World</p>" );
					expect( html ).toInclude( 'href="/index.html"' );
				}
			} );

			it( "HTML-escapes the page title and site name", function() {
				var root = newProjectRoot();
				var themeDir = renderer.resolveThemeDir( "bootstrap", root );

				var page = { title : '<script>alert(1)</script>', contentHtml : "<p>Body</p>" };
				var html = renderer.renderPage( page, [], { name : "Safe & Sound" }, themeDir );

				expect( html ).notToInclude( "<script>alert(1)</script>" );
				expect( html ).toInclude( "Safe &amp; Sound" );
			} );

			it( "prefixes nav, asset and brand links with a non-default basePath", function() {
				var root = newProjectRoot();
				var themeDir = renderer.resolveThemeDir( "bootstrap", root );

				var page = { title : "My Page", contentHtml : "<p>Body</p>" };
				var nav = [ { title : "My Page", url : "index.html", order : 1, children : [] } ];
				var html = renderer.renderPage( page, nav, { name : "My Site" }, themeDir, "/my-docs/" );

				expect( html ).toInclude( 'href="/my-docs/index.html"' );
				expect( html ).toInclude( 'href="/my-docs/assets/theme/style.css"' );
				expect( html ).toInclude( 'href="/my-docs/"' );
			} );

			it( "includes Alpine.js and a dark-mode toggle, and the copy-code script, in every built-in theme", function() {
				var root = newProjectRoot();
				var page = { title : "My Page", contentHtml : "<p>Body</p>" };
				var nav = [ { title : "My Page", url : "index.html", order : 1, children : [] } ];
				var config = { name : "My Site" };

				for ( var themeName in [ "bootstrap", "material", "tailwind" ] ) {
					var themeDir = renderer.resolveThemeDir( themeName, root );
					var html = renderer.renderPage( page, nav, config, themeDir );

					expect( html ).toInclude( "alpinejs" );
					expect( html ).toInclude( "theme-toggle" );
					expect( html ).toInclude( "data-theme" );
					expect( html ).toInclude( "assets/copy-code.js" );
				}
			} );

			it( "embeds bxdocs.json's [theme.options.colorMode] as the pre-paint default, across every built-in theme", function() {
				var root = newProjectRoot();
				var page = { title : "My Page", contentHtml : "<p>Body</p>" };
				var nav = [ { title : "My Page", url : "index.html", order : 1, children : [] } ];

				for ( var themeName in [ "bootstrap", "material", "tailwind" ] ) {
					var themeDir = renderer.resolveThemeDir( themeName, root );

					var autoHtml = renderer.renderPage( page, nav, { name : "My Site" }, themeDir );
					expect( autoHtml ).toInclude( 'configuredMode = "auto"' );

					var darkConfig = { name : "My Site", theme : { options : { colorMode : "dark" } } };
					var darkHtml = renderer.renderPage( page, nav, darkConfig, themeDir );
					expect( darkHtml ).toInclude( 'configuredMode = "dark"' );
				}
			} );

			it( "renders a distinct, recognized icon for every built-in social platform, across every built-in theme", function() {
				var root = newProjectRoot();
				var page = { title : "My Page", contentHtml : "<p>Body</p>" };
				var nav = [ { title : "My Page", url : "index.html", order : 1, children : [] } ];
				// one short, near-unique fragment lifted from each icon's own SVG path -
				// confirms bxdocsIcon() resolved the real icon rather than falling back to "generic"
				var iconFingerprints = {
					"youtube"  : "31.7",
					"linkedin" : "20.447 20.452",
					"facebook" : "24 12.073c0-6.627",
					"bluesky"  : "4.046-6.053",
					"threads"  : "12.186 24",
					"slack"    : "5.042 15.165",
					"patreon"  : "15.211 0c-4.831"
				};
				var config = {
					name   : "My Site",
					social : iconFingerprints.keyArray().map( icon => { return { url : "https://example.com/" & icon, icon : icon } } ),
					footer : true
				};

				for ( var themeName in [ "bootstrap", "material", "tailwind" ] ) {
					var themeDir = renderer.resolveThemeDir( themeName, root );
					var html = renderer.renderPage( page, nav, config, themeDir );

					for ( var icon in iconFingerprints ) {
						expect( html ).toInclude( iconFingerprints[ icon ] );
					}
				}
			} );

			it( "renders breadcrumbs when the page has more than one, and skips them otherwise", function() {
				var root = newProjectRoot();
				var themeDir = renderer.resolveThemeDir( "bootstrap", root );
				var nav = [ { title : "My Page", url : "index.html", order : 1, children : [] } ];
				var config = { name : "My Site" };

				var withCrumbs = {
					title       : "Setup",
					contentHtml : "<p>Body</p>",
					breadcrumbs : [
						{ title : "Guides", url : "guides/index.html" },
						{ title : "Setup", url : "guides/setup/index.html" }
					]
				};
				var htmlWithCrumbs = renderer.renderPage( withCrumbs, nav, config, themeDir );
				expect( htmlWithCrumbs ).toInclude( "breadcrumb-nav" );
				expect( htmlWithCrumbs ).toInclude( ">Guides<" );

				var withoutCrumbs = { title : "My Page", contentHtml : "<p>Body</p>" };
				var htmlWithoutCrumbs = renderer.renderPage( withoutCrumbs, nav, config, themeDir );
				expect( htmlWithoutCrumbs ).notToInclude( "breadcrumb-nav" );
			} );

			it( "renders a repo link, social links and a footer when configured, across every built-in theme", function() {
				var root = newProjectRoot();
				var page = { title : "My Page", contentHtml : "<p>Body</p>" };
				var nav = [ { title : "My Page", url : "index.html", order : 1, children : [] } ];
				var config = {
					name   : "My Site",
					repo   : { url : "https://github.com/acme/docs", editUri : "edit/main/docs/" },
					social : [ { url : "https://twitter.com/acme", icon : "twitter", label : "Twitter" } ],
					footer : true
				};

				for ( var themeName in [ "bootstrap", "material", "tailwind" ] ) {
					var themeDir = renderer.resolveThemeDir( themeName, root );
					var html = renderer.renderPage( page, nav, config, themeDir );

					expect( html ).toInclude( "repo-link" );
					expect( html ).toInclude( "github.com" );
					expect( html ).toInclude( "bxdocs-footer" );
					expect( html ).toInclude( "social-link" );
					expect( html ).toInclude( "twitter.com" );
				}
			} );

			it( "omits the repo link and footer entirely when unconfigured, across every built-in theme", function() {
				var root = newProjectRoot();
				var page = { title : "My Page", contentHtml : "<p>Body</p>" };
				var nav = [ { title : "My Page", url : "index.html", order : 1, children : [] } ];
				var config = { name : "My Site" };

				for ( var themeName in [ "bootstrap", "material", "tailwind" ] ) {
					var themeDir = renderer.resolveThemeDir( themeName, root );
					var html = renderer.renderPage( page, nav, config, themeDir );

					expect( html ).notToInclude( "repo-link" );
					expect( html ).notToInclude( "bxdocs-footer" );
				}
			} );

			it( "renders the edit-this-page link from the page's own editUrl, across every built-in theme", function() {
				var root = newProjectRoot();
				var page = {
					title       : "My Page",
					contentHtml : "<p>Body</p>",
					editUrl     : "https://github.com/acme/docs/edit/main/docs/index.md"
				};
				var nav = [ { title : "My Page", url : "index.html", order : 1, children : [] } ];
				var config = { name : "My Site" };

				for ( var themeName in [ "bootstrap", "material", "tailwind" ] ) {
					var themeDir = renderer.resolveThemeDir( themeName, root );
					var html = renderer.renderPage( page, nav, config, themeDir );

					expect( html ).toInclude( "github.com" );
					expect( html ).toInclude( "index.md" );
					expect( html ).toInclude( "Edit this page" );
				}
			} );

			it( "renders a Download Markdown link from the page's own markdownUrl, across every built-in theme, and omits it when markdownUrl is empty", function() {
				var root = newProjectRoot();
				var page = { title : "My Page", contentHtml : "<p>Body</p>", markdownUrl : "guides/setup.md" };
				var nav = [ { title : "My Page", url : "index.html", order : 1, children : [] } ];
				var config = { name : "My Site" };

				for ( var themeName in [ "bootstrap", "material", "tailwind" ] ) {
					var themeDir = renderer.resolveThemeDir( themeName, root );
					var html = renderer.renderPage( page, nav, config, themeDir );

					expect( html ).toInclude( 'href="/guides/setup.md" download' );
					expect( html ).toInclude( "Download Markdown" );
				}

				var pageWithoutMarkdown = { title : "My Page", contentHtml : "<p>Body</p>" };
				for ( var themeName in [ "bootstrap", "material", "tailwind" ] ) {
					var themeDir = renderer.resolveThemeDir( themeName, root );
					var html = renderer.renderPage( pageWithoutMarkdown, nav, config, themeDir );

					expect( html ).notToInclude( "Download Markdown" );
				}
			} );

			it( "renders a version switcher with the current version selected when more than one version is passed, across every built-in theme", function() {
				var root = newProjectRoot();
				var page = { title : "My Page", contentHtml : "<p>Body</p>" };
				var nav = [ { title : "My Page", url : "index.html", order : 1, children : [] } ];
				var config = { name : "My Site" };
				var versions = [
					{ label : "Latest", url : "/" },
					{ label : "1.0", url : "/versions/1.0/" }
				];

				for ( var themeName in [ "bootstrap", "material", "tailwind" ] ) {
					var themeDir = renderer.resolveThemeDir( themeName, root );
					var html = renderer.renderPage( page, nav, config, themeDir, "/", versions, "1.0" );

					expect( html ).toInclude( "version-switcher" );
					expect( html ).toInclude( ">Latest<" );
					expect( html ).toInclude( " selected>1.0<" );
					expect( html ).notToInclude( " selected>Latest<" );
				}
			} );

			it( "omits the version switcher when 0 or 1 versions are passed, across every built-in theme", function() {
				var root = newProjectRoot();
				var page = { title : "My Page", contentHtml : "<p>Body</p>" };
				var nav = [ { title : "My Page", url : "index.html", order : 1, children : [] } ];
				var config = { name : "My Site" };

				for ( var themeName in [ "bootstrap", "material", "tailwind" ] ) {
					var themeDir = renderer.resolveThemeDir( themeName, root );

					expect( renderer.renderPage( page, nav, config, themeDir ) ).notToInclude( "version-switcher" );
					expect(
						renderer.renderPage( page, nav, config, themeDir, "/", [ { label : "Latest", url : "/" } ], "Latest" )
					).notToInclude( "version-switcher" );
				}
			} );

			it( "renders a brand logo <img> when [theme.logo] is configured, and the default mark otherwise, across every built-in theme", function() {
				var root = newProjectRoot();
				var page = { title : "My Page", contentHtml : "<p>Body</p>" };
				var nav = [ { title : "My Page", url : "index.html", order : 1, children : [] } ];

				for ( var themeName in [ "bootstrap", "material", "tailwind" ] ) {
					var themeDir = renderer.resolveThemeDir( themeName, root );

					var defaultHtml = renderer.renderPage( page, nav, { name : "My Site" }, themeDir );
					expect( defaultHtml ).notToInclude( "brand-logo" );

					var logoConfig = { name : "My Site", theme : { logo : "assets/logo.svg" } };
					var logoHtml = renderer.renderPage( page, nav, logoConfig, themeDir );
					expect( logoHtml ).toInclude( "brand-logo" );
					expect( logoHtml ).toInclude( 'src="/assets/logo.svg"' );
				}
			} );

			it( "renders a favicon link only when [theme.favicon] is configured, across every built-in theme", function() {
				var root = newProjectRoot();
				var page = { title : "My Page", contentHtml : "<p>Body</p>" };
				var nav = [ { title : "My Page", url : "index.html", order : 1, children : [] } ];

				for ( var themeName in [ "bootstrap", "material", "tailwind" ] ) {
					var themeDir = renderer.resolveThemeDir( themeName, root );

					expect( renderer.renderPage( page, nav, { name : "My Site" }, themeDir ) ).notToInclude( 'rel="icon"' );

					var faviconConfig = { name : "My Site", theme : { favicon : "assets/favicon.ico" } };
					var html = renderer.renderPage( page, nav, faviconConfig, themeDir );
					expect( html ).toInclude( 'rel="icon" href="/assets/favicon.ico"' );
				}
			} );

			it( "renders a .nav-toggle button per nav section only when [theme.options.navCollapsible] is true, across every built-in theme - for both a linkless group and a linked one", function() {
				var root = newProjectRoot();
				var page = { title : "My Page", contentHtml : "<p>Body</p>", urlPath : "index.html" };
				var nav = [
					{ title : "My Page", url : "index.html", order : 1, children : [] },
					{ title : "Guides", url : "", order : 2, children : [
						{ title : "Setup", url : "guides/setup/index.html", order : 1, children : [] }
					] },
					{ title : "API", url : "api/index.html", order : 3, children : [
						{ title : "Reference", url : "api/reference/index.html", order : 1, children : [] }
					] }
				];

				for ( var themeName in [ "bootstrap", "material", "tailwind" ] ) {
					var themeDir = renderer.resolveThemeDir( themeName, root );

					var flatHtml = renderer.renderPage( page, nav, { name : "My Site" }, themeDir );
					expect( flatHtml ).notToInclude( 'class="nav-toggle"' );

					var collapsibleConfig = { name : "My Site", theme : { options : { navCollapsible : true } } };
					var collapsibleHtml = renderer.renderPage( page, nav, collapsibleConfig, themeDir );
					expect( collapsibleHtml ).toInclude( 'class="nav-toggle"' );
					expect( collapsibleHtml ).toInclude( ">Guides<" );
					expect( collapsibleHtml ).toInclude( ">API<" );
				}
			} );

			it( "starts a collapsible section open when it contains the current page, even when [navExpandAll] is false, across every built-in theme", function() {
				var root = newProjectRoot();
				var page = { title : "Setup", contentHtml : "<p>Body</p>", urlPath : "guides/setup/index.html" };
				var nav = [
					{ title : "My Page", url : "index.html", order : 1, children : [] },
					{ title : "Guides", url : "", order : 2, children : [
						{ title : "Setup", url : "guides/setup/index.html", order : 1, children : [] }
					] },
					{ title : "API", url : "api/index.html", order : 3, children : [
						{ title : "Reference", url : "api/reference/index.html", order : 1, children : [] }
					] }
				];

				for ( var themeName in [ "bootstrap", "material", "tailwind" ] ) {
					var themeDir = renderer.resolveThemeDir( themeName, root );
					var config = { name : "My Site", theme : { options : { navCollapsible : true, navExpandAll : false } } };
					var html = renderer.renderPage( page, nav, config, themeDir );

					// "Guides" contains the active page - stays open (aria-expanded="true", no `hidden` on its child <ul>)
					expect( html ).toInclude( 'aria-expanded="true" aria-label="Toggle Guides section"' );

					// "API" does not contain the active page and navExpandAll is false - stays collapsed
					expect( html ).toInclude( 'aria-expanded="false" aria-label="Toggle API section"' );
				}
			} );

			it( "renders Open Graph and Twitter Card meta tags from page/site description and [ogImage], across every built-in theme", function() {
				var root = newProjectRoot();
				var nav = [ { title : "My Page", url : "index.html", order : 1, children : [] } ];
				var page = {
					title       : "My Page",
					contentHtml : "<p>Body</p>",
					description : "A page about things"
				};
				var config = {
					name    : "My Site",
					ogImage : "assets/social-card.png"
				};

				for ( var themeName in [ "bootstrap", "material", "tailwind" ] ) {
					var themeDir = renderer.resolveThemeDir( themeName, root );
					var html = renderer.renderPage( page, nav, config, themeDir );

					expect( html ).toInclude( 'property="og:type" content="website"' );
					expect( html ).toInclude( 'property="og:title" content="My Page"' );
					expect( html ).toInclude( 'name="description" content="A page about things"' );
					expect( html ).toInclude( 'property="og:description" content="A page about things"' );
					expect( html ).toInclude( 'property="og:image" content="/assets/social-card.png"' );
					expect( html ).toInclude( 'name="twitter:card" content="summary_large_image"' );
				}
			} );

			it( "omits social-card meta tags entirely when unconfigured, across every built-in theme", function() {
				var root = newProjectRoot();
				var page = { title : "My Page", contentHtml : "<p>Body</p>" };
				var nav = [ { title : "My Page", url : "index.html", order : 1, children : [] } ];
				var config = { name : "My Site" };

				for ( var themeName in [ "bootstrap", "material", "tailwind" ] ) {
					var themeDir = renderer.resolveThemeDir( themeName, root );
					var html = renderer.renderPage( page, nav, config, themeDir );

					expect( html ).notToInclude( 'name="description"' );
					expect( html ).notToInclude( "og:image" );
				}
			} );

			it( "injects Google Analytics gtag.js only when [analytics.provider] is google, across every built-in theme", function() {
				var root = newProjectRoot();
				var page = { title : "My Page", contentHtml : "<p>Body</p>" };
				var nav = [ { title : "My Page", url : "index.html", order : 1, children : [] } ];

				for ( var themeName in [ "bootstrap", "material", "tailwind" ] ) {
					var themeDir = renderer.resolveThemeDir( themeName, root );

					expect( renderer.renderPage( page, nav, { name : "My Site" }, themeDir ) ).notToInclude( "googletagmanager" );

					var analyticsConfig = { name : "My Site", analytics : { provider : "google", id : "G-ABC123" } };
					var html = renderer.renderPage( page, nav, analyticsConfig, themeDir );
					expect( html ).toInclude( "googletagmanager.com/gtag/js?id=G-ABC123" );
					expect( html ).toInclude( "gtag('config', 'G-ABC123')" );
				}
			} );

			it( "renders extraCss <link> and extraJs <script> tags, across every built-in theme", function() {
				var root = newProjectRoot();
				var page = { title : "My Page", contentHtml : "<p>Body</p>" };
				var nav = [ { title : "My Page", url : "index.html", order : 1, children : [] } ];
				var config = {
					name     : "My Site",
					extraCss : [ "assets/extra.css", "https://cdn.example.com/extra.css" ],
					extraJs  : [ "assets/extra.js" ]
				};

				for ( var themeName in [ "bootstrap", "material", "tailwind" ] ) {
					var themeDir = renderer.resolveThemeDir( themeName, root );
					var html = renderer.renderPage( page, nav, config, themeDir );

					expect( html ).toInclude( '<link rel="stylesheet" href="/assets/extra.css">' );
					expect( html ).toInclude( '<link rel="stylesheet" href="https://cdn.example.com/extra.css">' );
					expect( html ).toInclude( '<script src="/assets/extra.js" defer></script>' );
				}
			} );

		} );
	}

}
