/**
 * FakeYamlRenderer.bx is injected throughout - real bx-yaml BIFs aren't
 * safely callable in a bare unit test (YamlRenderer.bx's own docblock), so
 * every YAML fixture below is written as the fake's own JSON-under-the-hood
 * "YAML" and read back through the same fake, the same shape
 * BlogAuthorsLoaderSpec.bx already uses.
 */
class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "build.DataLoader", function() {

			beforeEach( function() {
				variables.loader = new "models.build.DataLoader@bxsites"();
				variables.loader.setYamlRenderer( new "tests.support.FakeYamlRenderer@bxsites"() );
				variables.loader.setTomlRenderer( new "tests.support.FakeTomlRenderer@bxsites"() );
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			private function newDocsDir() {
				var dir = createTempDirectory( prefix = "bxsites-data-" );
				tempDirs.append( dir );
				return dir;
			}

			private function writeDataFile( required string docsDir, required string fileName, required any content ) {
				directoryCreate( arguments.docsDir & "/data", true, true );
				fileWrite( arguments.docsDir & "/data/" & arguments.fileName, jsonSerialize( arguments.content ) );
			}

			/**
			 * A `.bx`-loading test needs a docs/data/*.bx path with no
			 * hyphens anywhere in it (DataLoader.bx's own `toClassPath()`
			 * docblock explains why - a real BoxLang class-name-segment
			 * restriction, not a bx-sites one) - `createTempDirectory()`'s
			 * own `prefix` (used unmodified by `newDocsDir()` above, fine
			 * for the plain YAML/JSON tests, which never resolve a class
			 * path at all) always contains one, so `.bx` tests get their
			 * own dedicated, hyphen-free temp directory instead.
			 */
			private function newClassSafeDocsDir() {
				var dir = getTempDirectory().reReplace( "[\/]+$", "" ) & "/bxsitesdataloadertest" & replace( createUUID(), "-", "", "all" );
				directoryCreate( dir, true, true );
				tempDirs.append( dir );
				return dir;
			}

			it( "returns an empty struct when docs/data/ doesn't exist", function() {
				var dir = newDocsDir();
				expect( loader.load( dir ) ).toBeStruct();
				expect( loader.load( dir ).isEmpty() ).toBeTrue();
			} );

			it( "loads a .yaml file keyed by its basename", function() {
				var dir = newDocsDir();
				writeDataFile( dir, "products.yaml", { "name" : "Widget" } );

				var data = loader.load( dir );

				expect( data.keyExists( "products" ) ).toBeTrue();
				expect( data.products.name ).toBe( "Widget" );
			} );

			it( "loads a .json file keyed by its basename", function() {
				var dir = newDocsDir();
				writeDataFile( dir, "team.json", { "name" : "Ortus" } );

				var data = loader.load( dir );

				expect( data.keyExists( "team" ) ).toBeTrue();
				expect( data.team.name ).toBe( "Ortus" );
			} );

			it( "loads a .toml file keyed by its basename", function() {
				var dir = newDocsDir();
				writeDataFile( dir, "team.toml", { "name" : "Ortus" } );

				var data = loader.load( dir );

				expect( data.team.name ).toBe( "Ortus" );
			} );

			it( "preserves an array root exactly as parsed", function() {
				var dir = newDocsDir();
				writeDataFile( dir, "sponsors.yaml", [ "Ortus", "BoxLang" ] );

				var data = loader.load( dir );

				expect( data.sponsors ).toBeArray();
				expect( data.sponsors.len() ).toBe( 2 );
				expect( data.sponsors[ 1 ] ).toBe( "Ortus" );
			} );

			it( "loads multiple files into distinct top-level keys", function() {
				var dir = newDocsDir();
				writeDataFile( dir, "products.yaml", { "name" : "Widget" } );
				writeDataFile( dir, "team.json", { "name" : "Ortus" } );

				var data = loader.load( dir );

				expect( data.keyExists( "products" ) ).toBeTrue();
				expect( data.keyExists( "team" ) ).toBeTrue();
			} );

			it( "resolves a basename collision across extensions via the extensions order (yaml before toml before json)", function() {
				var dir = newDocsDir();
				writeDataFile( dir, "products.yaml", { "name" : "From YAML" } );
				writeDataFile( dir, "products.json", { "name" : "From JSON" } );

				var data = loader.load( dir );

				expect( data.products.name ).toBe( "From YAML" );
			} );

			it( "prefers TOML over JSON when YAML is absent", function() {
				var dir = newDocsDir();
				writeDataFile( dir, "products.toml", { "name" : "From TOML" } );
				writeDataFile( dir, "products.json", { "name" : "From JSON" } );

				var data = loader.load( dir );

				expect( data.products.name ).toBe( "From TOML" );
			} );

			it( "throws BxSites.InvalidDataFile naming the file when a YAML file is malformed", function() {
				var dir = newDocsDir();
				directoryCreate( dir & "/data", true, true );
				fileWrite( dir & "/data/broken.yaml", "not valid json for the fake renderer" );

				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxSites.InvalidDataFile" );
			} );

			it( "throws BxSites.InvalidDataFile naming the file when a JSON file is malformed", function() {
				var dir = newDocsDir();
				directoryCreate( dir & "/data", true, true );
				fileWrite( dir & "/data/broken.json", "{ not valid json" );

				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxSites.InvalidDataFile" );
			} );

			it( "ignores a file whose extension isn't yaml/yml/json/bx", function() {
				var dir = newDocsDir();
				directoryCreate( dir & "/data", true, true );
				fileWrite( dir & "/data/readme.txt", "not data" );

				var data = loader.load( dir );

				expect( data.isEmpty() ).toBeTrue();
			} );

			describe( "docs/data/*.bx classes", function() {

				private function writeClassFile( required string docsDir, required string rawBasename, required string body ) {
					directoryCreate( arguments.docsDir & "/data", true, true );
					fileWrite( arguments.docsDir & "/data/" & arguments.rawBasename & ".bx", arguments.body );
				}

				it( "loads a .bx class, keyed by its basename with the first letter lowercased", function() {
					var dir = newClassSafeDocsDir();
					writeClassFile( dir, "Pricing", '
						class {
							struct function getData() {
								return { "pro" : { "price" : 29 } }
							}
						}
					' );

					var data = loader.load( dir );

					expect( data.keyExists( "pricing" ) ).toBeTrue();
					expect( isObject( data.pricing ) ).toBeTrue();
					expect( data.pricing.getData().pro.price ).toBe( 29 );
				} );

				it( "the stored value is the live instance, not getData()'s own result - a caller can invoke any other public method too", function() {
					var dir = newClassSafeDocsDir();
					writeClassFile( dir, "Pricing", '
						class {
							struct function getData() {
								return { "pro" : { "price" : 29 } }
							}
							numeric function discounted( required numeric pct ) {
								return getData().pro.price - ( getData().pro.price * arguments.pct )
							}
						}
					' );

					var data = loader.load( dir );

					expect( data.pricing.discounted( 0.2 ) ).toBe( 23.2 );
				} );

				it( "a .bx file wins over a same-key .yaml/.json file", function() {
					var dir = newClassSafeDocsDir();
					writeDataFile( dir, "pricing.json", { "from" : "json" } );
					writeClassFile( dir, "Pricing", '
						class {
							struct function getData() {
								return { "from" : "bx" }
							}
						}
					' );

					var data = loader.load( dir );

					expect( isObject( data.pricing ) ).toBeTrue();
					expect( data.pricing.getData().from ).toBe( "bx" );
				} );

				it( "throws BxSites.MissingDataMethod when a .bx class has no public getData()", function() {
					var dir = newClassSafeDocsDir();
					writeClassFile( dir, "Broken", '
						class {
							string function somethingElse() {
								return "not getData"
							}
						}
					' );

					expect( function() {
						loader.load( dir );
					} ).toThrow( "BxSites.MissingDataMethod" );
				} );

				it( "throws BxSites.InvalidDataFile naming the file when a .bx class fails to compile/instantiate", function() {
					var dir = newClassSafeDocsDir();
					writeClassFile( dir, "Broken", "this is not valid BoxLang class syntax {{{" );

					expect( function() {
						loader.load( dir );
					} ).toThrow( "BxSites.InvalidDataFile" );
				} );

			} );

		} );
	}

}
