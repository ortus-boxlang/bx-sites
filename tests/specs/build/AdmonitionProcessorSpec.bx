class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "build.AdmonitionProcessor", function() {

			beforeEach( function() {
				variables.processor = new "models.build.AdmonitionProcessor@bxdocs"();
			} );

			describe( "extract()", function() {

				it( "returns the body unchanged and no admonitions when there is no !!! block", function() {
					var result = processor.extract( "Just a regular paragraph." & char( 10 ) & char( 10 ) & "Another one." );

					expect( result.admonitions ).toBeArray();
					expect( result.admonitions.len() ).toBe( 0 );
					expect( result.body ).toBe( "Just a regular paragraph." & char( 10 ) & char( 10 ) & "Another one." );
				} );

				it( "extracts a single admonition, replacing it with a placeholder div", function() {
					var body = '!!! note' & char( 10 ) & '    Hello there.';
					var result = processor.extract( body );

					expect( result.admonitions.len() ).toBe( 1 );
					expect( result.admonitions[ 1 ].type ).toBe( "note" );
					expect( result.admonitions[ 1 ].content ).toBe( "Hello there." );
					expect( result.body ).toInclude( '<div data-bxdocs-admonition="' & result.admonitions[ 1 ].token & '"></div>' );
					expect( result.body ).notToInclude( "Hello there." );
				} );

				it( "defaults the title from the type when no quoted title is given", function() {
					var result = processor.extract( '!!! warning' & char( 10 ) & '    Careful.' );
					expect( result.admonitions[ 1 ].title ).toBe( "Warning" );
				} );

				it( "uses the quoted title when given", function() {
					var result = processor.extract( '!!! note "Heads Up"' & char( 10 ) & '    Careful.' );
					expect( result.admonitions[ 1 ].title ).toBe( "Heads Up" );
				} );

				it( "dedents 4-space-indented content lines", function() {
					var result = processor.extract( '!!! note' & char( 10 ) & '    Line one.' & char( 10 ) & '    Line two.' );
					expect( result.admonitions[ 1 ].content ).toBe( "Line one." & char( 10 ) & "Line two." );
				} );

				it( "preserves a blank line within the block as a paragraph break, but stops at the first non-indented line", function() {
					var body = '!!! note' & char( 10 ) &
						'    Paragraph one.' & char( 10 ) &
						char( 10 ) &
						'    Paragraph two.' & char( 10 ) &
						char( 10 ) &
						'Not part of the block.';
					var result = processor.extract( body );

					expect( result.admonitions[ 1 ].content ).toBe( "Paragraph one." & char( 10 ) & char( 10 ) & "Paragraph two." );
					expect( result.body ).toInclude( "Not part of the block." );
				} );

				it( "sanitizes an unusual type into a safe lowercase CSS class", function() {
					var result = processor.extract( '!!! Custom-Type!!' & char( 10 ) & '    Body.' );
					expect( result.admonitions[ 1 ].type ).toBe( "custom-type" );
				} );

				it( "extracts multiple admonitions in one body, each with its own token", function() {
					var body = '!!! note "First"' & char( 10 ) & '    One.' & char( 10 ) &
						char( 10 ) &
						'Some text in between.' & char( 10 ) &
						char( 10 ) &
						'!!! warning "Second"' & char( 10 ) & '    Two.';
					var result = processor.extract( body );

					expect( result.admonitions.len() ).toBe( 2 );
					expect( result.admonitions[ 1 ].title ).toBe( "First" );
					expect( result.admonitions[ 2 ].title ).toBe( "Second" );
					expect( result.admonitions[ 1 ].token ).notToBe( result.admonitions[ 2 ].token );
					expect( result.body ).toInclude( "Some text in between." );
				} );

				it( "handles an admonition with no body content at all", function() {
					var result = processor.extract( '!!! note "Empty"' & char( 10 ) & 'Not indented.' );
					expect( result.admonitions.len() ).toBe( 1 );
					expect( result.admonitions[ 1 ].content ).toBe( "" );
					expect( result.body ).toInclude( "Not indented." );
				} );

				it( "ignores a !!! line inside a fenced code block - e.g. an example of the syntax itself", function() {
					var body = '```markdown' & char( 10 ) &
						'!!! note "Not a real one"' & char( 10 ) &
						'    Just an example.' & char( 10 ) &
						'```' & char( 10 ) &
						char( 10 ) &
						'!!! tip' & char( 10 ) &
						'    This one is real.';
					var result = processor.extract( body );

					expect( result.admonitions.len() ).toBe( 1 );
					expect( result.admonitions[ 1 ].type ).toBe( "tip" );
					expect( result.body ).toInclude( '!!! note "Not a real one"' );
					expect( result.body ).toInclude( "```markdown" );
				} );

			} );

			describe( "wrap()", function() {

				it( "renders the type class, escaped title and rendered content inside a div", function() {
					var admonition = { token : "t1", type : "warning", title : "Careful & Read", content : "raw" };
					var html = processor.wrap( admonition, "<p>Rendered content</p>" );

					expect( html ).toInclude( '<div class="admonition warning">' );
					expect( html ).toInclude( '<p class="admonition-title">Careful &amp; Read</p>' );
					expect( html ).toInclude( "<p>Rendered content</p>" );
					expect( html ).toEndWith( "</div>" );
				} );

			} );

			describe( "substitute()", function() {

				it( "replaces each placeholder with its wrapped HTML", function() {
					var html = '<p>Before</p><div data-bxdocs-admonition="t1"></div><p>After</p>';
					var result = processor.substitute( html, { "t1" : '<div class="admonition note">Wrapped</div>' } );

					expect( result ).toBe( '<p>Before</p><div class="admonition note">Wrapped</div><p>After</p>' );
				} );

				it( "leaves the html unchanged when there are no admonitions to substitute", function() {
					var html = "<p>Nothing to see here.</p>";
					expect( processor.substitute( html, {} ) ).toBe( html );
				} );

			} );

		} );
	}

}
