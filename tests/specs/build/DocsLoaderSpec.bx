class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "build.DocsLoader", function() {

			beforeEach( function() {
				variables.loader = new "models.build.DocsLoader@bxsites"();
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			private function newDocsDir() {
				var dir = createTempDirectory( prefix = "bxsites-docsloader-" );
				tempDirs.append( dir );
				return dir;
			}

			it( "throws BxSites.DocsDirNotFound when the docs/ directory is missing", function() {
				var dir = newDocsDir() & "/does-not-exist";
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxSites.DocsDirNotFound" );
			} );

			it( "loads a flat .md file with frontmatter and a pretty urlPath", function() {
				var dir = newDocsDir();
				fileWrite( dir & "/guide.md", "---" & char( 10 ) & "title: My Guide" & char( 10 ) & "order: 2" & char( 10 ) & "---" & char( 10 ) & "Body text" );

				var pages = loader.load( dir );

				expect( pages.len() ).toBe( 1 );
				expect( pages[ 1 ].title ).toBe( "My Guide" );
				expect( pages[ 1 ].order ).toBe( 2 );
				expect( pages[ 1 ].hidden ).toBeFalse();
				expect( pages[ 1 ].urlPath ).toBe( "guide/index.html" );
				expect( pages[ 1 ].relativePath ).toBe( "guide.md" );
				expect( pages[ 1 ].body ).toBe( "Body text" );
			} );

			it( "preserves the raw frontmatter struct, custom keys included, on page.frontmatter", function() {
				var dir = newDocsDir();
				fileWrite( dir & "/guide.md", "---" & char( 10 ) & "title: My Guide" & char( 10 ) & "product: BoxLang" & char( 10 ) & "release: 1.0.0" & char( 10 ) & "---" & char( 10 ) & "Body text" );

				var pages = loader.load( dir );

				expect( pages[ 1 ].frontmatter.title ).toBe( "My Guide" );
				expect( pages[ 1 ].frontmatter.product ).toBe( "BoxLang" );
				expect( pages[ 1 ].frontmatter.release ).toBe( "1.0.0" );
			} );

			it( "defaults page.frontmatter to an empty struct when a page has no frontmatter at all", function() {
				var dir = newDocsDir();
				fileWrite( dir & "/plain.md", "No frontmatter here" );

				var pages = loader.load( dir );

				expect( pages[ 1 ].frontmatter ).toBeStruct();
				expect( pages[ 1 ].frontmatter.isEmpty() ).toBeTrue();
			} );

			it( "maps a root index.md to index.html directly, not a subfolder", function() {
				var dir = newDocsDir();
				fileWrite( dir & "/index.md", "Welcome" );

				var pages = loader.load( dir );

				expect( pages[ 1 ].urlPath ).toBe( "index.html" );
			} );

			it( "maps a nested folder's index.md to <folder>/index.html", function() {
				var dir = newDocsDir();
				directoryCreate( dir & "/guides", true, true );
				fileWrite( dir & "/guides/index.md", "Guides home" );

				var pages = loader.load( dir );

				expect( pages[ 1 ].urlPath ).toBe( "guides/index.html" );
				expect( pages[ 1 ].relativePath ).toBe( "guides/index.md" );
			} );

			it( "derives a title from the filename when frontmatter has no title", function() {
				var dir = newDocsDir();
				fileWrite( dir & "/getting-started.md", "No frontmatter here" );

				var pages = loader.load( dir );

				expect( pages[ 1 ].title ).toBe( "Getting Started" );
			} );

			it( "defaults order to a large number and hidden to false when omitted", function() {
				var dir = newDocsDir();
				fileWrite( dir & "/plain.md", "No frontmatter" );

				var pages = loader.load( dir );

				expect( pages[ 1 ].order ).toBe( 999999 );
				expect( pages[ 1 ].hidden ).toBeFalse();
			} );

			it( "defaults tags/icon/summary/ogImage/redirectFrom to empty when omitted", function() {
				var dir = newDocsDir();
				fileWrite( dir & "/plain.md", "No frontmatter" );

				var pages = loader.load( dir );

				expect( pages[ 1 ].tags ).toBeArray();
				expect( pages[ 1 ].tags.len() ).toBe( 0 );
				expect( pages[ 1 ].icon ).toBe( "" );
				expect( pages[ 1 ].summary ).toBe( "" );
				expect( pages[ 1 ].ogImage ).toBe( "" );
				expect( pages[ 1 ].redirectFrom ).toBeArray();
				expect( pages[ 1 ].redirectFrom.len() ).toBe( 0 );
			} );

			it( "reads tags/icon/summary/ogImage/redirect_from from frontmatter", function() {
				var dir = newDocsDir();
				var content = "---" & char( 10 ) &
					"title: Tagged Page" & char( 10 ) &
					"tags: [cli, guide]" & char( 10 ) &
					"icon: 🚀" & char( 10 ) &
					"summary: A short lead-in." & char( 10 ) &
					"ogImage: assets/tagged-card.png" & char( 10 ) &
					"redirect_from: [old-tagged, guides/legacy-tagged]" & char( 10 ) &
					"---" & char( 10 ) &
					"Body";
				fileWrite( dir & "/tagged.md", content );

				var pages = loader.load( dir );

				expect( pages[ 1 ].tags ).toBe( [ "cli", "guide" ] );
				expect( pages[ 1 ].icon ).toBe( "🚀" );
				expect( pages[ 1 ].summary ).toBe( "A short lead-in." );
				expect( pages[ 1 ].ogImage ).toBe( "assets/tagged-card.png" );
				expect( pages[ 1 ].redirectFrom ).toBe( [ "old-tagged", "guides/legacy-tagged" ] );
			} );

			it( "defaults showToc to true, and to false when frontmatter sets [toc] to false", function() {
				var dir = newDocsDir();
				fileWrite( dir & "/plain.md", "No frontmatter" );
				fileWrite( dir & "/no-toc.md", "---" & char( 10 ) & "toc: false" & char( 10 ) & "---" & char( 10 ) & "Body" );

				var pages = loader.load( dir );
				var byPath = {};
				for ( var page in pages ) {
					byPath[ page.relativePath ] = page;
				}

				expect( byPath[ "plain.md" ].showToc ).toBeTrue();
				expect( byPath[ "no-toc.md" ].showToc ).toBeFalse();
			} );

			it( "excludes docs/assets/** from the loaded pages", function() {
				var dir = newDocsDir();
				directoryCreate( dir & "/assets", true, true );
				fileWrite( dir & "/assets/not-a-page.md", "Should be excluded" );
				fileWrite( dir & "/real.md", "Included" );

				var pages = loader.load( dir );

				expect( pages.len() ).toBe( 1 );
				expect( pages[ 1 ].relativePath ).toBe( "real.md" );
			} );

			it( "excludes docs/versions/** from the loaded pages (VersionsDiscoverer/BuildPipeline own that tree)", function() {
				var dir = newDocsDir();
				directoryCreate( dir & "/versions/1.0", true, true );
				fileWrite( dir & "/versions/1.0/index.md", "Old docs" );
				fileWrite( dir & "/real.md", "Included" );

				var pages = loader.load( dir );

				expect( pages.len() ).toBe( 1 );
				expect( pages[ 1 ].relativePath ).toBe( "real.md" );
			} );

			it( "excludes docs/blog/** from the loaded pages (BlogDiscoverer/BuildPipeline own that tree)", function() {
				var dir = newDocsDir();
				directoryCreate( dir & "/blog/posts", true, true );
				fileWrite( dir & "/blog/posts/hello-world.md", "---" & char( 10 ) & "date: 2026-01-01" & char( 10 ) & "---" & char( 10 ) & "Post body" );
				fileWrite( dir & "/real.md", "Included" );

				var pages = loader.load( dir );

				expect( pages.len() ).toBe( 1 );
				expect( pages[ 1 ].relativePath ).toBe( "real.md" );
			} );

			it( "excludes docs/includes/** from the loaded pages (IncludeProcessor's own reusable-content partials)", function() {
				var dir = newDocsDir();
				directoryCreate( dir & "/includes", true, true );
				fileWrite( dir & "/includes/notice.md", "Not a page - spliced via ::: include" );
				fileWrite( dir & "/real.md", "Included" );

				var pages = loader.load( dir );

				expect( pages.len() ).toBe( 1 );
				expect( pages[ 1 ].relativePath ).toBe( "real.md" );
			} );

			it( "sorts pages by order, then by title", function() {
				var dir = newDocsDir();
				fileWrite( dir & "/b.md", "---" & char( 10 ) & "title: B Page" & char( 10 ) & "order: 1" & char( 10 ) & "---" & char( 10 ) & "b" );
				fileWrite( dir & "/a.md", "---" & char( 10 ) & "title: A Page" & char( 10 ) & "order: 1" & char( 10 ) & "---" & char( 10 ) & "a" );
				fileWrite( dir & "/z.md", "---" & char( 10 ) & "title: Z First" & char( 10 ) & "order: 0" & char( 10 ) & "---" & char( 10 ) & "z" );

				var pages = loader.load( dir );

				expect( pages[ 1 ].title ).toBe( "Z First" );
				expect( pages[ 2 ].title ).toBe( "A Page" );
				expect( pages[ 3 ].title ).toBe( "B Page" );
			} );

		} );
	}

}
