class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "build.DocsLoader", function() {

			beforeEach( function() {
				variables.loader = new "models.build.DocsLoader@bxdocs"();
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			private function newDocsDir() {
				var dir = createTempDirectory( prefix = "bxdocs-docsloader-" );
				tempDirs.append( dir );
				return dir;
			}

			it( "throws BxDocs.DocsDirNotFound when the docs/ directory is missing", function() {
				var dir = newDocsDir() & "/does-not-exist";
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxDocs.DocsDirNotFound" );
			} );

			it( "loads a flat .md file with frontmatter and a pretty urlPath", function() {
				var dir = newDocsDir();
				fileWrite( dir & "/guide.md", "---" & char( 10 ) & "title: My Guide" & char( 10 ) & "order: 2" & char( 10 ) & "---" & char( 10 ) & "Body text" );

				var pages = loader.load( dir );

				expect( pages.len() ).toBe( 1 );
				expect( pages[ 1 ].title ).toBe( "My Guide" );
				expect( pages[ 1 ].order ).toBe( 2 );
				expect( pages[ 1 ].hidden ).toBeFalse();
				expect( pages[ 1 ].urlPath ).toBe( "guide/index.html" );
				expect( pages[ 1 ].relativePath ).toBe( "guide.md" );
				expect( pages[ 1 ].body ).toBe( "Body text" );
			} );

			it( "maps a root index.md to index.html directly, not a subfolder", function() {
				var dir = newDocsDir();
				fileWrite( dir & "/index.md", "Welcome" );

				var pages = loader.load( dir );

				expect( pages[ 1 ].urlPath ).toBe( "index.html" );
			} );

			it( "maps a nested folder's index.md to <folder>/index.html", function() {
				var dir = newDocsDir();
				directoryCreate( dir & "/guides", true, true );
				fileWrite( dir & "/guides/index.md", "Guides home" );

				var pages = loader.load( dir );

				expect( pages[ 1 ].urlPath ).toBe( "guides/index.html" );
				expect( pages[ 1 ].relativePath ).toBe( "guides/index.md" );
			} );

			it( "derives a title from the filename when frontmatter has no title", function() {
				var dir = newDocsDir();
				fileWrite( dir & "/getting-started.md", "No frontmatter here" );

				var pages = loader.load( dir );

				expect( pages[ 1 ].title ).toBe( "Getting Started" );
			} );

			it( "defaults order to a large number and hidden to false when omitted", function() {
				var dir = newDocsDir();
				fileWrite( dir & "/plain.md", "No frontmatter" );

				var pages = loader.load( dir );

				expect( pages[ 1 ].order ).toBe( 999999 );
				expect( pages[ 1 ].hidden ).toBeFalse();
			} );

			it( "excludes docs/assets/** from the loaded pages", function() {
				var dir = newDocsDir();
				directoryCreate( dir & "/assets", true, true );
				fileWrite( dir & "/assets/not-a-page.md", "Should be excluded" );
				fileWrite( dir & "/real.md", "Included" );

				var pages = loader.load( dir );

				expect( pages.len() ).toBe( 1 );
				expect( pages[ 1 ].relativePath ).toBe( "real.md" );
			} );

			it( "sorts pages by order, then by title", function() {
				var dir = newDocsDir();
				fileWrite( dir & "/b.md", "---" & char( 10 ) & "title: B Page" & char( 10 ) & "order: 1" & char( 10 ) & "---" & char( 10 ) & "b" );
				fileWrite( dir & "/a.md", "---" & char( 10 ) & "title: A Page" & char( 10 ) & "order: 1" & char( 10 ) & "---" & char( 10 ) & "a" );
				fileWrite( dir & "/z.md", "---" & char( 10 ) & "title: Z First" & char( 10 ) & "order: 0" & char( 10 ) & "---" & char( 10 ) & "z" );

				var pages = loader.load( dir );

				expect( pages[ 1 ].title ).toBe( "Z First" );
				expect( pages[ 2 ].title ).toBe( "A Page" );
				expect( pages[ 3 ].title ).toBe( "B Page" );
			} );

		} );
	}

}
