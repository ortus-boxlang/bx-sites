class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "build.DirectiveBlockProcessor", function() {

			beforeEach( function() {
				variables.processor = new "models.build.DirectiveBlockProcessor@bxsites"();
				variables.renderer = new "tests.support.FakeMarkdownRenderer@bxsites"();
			} );

			private string function render( required string markdown ) {
				var extracted = processor.extract( markdown );
				return htmlDecode( processor.restore( extracted.markdown, extracted.blocks, renderer, {} ) );
			}

			// encodeForHTML()'s exact escaping range for "safe" ASCII punctuation
			// (e.g. "/") and non-ASCII characters (emoji) is environment-dependent
			// (locale/JVM-charset-driven) - both the escaped numeric-entity form and
			// the raw character are equally valid, equivalent HTML, so assertions
			// below compare against decoded output rather than pinning one form.
			private string function htmlDecode( required string text ) {
				var matcher = createObject( "java", "java.util.regex.Pattern" ).compile( '&##x([0-9a-fA-F]+);' ).matcher( arguments.text )
				var buffer = createObject( "java", "java.lang.StringBuilder" ).init()
				while ( matcher.find() ) {
					var codepoint = createObject( "java", "java.lang.Integer" ).parseInt( matcher.group( 1 ), 16 )
					var chars = createObject( "java", "java.lang.String" ).valueOf( createObject( "java", "java.lang.Character" ).toChars( codepoint ) )
					matcher.appendReplacement( buffer, createObject( "java", "java.util.regex.Matcher" ).quoteReplacement( chars ) )
				}
				matcher.appendTail( buffer )
				return buffer.toString()
			}

			it( "leaves markdown with no directives untouched aside from trimming", function() {
				var md = "Just a paragraph.";
				var extracted = processor.extract( md );

				expect( extracted.blocks.len() ).toBe( 0 );
				expect( extracted.markdown ).toInclude( "Just a paragraph." );
			} );

			it( "renders an expandable as a <details>/<summary>, closed by default", function() {
				var html = render( '::: expandable "FAQ"' & char( 10 ) & "Body text." & char( 10 ) & ":::" );

				expect( html ).toInclude( '<details class="bxsites-expandable">' );
				expect( html ).toInclude( "<summary>FAQ</summary>" );
				expect( html ).toInclude( "Body text." );
				expect( html ).notToInclude( " open>" );
			} );

			it( "opens an expandable by default when open=""true""", function() {
				var html = render( '::: expandable "FAQ" open="true"' & char( 10 ) & "Body." & char( 10 ) & ":::" );

				expect( html ).toInclude( '<details class="bxsites-expandable" open>' );
			} );

			it( "renders a cards group with nested card children, each with title/icon/href/body", function() {
				var md = "::: cards" & char( 10 ) &
					'::: card title="Getting Started" icon="🚀" href="getting-started.md"' & char( 10 ) &
					"Install and scaffold." & char( 10 ) & ":::" & char( 10 ) &
					'::: card title="Themes"' & char( 10 ) &
					"No href here." & char( 10 ) & ":::" & char( 10 ) &
					":::";
				var html = render( md );

				expect( html ).toInclude( '<div class="bxsites-cards">' );
				expect( html ).toInclude( '<a class="bxsites-card" href="getting-started.md">' );
				expect( html ).toInclude( '<div class="bxsites-card__icon">🚀</div>' );
				expect( html ).toInclude( '<div class="bxsites-card__title">Getting Started</div>' );
				expect( html ).toInclude( "Install and scaffold." );
				// A card with no href renders as a plain <div>, not a link.
				expect( html ).toInclude( '<div class="bxsites-card">' );
				expect( html ).toInclude( '<div class="bxsites-card__title">Themes</div>' );
			} );

			it( "resolves a card's [icon] the same way frontmatter/nav icons are - a named icon renders as inline SVG", function() {
				var md = "::: cards" & char( 10 ) &
					'::: card title="Themes" icon="phosphor-duotone:palette"' & char( 10 ) & "Body." & char( 10 ) & ":::" & char( 10 ) &
					":::";
				var html = render( md );

				expect( html ).toInclude( '<div class="bxsites-card__icon"><svg' );
				expect( html ).toInclude( 'class="bxsites-icon"' );
				expect( html ).notToInclude( "phosphor-duotone:palette" );
			} );

			it( "renders columns honoring a valid CSS width and ignoring an invalid one", function() {
				var md = "::: columns" & char( 10 ) &
					'::: column width="50%"' & char( 10 ) & "Left." & char( 10 ) & ":::" & char( 10 ) &
					'::: column width="javascript:alert(1)"' & char( 10 ) & "Right." & char( 10 ) & ":::" & char( 10 ) &
					":::";
				var html = render( md );

				expect( html ).toInclude( 'style="--bxsites-column-width:50%"' );
				expect( html ).notToInclude( "javascript:" );
			} );

			it( "renders a numbered stepper from step children, in order", function() {
				var md = "::: stepper" & char( 10 ) &
					'::: step "Install"' & char( 10 ) & "Step one." & char( 10 ) & ":::" & char( 10 ) &
					'::: step "Build"' & char( 10 ) & "Step two." & char( 10 ) & ":::" & char( 10 ) &
					":::";
				var html = render( md );

				expect( html ).toInclude( '<div class="bxsites-step__marker">1</div>' );
				expect( html ).toInclude( '<div class="bxsites-step__title">Install</div>' );
				expect( html ).toInclude( '<div class="bxsites-step__marker">2</div>' );
				expect( html ).toInclude( '<div class="bxsites-step__title">Build</div>' );
			} );

			it( "flags a step with one of the semantic marker colors via its own [color] attribute", function() {
				var md = "::: stepper" & char( 10 ) &
					'::: step "Install" color="success"' & char( 10 ) & "Step one." & char( 10 ) & ":::" & char( 10 ) &
					'::: step "Wipe data" color="danger"' & char( 10 ) & "Step two." & char( 10 ) & ":::" & char( 10 ) &
					'::: step "Optional" color="warning"' & char( 10 ) & "Step three." & char( 10 ) & ":::" & char( 10 ) &
					":::";
				var html = render( md );

				expect( html ).toInclude( '<div class="bxsites-step__marker bxsites-step__marker--success">1</div>' );
				expect( html ).toInclude( '<div class="bxsites-step__marker bxsites-step__marker--danger">2</div>' );
				expect( html ).toInclude( '<div class="bxsites-step__marker bxsites-step__marker--warning">3</div>' );
			} );

			it( "is case-insensitive on a step's [color] attribute", function() {
				var md = "::: stepper" & char( 10 ) &
					'::: step "Install" color="SUCCESS"' & char( 10 ) & "Step one." & char( 10 ) & ":::" & char( 10 ) &
					":::";
				var html = render( md );

				expect( html ).toInclude( '<div class="bxsites-step__marker bxsites-step__marker--success">1</div>' );
			} );

			it( "falls back to the default marker for a step with no/unrecognized [color]", function() {
				var md = "::: stepper" & char( 10 ) &
					'::: step "Install"' & char( 10 ) & "Step one." & char( 10 ) & ":::" & char( 10 ) &
					'::: step "Build" color="purple"' & char( 10 ) & "Step two." & char( 10 ) & ":::" & char( 10 ) &
					":::";
				var html = render( md );

				expect( html ).toInclude( '<div class="bxsites-step__marker">1</div>' );
				expect( html ).toInclude( '<div class="bxsites-step__marker">2</div>' );
				expect( html ).notToInclude( "bxsites-step__marker--purple" );
			} );

			it( "recurses into a directive nested inside another block's content", function() {
				var md = '::: expandable "Outer"' & char( 10 ) &
					"::: cards" & char( 10 ) &
					'::: card title="Inner" href="x.md"' & char( 10 ) & "Inner body." & char( 10 ) & ":::" & char( 10 ) &
					":::" & char( 10 ) &
					":::";
				var html = render( md );

				expect( html ).toInclude( "<summary>Outer</summary>" );
				expect( html ).toInclude( '<div class="bxsites-cards">' );
				expect( html ).toInclude( '<div class="bxsites-card__title">Inner</div>' );
			} );

			it( "renders a file block as a download link, falling back to the filename when no title is given", function() {
				var html = render( '::: file src="assets/spec.pdf"' & char( 10 ) & ":::" );

				expect( html ).toInclude( '<a class="bxsites-file" href="assets/spec.pdf" download>' );
				expect( html ).toInclude( "spec.pdf" );
			} );

			it( "resolveFileHrefs() prefixes a bare file href with basePath, so a nested page's download link doesn't 404", function() {
				var html = render( '::: file src="assets/spec.pdf"' & char( 10 ) & ":::" );

				var resolved = processor.resolveFileHrefs( html, "/guides/content-blocks/" );

				expect( resolved ).toInclude( '<a class="bxsites-file" href="/guides/content-blocks/assets/spec.pdf" download>' );
			} );

			it( "resolveFileHrefs() leaves an already root-relative or absolute file href untouched", function() {
				var rootRelative = render( '::: file src="/downloads/spec.pdf"' & char( 10 ) & ":::" );
				var absolute = render( '::: file src="https://example.com/spec.pdf"' & char( 10 ) & ":::" );

				expect( processor.resolveFileHrefs( rootRelative, "/guides/content-blocks/" ) ).toInclude( 'href="/downloads/spec.pdf"' );
				expect( processor.resolveFileHrefs( absolute, "/guides/content-blocks/" ) ).toInclude( 'href="https://example.com/spec.pdf"' );
			} );

			it( "renders an openapi block as a placeholder div carrying its src and optional title", function() {
				var html = render( '::: openapi src="assets/openapi/example.yaml" title="Example API"' & char( 10 ) & ":::" );

				expect( html ).toInclude( '<div class="bxsites-openapi" data-openapi-src="assets/openapi/example.yaml">' );
				expect( html ).toInclude( '<div class="bxsites-openapi__title">Example API</div>' );
			} );

			it( "renders an openapi block with no title as a bare placeholder div", function() {
				var html = render( '::: openapi src="assets/openapi/example.yaml"' & char( 10 ) & ":::" );

				expect( html ).toInclude( '<div class="bxsites-openapi" data-openapi-src="assets/openapi/example.yaml"></div>' );
			} );

			it( "renders an invalid-block message when an openapi block is missing its required src", function() {
				var html = render( '::: openapi title="No src"' & char( 10 ) & ":::" );

				expect( html ).toInclude( "missing required src" );
			} );

			it( "resolveOpenApiSrcs() prefixes a bare openapi src with basePath, so the widget fetches the right spec from a nested page", function() {
				var html = render( '::: openapi src="assets/openapi/example.yaml"' & char( 10 ) & ":::" );

				var resolved = processor.resolveOpenApiSrcs( html, "/guides/content-blocks/" );

				expect( resolved ).toInclude( 'data-openapi-src="/guides/content-blocks/assets/openapi/example.yaml"' );
			} );

			it( "resolveOpenApiSrcs() leaves an already root-relative or absolute openapi src untouched", function() {
				var rootRelative = render( '::: openapi src="/specs/example.yaml"' & char( 10 ) & ":::" );
				var absolute = render( '::: openapi src="https://example.com/spec.yaml"' & char( 10 ) & ":::" );

				expect( processor.resolveOpenApiSrcs( rootRelative, "/guides/content-blocks/" ) ).toInclude( 'data-openapi-src="/specs/example.yaml"' );
				expect( processor.resolveOpenApiSrcs( absolute, "/guides/content-blocks/" ) ).toInclude( 'data-openapi-src="https://example.com/spec.yaml"' );
			} );

			it( "resolveOpenApiSrcs() also prefixes an operation-scoped block's own src, despite its extra bxsites-openapi--operation class", function() {
				var html = render( '::: openapi src="assets/openapi/example.yaml" operation="GET /books"' & char( 10 ) & ":::" );

				var resolved = processor.resolveOpenApiSrcs( html, "/guides/content-blocks/" );

				expect( resolved ).toInclude( 'data-openapi-src="/guides/content-blocks/assets/openapi/example.yaml"' );
			} );

			it( "resolves a YouTube embed URL to its iframe embed form", function() {
				var html = render( '::: embed url="https://www.youtube.com/watch?v=dQw4w9WgXcQ" title="Demo"' & char( 10 ) & ":::" );

				expect( html ).toInclude( 'src="https://www.youtube.com/embed/dQw4w9WgXcQ"' );
				expect( html ).toInclude( '<div class="bxsites-embed__caption">Demo</div>' );
			} );

			it( "falls back to a plain link card for an unrecognized embed provider", function() {
				var html = render( '::: embed url="https://example.com/random-page"' & char( 10 ) & ":::" );

				expect( html ).toInclude( '<a class="bxsites-embed-fallback" href="https://example.com/random-page"' );
				expect( html ).notToInclude( "<iframe" );
			} );

			it( "renders a page-link as a plain stub anchor - enrichment is PageLinkResolver's job", function() {
				var html = render( '::: page-link href="guides/themes.md"' & char( 10 ) & ":::" );

				expect( html ).toInclude( '<a class="bxsites-page-link" href="guides/themes.md" data-bxsites-page-link>' );
			} );

			it( "renders a link-preview card for an external URL with title/description/image/domain", function() {
				var md = '::: link-preview url="https://boxlang.io" title="BoxLang" description="A dynamic JVM language." image="https://boxlang.io/og.png"' & char( 10 ) & ":::";
				var html = render( md );

				expect( html ).toInclude( '<a class="bxsites-link-preview" href="https://boxlang.io" target="_blank" rel="noopener noreferrer">' );
				expect( html ).toInclude( '<img src="https://boxlang.io/og.png" alt="">' );
				expect( html ).toInclude( '<div class="bxsites-link-preview__title">BoxLang</div>' );
				expect( html ).toInclude( '<div class="bxsites-link-preview__description">A dynamic JVM language.</div>' );
				expect( html ).toInclude( '<div class="bxsites-link-preview__domain">boxlang.io</div>' );
			} );

			it( "falls back to the bare url as a link-preview's title when none is given, and omits optional parts", function() {
				var html = render( '::: link-preview url="https://example.com/some/page"' & char( 10 ) & ":::" );

				expect( html ).toInclude( 'href="https://example.com/some/page"' );
				expect( html ).notToInclude( "bxsites-link-preview__image" );
				expect( html ).notToInclude( "bxsites-link-preview__description" );
				expect( html ).toInclude( '<div class="bxsites-link-preview__domain">example.com</div>' );
			} );

			it( "renders an invalid-block message when a link-preview is missing its required url", function() {
				var html = render( "::: link-preview" & char( 10 ) & ":::" );

				expect( html ).toInclude( "bxsites-link-preview--invalid" );
			} );

			it( "renders updates entries with date, tags and body, most-recent-first order left to the caller", function() {
				var md = "::: updates" & char( 10 ) &
					'::: update date="2026-01-15" tags="feature,fix"' & char( 10 ) & "Added dark mode." & char( 10 ) & ":::" & char( 10 ) &
					'::: update date="2026-01-01"' & char( 10 ) & "Initial release." & char( 10 ) & ":::" & char( 10 ) &
					":::";
				var html = render( md );

				expect( html ).toInclude( '<time class="bxsites-update__date" datetime="2026-01-15">2026-01-15</time>' );
				expect( html ).toInclude( '<span class="bxsites-update__tag">feature</span>' );
				expect( html ).toInclude( '<span class="bxsites-update__tag">fix</span>' );
				expect( html ).toInclude( "Added dark mode." );
				expect( html ).toInclude( "Initial release." );
			} );

			it( "extractUpdateEntries() returns structured entries from an already-extracted updates block", function() {
				var md = "::: updates" & char( 10 ) &
					'::: update date="2026-01-01" tags="a, b"' & char( 10 ) & "Body." & char( 10 ) & ":::" & char( 10 ) &
					":::";
				var extracted = processor.extract( md );
				var updatesBlock = extracted.blocks[ 1 ];

				var entries = processor.extractUpdateEntries( updatesBlock, renderer, {} );

				expect( entries.len() ).toBe( 1 );
				expect( entries[ 1 ].date ).toBe( "2026-01-01" );
				expect( entries[ 1 ].tags ).toBe( [ "a", "b" ] );
				expect( entries[ 1 ].contentHtml ).toInclude( "Body." );
			} );

			it( "flushes an unclosed directive at end of file instead of dropping its content", function() {
				var html = render( '::: expandable "Oops, forgot to close"' & char( 10 ) & "Still here." );

				expect( html ).toInclude( "<summary>Oops, forgot to close</summary>" );
				expect( html ).toInclude( "Still here." );
			} );

			it( "renders a ::: conditional block tagged with its own key/value", function() {
				var html = render( '::: conditional key="plan" value="pro"' & char( 10 ) & "Pro-only body." & char( 10 ) & ":::" );

				expect( html ).toInclude( 'class="bxsites-conditional"' );
				expect( html ).toInclude( 'data-bxsites-key="plan"' );
				expect( html ).toInclude( 'data-bxsites-value="pro"' );
				expect( html ).toInclude( "Pro-only body." );
			} );

			it( "renders a ::: conditional error placeholder when key or value is missing", function() {
				var html = render( '::: conditional key="plan"' & char( 10 ) & "x" & char( 10 ) & ":::" );

				expect( html ).toInclude( "bxsites-conditional--invalid" );
			} );

			it( "renders a ::: audience-switcher with one button per option", function() {
				var html = render( '::: audience-switcher key="plan" options="free:Free,pro:Pro"' & char( 10 ) & ":::" );

				expect( html ).toInclude( 'data-bxsites-key="plan"' );
				expect( html.reMatch( 'data-bxsites-value="free"' ).len() ).toBe( 1 );
				expect( html.reMatch( 'data-bxsites-value="pro"' ).len() ).toBe( 1 );
				expect( html ).toInclude( ">Free<" );
				expect( html ).toInclude( ">Pro<" );
			} );

			it( "renders a ::: audience-switcher error placeholder when key or options is missing", function() {
				var html = render( "::: audience-switcher" & char( 10 ) & ":::" );

				expect( html ).toInclude( "bxsites-audience-switcher--invalid" );
			} );

			it( "renders ::: openapi with an operation attribute scoped to one method+path", function() {
				var html = render( '::: openapi src="assets/openapi/spec.yaml" operation="POST /users"' & char( 10 ) & ":::" );

				expect( html ).toInclude( "bxsites-openapi--operation" );
				expect( html ).toInclude( 'data-openapi-operation="post /users"' );
			} );

			it( "renders an ::: openapi invalid placeholder when operation isn't METHOD /path", function() {
				var html = render( '::: openapi src="assets/openapi/spec.yaml" operation="nope"' & char( 10 ) & ":::" );

				expect( html ).toInclude( "bxsites-openapi--invalid" );
			} );

			it( "still renders plain ::: openapi with no operation attribute unaffected", function() {
				var html = render( '::: openapi src="assets/openapi/spec.yaml"' & char( 10 ) & ":::" );

				expect( html ).toInclude( 'data-openapi-src="assets/openapi/spec.yaml"' );
				expect( html ).notToInclude( "data-openapi-operation" );
				expect( html ).notToInclude( "bxsites-openapi--operation" );
			} );

		} );
	}

}
