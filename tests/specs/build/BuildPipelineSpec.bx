class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "build.BuildPipeline", function() {

			beforeEach( function() {
				variables.pipeline = new "models.build.BuildPipeline@bxdocs"();
				variables.fakeMarkdown = new "tests.support.FakeMarkdownRenderer@bxdocs"();
				pipeline.setMarkdownRenderer( fakeMarkdown );
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			private function newProject( string themeName = "bootstrap" ) {
				var dir = createTempDirectory( prefix = "bxdocs-buildpipeline-" );
				tempDirs.append( dir );
				directoryCreate( dir & "/docs", true, true );
				fileWrite(
					dir & "/bxdocs.json",
					'{"name":"Test Site","theme":{"name":"' & themeName & '"}}'
				);
				return dir;
			}

			it( "builds a single page site end to end", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "Welcome home" );

				var result = pipeline.build( root );

				expect( result.pageCount ).toBe( 1 );
				expect( result.siteDir ).toBe( root & "/site" );
				expect( fileExists( root & "/site/index.html" ) ).toBeTrue();

				var html = fileRead( root & "/site/index.html" );
				expect( html ).toInclude( "Test Site" );
				expect( html ).toInclude( "<p>Welcome home</p>" );
			} );

			it( "builds nested pages at their pretty-URL paths and links them in the nav", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "Home" );
				directoryCreate( root & "/docs/guides", true, true );
				fileWrite( root & "/docs/guides/setup.md", "---" & char( 10 ) & "title: Setup" & char( 10 ) & "---" & char( 10 ) & "Setup body" );

				var result = pipeline.build( root );

				expect( result.pageCount ).toBe( 2 );
				expect( fileExists( root & "/site/guides/setup/index.html" ) ).toBeTrue();

				var homeHtml = fileRead( root & "/site/index.html" );
				expect( homeHtml ).toInclude( 'href="/guides/setup/index.html"' );
				expect( homeHtml ).toInclude( 'href="/index.html"' );
			} );

			it( "passes bxdocs.json's markdown options through to the markdown renderer", function() {
				var root = newProject();
				fileWrite(
					root & "/bxdocs.json",
					'{"name":"Test Site","theme":{"name":"bootstrap"},"markdown":{"anchorLinks":false}}'
				);
				fileWrite( root & "/docs/index.md", "Home" );

				pipeline.build( root );

				var calls = fakeMarkdown.getCalls();
				expect( calls.len() ).toBe( 1 );
				expect( calls[ 1 ].options.anchorLinks ).toBeFalse();
			} );

			it( "builds end to end with the material and tailwind themes too", function() {
				for ( var themeName in [ "material", "tailwind" ] ) {
					var root = newProject( themeName );
					fileWrite( root & "/docs/index.md", "Welcome home" );

					var result = pipeline.build( root );

					expect( result.pageCount ).toBe( 1 );
					var html = fileRead( root & "/site/index.html" );
					expect( html ).toInclude( "<p>Welcome home</p>" );
					expect( fileExists( root & "/site/assets/theme/style.css" ) ).toBeTrue();
				}
			} );

			it( "copies theme assets to site/assets/theme and docs/assets to site/assets", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "Home" );
				directoryCreate( root & "/docs/assets", true, true );
				fileWrite( root & "/docs/assets/logo.svg", "<svg></svg>" );

				pipeline.build( root );

				expect( fileExists( root & "/site/assets/theme/style.css" ) ).toBeTrue();
				expect( fileExists( root & "/site/assets/logo.svg" ) ).toBeTrue();
			} );

			it( "excludes hidden pages from the nav but still builds them", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "Home" );
				fileWrite( root & "/docs/secret.md", "---" & char( 10 ) & "title: Secret" & char( 10 ) & "hidden: true" & char( 10 ) & "---" & char( 10 ) & "Shh" );

				pipeline.build( root );

				expect( fileExists( root & "/site/secret/index.html" ) ).toBeTrue();
				var homeHtml = fileRead( root & "/site/index.html" );
				expect( homeHtml ).notToInclude( "Secret" );
			} );

			it( "removes a previous site/ before rebuilding", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "Home" );
				directoryCreate( root & "/site/stale", true, true );
				fileWrite( root & "/site/stale/old.html", "old" );

				pipeline.build( root );

				expect( fileExists( root & "/site/stale/old.html" ) ).toBeFalse();
				expect( fileExists( root & "/site/index.html" ) ).toBeTrue();
			} );

			it( "builds search-index.json and copies the shared search.js widget when search is enabled (the default)", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "---" & char( 10 ) & "title: Home" & char( 10 ) & "---" & char( 10 ) & "Welcome home" );

				pipeline.build( root );

				expect( fileExists( root & "/site/search-index.json" ) ).toBeTrue();
				expect( fileExists( root & "/site/assets/search.js" ) ).toBeTrue();

				var index = jsonDeserialize( fileRead( root & "/site/search-index.json" ) );
				expect( index.len() ).toBe( 1 );
				expect( index[ 1 ].title ).toBe( "Home" );
				expect( index[ 1 ].url ).toBe( "index.html" );

				var html = fileRead( root & "/site/index.html" );
				expect( html ).toInclude( "bxdocs-search-input" );
				expect( html ).toInclude( "lunr" );
			} );

			it( "skips the search index, search.js and search UI when search is disabled", function() {
				var root = newProject();
				fileWrite(
					root & "/bxdocs.json",
					'{"name":"Test Site","theme":{"name":"bootstrap"},"search":false}'
				);
				fileWrite( root & "/docs/index.md", "Welcome home" );

				pipeline.build( root );

				expect( fileExists( root & "/site/search-index.json" ) ).toBeFalse();
				expect( fileExists( root & "/site/assets/search.js" ) ).toBeFalse();

				var html = fileRead( root & "/site/index.html" );
				expect( html ).notToInclude( "bxdocs-search-input" );
				expect( html ).notToInclude( "lunr" );
			} );

			it( "excludes hidden pages from the search index too", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "Home" );
				fileWrite( root & "/docs/secret.md", "---" & char( 10 ) & "title: Secret" & char( 10 ) & "hidden: true" & char( 10 ) & "---" & char( 10 ) & "Shh" );

				pipeline.build( root );

				var index = jsonDeserialize( fileRead( root & "/site/search-index.json" ) );
				expect( index.len() ).toBe( 1 );
				expect( index[ 1 ].title ).notToBe( "Secret" );
			} );

			it( "buildSearchIndex() writes just site/search-index.json, without rendering pages or copying assets", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "---" & char( 10 ) & "title: Home" & char( 10 ) & "---" & char( 10 ) & "Welcome home" );

				var result = pipeline.buildSearchIndex( root );

				expect( result.skipped ).toBeFalse();
				expect( result.pageCount ).toBe( 1 );
				expect( result.indexPath ).toBe( root & "/site/search-index.json" );
				expect( fileExists( root & "/site/search-index.json" ) ).toBeTrue();
				expect( fileExists( root & "/site/index.html" ) ).toBeFalse();
				expect( fileExists( root & "/site/assets/theme/style.css" ) ).toBeFalse();

				var index = jsonDeserialize( fileRead( root & "/site/search-index.json" ) );
				expect( index[ 1 ].title ).toBe( "Home" );
			} );

			it( "buildSearchIndex() reports skipped without writing anything when search is disabled", function() {
				var root = newProject();
				fileWrite(
					root & "/bxdocs.json",
					'{"name":"Test Site","theme":{"name":"bootstrap"},"search":false}'
				);
				fileWrite( root & "/docs/index.md", "Welcome home" );

				var result = pipeline.buildSearchIndex( root );

				expect( result.skipped ).toBeTrue();
				expect( fileExists( root & "/site/search-index.json" ) ).toBeFalse();
			} );

			it( "renders an in-page table of contents from the page's own headings", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", '<h2 id="install">Install</h2>' & char( 10 ) & '<h3 id="prereqs">Prereqs</h3>' );

				pipeline.build( root );

				var html = fileRead( root & "/site/index.html" );
				expect( html ).toInclude( "On this page" );
				expect( html ).toInclude( 'href="##install"' );
				expect( html ).toInclude( ">Install<" );
				expect( html ).toInclude( 'href="##prereqs"' );
			} );

			it( "links prev/next pages in nav reading order", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "---" & char( 10 ) & "title: Home" & char( 10 ) & "order: 1" & char( 10 ) & "---" & char( 10 ) & "Home body" );
				fileWrite( root & "/docs/middle.md", "---" & char( 10 ) & "title: Middle" & char( 10 ) & "order: 2" & char( 10 ) & "---" & char( 10 ) & "Middle body" );
				fileWrite( root & "/docs/last.md", "---" & char( 10 ) & "title: Last" & char( 10 ) & "order: 3" & char( 10 ) & "---" & char( 10 ) & "Last body" );

				pipeline.build( root );

				var homeHtml = fileRead( root & "/site/index.html" );
				expect( homeHtml ).notToInclude( "page-nav__prev" );
				expect( homeHtml ).toInclude( "Middle" );

				var middleHtml = fileRead( root & "/site/middle/index.html" );
				expect( middleHtml ).toInclude( "Home" );
				expect( middleHtml ).toInclude( "Last" );

				var lastHtml = fileRead( root & "/site/last/index.html" );
				expect( lastHtml ).toInclude( "Middle" );
				expect( lastHtml ).notToInclude( "page-nav__next" );
			} );

			it( "writes a themed 404.html", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "Home" );

				pipeline.build( root );

				expect( fileExists( root & "/site/404.html" ) ).toBeTrue();
				var html = fileRead( root & "/site/404.html" );
				expect( html ).toInclude( "Page Not Found" );
				expect( html ).toInclude( "Test Site" );
			} );

			it( "throws BxDocs.ConfigNotFound when the project has no bxdocs.json", function() {
				var root = createTempDirectory( prefix = "bxdocs-buildpipeline-noconfig-" );
				tempDirs.append( root );
				directoryCreate( root & "/docs", true, true );

				expect( function() {
					pipeline.build( root );
				} ).toThrow( "BxDocs.ConfigNotFound" );
			} );

			it( "prefixes every internal link with a path-only baseURL override", function() {
				var root = newProject();
				fileWrite(
					root & "/bxdocs.json",
					'{"name":"Test Site","theme":{"name":"bootstrap"},"baseURL":"my-docs"}'
				);
				fileWrite( root & "/docs/index.md", "Home" );
				directoryCreate( root & "/docs/guides", true, true );
				fileWrite( root & "/docs/guides/setup.md", "---" & char( 10 ) & "title: Setup" & char( 10 ) & "---" & char( 10 ) & "Setup body" );

				pipeline.build( root );

				var homeHtml = fileRead( root & "/site/index.html" );
				expect( homeHtml ).toInclude( 'href="/my-docs/guides/setup/index.html"' );
				expect( homeHtml ).toInclude( 'href="/my-docs/assets/theme/style.css"' );
			} );

			it( "writes sitemap.xml with absolute URLs only when baseURL is a full URL", function() {
				var root = newProject();
				fileWrite(
					root & "/bxdocs.json",
					'{"name":"Test Site","theme":{"name":"bootstrap"},"baseURL":"https://docs.example.com/"}'
				);
				fileWrite( root & "/docs/index.md", "Home" );

				pipeline.build( root );

				expect( fileExists( root & "/site/sitemap.xml" ) ).toBeTrue();
				var xml = fileRead( root & "/site/sitemap.xml" );
				expect( xml ).toInclude( "<loc>https://docs.example.com/index.html</loc>" );
			} );

			it( "skips sitemap.xml when baseURL has no absolute URL", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "Home" );

				pipeline.build( root );

				expect( fileExists( root & "/site/sitemap.xml" ) ).toBeFalse();
			} );

			it( "always writes llms.txt, falling back to basePath when baseURL has no absolute URL", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "---" & char( 10 ) & "title: Home" & char( 10 ) & "---" & char( 10 ) & "Welcome" );

				pipeline.build( root );

				expect( fileExists( root & "/site/llms.txt" ) ).toBeTrue();
				var txt = fileRead( root & "/site/llms.txt" );
				expect( txt ).toInclude( "Test Site" );
				expect( txt ).toInclude( "(/index.html)" );
			} );

			it( "writes site/tags/index.html grouping pages by frontmatter tags, only when at least one page has tags", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "Home" );

				pipeline.build( root );

				expect( fileExists( root & "/site/tags/index.html" ) ).toBeFalse();

				var taggedRoot = newProject();
				fileWrite(
					taggedRoot & "/docs/index.md",
					"---" & char( 10 ) & "title: Home" & char( 10 ) & "tags: [cli, guide]" & char( 10 ) & "---" & char( 10 ) & "Welcome"
				);

				pipeline.build( taggedRoot );

				expect( fileExists( taggedRoot & "/site/tags/index.html" ) ).toBeTrue();
				var tagsHtml = fileRead( taggedRoot & "/site/tags/index.html" );
				expect( tagsHtml ).toInclude( '<h2 id="tag-cli">cli</h2>' );
				expect( tagsHtml ).toInclude( '<a href="/index.html">Home</a>' );

				var homeHtml = fileRead( taggedRoot & "/site/index.html" );
				expect( homeHtml ).toInclude( 'href="/tags/index.html##tag-cli"' );
			} );

			it( "copies the shared copy-code.js widget regardless of whether search is enabled", function() {
				var root = newProject();
				fileWrite(
					root & "/bxdocs.json",
					'{"name":"Test Site","theme":{"name":"bootstrap"},"search":false}'
				);
				fileWrite( root & "/docs/index.md", "Home" );

				pipeline.build( root );

				expect( fileExists( root & "/site/assets/copy-code.js" ) ).toBeTrue();
				var html = fileRead( root & "/site/index.html" );
				expect( html ).toInclude( "assets/copy-code.js" );
			} );

			it( "self-hosts the theme's webfonts under site/assets/fonts, with no fonts.googleapis.com reference anywhere in the page", function() {
				for ( var themeName in [ "bootstrap", "material", "tailwind" ] ) {
					var root = newProject( themeName );
					fileWrite( root & "/docs/index.md", "Home" );

					pipeline.build( root );

					expect( directoryExists( root & "/site/assets/fonts" ) ).toBeTrue();
					expect( directoryList( root & "/site/assets/fonts", false, "name", "*.woff2" ).len() ).toBeGT( 0 );

					var html = fileRead( root & "/site/index.html" );
					expect( html ).notToInclude( "fonts.googleapis.com" );
					expect( html ).notToInclude( "fonts.gstatic.com" );

					var css = fileRead( root & "/site/assets/theme/style.css" );
					expect( css ).toInclude( "@font-face" );
					expect( css ).toInclude( "../fonts/" );
				}
			} );

			it( "copies the shared highlight-boxlang.js grammar and loads it before hljs.highlightAll()", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "Home" );

				pipeline.build( root );

				expect( fileExists( root & "/site/assets/highlight-boxlang.js" ) ).toBeTrue();
				var html = fileRead( root & "/site/index.html" );
				var scriptPos = html.findNoCase( "assets/highlight-boxlang.js" );
				var highlightAllPos = html.findNoCase( "hljs.highlightAll" );
				expect( scriptPos ).toBeGT( 0 );
				expect( scriptPos ).toBeLT( highlightAllPos );
			} );

			it( "copies the shared admonition-collapse.js widget regardless of whether search is enabled", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "Home" );

				pipeline.build( root );

				expect( fileExists( root & "/site/assets/admonition-collapse.js" ) ).toBeTrue();
				var html = fileRead( root & "/site/index.html" );
				expect( html ).toInclude( "assets/admonition-collapse.js" );
			} );

			it( "renders mermaid.js and its init script only when [mermaid] is enabled, across every built-in theme", function() {
				for ( var themeName in [ "bootstrap", "material", "tailwind" ] ) {
					var root = newProject( themeName );
					fileWrite( root & "/docs/index.md", "Home" );
					pipeline.build( root );

					var offHtml = fileRead( root & "/site/index.html" );
					expect( offHtml ).notToInclude( "mermaid" );
					expect( fileExists( root & "/site/assets/mermaid-init.js" ) ).toBeFalse();

					var mermaidRoot = newProject( themeName );
					fileWrite(
						mermaidRoot & "/bxdocs.json",
						'{"name":"Test Site","theme":{"name":"' & themeName & '"},"mermaid":true}'
					);
					fileWrite( mermaidRoot & "/docs/index.md", "Home" );
					pipeline.build( mermaidRoot );

					var onHtml = fileRead( mermaidRoot & "/site/index.html" );
					expect( onHtml ).toInclude( "mermaid.min.js" );
					expect( onHtml ).toInclude( "assets/mermaid-init.js" );
					expect( fileExists( mermaidRoot & "/site/assets/mermaid-init.js" ) ).toBeTrue();
				}
			} );

			it( "copies the shared tabs.js and code-lines.js widgets unconditionally, loading code-lines.js after hljs.highlightAll()", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "Home" );

				pipeline.build( root );

				expect( fileExists( root & "/site/assets/tabs.js" ) ).toBeTrue();
				expect( fileExists( root & "/site/assets/code-lines.js" ) ).toBeTrue();

				var html = fileRead( root & "/site/index.html" );
				expect( html ).toInclude( "assets/tabs.js" );
				var codeLinesPos = html.findNoCase( "assets/code-lines.js" );
				var highlightAllPos = html.findNoCase( "hljs.highlightAll" );
				expect( codeLinesPos ).toBeGT( highlightAllPos );
			} );

			it( "converts a === ""Title"" content tab block into a tab widget, rendering each tab's own markdown", function() {
				var root = newProject();
				fileWrite(
					root & "/docs/index.md",
					'=== "Java"' & char( 10 ) & "    hello java" & char( 10 ) & char( 10 ) &
						'=== "BoxLang"' & char( 10 ) & "    hello bx"
				);

				pipeline.build( root );

				var html = fileRead( root & "/site/index.html" );
				expect( html ).toInclude( 'class="bxdocs-tabs" data-bxdocs-tabgroup' );
				expect( html ).toInclude( ">Java</button>" );
				expect( html ).toInclude( ">BoxLang</button>" );
				expect( html ).toInclude( "<p>hello java</p>" );
				expect( html ).toInclude( "<p>hello bx</p>" );
				expect( html ).notToInclude( "data-bxdocs-token" );
			} );

			it( "loads KaTeX and restores literal math formula text only when [math] is enabled, across every built-in theme", function() {
				var expectedFormula = encodeForHTML( "$e^{i\pi}+1=0$" );

				for ( var themeName in [ "bootstrap", "material", "tailwind" ] ) {
					var root = newProject( themeName );
					fileWrite( root & "/docs/index.md", 'Euler: $e^{i\pi}+1=0$ here.' );
					pipeline.build( root );

					var offHtml = fileRead( root & "/site/index.html" );
					expect( offHtml ).notToInclude( "katex" );
					expect( fileExists( root & "/site/assets/math-init.js" ) ).toBeFalse();
					expect( offHtml ).toInclude( expectedFormula );

					var mathRoot = newProject( themeName );
					fileWrite(
						mathRoot & "/bxdocs.json",
						'{"name":"Test Site","theme":{"name":"' & themeName & '"},"math":true}'
					);
					fileWrite( mathRoot & "/docs/index.md", 'Euler: $e^{i\pi}+1=0$ here.' );
					pipeline.build( mathRoot );

					var onHtml = fileRead( mathRoot & "/site/index.html" );
					expect( onHtml ).toInclude( "katex.min.css" );
					expect( onHtml ).toInclude( "katex.min.js" );
					expect( onHtml ).toInclude( "assets/math-init.js" );
					expect( onHtml ).toInclude( expectedFormula );
					expect( fileExists( mathRoot & "/site/assets/math-init.js" ) ).toBeTrue();
				}
			} );

			it( "runs a plugin's onConfig/onPageMarkdown/onPageHtml/onNav/onBuildComplete hooks in the pipeline, via the setPlugins() test seam", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "Home" );

				var fakePlugin = {
					onConfig : function( required struct config ) {
						arguments.config.pluginTouchedConfig = true;
						return arguments.config;
					},
					onPageMarkdown : function( required string markdown, required struct page, required struct config ) {
						return arguments.markdown & char( 10 ) & "Injected line.";
					},
					onPageHtml : function( required string html, required struct page, required struct config ) {
						return arguments.html & "<!--plugin-html-->";
					},
					onNav : function( required array nav, required struct config ) {
						arguments.nav.append( { title : "Plugin Page", url : "plugin.html", order : 0, children : [] } );
						return arguments.nav;
					},
					onBuildComplete : function( required string siteDir, required struct config ) {
						fileWrite( arguments.siteDir & "/plugin-marker.txt", "built" );
					}
				};
				pipeline.setPlugins( [ { name : "fake", instance : fakePlugin } ] );

				var result = pipeline.build( root );

				var html = fileRead( root & "/site/index.html" );
				expect( html ).toInclude( "Injected line." );
				expect( html ).toInclude( "<!--plugin-html-->" );
				expect( html ).toInclude( "Plugin Page" );
				expect( fileExists( root & "/site/plugin-marker.txt" ) ).toBeTrue();
			} );

			it( "throws BxDocs.PluginNotFound when bxdocs.json [plugins] names an uninstalled module, without the setPlugins() seam", function() {
				var root = newProject();
				fileWrite(
					root & "/bxdocs.json",
					'{"name":"Test Site","plugins":["someUnknownModule"]}'
				);
				fileWrite( root & "/docs/index.md", "Home" );

				expect( function() {
					pipeline.build( root );
				} ).toThrow( "BxDocs.PluginNotFound" );
			} );

			it( "uses bxdocs.json's [nav] array as the nav tree, in its own order, instead of folder inference", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "Home" );
				fileWrite( root & "/docs/about.md", "About" );
				fileWrite(
					root & "/bxdocs.json",
					'{"name":"Test Site","theme":{"name":"bootstrap"},"nav":[{"path":"about.md"},{"path":"index.md"}]}'
				);

				pipeline.build( root );

				var html = fileRead( root & "/site/index.html" );
				expect( html ).toInclude( 'href="/about/index.html">About</a>' );
				expect( html.findNoCase( ">About<" ) ).toBeLT( html.findNoCase( ">Index<" ) );
			} );

			it( "uses a docs/nav.json file as the nav tree when bxdocs.json's [nav] is empty", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "Home" );
				directoryCreate( root & "/docs/guides", true, true );
				fileWrite( root & "/docs/guides/setup.md", "Setup" );
				fileWrite(
					root & "/docs/nav.json",
					'[{"path":"index.md"},{"title":"Guides","children":[{"title":"Setup Guide","path":"guides/setup.md"}]}]'
				);

				pipeline.build( root );

				var html = fileRead( root & "/site/index.html" );
				expect( html ).toInclude( "Setup Guide" );
				expect( html ).notToInclude( ">Setup<" );
			} );

			it( "throws BxDocs.InvalidConfig for a docs/nav.json entry referencing a nonexistent page", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "Home" );
				fileWrite( root & "/docs/nav.json", '["does-not-exist.md"]' );

				expect( function() {
					pipeline.build( root );
				} ).toThrow( "BxDocs.InvalidConfig" );
			} );

			it( "renders breadcrumbs for a nested page under a linked ancestor but not for a top-level page", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "Home" );
				directoryCreate( root & "/docs/guides", true, true );
				fileWrite( root & "/docs/guides/index.md", "---" & char( 10 ) & "title: Guides" & char( 10 ) & "---" & char( 10 ) & "Guides body" );
				fileWrite( root & "/docs/guides/setup.md", "---" & char( 10 ) & "title: Setup" & char( 10 ) & "---" & char( 10 ) & "Setup body" );

				pipeline.build( root );

				var homeHtml = fileRead( root & "/site/index.html" );
				expect( homeHtml ).notToInclude( "breadcrumb-nav" );

				var setupHtml = fileRead( root & "/site/guides/setup/index.html" );
				expect( setupHtml ).toInclude( "breadcrumb-nav" );
				expect( setupHtml ).toInclude( ">Guides<" );
				expect( setupHtml ).toInclude( ">Setup<" );
			} );

			it( "leaves og:image untouched (site-wide ogImage or none) when [generateOgImages] is off (the default)", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "Home" );

				pipeline.build( root );

				expect( fileExists( root & "/site/assets/og" ) ).toBeFalse();
				var html = fileRead( root & "/site/index.html" );
				expect( html ).notToInclude( "og:image" );
			} );

			it( "generates a per-page og:image PNG per page when [generateOgImages] is on", function() {
				var root = newProject();
				fileWrite(
					root & "/bxdocs.json",
					'{"name":"Test Site","theme":{"name":"bootstrap"},"generateOgImages":true}'
				);
				fileWrite( root & "/docs/index.md", "---" & char( 10 ) & "title: Home" & char( 10 ) & "---" & char( 10 ) & "Welcome" );
				directoryCreate( root & "/docs/guides", true, true );
				fileWrite( root & "/docs/guides/setup.md", "Setup" );

				pipeline.build( root );

				expect( fileExists( root & "/site/assets/og/home.png" ) ).toBeTrue();
				expect( fileExists( root & "/site/assets/og/guides-setup.png" ) ).toBeTrue();

				var html = fileRead( root & "/site/index.html" );
				expect( html ).toInclude( '<meta property="og:image" content="/assets/og/home.png">' );
			} );

			it( "prefers a page's own frontmatter [ogImage] over auto-generating one", function() {
				var root = newProject();
				fileWrite(
					root & "/bxdocs.json",
					'{"name":"Test Site","theme":{"name":"bootstrap"},"generateOgImages":true}'
				);
				fileWrite(
					root & "/docs/index.md",
					"---" & char( 10 ) & "title: Home" & char( 10 ) & "ogImage: assets/custom-card.png" & char( 10 ) & "---" & char( 10 ) & "Welcome"
				);

				pipeline.build( root );

				expect( fileExists( root & "/site/assets/og/home.png" ) ).toBeFalse();
				var html = fileRead( root & "/site/index.html" );
				expect( html ).toInclude( '<meta property="og:image" content="/assets/custom-card.png">' );
			} );

			it( "renders a repo link when [repo.url] is configured, and none when it isn't", function() {
				var root = newProject();
				fileWrite(
					root & "/bxdocs.json",
					'{"name":"Test Site","theme":{"name":"bootstrap"},"repo":{"url":"https://github.com/acme/docs"}}'
				);
				fileWrite( root & "/docs/index.md", "Home" );

				pipeline.build( root );

				var html = fileRead( root & "/site/index.html" );
				expect( html ).toInclude( "repo-link" );
				expect( html ).toInclude( "github.com" );
				expect( html ).toInclude( "acme" );
			} );

			it( "omits the repo link when [repo.url] isn't configured", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "Home" );

				pipeline.build( root );

				var html = fileRead( root & "/site/index.html" );
				expect( html ).notToInclude( "repo-link" );
			} );

			it( "computes editUrl from [repo.url] + [repo.editUri] + the page's relative path", function() {
				var root = newProject();
				fileWrite(
					root & "/bxdocs.json",
					'{"name":"Test Site","theme":{"name":"bootstrap"},"repo":{"url":"https://github.com/acme/docs","editUri":"edit/main/docs/"}}'
				);
				directoryCreate( root & "/docs/guides", true, true );
				fileWrite( root & "/docs/guides/setup.md", "---" & char( 10 ) & "title: Setup" & char( 10 ) & "---" & char( 10 ) & "Setup body" );

				pipeline.build( root );

				var html = fileRead( root & "/site/guides/setup/index.html" );
				expect( html ).toInclude( "github.com" );
				expect( html ).toInclude( "edit" );
				expect( html ).toInclude( "guides" );
				expect( html ).toInclude( "setup.md" );
				expect( html ).toInclude( "Edit this page" );
			} );

			it( "omits the edit link when [repo.url] is set but [repo.editUri] isn't", function() {
				var root = newProject();
				fileWrite(
					root & "/bxdocs.json",
					'{"name":"Test Site","theme":{"name":"bootstrap"},"repo":{"url":"https://github.com/acme/docs"}}'
				);
				fileWrite( root & "/docs/index.md", "Home" );

				pipeline.build( root );

				var html = fileRead( root & "/site/index.html" );
				expect( html ).notToInclude( "Edit this page" );
			} );

			it( "renders a footer with social links and copyright only when [footer] is enabled", function() {
				var root = newProject();
				fileWrite(
					root & "/bxdocs.json",
					'{"name":"Test Site","theme":{"name":"bootstrap"},"footer":true,"social":[{"url":"https://twitter.com/acme","icon":"twitter","label":"Twitter"}]}'
				);
				fileWrite( root & "/docs/index.md", "Home" );

				pipeline.build( root );

				var html = fileRead( root & "/site/index.html" );
				expect( html ).toInclude( "bxdocs-footer" );
				expect( html ).toInclude( "social-link" );
				expect( html ).toInclude( "twitter.com" );
				expect( html ).toInclude( "Test Site" );
			} );

			it( "omits the footer entirely when [footer] is off (the default)", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "Home" );

				pipeline.build( root );

				var html = fileRead( root & "/site/index.html" );
				expect( html ).notToInclude( "bxdocs-footer" );
			} );

			it( "omits lastUpdated when the [lastUpdated] option is off (the default)", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "Home" );

				pipeline.build( root );

				var html = fileRead( root & "/site/index.html" );
				expect( html ).notToInclude( "Last updated" );
			} );

			it( "builds each docs/versions/* folder as its own tree under site/versions/*, alongside the main build", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "Latest home" );
				directoryCreate( root & "/docs/versions/1.0", true, true );
				fileWrite( root & "/docs/versions/1.0/index.md", "1.0 home" );
				directoryCreate( root & "/docs/versions/2.0", true, true );
				fileWrite( root & "/docs/versions/2.0/index.md", "2.0 home" );

				var result = pipeline.build( root );

				expect( result.pageCount ).toBe( 1 );
				expect( fileExists( root & "/site/index.html" ) ).toBeTrue();
				expect( fileExists( root & "/site/versions/1.0/index.html" ) ).toBeTrue();
				expect( fileExists( root & "/site/versions/2.0/index.html" ) ).toBeTrue();

				var mainHtml = fileRead( root & "/site/index.html" );
				expect( mainHtml ).toInclude( "Latest home" );
				expect( mainHtml ).notToInclude( "1.0 home" );

				var v1Html = fileRead( root & "/site/versions/1.0/index.html" );
				expect( v1Html ).toInclude( "1.0 home" );

				var v2Html = fileRead( root & "/site/versions/2.0/index.html" );
				expect( v2Html ).toInclude( "2.0 home" );
			} );

			it( "prefixes a version build's internal links with its own versions/<name>/ basePath", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "Latest home" );
				directoryCreate( root & "/docs/versions/1.0/guides", true, true );
				fileWrite( root & "/docs/versions/1.0/index.md", "1.0 home" );
				fileWrite( root & "/docs/versions/1.0/guides/setup.md", "---" & char( 10 ) & "title: Setup" & char( 10 ) & "---" & char( 10 ) & "Setup body" );

				pipeline.build( root );

				var v1Html = fileRead( root & "/site/versions/1.0/index.html" );
				expect( v1Html ).toInclude( 'href="/versions/1.0/guides/setup/index.html"' );
				expect( v1Html ).toInclude( 'href="/versions/1.0/assets/theme/style.css"' );

				var mainHtml = fileRead( root & "/site/index.html" );
				expect( mainHtml ).toInclude( 'href="/assets/theme/style.css"' );
				expect( mainHtml ).notToInclude( "/versions/1.0/guides" );
			} );

			it( "renders a version switcher with the current version selected when docs/versions/* exist, and none when there aren't any", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "Latest home" );
				directoryCreate( root & "/docs/versions/1.0", true, true );
				fileWrite( root & "/docs/versions/1.0/index.md", "1.0 home" );

				pipeline.build( root );

				var mainHtml = fileRead( root & "/site/index.html" );
				expect( mainHtml ).toInclude( "version-switcher" );
				expect( mainHtml ).toInclude( ">Latest<" );
				expect( mainHtml ).toInclude( ">1.0<" );

				var v1Html = fileRead( root & "/site/versions/1.0/index.html" );
				expect( v1Html ).toInclude( "version-switcher" );

				var unversionedRoot = newProject();
				fileWrite( unversionedRoot & "/docs/index.md", "Home" );
				pipeline.build( unversionedRoot );
				var unversionedHtml = fileRead( unversionedRoot & "/site/index.html" );
				expect( unversionedHtml ).notToInclude( "version-switcher" );
			} );

			it( "computes editUrl and lastUpdated for a versioned page relative to its own docs/versions/<name>/ folder", function() {
				var root = newProject();
				fileWrite(
					root & "/bxdocs.json",
					'{"name":"Test Site","theme":{"name":"bootstrap"},"repo":{"url":"https://github.com/acme/docs","editUri":"edit/main/docs/"}}'
				);
				fileWrite( root & "/docs/index.md", "Latest home" );
				directoryCreate( root & "/docs/versions/1.0", true, true );
				fileWrite( root & "/docs/versions/1.0/index.md", "1.0 home" );

				pipeline.build( root );

				var v1Html = fileRead( root & "/site/versions/1.0/index.html" );
				expect( v1Html ).toInclude( "Edit this page" );
				expect( v1Html ).toInclude( "versions" );
				expect( v1Html ).toInclude( "1.0" );
			} );

			it( "includes version pages in sitemap.xml and llms.txt alongside the main tree", function() {
				var root = newProject();
				fileWrite(
					root & "/bxdocs.json",
					'{"name":"Test Site","theme":{"name":"bootstrap"},"baseURL":"https://docs.example.com/"}'
				);
				fileWrite( root & "/docs/index.md", "Latest home" );
				directoryCreate( root & "/docs/versions/1.0", true, true );
				fileWrite( root & "/docs/versions/1.0/index.md", "1.0 home" );

				pipeline.build( root );

				var sitemap = fileRead( root & "/site/sitemap.xml" );
				expect( sitemap ).toInclude( "<loc>https://docs.example.com/index.html</loc>" );
				expect( sitemap ).toInclude( "<loc>https://docs.example.com/versions/1.0/index.html</loc>" );

				var llms = fileRead( root & "/site/llms.txt" );
				expect( llms ).toInclude( "(https://docs.example.com/index.html)" );
				expect( llms ).toInclude( "(https://docs.example.com/versions/1.0/index.html)" );
			} );

			it( "ignores loose files directly under docs/versions/ and only builds its subfolders", function() {
				var root = newProject();
				fileWrite( root & "/docs/index.md", "Latest home" );
				directoryCreate( root & "/docs/versions", true, true );
				fileWrite( root & "/docs/versions/README.md", "not a version" );
				directoryCreate( root & "/docs/versions/1.0", true, true );
				fileWrite( root & "/docs/versions/1.0/index.md", "1.0 home" );

				var result = pipeline.build( root );

				expect( result.pageCount ).toBe( 1 );
				expect( fileExists( root & "/site/versions/1.0/index.html" ) ).toBeTrue();
				expect( directoryExists( root & "/site/versions/README.md" ) ).toBeFalse();
				expect( fileExists( root & "/site/versions/README.md" ) ).toBeFalse();
			} );

		} );
	}

}
