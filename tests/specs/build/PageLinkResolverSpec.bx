class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "build.PageLinkResolver", function() {

			beforeEach( function() {
				variables.resolver = new "models.build.PageLinkResolver@bxdocs"();
			} );

			it( "enriches a page-link stub with its target page's title/icon/summary", function() {
				var pages = [
					{
						urlPath : "index.html",
						contentHtml : '<a class="bxdocs-page-link" href="/guides/themes/index.html" data-bxdocs-page-link><span class="bxdocs-page-link__title">/guides/themes/index.html</span></a>'
					},
					{ urlPath : "guides/themes/index.html", title : "Themes", icon : "🎨", summary : "Customize the look." }
				];

				resolver.resolve( pages, "/" );

				expect( pages[ 1 ].contentHtml ).toInclude( '<span class="bxdocs-page-link__icon">🎨</span>' );
				expect( pages[ 1 ].contentHtml ).toInclude( '<span class="bxdocs-page-link__title">Themes</span>' );
				expect( pages[ 1 ].contentHtml ).toInclude( '<span class="bxdocs-page-link__summary">Customize the look.</span>' );
			} );

			it( "falls back to a page's description when it has no summary", function() {
				var pages = [
					{
						urlPath : "index.html",
						contentHtml : '<a class="bxdocs-page-link" href="/guides/themes/index.html" data-bxdocs-page-link><span class="bxdocs-page-link__title">x</span></a>'
					},
					{ urlPath : "guides/themes/index.html", title : "Themes", icon : "", summary : "", description : "A description." }
				];

				resolver.resolve( pages, "/" );

				expect( pages[ 1 ].contentHtml ).toInclude( '<span class="bxdocs-page-link__summary">A description.</span>' );
			} );

			it( "leaves a stub untouched when its href doesn't match any page (dead link)", function() {
				var original = '<a class="bxdocs-page-link" href="/nowhere/index.html" data-bxdocs-page-link><span class="bxdocs-page-link__title">/nowhere/index.html</span></a>';
				var pages = [ { urlPath : "index.html", contentHtml : original } ];

				resolver.resolve( pages, "/" );

				expect( pages[ 1 ].contentHtml ).toBe( original );
			} );

			it( "is a no-op on a page with no page-link stubs at all", function() {
				var pages = [ { urlPath : "index.html", contentHtml : "<p>Nothing here.</p>" } ];

				resolver.resolve( pages, "/" );

				expect( pages[ 1 ].contentHtml ).toBe( "<p>Nothing here.</p>" );
			} );

			it( "resolves stubs correctly under a non-root basePath", function() {
				var pages = [
					{
						urlPath : "index.html",
						contentHtml : '<a class="bxdocs-page-link" href="/my-docs/guides/themes/index.html" data-bxdocs-page-link><span class="bxdocs-page-link__title">x</span></a>'
					},
					{ urlPath : "guides/themes/index.html", title : "Themes" }
				];

				resolver.resolve( pages, "/my-docs/" );

				expect( pages[ 1 ].contentHtml ).toInclude( '<span class="bxdocs-page-link__title">Themes</span>' );
			} );

		} );
	}

}
