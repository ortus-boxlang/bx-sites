class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "build.FunctionsLoader", function() {

			beforeEach( function() {
				variables.loader = new "models.build.FunctionsLoader@bxsites"();
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			private function newDocsDir() {
				var dir = createTempDirectory( prefix = "bxsites-functionsloader-" );
				tempDirs.append( dir );
				return dir;
			}

			it( "returns an empty struct when functions.bxs doesn't exist", function() {
				var dir = newDocsDir();
				var result = loader.load( dir );
				expect( result ).toBeStruct();
				expect( result.isEmpty() ).toBeTrue();
			} );

			it( "loads a single $-prefixed function, callable by its own key", function() {
				var dir = newDocsDir();
				fileWrite( dir & "/functions.bxs", 'function $greet( name ) { return "Hi " & arguments.name }' );

				var result = loader.load( dir );
				expect( result.keyExists( "$greet" ) ).toBeTrue();
				expect( result[ "$greet" ]( "World" ) ).toBe( "Hi World" );
			} );

			it( "loads more than one $-prefixed function from the same file", function() {
				var dir = newDocsDir();
				fileWrite(
					dir & "/functions.bxs",
					'function $greet( name ) { return "Hi " & arguments.name }' & char( 10 ) &
					'function $shout( text ) { return uCase( arguments.text ) }'
				);

				var result = loader.load( dir );
				expect( result.keyExists( "$greet" ) ).toBeTrue();
				expect( result.keyExists( "$shout" ) ).toBeTrue();
				expect( result[ "$shout" ]( "loud" ) ).toBe( "LOUD" );
			} );

			it( "also returns a plain (non-$-prefixed) function declared in the same file", function() {
				var dir = newDocsDir();
				fileWrite(
					dir & "/functions.bxs",
					'function formatPrice( amount ) { return "$" & arguments.amount }' & char( 10 ) &
					'function $price( amount ) { return formatPrice( arguments.amount ) }'
				);

				var result = loader.load( dir );
				// A private, non-$ helper is still returned (not filtered
				// out) - a consumer needs it bound alongside its $-prefixed
				// caller for that caller's own bare-name resolution to
				// succeed once actually invoked (see FunctionsLoader.bx's
				// and FunctionScope.bx's own docblocks for why).
				expect( result.keyExists( "formatPrice" ) ).toBeTrue();
				expect( result.keyExists( "$price" ) ).toBeTrue();
			} );

			it( "throws BxSites.InvalidFunctions for a functions.bxs with a syntax error", function() {
				var dir = newDocsDir();
				fileWrite( dir & "/functions.bxs", "function $broken( { this is not valid BoxLang" );

				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxSites.InvalidFunctions" );
			} );

			it( "throws BxSites.InvalidFunctions when a function name collides with a reserved supporting variable", function() {
				var dir = newDocsDir();
				fileWrite( dir & "/functions.bxs", 'function page() { return "oops" }' );

				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxSites.InvalidFunctions" );
			} );

			it( "is safely repeatable on the same instance - an unchanged function survives a second load()", function() {
				// Regression test: load() used to leave its own newly-included
				// keys sitting in `variables` forever, so a second call on the
				// same instance (BuildPipeline's own long-lived singleton,
				// reused across every `bxSites serve` rebuild) would treat an
				// unchanged function as "not new" and silently drop it.
				var dir = newDocsDir();
				fileWrite( dir & "/functions.bxs", 'function $greet( name ) { return "Hi " & arguments.name }' );
				var first = loader.load( dir );
				expect( first.keyExists( "$greet" ) ).toBeTrue();

				fileWrite(
					dir & "/functions.bxs",
					'function $greet( name ) { return "Yo " & arguments.name }' & char( 10 ) &
					'function $newone( name ) { return "New " & arguments.name }'
				);
				var second = loader.load( dir );
				expect( second.keyExists( "$greet" ) ).toBeTrue();
				expect( second[ "$greet" ]( "B" ) ).toBe( "Yo B" );
				expect( second.keyExists( "$newone" ) ).toBeTrue();
			} );

			it( "leaves the instance usable after a load() that throws", function() {
				var dir = newDocsDir();
				fileWrite( dir & "/functions.bxs", 'function page() { return "oops" }' );
				expect( function() {
					loader.load( dir );
				} ).toThrow( "BxSites.InvalidFunctions" );

				var otherDir = newDocsDir();
				fileWrite( otherDir & "/functions.bxs", 'function $greet( name ) { return "Hi " & arguments.name }' );
				var result = loader.load( otherDir );
				expect( result.keyExists( "$greet" ) ).toBeTrue();
			} );

		} );
	}

}
