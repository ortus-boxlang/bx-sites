class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "build.ContentLinter", function() {

			beforeEach( function() {
				variables.linter = new "models.build.ContentLinter@bxdocs"();
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			private string function newDocsDir() {
				var dir = createTempDirectory( prefix = "bxdocs-contentlinter-" );
				tempDirs.append( dir );
				var docsDir = dir & "/docs";
				directoryCreate( docsDir, true, true );
				return docsDir;
			}

			it( "reports no issues for a clean docs tree", function() {
				var docsDir = newDocsDir();
				fileWrite( docsDir & "/clean.md", "#### Level Two

###### Level Three

All good." );

				var result = linter.lint( docsDir );

				expect( result.headingSkips.len() ).toBe( 0 );
				expect( result.blogDateIssues.len() ).toBe( 0 );
			} );

			it( "flags a heading level skip within a page's body", function() {
				var docsDir = newDocsDir();
				fileWrite( docsDir & "/skippy.md", "#### Level Two

######## Level Four (skipped three)" );

				var result = linter.lint( docsDir );

				expect( result.headingSkips.len() ).toBe( 1 );
				expect( result.headingSkips[ 1 ].page ).toBe( "skippy.md" );
				expect( result.headingSkips[ 1 ].from ).toBe( 2 );
				expect( result.headingSkips[ 1 ].to ).toBe( 4 );
			} );

			it( "ignores heading-looking lines inside a fenced code block", function() {
				var docsDir = newDocsDir();
				fileWrite( docsDir & "/withcode.md", "#### Heading

```bash
######## this is not a heading, just a shell comment
```

###### Real Next Heading" );

				var result = linter.lint( docsDir );

				expect( result.headingSkips.len() ).toBe( 0 );
			} );

			it( "flags a blog post with missing or invalid frontmatter date", function() {
				var docsDir = newDocsDir();
				var postsDir = docsDir & "/blog/posts";
				directoryCreate( postsDir, true, true );
				fileWrite( postsDir & "/no-date.md", "---
title: No Date Post
---
Body" );
				fileWrite( postsDir & "/bad-date.md", "---
title: Bad Date Post
date: not-a-real-date
---
Body" );
				fileWrite( postsDir & "/good.md", "---
title: Good Post
date: 2026-01-01
---
Body" );

				var result = linter.lint( docsDir );

				expect( result.blogDateIssues.len() ).toBe( 2 );
			} );

			it( "returns no blog date issues when docs/blog/posts/ doesn't exist", function() {
				var docsDir = newDocsDir();

				var result = linter.lint( docsDir );

				expect( result.blogDateIssues.len() ).toBe( 0 );
			} );

		} );
	}

}
