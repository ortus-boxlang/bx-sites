/**
 * Exercises MkdocsMigrator.bx directly against temp mkdocs/bx-docs project
 * directories - no CLI dispatch involved (see MigrateSpec.bx for that).
 */
class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "build.MkdocsMigrator", function() {

			beforeEach( function() {
				variables.migrator = new "models.build.MkdocsMigrator@bxdocs"();
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			private string function newMkdocsProject( string mkdocsYml = 'site_name: My Docs' ) {
				var dir = createTempDirectory( prefix = "bxdocs-mkdocs-source-" );
				tempDirs.append( dir );
				directoryCreate( dir & "/docs", true, true );
				fileWrite( dir & "/mkdocs.yml", arguments.mkdocsYml );
				return dir;
			}

			private string function newProjectRoot() {
				var dir = createTempDirectory( prefix = "bxdocs-mkdocs-project-" );
				tempDirs.append( dir );
				return dir;
			}

			it( "throws BxDocs.MigrateMissingMkdocsConfig when there's no mkdocs.yml", function() {
				var source = createTempDirectory( prefix = "bxdocs-mkdocs-empty-" );
				tempDirs.append( source );

				expect( function() {
					migrator.migrate( source, newProjectRoot() );
				} ).toThrow( "BxDocs.MigrateMissingMkdocsConfig" );
			} );

			it( "throws BxDocs.MigrateMissingDocsDir when mkdocs.yml's own docs_dir doesn't exist", function() {
				var source = createTempDirectory( prefix = "bxdocs-mkdocs-nodocsdir-" );
				tempDirs.append( source );
				fileWrite( source & "/mkdocs.yml", "site_name: My Docs" );

				expect( function() {
					migrator.migrate( source, newProjectRoot() );
				} ).toThrow( "BxDocs.MigrateMissingDocsDir" );
			} );

			it( "converts site_name/site_description/site_url/repo into bxdocs.json", function() {
				var source = newMkdocsProject(
					'site_name: My Docs' & char( 10 ) &
					'site_description: A great project' & char( 10 ) &
					'site_url: https://example.com/docs' & char( 10 ) &
					'repo_url: https://github.com/acme/docs' & char( 10 ) &
					'edit_uri: edit/main/docs/'
				);
				fileWrite( source & "/docs/index.md", "Welcome." );
				var projectRoot = newProjectRoot();

				var result = migrator.migrate( source, projectRoot );

				var config = jsonDeserialize( fileRead( result.configPath ) );
				expect( config.name ).toBe( "My Docs" );
				expect( config.description ).toBe( "A great project" );
				expect( config.baseURL ).toBe( "https://example.com/docs/" );
				expect( config.repo.url ).toBe( "https://github.com/acme/docs" );
				expect( config.repo.editUri ).toBe( "edit/main/docs/" );
				expect( result.pagesConverted ).toBe( 1 );
				expect( fileExists( projectRoot & "/docs/index.md" ) ).toBeTrue();
			} );

			it( "maps theme.name material to the bx-docs material theme, and falls back to bootstrap with a warning for anything else", function() {
				var materialSource = newMkdocsProject( "site_name: Docs" & char( 10 ) & "theme:" & char( 10 ) & "  name: material" );
				fileWrite( materialSource & "/docs/index.md", "Home" );
				var materialResult = migrator.migrate( materialSource, newProjectRoot() );
				expect( jsonDeserialize( fileRead( materialResult.configPath ) ).theme.name ).toBe( "material" );

				var customSource = newMkdocsProject( "site_name: Docs" & char( 10 ) & "theme:" & char( 10 ) & "  name: cinder" );
				fileWrite( customSource & "/docs/index.md", "Home" );
				var customResult = migrator.migrate( customSource, newProjectRoot() );
				expect( jsonDeserialize( fileRead( customResult.configPath ) ).theme.name ).toBe( "bootstrap" );
				expect( customResult.warnings.len() ).toBeGT( 0 );
			} );

			it( "maps footnotes/def_list/pymdownx.arithmatex markdown_extensions", function() {
				var source = newMkdocsProject(
					"site_name: Docs" & char( 10 ) &
					"markdown_extensions:" & char( 10 ) &
					"  - footnotes" & char( 10 ) &
					"  - def_list" & char( 10 ) &
					"  - pymdownx.arithmatex"
				);
				fileWrite( source & "/docs/index.md", "Home" );

				var result = migrator.migrate( source, newProjectRoot() );
				var config = jsonDeserialize( fileRead( result.configPath ) );

				expect( config.markdown.enableFootnotes ).toBeTrue();
				expect( config.markdown.enableDefinitionLists ).toBeTrue();
				expect( config.math ).toBeTrue();
			} );

			it( "reports an unmapped markdown_extensions/plugins entry as a warning, without failing the migration", function() {
				var source = newMkdocsProject(
					"site_name: Docs" & char( 10 ) &
					"markdown_extensions:" & char( 10 ) &
					"  - pymdownx.emoji" & char( 10 ) &
					"plugins:" & char( 10 ) &
					"  - awesome-pages"
				);
				fileWrite( source & "/docs/index.md", "Home" );

				var result = migrator.migrate( source, newProjectRoot() );

				expect( result.warnings.filter( w => w.findNoCase( "pymdownx.emoji" ) > 0 ).len() ).toBe( 1 );
				expect( result.warnings.filter( w => w.findNoCase( "awesome-pages" ) > 0 ).len() ).toBe( 1 );
			} );

			it( "does not warn about the search plugin or already-native-syntax extensions", function() {
				var source = newMkdocsProject(
					"site_name: Docs" & char( 10 ) &
					"markdown_extensions:" & char( 10 ) &
					"  - pymdownx.tabbed" & char( 10 ) &
					"  - pymdownx.superfences" & char( 10 ) &
					"plugins:" & char( 10 ) &
					"  - search"
				);
				fileWrite( source & "/docs/index.md", "Home" );

				var result = migrator.migrate( source, newProjectRoot() );

				expect( result.warnings.len() ).toBe( 0 );
			} );

			it( "converts nav: into docs/nav.json, including a nested group", function() {
				var source = newMkdocsProject(
					"site_name: Docs" & char( 10 ) &
					"nav:" & char( 10 ) &
					"  - Home: index.md" & char( 10 ) &
					"  - Guide:" & char( 10 ) &
					"      - Setup: guide/setup.md" & char( 10 ) &
					"  - about.md"
				);
				fileWrite( source & "/docs/index.md", "Home" );
				directoryCreate( source & "/docs/guide", true, true );
				fileWrite( source & "/docs/guide/setup.md", "Setup" );
				fileWrite( source & "/docs/about.md", "About" );

				var result = migrator.migrate( source, newProjectRoot() );
				var nav = jsonDeserialize( fileRead( result.navPath ) );

				expect( nav.len() ).toBe( 3 );
				expect( nav[ 1 ].title ).toBe( "Home" );
				expect( nav[ 1 ].path ).toBe( "index.md" );
				expect( nav[ 2 ].title ).toBe( "Guide" );
				expect( nav[ 2 ].children[ 1 ].title ).toBe( "Setup" );
				expect( nav[ 2 ].children[ 1 ].path ).toBe( "guide/setup.md" );
				expect( nav[ 3 ].title ).toBe( "" );
				expect( nav[ 3 ].path ).toBe( "about.md" );
			} );

			it( "relocates a non-.md asset into docs/assets/mkdocs/ and rewrites its reference, depth-correctly", function() {
				var source = newMkdocsProject();
				directoryCreate( source & "/docs/guide/img", true, true );
				fileWrite( source & "/docs/guide/img/diagram.png", "fake-png-bytes" );
				fileWrite( source & "/docs/guide/setup.md", "![Diagram](img/diagram.png)" );

				var projectRoot = newProjectRoot();
				var result = migrator.migrate( source, projectRoot );

				expect( result.assetsConverted ).toBe( 1 );
				expect( fileExists( projectRoot & "/docs/assets/mkdocs/guide/img/diagram.png" ) ).toBeTrue();

				var converted = fileRead( projectRoot & "/docs/guide/setup.md" );
				expect( converted ).toInclude( "](../assets/mkdocs/guide/img/diagram.png)" );
			} );

			it( "leaves a .md link, an external URL, and an in-page anchor untouched", function() {
				var source = newMkdocsProject();
				fileWrite( source & "/docs/index.md", "[Setup](guide/setup.md) [Ortus](https://ortussolutions.com) [Top](##top)" );

				var projectRoot = newProjectRoot();
				migrator.migrate( source, projectRoot );

				var converted = fileRead( projectRoot & "/docs/index.md" );
				expect( converted ).toInclude( "(guide/setup.md)" );
				expect( converted ).toInclude( "(https://ortussolutions.com)" );
				expect( converted ).toInclude( "(##top)" );
			} );

			it( "copies admonition/tab/math syntax through completely unchanged - it's already bx-docs' own native syntax", function() {
				var source = newMkdocsProject();
				var body = '!!! note "Heads up"' & char( 10 ) & "    Body text." & char( 10 ) & char( 10 ) &
					'=== "Tab A"' & char( 10 ) & "    Content." & char( 10 ) & char( 10 ) &
					"Inline math: $x^2$";
				fileWrite( source & "/docs/index.md", body );

				var projectRoot = newProjectRoot();
				migrator.migrate( source, projectRoot );

				expect( fileRead( projectRoot & "/docs/index.md" ) ).toBe( body );
			} );

			it( "warns and overwrites when bxdocs.json/docs/nav.json already exist", function() {
				var source = newMkdocsProject( "site_name: Docs" & char( 10 ) & "nav:" & char( 10 ) & "  - Home: index.md" );
				fileWrite( source & "/docs/index.md", "Home" );

				var projectRoot = newProjectRoot();
				fileWrite( projectRoot & "/bxdocs.json", '{"name":"Old"}' );
				directoryCreate( projectRoot & "/docs", true, true );
				fileWrite( projectRoot & "/docs/nav.json", "[]" );

				var result = migrator.migrate( source, projectRoot );

				expect( result.warnings.filter( w => w.findNoCase( "bxdocs.json already existed" ) > 0 ).len() ).toBe( 1 );
				expect( result.warnings.filter( w => w.findNoCase( "nav.json already existed" ) > 0 ).len() ).toBe( 1 );
				expect( jsonDeserialize( fileRead( result.configPath ) ).name ).toBe( "Docs" );
			} );

			it( "defaults [name] to the source folder name and warns when mkdocs.yml has no site_name", function() {
				var source = newMkdocsProject( "theme:" & char( 10 ) & "  name: material" );
				fileWrite( source & "/docs/index.md", "Home" );

				var result = migrator.migrate( source, newProjectRoot() );

				expect( jsonDeserialize( fileRead( result.configPath ) ).name ).toBe( listLast( source, "/\" ) );
				expect( result.warnings.filter( w => w.findNoCase( "no [site_name]" ) > 0 ).len() ).toBe( 1 );
			} );

		} );
	}

}
