class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "build.PageRenamer", function() {

			beforeEach( function() {
				variables.renamer = new "models.build.PageRenamer@bxdocs"();
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			private string function newDocsDir() {
				var dir = createTempDirectory( prefix = "bxdocs-pagerenamer-" );
				tempDirs.append( dir );
				var docsDir = dir & "/docs";
				directoryCreate( docsDir, true, true );
				return docsDir;
			}

			it( "throws BxDocs.MissingFromPath when from is blank", function() {
				var docsDir = newDocsDir();
				expect( function() {
					renamer.rename( docsDir : docsDir, from : "", to : "x.md" );
				} ).toThrow( "BxDocs.MissingFromPath" );
			} );

			it( "throws BxDocs.MissingToPath when to is blank", function() {
				var docsDir = newDocsDir();
				expect( function() {
					renamer.rename( docsDir : docsDir, from : "a.md", to : "" );
				} ).toThrow( "BxDocs.MissingToPath" );
			} );

			it( "throws BxDocs.InvalidPagePath when from/to doesn't end in .md", function() {
				var docsDir = newDocsDir();
				expect( function() {
					renamer.rename( docsDir : docsDir, from : "a.txt", to : "b.md" );
				} ).toThrow( "BxDocs.InvalidPagePath" );
			} );

			it( "throws BxDocs.SamePagePath when from and to are identical", function() {
				var docsDir = newDocsDir();
				expect( function() {
					renamer.rename( docsDir : docsDir, from : "a.md", to : "a.md" );
				} ).toThrow( "BxDocs.SamePagePath" );
			} );

			it( "throws BxDocs.PageNotFound when the source page doesn't exist", function() {
				var docsDir = newDocsDir();
				expect( function() {
					renamer.rename( docsDir : docsDir, from : "missing.md", to : "target.md" );
				} ).toThrow( "BxDocs.PageNotFound" );
			} );

			it( "throws BxDocs.PageAlreadyExists rather than overwriting the destination", function() {
				var docsDir = newDocsDir();
				fileWrite( docsDir & "/a.md", "a" );
				fileWrite( docsDir & "/b.md", "b" );

				expect( function() {
					renamer.rename( docsDir : docsDir, from : "a.md", to : "b.md" );
				} ).toThrow( "BxDocs.PageAlreadyExists" );
			} );

			it( "moves the file to the new path, creating parent directories as needed", function() {
				var docsDir = newDocsDir();
				fileWrite( docsDir & "/old.md", "## Old" );

				var result = renamer.rename( docsDir : docsDir, from : "old.md", to : "guides/new.md" );

				expect( result.path ).toBe( docsDir & "/guides/new.md" );
				expect( fileExists( docsDir & "/guides/new.md" ) ).toBeTrue();
				expect( fileExists( docsDir & "/old.md" ) ).toBeFalse();
			} );

			it( "retargets links in other files that point at the renamed page, preserving anchors", function() {
				var docsDir = newDocsDir();
				directoryCreate( docsDir & "/guides", true, true );
				fileWrite( docsDir & "/guides/old-name.md", "## Old" );
				fileWrite( docsDir & "/index.md", "See [old](guides/old-name.md##section)." );
				fileWrite( docsDir & "/guides/sibling.md", "See [old](old-name.md)." );

				var result = renamer.rename( docsDir : docsDir, from : "guides/old-name.md", to : "guides/new-name.md" );

				expect( fileRead( docsDir & "/index.md" ) ).toInclude( "[old](guides/new-name.md##section)" );
				expect( fileRead( docsDir & "/guides/sibling.md" ) ).toInclude( "[old](new-name.md)" );
				expect( result.filesUpdated ).toBe( 2 );
			} );

			it( "rebases the moved file's own relative links against its new directory depth", function() {
				var docsDir = newDocsDir();
				directoryCreate( docsDir & "/guides", true, true );
				fileWrite( docsDir & "/configuration.md", "## Config" );
				fileWrite( docsDir & "/guides/moved.md", "See [config](../configuration.md) and [other](other.md)." );
				fileWrite( docsDir & "/guides/other.md", "## Other" );

				renamer.rename( docsDir : docsDir, from : "guides/moved.md", to : "guides/deep/moved.md" );

				var movedContent = fileRead( docsDir & "/guides/deep/moved.md" );
				expect( movedContent ).toInclude( "[config](../../configuration.md)" );
				expect( movedContent ).toInclude( "[other](../other.md)" );
			} );

			it( "leaves links to a different, non-renamed page untouched", function() {
				var docsDir = newDocsDir();
				directoryCreate( docsDir & "/guides", true, true );
				directoryCreate( docsDir & "/other", true, true );
				fileWrite( docsDir & "/guides/old-name.md", "## Old" );
				fileWrite( docsDir & "/other/old-name-extra.md", "See [similar](other-target.md), not the renamed page." );
				fileWrite( docsDir & "/other/other-target.md", "## Other target" );

				renamer.rename( docsDir : docsDir, from : "guides/old-name.md", to : "guides/new-name.md" );

				expect( fileRead( docsDir & "/other/old-name-extra.md" ) ).toInclude( "[similar](other-target.md)" );
			} );

			it( "excludes assets/ from the link-rewrite scan", function() {
				var docsDir = newDocsDir();
				directoryCreate( docsDir & "/assets", true, true );
				fileWrite( docsDir & "/guides.md", "## Guides" );
				fileWrite( docsDir & "/assets/readme.md", "[link](../guides.md)" );

				renamer.rename( docsDir : docsDir, from : "guides.md", to : "guides-renamed.md" );

				expect( fileRead( docsDir & "/assets/readme.md" ) ).toInclude( "[link](../guides.md)" );
			} );

		} );
	}

}
