class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "build.PageRenamer", function() {

			beforeEach( function() {
				variables.renamer = new "models.build.PageRenamer@bxsites"();
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			private string function newDocsDir() {
				var dir = createTempDirectory( prefix = "bxsites-pagerenamer-" );
				tempDirs.append( dir );
				var docsDir = dir & "/docs";
				directoryCreate( docsDir, true, true );
				return docsDir;
			}

			it( "throws BxSites.MissingFromPath when from is blank", function() {
				var docsDir = newDocsDir();
				expect( function() {
					renamer.rename( docsDir : docsDir, from : "", to : "x.md" );
				} ).toThrow( "BxSites.MissingFromPath" );
			} );

			it( "throws BxSites.MissingToPath when to is blank", function() {
				var docsDir = newDocsDir();
				expect( function() {
					renamer.rename( docsDir : docsDir, from : "a.md", to : "" );
				} ).toThrow( "BxSites.MissingToPath" );
			} );

			it( "throws BxSites.InvalidPagePath when from/to doesn't end in .md", function() {
				var docsDir = newDocsDir();
				expect( function() {
					renamer.rename( docsDir : docsDir, from : "a.txt", to : "b.md" );
				} ).toThrow( "BxSites.InvalidPagePath" );
			} );

			it( "throws BxSites.SamePagePath when from and to are identical", function() {
				var docsDir = newDocsDir();
				expect( function() {
					renamer.rename( docsDir : docsDir, from : "a.md", to : "a.md" );
				} ).toThrow( "BxSites.SamePagePath" );
			} );

			it( "throws BxSites.PageNotFound when the source page doesn't exist", function() {
				var docsDir = newDocsDir();
				expect( function() {
					renamer.rename( docsDir : docsDir, from : "missing.md", to : "target.md" );
				} ).toThrow( "BxSites.PageNotFound" );
			} );

			it( "throws BxSites.PageAlreadyExists rather than overwriting the destination", function() {
				var docsDir = newDocsDir();
				fileWrite( docsDir & "/a.md", "a" );
				fileWrite( docsDir & "/b.md", "b" );

				expect( function() {
					renamer.rename( docsDir : docsDir, from : "a.md", to : "b.md" );
				} ).toThrow( "BxSites.PageAlreadyExists" );
			} );

			it( "moves the file to the new path, creating parent directories as needed", function() {
				var docsDir = newDocsDir();
				fileWrite( docsDir & "/old.md", "## Old" );

				var result = renamer.rename( docsDir : docsDir, from : "old.md", to : "guides/new.md" );

				expect( result.path ).toBe( docsDir & "/guides/new.md" );
				expect( fileExists( docsDir & "/guides/new.md" ) ).toBeTrue();
				expect( fileExists( docsDir & "/old.md" ) ).toBeFalse();
			} );

			it( "retargets links in other files that point at the renamed page, preserving anchors", function() {
				var docsDir = newDocsDir();
				directoryCreate( docsDir & "/guides", true, true );
				fileWrite( docsDir & "/guides/old-name.md", "## Old" );
				fileWrite( docsDir & "/index.md", "See [old](guides/old-name.md##section)." );
				fileWrite( docsDir & "/guides/sibling.md", "See [old](old-name.md)." );

				var result = renamer.rename( docsDir : docsDir, from : "guides/old-name.md", to : "guides/new-name.md" );

				expect( fileRead( docsDir & "/index.md" ) ).toInclude( "[old](guides/new-name.md##section)" );
				expect( fileRead( docsDir & "/guides/sibling.md" ) ).toInclude( "[old](new-name.md)" );
				expect( result.filesUpdated ).toBe( 2 );
			} );

			it( "rebases the moved file's own relative links against its new directory depth", function() {
				var docsDir = newDocsDir();
				directoryCreate( docsDir & "/guides", true, true );
				fileWrite( docsDir & "/configuration.md", "## Config" );
				fileWrite( docsDir & "/guides/moved.md", "See [config](../configuration.md) and [other](other.md)." );
				fileWrite( docsDir & "/guides/other.md", "## Other" );

				renamer.rename( docsDir : docsDir, from : "guides/moved.md", to : "guides/deep/moved.md" );

				var movedContent = fileRead( docsDir & "/guides/deep/moved.md" );
				expect( movedContent ).toInclude( "[config](../../configuration.md)" );
				expect( movedContent ).toInclude( "[other](../other.md)" );
			} );

			it( "leaves links to a different, non-renamed page untouched", function() {
				var docsDir = newDocsDir();
				directoryCreate( docsDir & "/guides", true, true );
				directoryCreate( docsDir & "/other", true, true );
				fileWrite( docsDir & "/guides/old-name.md", "## Old" );
				fileWrite( docsDir & "/other/old-name-extra.md", "See [similar](other-target.md), not the renamed page." );
				fileWrite( docsDir & "/other/other-target.md", "## Other target" );

				renamer.rename( docsDir : docsDir, from : "guides/old-name.md", to : "guides/new-name.md" );

				expect( fileRead( docsDir & "/other/old-name-extra.md" ) ).toInclude( "[similar](other-target.md)" );
			} );

			it( "excludes assets/ from the link-rewrite scan", function() {
				var docsDir = newDocsDir();
				directoryCreate( docsDir & "/assets", true, true );
				fileWrite( docsDir & "/guides.md", "## Guides" );
				fileWrite( docsDir & "/assets/readme.md", "[link](../guides.md)" );

				renamer.rename( docsDir : docsDir, from : "guides.md", to : "guides-renamed.md" );

				expect( fileRead( docsDir & "/assets/readme.md" ) ).toInclude( "[link](../guides.md)" );
			} );

			it( "stamps a new redirect_from key onto a moved page's own frontmatter", function() {
				var docsDir = newDocsDir();
				directoryCreate( docsDir & "/guides", true, true );
				fileWrite( docsDir & "/guides/old-setup.md", "---" & char( 10 ) & "title: Old Setup" & char( 10 ) & "---" & char( 10 ) & "Body." );

				var result = renamer.rename( docsDir : docsDir, from : "guides/old-setup.md", to : "guides/new-setup.md" );

				var content = fileRead( result.path );
				expect( content ).toInclude( "redirect_from:" );
				expect( content ).toInclude( "guides/old-setup" );
				expect( content ).toInclude( "title: Old Setup" );
			} );

			it( "appends to an existing block-list redirect_from instead of replacing it", function() {
				var docsDir = newDocsDir();
				directoryCreate( docsDir & "/guides", true, true );
				fileWrite( docsDir & "/guides/mid-setup.md", "---" & char( 10 ) & "title: Mid" & char( 10 ) & "redirect_from:" & char( 10 ) & "  - guides/original-setup" & char( 10 ) & "---" & char( 10 ) & "Body." );

				var result = renamer.rename( docsDir : docsDir, from : "guides/mid-setup.md", to : "guides/final-setup.md" );

				var content = fileRead( result.path );
				expect( content ).toInclude( "guides/original-setup" );
				expect( content ).toInclude( "guides/mid-setup" );
			} );

			it( "merges into an existing inline redirect_from list", function() {
				var docsDir = newDocsDir();
				directoryCreate( docsDir & "/guides", true, true );
				fileWrite( docsDir & "/guides/a.md", "---" & char( 10 ) & "title: A" & char( 10 ) & "redirect_from: [old-a]" & char( 10 ) & "---" & char( 10 ) & "Body." );

				var result = renamer.rename( docsDir : docsDir, from : "guides/a.md", to : "guides/b.md" );

				expect( fileRead( result.path ) ).toInclude( "redirect_from: [old-a, guides/a]" );
			} );

			it( "adds a frontmatter block when the moved page had none", function() {
				var docsDir = newDocsDir();
				directoryCreate( docsDir & "/guides", true, true );
				fileWrite( docsDir & "/guides/plain.md", "## Just a heading" & char( 10 ) & "Body text." );

				var result = renamer.rename( docsDir : docsDir, from : "guides/plain.md", to : "guides/renamed-plain.md" );

				var content = fileRead( result.path );
				expect( content ).toInclude( "redirect_from:" );
				expect( content ).toInclude( "guides/plain" );
			} );

			it( "doesn't duplicate a block-list redirect_from entry that already matches the old path", function() {
				var docsDir = newDocsDir();
				directoryCreate( docsDir & "/guides", true, true );
				fileWrite( docsDir & "/guides/mid-setup.md", "---" & char( 10 ) & "title: Mid" & char( 10 ) & "redirect_from:" & char( 10 ) & "  - guides/mid-setup" & char( 10 ) & "---" & char( 10 ) & "Body." );

				var result = renamer.rename( docsDir : docsDir, from : "guides/mid-setup.md", to : "guides/final-setup.md" );

				var content = fileRead( result.path );
				var firstIndex = content.find( "guides/mid-setup" );
				var secondIndex = content.find( "guides/mid-setup", firstIndex + 1 );
				expect( firstIndex > 0 ).toBeTrue();
				expect( secondIndex ).toBe( 0 );
			} );

			it( "doesn't duplicate an inline redirect_from entry that already matches the old path", function() {
				var docsDir = newDocsDir();
				directoryCreate( docsDir & "/guides", true, true );
				fileWrite( docsDir & "/guides/a.md", "---" & char( 10 ) & "title: A" & char( 10 ) & "redirect_from: [guides/a]" & char( 10 ) & "---" & char( 10 ) & "Body." );

				var result = renamer.rename( docsDir : docsDir, from : "guides/a.md", to : "guides/b.md" );

				expect( fileRead( result.path ) ).toInclude( "redirect_from: [guides/a]" );
			} );

			it( "doesn't stamp redirect_from when renaming the tree's own root index.md", function() {
				var docsDir = newDocsDir();
				fileWrite( docsDir & "/index.md", "---" & char( 10 ) & "title: Home" & char( 10 ) & "---" & char( 10 ) & "Body." );

				var result = renamer.rename( docsDir : docsDir, from : "index.md", to : "welcome.md" );

				expect( fileRead( result.path ) ).notToInclude( "redirect_from" );
			} );

		} );
	}

}
